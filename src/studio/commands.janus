/// Commandes utilisateur et outillage de Janus Studio.
module studio.commands

import editor.completion
import editor.path_prompt
import editor.vim
import studio.files
import studio.frame
import studio.input
import studio.state
import tooling.compiler
import std.graphics

def handleFileCommands(
    borrow var app : StudioAppState,
    borrow var ui : StudioUiState,
    borrow var frame : StudioFrame
) : Unit {
    consumeOpenFileMenu(ui, frame)
    if app.filePrompt.isVisible() {
        submitPathPrompt(app, ui)
        frame.fileInputConsumed = true
        return
    }
    if frame.fileInputConsumed { return }
    if beginPathPromptShortcut(app, frame) { return }
    if closeTabShortcut(app, ui, frame) { return }
    if switchTabShortcut(app, ui, frame) { return }
    if handleClipboardShortcut(app, frame) { return }
    handleSaveShortcut(app, ui, frame)
}

def consumeOpenFileMenu(borrow var ui : StudioUiState, borrow var frame : StudioFrame) : Unit {
    if !ui.fileMenuOpen { return }
    if isKeyPressed(Key.Escape) { ui.fileMenuOpen = false }
    frame.fileInputConsumed = true
}

def submitPathPrompt(borrow var app : StudioAppState, borrow var ui : StudioUiState) : Unit {
    borrow var filePrompt = app.filePrompt
    if !handlePathPromptKeys(filePrompt) { return }
    if filePrompt.action() == PathPromptAction.OpenFolder {
        submitFolderPrompt(app, ui)
        return
    }
    submitDocumentPrompt(app, ui)
}

def submitFolderPrompt(borrow var app : StudioAppState, borrow var ui : StudioUiState) : Unit {
    borrow var filePrompt = app.filePrompt
    borrow var projectRoot = app.projectRoot
    borrow var explorer = app.explorer
    borrow var status = app.status
    borrow var completionError = app.tooling.completionError
    if !openProjectFolder(
        filePrompt.value(),
        projectRoot,
        explorer,
        status
    ) {
        return
    }
    filePrompt.dismiss()
    ui.firstExplorerEntry = usize(0)
    ui.explorerHorizontalOffset = 0
    if !app.tooling.languageServer.restart(
        projectRoot.view(),
        completionError
    ) {
        setStatus(status, completionError.view())
    }
}

def capturePromptedDocument(borrow var app : StudioAppState) : bool {
    borrow var filePrompt = app.filePrompt
    borrow var promptedPath = app.promptedPath
    borrow var status = app.status
    if filePrompt.value() == "" {
        setStatus(status, "Saisissez un chemin de fichier.")
        return false
    }
    if captureDocumentPath(filePrompt.value(), promptedPath) {
        return true
    }
    setStatus(status, "Chemin de fichier invalide.")
    return false
}

def submitDocumentPrompt(borrow var app : StudioAppState, borrow var ui : StudioUiState) : Unit {
    if !capturePromptedDocument(app) { return }
    val action : PathPromptAction = app.filePrompt.action()
    val applied : bool = if action == PathPromptAction.Open {
        openPromptedDocument(app, ui)
    } else {
        if action == PathPromptAction.Create {
            createPromptedDocument(app, ui)
        } else {
            saveAsPromptedDocument(app)
        }
    }
    if applied {
        restoreSelectedDocument(app, ui)
        ui.editorScrollDetached = false
        ui.horizontalScrollDetached = false
    }
}

def openPromptedDocument(borrow var app : StudioAppState, borrow var ui : StudioUiState) : bool {
    borrow var tabs = app.tabs
    borrow var promptedPath = app.promptedPath
    borrow var buffer = app.buffer
    borrow var activePath = app.activePath
    borrow var status = app.status
    val opened : bool = tabs.open(
        promptedPath.view(),
        buffer,
        activePath,
        status,
        ui.firstLine,
        ui.firstColumn
    )
    if opened { app.filePrompt.dismiss() }
    return opened
}

def createPromptedDocument(borrow var app : StudioAppState, borrow var ui : StudioUiState) : bool {
    borrow var promptedPath = app.promptedPath
    borrow var status = app.status
    borrow var tabs = app.tabs
    borrow var buffer = app.buffer
    borrow var activePath = app.activePath
    if !validateNewPath(promptedPath.view(), status) { return false }
    val created : bool = tabs.create(
        promptedPath.view(),
        buffer,
        activePath,
        ui.firstLine,
        ui.firstColumn,
        status
    )
    if created {
        setStatus(status, "Nouveau fichier : Ctrl+S pour le créer.")
        app.filePrompt.dismiss()
    }
    return created
}

def saveAsPromptedDocument(borrow var app : StudioAppState) : bool {
    borrow var tabs = app.tabs
    borrow var promptedPath = app.promptedPath
    borrow var status = app.status
    borrow var filePrompt = app.filePrompt
    borrow var activePath = app.activePath
    borrow var buffer = app.buffer
    borrow var diagnostics = app.tooling.diagnostics
    borrow var search = app.search
    if !tabs.pathAvailableForActive(promptedPath.view()) {
        setStatus(
            status,
            "Ce fichier est déjà ouvert dans un autre onglet."
        )
        return false
    }
    if !applyPathPrompt(
        filePrompt,
        promptedPath.view(),
        activePath,
        buffer,
        diagnostics,
        search,
        status
    ) {
        return false
    }
    return tabs.updateActivePath(activePath.view())
}

def beginPathPromptShortcut(borrow var app : StudioAppState, borrow var frame : StudioFrame) : bool {
    if app.tabs.size() > usize(0) && frame.control && frame.shift &&
    isKeyPressed(Key.S) {
        app.filePrompt.begin(PathPromptAction.SaveAs, app.activePath.view())
    } else if frame.control && isKeyPressed(Key.O) {
        app.filePrompt.begin(PathPromptAction.Open, "")
    } else if frame.control && isKeyPressed(Key.N) {
        app.filePrompt.begin(PathPromptAction.Create, "")
    } else {
        return false
    }
    app.tooling.completion.dismiss()
    frame.fileInputConsumed = true
    return true
}

def closeTabShortcut(
    borrow var app : StudioAppState,
    borrow var ui : StudioUiState,
    borrow var frame : StudioFrame
) : bool {
    borrow var tabs = app.tabs
    borrow var buffer = app.buffer
    borrow var activePath = app.activePath
    borrow var status = app.status
    if tabs.size() == usize(0) || !frame.control ||
    !isKeyPressed(Key.W) {
        return false
    }
    if tabs.close(
        tabs.selected(),
        buffer,
        activePath,
        status,
        ui.firstLine,
        ui.firstColumn
    ) {
        restoreSelectedDocument(app, ui)
        app.tooling.signatureText.clear()
    }
    frame.fileInputConsumed = true
    return true
}

def switchTabShortcut(
    borrow var app : StudioAppState,
    borrow var ui : StudioUiState,
    borrow var frame : StudioFrame
) : bool {
    borrow var tabs = app.tabs
    borrow var buffer = app.buffer
    borrow var activePath = app.activePath
    if tabs.size() == usize(0) || !frame.control ||
    !isKeyPressed(Key.Tab) {
        return false
    }
    val next : usize = if frame.shift {
        if tabs.selected() == usize(0) {
            tabs.size() - usize(1)
        } else {
            tabs.selected() - usize(1)
        }
    } else {
        (tabs.selected() + usize(1)) % tabs.size()
    }
    if tabs.switchTo(
        next,
        buffer,
        activePath,
        ui.firstLine,
        ui.firstColumn
    ) {
        restoreSelectedDocument(app, ui)
        app.tooling.signatureText.clear()
    }
    frame.fileInputConsumed = true
    return true
}

def handleClipboardShortcut(borrow var app : StudioAppState, borrow var frame : StudioFrame) : bool {
    borrow var buffer = app.buffer
    borrow var clipboard = app.clipboard
    borrow var status = app.status
    if app.tabs.size() == usize(0) || !frame.control { return false }
    if isKeyPressed(Key.C) && buffer.appendSelection(clipboard) {
        setClipboardText(clipboard.view())
        setStatus(status, "Sélection copiée.")
    } else if isKeyPressed(Key.X) && buffer.appendSelection(clipboard) {
        setClipboardText(clipboard.view())
        buffer.deleteSelection()
        setStatus(status, "Sélection coupée.")
    } else if isKeyPressed(Key.V) &&
    app.controller.mode() == EditorMode.Insert {
        pasteClipboard(app)
    } else {
        return false
    }
    frame.fileInputConsumed = true
    return true
}

def pasteClipboard(borrow var app : StudioAppState) : Unit {
    borrow var status = app.status
    val systemClipboard : string = clipboardText()
    if systemClipboard != "" {
        app.buffer.insertText(systemClipboard)
    } else if app.clipboard.size() > usize(0) {
        app.buffer.insertText(app.clipboard.view())
    }
    setStatus(status, "Presse-papiers collé.")
}

def handleSaveShortcut(
    borrow var app : StudioAppState,
    borrow var ui : StudioUiState,
    borrow var frame : StudioFrame
) : Unit {
    borrow var buffer = app.buffer
    borrow var status = app.status
    if app.tabs.size() == usize(0) { return }
    if frame.control && isKeyPressed(Key.S) {
        saveFile(app.activePath.view(), buffer, status)
    } else if isKeyPressed(Key.F5) {
        runCompilerCheck(app, ui)
    } else {
        return
    }
    frame.fileInputConsumed = true
}

def runCompilerCheck(borrow var app : StudioAppState, borrow var ui : StudioUiState) : Unit {
    borrow var buffer = app.buffer
    borrow var status = app.status
    borrow var toolOutput = app.tooling.toolOutput
    borrow var diagnostics = app.tooling.diagnostics
    if saveFile(app.activePath.view(), buffer, status) {
        app.tooling.compiler.start(
            app.activePath.view(),
            app.projectRoot.view(),
            toolOutput,
            diagnostics
        )
    }
    ui.firstOutputLine = usize(0)
    ui.firstOutputColumn = usize(0)
}

def handleEditorCommands(
    borrow var app : StudioAppState,
    borrow var ui : StudioUiState,
    borrow var frame : StudioFrame
) : Unit {
    val completionConsumed : bool = completionConsumesInput(app, frame)
    var keyAction : EditorAction = EditorAction.None
    var characterAction : EditorAction = EditorAction.None
    if !completionConsumed {
        borrow var controller = app.controller
        borrow var buffer = app.buffer
        borrow var completion = app.tooling.completion
        keyAction = handleModeKeys(controller, buffer)
        characterAction = handlePrintableKeys(
            controller,
            buffer,
            completion
        )
    }
    updateCompletionFilter(app, completionConsumed)
    characterAction = resolveLanguageFeatureAction(app, frame, characterAction)
    dismissStaleLanguageHints(app, completionConsumed)
    pollTooling(app, ui)
    val requestedAction : EditorAction = resolveSearchAction(
        app,
        keyAction,
        characterAction
    )
    applyEditorCommand(app, ui, frame, requestedAction)
}

def completionConsumesInput(
    borrow var app : StudioAppState,
    borrow var frame : StudioFrame
) : bool {
    borrow var completion = app.tooling.completion
    borrow var buffer = app.buffer
    borrow var pendingSignature = app.tooling.pendingSignature
    if frame.fileInputConsumed || app.tabs.size() == usize(0) { return true }
    return handleCompletionKeys(
        completion,
        buffer,
        pendingSignature
    )
}

def updateCompletionFilter(
    borrow var app : StudioAppState,
    completionConsumed : bool
) : Unit {
    if !completionConsumed && isKeyPressed(Key.Backspace) &&
    app.tooling.completion.isFiltering() {
        app.tooling.completion.broaden()
    }
}

def resolveLanguageFeatureAction(
    borrow var app : StudioAppState,
    borrow var frame : StudioFrame,
    action : EditorAction
) : EditorAction {
    borrow var languageServer = app.tooling.languageServer
    borrow var buffer = app.buffer
    borrow var completion = app.tooling.completion
    borrow var completionLabels = app.tooling.completionLabels
    borrow var completionError = app.tooling.completionError
    borrow var status = app.status
    borrow var signatureText = app.tooling.signatureText
    borrow var pendingSignature = app.tooling.pendingSignature
    val manualCompletion : bool = app.controller.mode() == EditorMode.Insert &&
    frame.control && isKeyPressed(Key.Space)
    if action == EditorAction.Complete || manualCompletion {
        refreshCompletion(
            languageServer,
            app.activePath.view(),
            buffer,
            completion,
            completionLabels,
            completionError,
            status
        )
        return EditorAction.None
    }
    if action == EditorAction.SignatureHelp {
        completion.dismiss()
        refreshSignatureHelp(
            languageServer,
            app.activePath.view(),
            buffer,
            signatureText,
            pendingSignature,
            completionError
        )
        return EditorAction.None
    }
    if action == EditorAction.DismissSignatureHelp {
        completion.dismiss()
        signatureText.clear()
        pendingSignature.clear()
        return EditorAction.None
    }
    if action == EditorAction.DismissCompletion {
        completion.dismiss()
        return EditorAction.None
    }
    return action
}

def completionInvalidatedByNavigation() : bool {
    return isKeyPressed(Key.Left) || isKeyPressed(Key.Right) ||
    isKeyPressed(Key.Home) || isKeyPressed(Key.End) ||
    isKeyPressed(Key.Delete) || isKeyPressed(Key.Enter) ||
    isKeyPressed(Key.Tab)
}

def signatureInvalidated(borrow var app : StudioAppState) : bool {
    return app.controller.mode() != EditorMode.Insert ||
    isKeyPressed(Key.Escape) || isKeyPressed(Key.Backspace) ||
    isKeyPressed(Key.Delete) || isKeyPressed(Key.Left) ||
    isKeyPressed(Key.Right) || isKeyPressed(Key.Home) ||
    isKeyPressed(Key.End)
}

def dismissStaleLanguageHints(
    borrow var app : StudioAppState,
    completionConsumed : bool
) : Unit {
    if !completionConsumed && app.tooling.completion.isFiltering() &&
    completionInvalidatedByNavigation() {
        app.tooling.completion.dismiss()
    }
    if signatureInvalidated(app) { app.tooling.signatureText.clear() }
}

def pollTooling(borrow var app : StudioAppState, borrow var ui : StudioUiState) : Unit {
    borrow var languageServer = app.tooling.languageServer
    borrow var buffer = app.buffer
    borrow var completion = app.tooling.completion
    borrow var completionLabels = app.tooling.completionLabels
    borrow var signatureText = app.tooling.signatureText
    borrow var pendingSignature = app.tooling.pendingSignature
    borrow var semanticTokens = app.tooling.semanticTokens
    borrow var completionError = app.tooling.completionError
    borrow var status = app.status
    borrow var toolOutput = app.tooling.toolOutput
    borrow var diagnostics = app.tooling.diagnostics
    borrow var storedSemanticRevision = app.tooling.semanticRevision
    borrow var compiler = app.tooling.compiler
    val semanticRevision : usize = pollLanguageServer(
        languageServer,
        app.activePath.view(),
        buffer,
        completion,
        completionLabels,
        signatureText,
        pendingSignature,
        semanticTokens,
        storedSemanticRevision,
        completionError,
        status
    )
    storedSemanticRevision = semanticRevision
    val compilerState : CompilerCheckState = compiler.poll(
        toolOutput,
        diagnostics
    )
    if compilerState == CompilerCheckState.Completed ||
    compilerState == CompilerCheckState.Failed {
        ui.firstOutputLine = usize(0)
        ui.firstOutputColumn = usize(0)
    }
}

def resolveSearchAction(
    borrow var app : StudioAppState,
    keyAction : EditorAction,
    characterAction : EditorAction
) : EditorAction {
    borrow var search = app.search
    borrow var buffer = app.buffer
    borrow var status = app.status
    if keyAction == EditorAction.Search {
        search.begin(buffer, app.controller.commandView())
        search.appendStatus(status)
        return EditorAction.None
    }
    if keyAction == EditorAction.SearchNext ||
    characterAction == EditorAction.SearchNext {
        search.selectNext(buffer)
        search.appendStatus(status)
        return EditorAction.None
    }
    if keyAction == EditorAction.SearchPrevious ||
    characterAction == EditorAction.SearchPrevious {
        search.selectPrevious(buffer)
        search.appendStatus(status)
        return EditorAction.None
    }
    return if keyAction != EditorAction.None { keyAction } else { characterAction }
}

def applyEditorCommand(
    borrow var app : StudioAppState,
    borrow var ui : StudioUiState,
    borrow var frame : StudioFrame,
    requestedAction : EditorAction
) : Unit {
    borrow var buffer = app.buffer
    borrow var status = app.status
    borrow var tabs = app.tabs
    val editorQuitRequested : bool = applyEditorAction(
        requestedAction,
        app.activePath.view(),
        buffer,
        status
    )
    val hasModifiedDocuments : bool = tabs.anyModified(buffer)
    ui.quitRequested = resolveQuitRequest(
        editorQuitRequested,
        requestedAction == EditorAction.ForceQuit,
        frame.nativeCloseRequested,
        hasModifiedDocuments
    )
    if (editorQuitRequested || frame.nativeCloseRequested) &&
    !ui.quitRequested && hasModifiedDocuments {
        setStatus(
            status,
            "Des onglets contiennent des modifications non enregistrées."
        )
    }
}
