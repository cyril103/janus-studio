/// Géométrie, navigation visuelle et rendu de Janus Studio.
module studio.view

import editor.buffer
import editor.completion
import editor.explorer
import editor.path_prompt
import editor.search
import editor.syntax
import editor.vim
import tooling.diagnostics
import std.array
import std.graphics
import std.text

var editorLeft : int = 260
const editorTop : int = 62
var editorBottom : int = 590
const codeFontSize : float = 20.0f
const codeFontSpacing : float = 1.0f
const statusBarHeight : int = 28
const commandLineHeight : int = 28
const explorerTreeTop : int = 120
const explorerRowHeight : int = 28
const explorerIndentWidth : int = 16
const doubleClickDelayMilliseconds : usize = usize(500)
const fileMenuX : int = 172
const fileMenuWidth : int = 250
const fileMenuButtonWidth : int = 78
const fileMenuTop : int = 54
const fileMenuRowHeight : int = 42
const separatorHitWidth : int = 5
const minimumExplorerWidth : int = 150
const minimumEditorWidth : int = 360
const minimumEditorHeight : int = 180
const minimumOutputHeight : int = 80
const editorGutterWidth : int = 56

def editorCodeLeft() : int {
    return editorLeft + editorGutterWidth
}

enum PaneResize derives Copy, Equality, Debug {
    None,
    Explorer,
    Output
}

def pathPromptTitle(action : PathPromptAction) : string {
    return match action {
        Open => "OUVRIR UN FICHIER",
        OpenFolder => "OUVRIR UN DOSSIER",
        Create => "NOUVEAU FICHIER",
        SaveAs => "ENREGISTRER SOUS",
        None => "FICHIER"
    }
}

def pointInArea(x : int, y : int, width : int, height : int) : bool {
    return mouseX() >= x && mouseX() < x + width &&
    mouseY() >= y && mouseY() < y + height
}

def distance(left : int, right : int) : int {
    return if left >= right { left - right } else { right - left }
}

def explorerSeparatorHovered() : bool {
    return distance(mouseX(), editorLeft - 12) <= separatorHitWidth &&
    mouseY() >= editorTop &&
    mouseY() < screenHeight() - statusBarHeight - commandLineHeight
}

def outputSeparatorHovered() : bool {
    return distance(mouseY(), editorBottom) <= separatorHitWidth &&
    mouseX() >= editorLeft - 12 && mouseX() < screenWidth()
}

def resizeExplorerToMouse() : Unit {
    val requested : int = mouseX() + 12
    val maximum : int = screenWidth() - minimumEditorWidth
    if requested < minimumExplorerWidth + 12 {
        editorLeft = minimumExplorerWidth + 12
    } else if requested > maximum {
        editorLeft = maximum
    } else {
        editorLeft = requested
    }
}

def resizeOutputToMouse() : Unit {
    val requested : int = mouseY()
    val maximum : int = screenHeight() - statusBarHeight -
    commandLineHeight - minimumOutputHeight
    if requested < editorTop + minimumEditorHeight {
        editorBottom = editorTop + minimumEditorHeight
    } else if requested > maximum {
        editorBottom = maximum
    } else {
        editorBottom = requested
    }
}

def keepCursorVisible(
buffer : EditorBuffer,
firstLine : usize,
maximumLines : usize
) : usize {
    val cursorLine : usize = buffer.line()
    if cursorLine < firstLine {
        return cursorLine
    }
    if cursorLine >= firstLine + maximumLines {
        return cursorLine - maximumLines + usize(1)
    }
    return firstLine
}

def maximumEditorFirst(
buffer : EditorBuffer,
maximumLines : usize
) : usize {
    return if buffer.lineCount() > maximumLines {
        buffer.lineCount() - maximumLines
    } else {
        usize(0)
    }
}

def scrollEditor(
buffer : EditorBuffer,
first : usize,
maximumLines : usize
) : usize {
    if mouseX() < editorLeft - 12 || mouseX() >= screenWidth() ||
    mouseY() < editorTop || mouseY() >= editorBottom {
        return first
    }
    val movement : float = mouseWheelMove()
    if movement > 0.0f {
        return if first > usize(2) { first - usize(3) } else { usize(0) }
    }
    if movement < 0.0f {
        val maximum : usize = maximumEditorFirst(buffer, maximumLines)
        val requested : usize = first + usize(3)
        return if requested < maximum { requested } else { maximum }
    }
    return first
}

def moveCursorToEditorMouse(
buffer : EditorBuffer,
firstLine : usize,
glyphAdvance : float,
lineAdvance : float,
maximumLines : usize
) : Unit {
    val relativeY : int = mouseY() - editorTop - 12
    var row : usize = if relativeY > 0 {
        numericCast[usize](truncatingCast[int](
        numericCast[float](relativeY) / lineAdvance
        ))
    } else {
        usize(0)
    }
    if maximumLines > usize(0) && row >= maximumLines {
        row = maximumLines - usize(1)
    }
    val relativeX : int = mouseX() - editorCodeLeft()
    val column : usize = if relativeX > 0 {
        numericCast[usize](truncatingCast[int](
        (numericCast[float](relativeX) + glyphAdvance * 0.5f) /
        glyphAdvance
        ))
    } else {
        usize(0)
    }
    buffer.moveTo(firstLine + row, column)
}

def explorerVisibleRows() : usize {
    val available : int = screenHeight() - statusBarHeight -
    commandLineHeight - explorerTreeTop
    if available <= 0 {
        return usize(0)
    }
    return numericCast[usize](available / explorerRowHeight)
}

def maximumExplorerFirst(
explorer : ProjectExplorer,
visibleRows : usize
) : usize {
    return if explorer.size() > visibleRows {
        explorer.size() - visibleRows
    } else {
        usize(0)
    }
}

def scrollExplorer(
explorer : ProjectExplorer,
first : usize,
visibleRows : usize
) : usize {
    if mouseX() >= editorLeft - 12 || mouseY() < explorerTreeTop ||
    mouseY() >= explorerTreeTop +
    truncatingCast[int](visibleRows) * explorerRowHeight {
        return first
    }
    val movement : float = mouseWheelMove()
    if movement > 0.0f {
        return if first > usize(2) { first - usize(3) } else { usize(0) }
    }
    if movement < 0.0f {
        val maximum : usize = maximumExplorerFirst(explorer, visibleRows)
        val requested : usize = first + usize(3)
        return if requested < maximum { requested } else { maximum }
    }
    return first
}

def explorerEntryAtMouse(
explorer : ProjectExplorer,
first : usize,
visibleRows : usize
) : usize {
    if mouseX() < 0 || mouseX() >= editorLeft - 12 ||
    mouseY() < explorerTreeTop ||
    mouseY() >= explorerTreeTop +
    truncatingCast[int](visibleRows) * explorerRowHeight {
        return usize(-1)
    }
    val row : usize = numericCast[usize](
    (mouseY() - explorerTreeTop) / explorerRowHeight
    )
    val index : usize = first + row
    return if index < explorer.size() { index } else { usize(-1) }
}

def buildStatusLine(
output : TextBuilder,
path : string,
buffer : EditorBuffer
) : Unit {
    output.clear()
    output.append(if path == "" { "Nouveau fichier" } else { path })
    output.append(if buffer.isModified() { "  • modifié" } else { "  • enregistré" })
    output.append("    ligne ")
    output.appendUSize(buffer.line() + usize(1))
    output.append(", colonne ")
    output.appendUSize(buffer.column() + usize(1))
}

def drawUiText(
font : Font,
text : string,
x : int,
y : int,
size : float,
color : Color
) : Unit {
    font.draw(
    text,
    vector2(numericCast[float](x), numericCast[float](y)),
    size,
    0.25f,
    color
    )
}

def drawCodeText(
font : Font,
text : string,
x : int,
y : int,
size : float,
color : Color
) : Unit {
    font.draw(
    text,
    vector2(numericCast[float](x), numericCast[float](y)),
    size,
    codeFontSpacing,
    color
    )
}

def drawRoundedRectangle(
x : int,
y : int,
width : int,
height : int,
roundness : float,
color : Color
) : Unit {
    drawRectangleRounded(
    rectangle(
    numericCast[float](x),
    numericCast[float](y),
    numericCast[float](width),
    numericCast[float](height)
    ),
    roundness,
    8,
    color
    )
}

def drawRoundedOutline(
x : int,
y : int,
width : int,
height : int,
roundness : float,
thickness : float,
color : Color
) : Unit {
    drawRectangleRoundedLines(
    rectangle(
    numericCast[float](x),
    numericCast[float](y),
    numericCast[float](width),
    numericCast[float](height)
    ),
    roundness,
    8,
    thickness,
    color
    )
}

def syntaxColor(kind : SyntaxKind) : Color {
    if kind == SyntaxKind.Keyword {
        return rgb(198, 160, 246)
    }
    if kind == SyntaxKind.Type {
        return rgb(126, 200, 227)
    }
    if kind == SyntaxKind.String {
        return rgb(166, 218, 149)
    }
    if kind == SyntaxKind.Character {
        return rgb(139, 213, 202)
    }
    if kind == SyntaxKind.Number {
        return rgb(245, 194, 231)
    }
    if kind == SyntaxKind.Comment {
        return rgb(108, 117, 145)
    }
    if kind == SyntaxKind.Operator {
        return rgb(238, 212, 159)
    }
    return rgb(205, 214, 244)
}

def modeColor(mode : EditorMode) : Color {
    if mode == EditorMode.Insert {
        return rgb(166, 218, 149)
    }
    if mode == EditorMode.Command || mode == EditorMode.Search {
        return rgb(249, 226, 175)
    }
    return rgb(137, 180, 250)
}

def drawHighlightedCode(
font : Font,
characters : Array[char],
spans : Array[SyntaxSpan],
glyph : TextBuilder,
x : int,
y : int,
glyphAdvance : float,
lineAdvance : float
) : Unit {
    var line : usize = usize(0)
    var column : usize = usize(0)
    var spanIndex : usize = usize(0)
    while spanIndex < spans.size() {
        val span : SyntaxSpan = spans.get(spanIndex)
        val color : Color = syntaxColor(span.kind)
        var index : usize = span.start
        val end : usize = span.start + span.length
        while index < end {
            val value : char = characters.get(index)
            if value == '\n' {
                line = line + usize(1)
                column = usize(0)
            } else {
                if value != ' ' && value != '\t' && value != '\r' {
                    glyph.clear()
                    glyph.appendChar(value)
                    drawCodeText(
                    font,
                    glyph.view(),
                    x + truncatingCast[int](
                    numericCast[float](truncatingCast[int](column)) * glyphAdvance
                    ),
                    y + truncatingCast[int](
                    numericCast[float](truncatingCast[int](line)) * lineAdvance
                    ),
                    codeFontSize,
                    color
                    )
                }
                column = column + usize(1)
            }
            index = index + usize(1)
        }
        spanIndex = spanIndex + usize(1)
    }
}

def drawLineNumbers(
font : Font,
label : TextBuilder,
firstLine : usize,
maximumLines : usize,
lineCount : usize,
y : int,
lineAdvance : float,
color : Color
) : Unit {
    var row : usize = usize(0)
    while row < maximumLines && firstLine + row < lineCount {
        label.clear()
        label.appendUSize(firstLine + row + usize(1))
        drawCodeText(
        font,
        label.view(),
        editorCodeLeft() - 48,
        y + truncatingCast[int](
        numericCast[float](truncatingCast[int](row)) * lineAdvance
        ),
        14.0f,
        color
        )
        row = row + usize(1)
    }
}

def drawEditorDiagnostics(
diagnostics : EditorDiagnostics,
firstLine : usize,
maximumLines : usize,
y : int,
glyphAdvance : float,
lineAdvance : float
) : Unit {
    var index : usize = usize(0)
    while index < diagnostics.size() {
        val line : usize = diagnostics.line(index)
        if line >= firstLine && line < firstLine + maximumLines {
            val row : usize = line - firstLine
            val diagnosticY : int = y + truncatingCast[int](
            numericCast[float](truncatingCast[int](row)) * lineAdvance
            )
            val color : Color = if diagnostics.isError(index) {
                rgb(243, 139, 168)
            } else {
                rgb(249, 226, 175)
            }
            drawRectangle(editorCodeLeft() - 12, diagnosticY + 7, 5, 12, color)
            drawRectangle(
            editorCodeLeft() + truncatingCast[int](
            numericCast[float](truncatingCast[int](diagnostics.column(index))) *
            glyphAdvance
            ),
            diagnosticY + 21,
            truncatingCast[int](glyphAdvance),
            2,
            color
            )
        }
        index = index + usize(1)
    }
}

def drawSearchMatches(
search : SearchModel,
buffer : EditorBuffer,
firstLine : usize,
maximumLines : usize,
y : int,
glyphAdvance : float,
lineAdvance : float
) : Unit {
    var index : usize = usize(0)
    while index < search.size() {
        val line : usize = buffer.lineAtOffset(search.offset(index))
        if line >= firstLine && line < firstLine + maximumLines {
            val column : usize = buffer.columnAtOffset(search.offset(index))
            val row : usize = line - firstLine
            drawRectangle(
            editorCodeLeft() + truncatingCast[int](
            numericCast[float](truncatingCast[int](column)) * glyphAdvance
            ),
            y + truncatingCast[int](
            numericCast[float](truncatingCast[int](row)) * lineAdvance
            ),
            truncatingCast[int](
            numericCast[float](truncatingCast[int](search.length())) *
            glyphAdvance
            ),
            23,
            if index == search.selected() {
                rgb(74, 83, 117)
            } else {
                rgb(48, 55, 76)
            }
            )
        }
        index = index + usize(1)
    }
}

def drawSelection(
buffer : EditorBuffer,
firstLine : usize,
maximumLines : usize,
y : int,
glyphAdvance : float,
lineAdvance : float
) : Unit {
    if !buffer.hasSelection() { return }
    val startLine : usize = buffer.lineAtOffset(buffer.selectionStart())
    val endLine : usize = buffer.lineAtOffset(buffer.selectionEnd())
    val startColumn : usize = buffer.columnAtOffset(buffer.selectionStart())
    val endColumn : usize = buffer.columnAtOffset(buffer.selectionEnd())
    var line : usize = startLine
    while line <= endLine {
        if line >= firstLine && line < firstLine + maximumLines {
            val firstColumn : usize = if line == startLine {
                startColumn
            } else {
                usize(0)
            }
            val lastColumn : usize = if line == endLine {
                endColumn
            } else {
                buffer.lineLength(line)
            }
            if lastColumn > firstColumn {
                drawRectangle(
                editorCodeLeft() + truncatingCast[int](
                numericCast[float](truncatingCast[int](firstColumn)) *
                glyphAdvance
                ),
                y + truncatingCast[int](
                numericCast[float](truncatingCast[int](line - firstLine)) *
                lineAdvance
                ),
                truncatingCast[int](
                numericCast[float](truncatingCast[int](
                lastColumn - firstColumn
                )) * glyphAdvance
                ),
                23,
                rgb(54, 66, 96)
                )
            }
        }
        line = line + usize(1)
    }
}

def drawExplorer(
explorer : ProjectExplorer,
firstEntry : usize,
visibleRows : usize,
label : TextBuilder,
font : Font,
muted : Color
) : Unit {
    var index : usize = firstEntry
    var row : usize = usize(0)
    while index < explorer.size() && row < visibleRows {
        val y : int = explorerTreeTop +
        truncatingCast[int](row) * explorerRowHeight
        val rowHovered : bool = pointInArea(
        8,
        y - 2,
        editorLeft - 28,
        explorerRowHeight
        )
        if explorer.selected() == index {
            drawRoundedRectangle(
            8,
            y - 1,
            editorLeft - 28,
            explorerRowHeight - 2,
            0.22f,
            rgb(49, 55, 75)
            )
            drawRoundedRectangle(8, y + 4, 3, 14, 0.8f, rgb(137, 180, 250))
        } else if rowHovered {
            drawRoundedRectangle(
            8,
            y - 1,
            editorLeft - 28,
            explorerRowHeight - 2,
            0.22f,
            rgb(37, 42, 56)
            )
        }
        val x : int = 16 + truncatingCast[int](explorer.depth(index)) *
        explorerIndentWidth
        if explorer.isDirectory(index) {
            val icon : Color = if explorer.selected() == index {
                rgb(137, 180, 250)
            } else {
                rgb(166, 173, 200)
            }
            drawRectangle(x + 2, y + 7, 11, 9, icon)
            drawRectangle(x + 3, y + 5, 5, 3, icon)
            if explorer.isExpanded(index) {
                drawLine(x - 6, y + 9, x - 3, y + 12, muted)
                drawLine(x - 3, y + 12, x, y + 9, muted)
            } else {
                drawLine(x - 5, y + 8, x - 2, y + 11, muted)
                drawLine(x - 2, y + 11, x - 5, y + 14, muted)
            }
        } else {
            drawRoundedOutline(x + 3, y + 5, 9, 12, 0.18f, 1.0f, muted)
        }
        explorer.appendLabel(index, label)
        var labelColor : Color = muted
        if explorer.isDirectory(index) {
            labelColor = rgb(205, 214, 244)
        }
        if explorer.selected() == index {
            labelColor = rgb(239, 241, 245)
        }
        drawUiText(
        font,
        label.view(),
        x + 19,
        y + 4,
        15.0f,
        labelColor
        )
        index = index + usize(1)
        row = row + usize(1)
    }
}

def drawStudio(
path : string,
buffer : EditorBuffer,
firstLine : usize,
visibleCharacters : Array[char],
syntaxSpans : Array[SyntaxSpan],
glyph : TextBuilder,
diagnostics : EditorDiagnostics,
diagnosticText : TextBuilder,
search : SearchModel,
completion : CompletionModel,
completionText : TextBuilder,
signatureText : TextBuilder,
pathPrompt : PathPrompt,
statusLine : TextBuilder,
status : TextBuilder,
toolOutput : TextBuilder,
modeLine : TextBuilder,
commandLine : TextBuilder,
explorer : ProjectExplorer,
firstExplorerEntry : usize,
visibleExplorerRows : usize,
explorerLabel : TextBuilder,
fileMenuOpen : bool,
mode : EditorMode,
uiFont : Font,
codeFont : Font,
glyphAdvance : float,
lineAdvance : float,
maximumLines : usize
) : Unit {
    buffer.appendVisibleCharacters(visibleCharacters, firstLine, maximumLines)
    highlight(visibleCharacters, syntaxSpans)
    buildStatusLine(statusLine, path, buffer)
    diagnostics.appendForLine(buffer.line(), diagnosticText)

    val background : Color = rgb(17, 19, 27)
    val sidebar : Color = rgb(24, 27, 37)
    val header : Color = rgb(20, 23, 32)
    val panel : Color = rgb(14, 16, 23)
    val surface : Color = rgb(30, 34, 46)
    val surfaceHover : Color = rgb(43, 48, 65)
    val border : Color = rgb(45, 51, 68)
    val accent : Color = rgb(137, 180, 250)
    val text : Color = rgb(205, 214, 244)
    val muted : Color = rgb(127, 132, 156)
    val bottomStatusY : int = screenHeight() - statusBarHeight - commandLineHeight
    val commandLineY : int = screenHeight() - commandLineHeight

    beginDrawing()
    clearBackground(background)
    drawRectangle(0, 0, screenWidth(), editorTop, header)
    drawRectangle(0, editorTop - 1, screenWidth(), 1, border)
    drawRectangle(
    0,
    editorTop,
    editorLeft - 12,
    screenHeight() - editorTop,
    sidebar
    )
    drawRectangle(editorLeft - 12, editorTop, 1, editorBottom - editorTop, border)
    drawRectangle(
    editorLeft - 11,
    editorTop,
    editorGutterWidth + 11,
    editorBottom - editorTop,
    rgb(20, 23, 32)
    )
    drawRectangle(editorCodeLeft() - 1, editorTop, 1, editorBottom - editorTop, border)
    drawRectangle(
    editorLeft - 12,
    editorBottom,
    screenWidth() - editorLeft + 12,
    screenHeight() - editorBottom,
    panel
    )
    drawRectangle(
    editorLeft - 13,
    editorTop,
    2,
    screenHeight() - editorTop - statusBarHeight - commandLineHeight,
    if explorerSeparatorHovered() { accent } else { border }
    )
    drawRectangle(
    editorLeft - 12,
    editorBottom - 1,
    screenWidth() - editorLeft + 12,
    2,
    if outputSeparatorHovered() { accent } else { border }
    )

    drawRoundedRectangle(14, 13, 34, 34, 0.28f, accent)
    drawUiText(uiFont, "J", 24, 16, 22.0f, header)
    drawUiText(uiFont, "Janus", 58, 13, 22.0f, text)
    drawUiText(uiFont, "STUDIO", 58, 36, 11.0f, muted)
    val fileMenuHovered : bool = pointInArea(
    fileMenuX,
    10,
    fileMenuButtonWidth,
    40
    )
    if fileMenuOpen || fileMenuHovered {
        drawRoundedRectangle(
        fileMenuX,
        10,
        fileMenuButtonWidth,
        40,
        0.25f,
        if fileMenuOpen { surfaceHover } else { surface }
        )
    }
    drawUiText(uiFont, "Fichier", fileMenuX + 11, 19, 16.0f, text)

    val availableTabWidth : int = screenWidth() - editorLeft - 24
    val activeTabWidth : int = if availableTabWidth > 380 {
        380
    } else {
        availableTabWidth
    }
    if activeTabWidth > 100 {
        drawRoundedRectangle(
        editorLeft,
        10,
        activeTabWidth,
        42,
        0.18f,
        surface
        )
        drawRoundedRectangle(editorLeft, 18, 3, 26, 0.8f, accent)
        drawCircle(editorLeft + 19, 31, 4.0f, rgb(166, 218, 149))
        drawUiText(
        uiFont,
        if path == "" { "Nouveau fichier" } else { path },
        editorLeft + 31,
        23,
        16.0f,
        text
        )
    }

    drawUiText(uiFont, "PROJET", 16, 78, 15.0f, muted)
    drawRectangle(16, 105, editorLeft - 44, 1, border)
    drawExplorer(
    explorer,
    firstExplorerEntry,
    visibleExplorerRows,
    explorerLabel,
    uiFont,
    muted
    )

    if buffer.line() >= firstLine &&
    buffer.line() < firstLine + maximumLines {
        val activeRow : int = truncatingCast[int](buffer.line() - firstLine)
        drawRectangle(
        editorLeft - 10,
        editorTop + 10 + truncatingCast[int](
        numericCast[float](activeRow) * lineAdvance
        ),
        screenWidth() - editorLeft + 2,
        25,
        rgb(23, 27, 38)
        )
    }

    drawLineNumbers(
    codeFont,
    glyph,
    firstLine,
    maximumLines,
    buffer.lineCount(),
    editorTop + 12,
    lineAdvance,
    muted
    )

    drawSelection(
    buffer,
    firstLine,
    maximumLines,
    editorTop + 12,
    glyphAdvance,
    lineAdvance
    )

    drawSearchMatches(
    search,
    buffer,
    firstLine,
    maximumLines,
    editorTop + 12,
    glyphAdvance,
    lineAdvance
    )

    drawHighlightedCode(
    codeFont,
    visibleCharacters,
    syntaxSpans,
    glyph,
    editorCodeLeft(),
    editorTop + 12,
    glyphAdvance,
    lineAdvance
    )
    drawEditorDiagnostics(
    diagnostics,
    firstLine,
    maximumLines,
    editorTop + 12,
    glyphAdvance,
    lineAdvance
    )
    val cursorVisible : bool = buffer.line() >= firstLine &&
    buffer.line() < firstLine + maximumLines
    var cursorX : int = editorCodeLeft()
    var cursorY : int = editorTop + 12
    if cursorVisible {
        val cursorColumn : float = numericCast[float](
        truncatingCast[int](buffer.column())
        )
        val cursorLine : float = numericCast[float](
        truncatingCast[int](buffer.line() - firstLine)
        )
        cursorX = editorCodeLeft() +
        truncatingCast[int](cursorColumn * glyphAdvance)
        cursorY = editorTop + 12 +
        truncatingCast[int](cursorLine * lineAdvance)
        val cursorWidth : int = if mode == EditorMode.Insert {
            2
        } else {
            truncatingCast[int](glyphAdvance)
        }
        drawRectangle(cursorX, cursorY, cursorWidth, 23, accent)
    }

    if buffer.lineCount() > maximumLines {
        val trackHeight : int = editorBottom - editorTop
        val lineCount : int = truncatingCast[int](buffer.lineCount())
        var thumbHeight : int = trackHeight *
        truncatingCast[int](maximumLines) / lineCount
        if thumbHeight < 28 {
            thumbHeight = 28
        }
        val maximumFirst : int = truncatingCast[int](
        maximumEditorFirst(buffer, maximumLines)
        )
        val thumbY : int = editorTop +
        (trackHeight - thumbHeight) * truncatingCast[int](firstLine) /
        maximumFirst
        drawRectangle(screenWidth() - 6, editorTop, 6, trackHeight, panel)
        drawRoundedRectangle(
        screenWidth() - 5,
        thumbY,
        4,
        thumbHeight,
        0.8f,
        rgb(89, 96, 120)
        )
    }

    if completion.isVisible() && cursorVisible {
        val shown : usize = if completion.size() < usize(8) {
            completion.size()
        } else {
            usize(8)
        }
        val popupHeight : int = truncatingCast[int](shown) * 24 + 10
        val requestedX : int = cursorX
        val availablePopupWidth : int = screenWidth() - editorCodeLeft() - 16
        val popupWidth : int = if availablePopupWidth < 620 {
            availablePopupWidth
        } else {
            620
        }
        val fittedPopupX : int = if requestedX + popupWidth + 10 < screenWidth() {
            requestedX
        } else {
            screenWidth() - popupWidth - 10
        }
        val popupX : int = if fittedPopupX < editorCodeLeft() {
            editorCodeLeft()
        } else { fittedPopupX }
        val popupY : int = if cursorY + 27 + popupHeight < editorBottom {
            cursorY + 27
        } else {
            cursorY - popupHeight
        }
        drawRoundedRectangle(
        popupX + 5,
        popupY + 6,
        popupWidth,
        popupHeight,
        0.08f,
        rgba(5, 7, 12, 150)
        )
        drawRoundedRectangle(
        popupX,
        popupY,
        popupWidth,
        popupHeight,
        0.08f,
        surface
        )
        drawRoundedOutline(
        popupX,
        popupY,
        popupWidth,
        popupHeight,
        0.08f,
        1.0f,
        border
        )
        completion.appendVisible(completionText, usize(8))
        drawCodeText(
        codeFont,
        completionText.view(),
        popupX + 8,
        popupY + 5,
        17.0f,
        text
        )
    }

    if signatureText.size() > usize(0) && cursorVisible {
        val availableSignatureWidth : int =
        screenWidth() - editorCodeLeft() - 16
        val signatureWidth : int = if availableSignatureWidth < 620 {
            availableSignatureWidth
        } else {
            620
        }
        val fittedSignatureX : int =
        if cursorX + signatureWidth + 10 < screenWidth() {
            cursorX
        } else {
            screenWidth() - signatureWidth - 10
        }
        val signatureX : int = if fittedSignatureX < editorCodeLeft() {
            editorCodeLeft()
        } else { fittedSignatureX }
        val signatureY : int = if cursorY - 38 >= editorTop {
            cursorY - 38
        } else {
            cursorY + 27
        }
        drawRoundedRectangle(
        signatureX + 4,
        signatureY + 5,
        signatureWidth,
        32,
        0.18f,
        rgba(5, 7, 12, 150)
        )
        drawRoundedRectangle(
        signatureX,
        signatureY,
        signatureWidth,
        32,
        0.18f,
        surface
        )
        drawRoundedOutline(
        signatureX,
        signatureY,
        signatureWidth,
        32,
        0.18f,
        1.0f,
        border
        )
        drawCodeText(
        codeFont,
        signatureText.view(),
        signatureX + 8,
        signatureY + 5,
        17.0f,
        text
        )
    }

    if fileMenuOpen {
        drawRoundedRectangle(
        fileMenuX + 5,
        fileMenuTop + 6,
        fileMenuWidth,
        fileMenuRowHeight * 2 + 10,
        0.08f,
        rgba(5, 7, 12, 160)
        )
        drawRoundedRectangle(
        fileMenuX,
        fileMenuTop,
        fileMenuWidth,
        fileMenuRowHeight * 2 + 10,
        0.08f,
        surface
        )
        drawRoundedOutline(
        fileMenuX,
        fileMenuTop,
        fileMenuWidth,
        fileMenuRowHeight * 2 + 10,
        0.08f,
        1.0f,
        border
        )
        if pointInArea(fileMenuX, fileMenuTop, fileMenuWidth, fileMenuRowHeight) {
            drawRoundedRectangle(
            fileMenuX + 5,
            fileMenuTop + 4,
            fileMenuWidth - 10,
            fileMenuRowHeight - 4,
            0.16f,
            surfaceHover
            )
        }
        if pointInArea(
        fileMenuX,
        fileMenuTop + fileMenuRowHeight,
        fileMenuWidth,
        fileMenuRowHeight
        ) {
            drawRoundedRectangle(
            fileMenuX + 5,
            fileMenuTop + fileMenuRowHeight,
            fileMenuWidth - 10,
            fileMenuRowHeight - 4,
            0.16f,
            surfaceHover
            )
        }
        drawUiText(
        uiFont,
        "Ouvrir un dossier...",
        fileMenuX + 18,
        fileMenuTop + 11,
        16.0f,
        text
        )
        drawUiText(
        uiFont,
        "Fermer le dossier",
        fileMenuX + 18,
        fileMenuTop + fileMenuRowHeight + 11,
        16.0f,
        if explorer.size() > usize(0) { text } else { muted }
        )
    }

    if pathPrompt.isVisible() {
        val dialogX : int = (screenWidth() - 720) / 2
        val dialogY : int = 230
        val dialogWidth : int = 720
        drawRectangle(0, 0, screenWidth(), screenHeight(), rgba(6, 8, 13, 170))
        drawRoundedRectangle(
        dialogX + 8,
        dialogY + 10,
        dialogWidth,
        164,
        0.06f,
        rgba(5, 7, 12, 180)
        )
        drawRoundedRectangle(
        dialogX,
        dialogY,
        dialogWidth,
        164,
        0.06f,
        surface
        )
        drawRoundedOutline(
        dialogX,
        dialogY,
        dialogWidth,
        164,
        0.06f,
        1.0f,
        border
        )
        drawUiText(
        uiFont,
        pathPromptTitle(pathPrompt.action()),
        dialogX + 20,
        dialogY + 16,
        21.0f,
        accent
        )
        drawRoundedRectangle(
        dialogX + 20,
        dialogY + 55,
        dialogWidth - 40,
        42,
        0.14f,
        background
        )
        drawRoundedOutline(
        dialogX + 20,
        dialogY + 55,
        dialogWidth - 40,
        42,
        0.14f,
        1.0f,
        rgb(74, 84, 112)
        )
        drawCodeText(
        codeFont,
        pathPrompt.value(),
        dialogX + 30,
        dialogY + 64,
        17.0f,
        text
        )
        val promptGlyph : Vector2 = codeFont.measure(
        "M",
        17.0f,
        codeFontSpacing
        )
        val promptAdvance : float = codeFont.measure(
        "MM",
        17.0f,
        codeFontSpacing
        ).x - promptGlyph.x
        drawRectangle(
        dialogX + 30 + truncatingCast[int](
        numericCast[float](truncatingCast[int](pathPrompt.cursor())) *
        promptAdvance
        ),
        dialogY + 63,
        2,
        22,
        accent
        )
        drawUiText(
        uiFont,
        "Tab : compléter    Entrée : valider    Esc : annuler",
        dialogX + 20,
        dialogY + 122,
        15.0f,
        muted
        )
    }

    drawRoundedRectangle(
    editorLeft,
    editorBottom + 12,
    82,
    24,
    0.5f,
    surface
    )
    drawCircle(editorLeft + 12, editorBottom + 24, 3.0f, accent)
    drawUiText(
    uiFont,
    "SORTIE",
    editorLeft + 21,
    editorBottom + 15,
    14.0f,
    text
    )
    drawRectangle(editorLeft, editorBottom + 43, screenWidth() - editorLeft, 1, border)
    drawCodeText(
    codeFont,
    toolOutput.view(),
    editorLeft,
    editorBottom + 53,
    15.0f,
    muted
    )

    drawRectangle(0, bottomStatusY, screenWidth(), statusBarHeight, surface)
    drawRectangle(0, bottomStatusY, screenWidth(), 1, border)
    drawRoundedRectangle(
    10,
    bottomStatusY + 4,
    96,
    20,
    0.5f,
    modeColor(mode)
    )
    drawCircle(22, bottomStatusY + 14, 3.0f, header)
    drawUiText(uiFont, modeLine.view(), 32, bottomStatusY + 7, 14.0f, header)
    drawUiText(
    uiFont,
    statusLine.view(),
    120,
    bottomStatusY + 5,
    14.0f,
    text
    )
    drawRectangle(0, commandLineY, screenWidth(), commandLineHeight, panel)
    drawRectangle(0, commandLineY, screenWidth(), 1, border)
    if mode == EditorMode.Command || mode == EditorMode.Search {
        drawRoundedRectangle(8, commandLineY + 4, 4, 20, 0.8f, accent)
        drawCodeText(
        codeFont,
        commandLine.view(),
        20,
        commandLineY + 4,
        17.0f,
        text
        )
    } else {
        drawUiText(
        uiFont,
        if diagnosticText.size() > usize(0) {
            diagnosticText.view()
        } else {
            status.view()
        },
        12,
        commandLineY + 5,
        15.0f,
        muted
        )
    }
    endDrawing()
}
