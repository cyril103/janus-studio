/// Géométrie, navigation visuelle et rendu de Janus Studio.
module studio.view

import editor.buffer
import editor.completion
import editor.explorer
import editor.path_prompt
import editor.search
import editor.syntax
import editor.vim
import studio.tabs
import tooling.diagnostics
import std.array
import std.graphics
import std.text

var editorLeft : int = 260
const editorTop : int = 62
var editorBottom : int = 590
const codeFontSize : float = 20.0f
const codeFontSpacing : float = 1.0f
const statusBarHeight : int = 28
const commandLineHeight : int = 28
const explorerTreeTop : int = 120
const explorerRowHeight : int = 28
const explorerIndentWidth : int = 16
const doubleClickDelayMilliseconds : usize = usize(500)
const fileMenuX : int = 172
const fileMenuWidth : int = 250
const fileMenuButtonWidth : int = 78
const fileMenuTop : int = 54
const fileMenuRowHeight : int = 42
const separatorHitWidth : int = 5
const minimumExplorerWidth : int = 150
const minimumEditorWidth : int = 360
const minimumEditorHeight : int = 180
const minimumOutputHeight : int = 80
const editorGutterWidth : int = 56
const documentTabWidth : int = 190
const documentTabGap : int = 4
const minimumWindowWidth : int = 720
const minimumWindowHeight : int = 520

def editorCodeLeft() : int {
    return editorLeft + editorGutterWidth
}

enum PaneResize derives Copy, Equality, Debug {
    None,
    Explorer,
    Output
}

def constrainStudioLayout() : Unit {
    if screenWidth() < minimumWindowWidth || screenHeight() < minimumWindowHeight {
        setWindowSize(
        if screenWidth() < minimumWindowWidth {
            minimumWindowWidth
        } else {
            screenWidth()
        },
        if screenHeight() < minimumWindowHeight {
            minimumWindowHeight
        } else {
            screenHeight()
        }
        )
    }
    val maximumLeft : int = screenWidth() - minimumEditorWidth
    if editorLeft < minimumExplorerWidth + 12 {
        editorLeft = minimumExplorerWidth + 12
    } else if editorLeft > maximumLeft {
        editorLeft = maximumLeft
    }
    val minimumBottom : int = editorTop + minimumEditorHeight
    val maximumBottom : int = screenHeight() - statusBarHeight -
    commandLineHeight - minimumOutputHeight
    if editorBottom < minimumBottom {
        editorBottom = minimumBottom
    } else if editorBottom > maximumBottom {
        editorBottom = maximumBottom
    }
}

def pathPromptTitle(action : PathPromptAction) : string {
    return match action {
        Open => "OUVRIR UN FICHIER",
        OpenFolder => "OUVRIR UN DOSSIER",
        Create => "NOUVEAU FICHIER",
        SaveAs => "ENREGISTRER SOUS",
        None => "FICHIER"
    }
}

def pointInArea(x : int, y : int, width : int, height : int) : bool {
    return mouseX() >= x && mouseX() < x + width &&
    mouseY() >= y && mouseY() < y + height
}

def visibleDocumentTabs() : usize {
    val available : int = screenWidth() - editorLeft - 16
    if available <= documentTabWidth { return usize(1) }
    return numericCast[usize](available / (documentTabWidth + documentTabGap))
}

def maximumFirstDocumentTab(tabs : DocumentTabs) : usize {
    val visible : usize = visibleDocumentTabs()
    return if tabs.size() > visible {
        tabs.size() - visible
    } else {
        usize(0)
    }
}

def keepSelectedDocumentTabVisible(
tabs : DocumentTabs,
first : usize
) : usize {
    val visible : usize = visibleDocumentTabs()
    if tabs.selected() < first { return tabs.selected() }
    if tabs.selected() >= first + visible {
        return tabs.selected() - visible + usize(1)
    }
    val maximum : usize = maximumFirstDocumentTab(tabs)
    return if first < maximum { first } else { maximum }
}

def mouseInDocumentTabs() : bool {
    return mouseX() >= editorLeft && mouseX() < screenWidth() &&
    mouseY() >= 10 && mouseY() < editorTop
}

def scrollDocumentTabs(tabs : DocumentTabs, first : usize) : usize {
    if !mouseInDocumentTabs() { return first }
    val movement : float = mouseWheelMove()
    if movement > 0.0f {
        return if first > usize(0) { first - usize(1) } else { usize(0) }
    }
    if movement < 0.0f {
        val maximum : usize = maximumFirstDocumentTab(tabs)
        return if first < maximum { first + usize(1) } else { maximum }
    }
    return first
}

def documentTabScrollbarHovered(tabs : DocumentTabs) : bool {
    return maximumFirstDocumentTab(tabs) > usize(0) &&
    pointInArea(editorLeft, editorTop - 10, screenWidth() - editorLeft - 8, 10)
}

def documentTabScrollAtMouse(tabs : DocumentTabs) : usize {
    val maximum : usize = maximumFirstDocumentTab(tabs)
    if maximum == usize(0) { return usize(0) }
    val trackWidth : int = screenWidth() - editorLeft - 8
    var thumbWidth : int = trackWidth *
    truncatingCast[int](visibleDocumentTabs()) /
    truncatingCast[int](tabs.size())
    if thumbWidth < 36 { thumbWidth = 36 }
    val available : int = trackWidth - thumbWidth
    var requested : int = mouseX() - editorLeft - thumbWidth / 2
    if requested < 0 {
        requested = 0
    } else if requested > available {
        requested = available
    }
    return if available > 0 {
        numericCast[usize](
        requested * truncatingCast[int](maximum) / available
        )
    } else {
        usize(0)
    }
}

def documentTabAtMouse(tabs : DocumentTabs, first : usize) : usize {
    if mouseY() < 10 || mouseY() >= 52 || mouseX() < editorLeft {
        return usize(-1)
    }
    val stride : int = documentTabWidth + documentTabGap
    val relative : int = mouseX() - editorLeft
    if relative % stride >= documentTabWidth { return usize(-1) }
    val index : usize = first +
    numericCast[usize](relative / stride)
    return if index < tabs.size() { index } else { usize(-1) }
}

def documentTabCloseHovered(
tabs : DocumentTabs,
first : usize,
index : usize
) : bool {
    if index == usize(-1) { return false }
    val visibleIndex : usize = index - first
    val x : int = editorLeft + truncatingCast[int](visibleIndex) *
    (documentTabWidth + documentTabGap)
    return pointInArea(x + documentTabWidth - 34, 17, 28, 28)
}

def distance(left : int, right : int) : int {
    return if left >= right { left - right } else { right - left }
}

def explorerSeparatorHovered() : bool {
    return distance(mouseX(), editorLeft - 12) <= separatorHitWidth &&
    mouseY() >= editorTop &&
    mouseY() < screenHeight() - statusBarHeight - commandLineHeight
}

def outputSeparatorHovered() : bool {
    return distance(mouseY(), editorBottom) <= separatorHitWidth &&
    mouseX() >= editorLeft - 12 && mouseX() < screenWidth()
}

def resizeExplorerToMouse() : Unit {
    val requested : int = mouseX() + 12
    val maximum : int = screenWidth() - minimumEditorWidth
    if requested < minimumExplorerWidth + 12 {
        editorLeft = minimumExplorerWidth + 12
    } else if requested > maximum {
        editorLeft = maximum
    } else {
        editorLeft = requested
    }
}

def resizeOutputToMouse() : Unit {
    val requested : int = mouseY()
    val maximum : int = screenHeight() - statusBarHeight -
    commandLineHeight - minimumOutputHeight
    if requested < editorTop + minimumEditorHeight {
        editorBottom = editorTop + minimumEditorHeight
    } else if requested > maximum {
        editorBottom = maximum
    } else {
        editorBottom = requested
    }
}

def keepCursorVisible(
buffer : EditorBuffer,
firstLine : usize,
maximumLines : usize
) : usize {
    val cursorLine : usize = buffer.line()
    if cursorLine < firstLine {
        return cursorLine
    }
    if cursorLine >= firstLine + maximumLines {
        return cursorLine - maximumLines + usize(1)
    }
    return firstLine
}

def maximumEditorFirst(
buffer : EditorBuffer,
maximumLines : usize
) : usize {
    return if buffer.lineCount() > maximumLines {
        buffer.lineCount() - maximumLines
    } else {
        usize(0)
    }
}

def visibleEditorColumns(glyphAdvance : float) : usize {
    val available : int = screenWidth() - editorCodeLeft() - 14
    if available <= 0 {
        return usize(1)
    }
    val columns : int = truncatingCast[int](
    numericCast[float](available) / glyphAdvance
    )
    return if columns > 0 { numericCast[usize](columns) } else { usize(1) }
}

def maximumEditorFirstColumn(
buffer : EditorBuffer,
visibleColumns : usize
) : usize {
    val maximumLength : usize = buffer.maximumLineLength()
    return if maximumLength >= visibleColumns {
        maximumLength - visibleColumns + usize(1)
    } else {
        usize(0)
    }
}

def keepCursorHorizontallyVisible(
buffer : EditorBuffer,
firstColumn : usize,
visibleColumns : usize
) : usize {
    val cursorColumn : usize = buffer.column()
    if cursorColumn < firstColumn {
        return cursorColumn
    }
    if cursorColumn >= firstColumn + visibleColumns {
        return cursorColumn - visibleColumns + usize(1)
    }
    return firstColumn
}

def scrollEditor(
buffer : EditorBuffer,
first : usize,
maximumLines : usize
) : usize {
    if mouseX() < editorLeft - 12 || mouseX() >= screenWidth() ||
    mouseY() < editorTop || mouseY() >= editorBottom {
        return first
    }
    val movement : float = mouseWheelMove()
    if movement > 0.0f {
        return if first > usize(2) { first - usize(3) } else { usize(0) }
    }
    if movement < 0.0f {
        val maximum : usize = maximumEditorFirst(buffer, maximumLines)
        val requested : usize = first + usize(3)
        return if requested < maximum { requested } else { maximum }
    }
    return first
}

def scrollEditorHorizontally(
buffer : EditorBuffer,
first : usize,
visibleColumns : usize
) : usize {
    if mouseX() < editorLeft - 12 || mouseX() >= screenWidth() ||
    mouseY() < editorTop || mouseY() >= editorBottom {
        return first
    }
    val movement : float = mouseWheelMove()
    if movement > 0.0f {
        return if first > usize(5) { first - usize(6) } else { usize(0) }
    }
    if movement < 0.0f {
        val maximum : usize = maximumEditorFirstColumn(buffer, visibleColumns)
        val requested : usize = first + usize(6)
        return if requested < maximum { requested } else { maximum }
    }
    return first
}

def horizontalScrollbarHovered(
buffer : EditorBuffer,
visibleColumns : usize
) : bool {
    return maximumEditorFirstColumn(buffer, visibleColumns) > usize(0) &&
    pointInArea(
    editorCodeLeft(),
    editorBottom - 10,
    screenWidth() - editorCodeLeft() - 6,
    12
    )
}

def horizontalScrollAtMouse(
buffer : EditorBuffer,
visibleColumns : usize
) : usize {
    val maximumFirst : usize = maximumEditorFirstColumn(buffer, visibleColumns)
    if maximumFirst == usize(0) {
        return usize(0)
    }
    val trackX : int = editorCodeLeft()
    val trackWidth : int = screenWidth() - trackX - 6
    val maximumLength : int =
    truncatingCast[int](buffer.maximumLineLength() + usize(1))
    var thumbWidth : int = trackWidth * truncatingCast[int](visibleColumns) /
    maximumLength
    if thumbWidth < 36 {
        thumbWidth = 36
    }
    val available : int = trackWidth - thumbWidth
    if available <= 0 {
        return usize(0)
    }
    var requested : int = mouseX() - trackX - thumbWidth / 2
    if requested < 0 {
        requested = 0
    } else if requested > available {
        requested = available
    }
    return numericCast[usize](
    requested * truncatingCast[int](maximumFirst) / available
    )
}

def utf8SequenceWidth(
value : string,
index : usize
) : usize {
    val data : Ptr[byte] = stringData(value)
    val length : usize = stringLength(value)
    val first : int = int(data.load(index)) & 255
    if first >= 194 && first <= 223 && index + usize(1) < length {
        return usize(2)
    }
    if first >= 224 && first <= 239 && index + usize(2) < length {
        return usize(3)
    }
    if first >= 240 && first <= 244 && index + usize(3) < length {
        return usize(4)
    }
    return usize(1)
}

def outputLineCount(value : string) : usize {
    var lines : usize = usize(1)
    val data : Ptr[byte] = stringData(value)
    var index : usize = usize(0)
    while index < stringLength(value) {
        if data.load(index) == byte(10) {
            lines = lines + usize(1)
        }
        index = index + usize(1)
    }
    return lines
}

def outputMaximumColumns(value : string) : usize {
    val data : Ptr[byte] = stringData(value)
    val length : usize = stringLength(value)
    var maximum : usize = usize(0)
    var current : usize = usize(0)
    var index : usize = usize(0)
    while index < length {
        if data.load(index) == byte(10) {
            if current > maximum {
                maximum = current
            }
            current = usize(0)
            index = index + usize(1)
        } else {
            current = current + usize(1)
            index = index + utf8SequenceWidth(value, index)
        }
    }
    return if current > maximum { current } else { maximum }
}

def outputContentTop() : int {
    return editorBottom + 49
}

def outputContentBottom() : int {
    return screenHeight() - statusBarHeight - commandLineHeight - 10
}

def visibleOutputRows(lineAdvance : float) : usize {
    val available : int = outputContentBottom() - outputContentTop()
    if available <= 0 {
        return usize(1)
    }
    val rows : int = truncatingCast[int](
    numericCast[float](available) / lineAdvance
    )
    return if rows > 0 { numericCast[usize](rows) } else { usize(1) }
}

def visibleOutputColumns(glyphAdvance : float) : usize {
    val available : int = screenWidth() - editorLeft - 18
    if available <= 0 {
        return usize(1)
    }
    val columns : int = truncatingCast[int](
    numericCast[float](available) / glyphAdvance
    )
    return if columns > 0 { numericCast[usize](columns) } else { usize(1) }
}

def maximumOutputFirstLine(value : string, visibleRows : usize) : usize {
    val lines : usize = outputLineCount(value)
    return if lines > visibleRows { lines - visibleRows } else { usize(0) }
}

def maximumOutputFirstColumn(value : string, visibleColumns : usize) : usize {
    val columns : usize = outputMaximumColumns(value)
    return if columns > visibleColumns {
        columns - visibleColumns
    } else {
        usize(0)
    }
}

def mouseInOutputPanel() : bool {
    return mouseX() >= editorLeft && mouseX() < screenWidth() &&
    mouseY() >= editorBottom + 4 &&
    mouseY() < screenHeight() - statusBarHeight - commandLineHeight
}

def scrollOutputVertically(
value : string,
first : usize,
visibleRows : usize
) : usize {
    if !mouseInOutputPanel() {
        return first
    }
    val movement : float = mouseWheelMove()
    if movement > 0.0f {
        return if first > usize(2) { first - usize(3) } else { usize(0) }
    }
    if movement < 0.0f {
        val maximum : usize = maximumOutputFirstLine(value, visibleRows)
        val requested : usize = first + usize(3)
        return if requested < maximum { requested } else { maximum }
    }
    return first
}

def scrollOutputHorizontally(
value : string,
first : usize,
visibleColumns : usize
) : usize {
    if !mouseInOutputPanel() {
        return first
    }
    val movement : float = mouseWheelMove()
    if movement > 0.0f {
        return if first > usize(5) { first - usize(6) } else { usize(0) }
    }
    if movement < 0.0f {
        val maximum : usize = maximumOutputFirstColumn(value, visibleColumns)
        val requested : usize = first + usize(6)
        return if requested < maximum { requested } else { maximum }
    }
    return first
}

def outputVerticalScrollbarHovered(
value : string,
visibleRows : usize
) : bool {
    return maximumOutputFirstLine(value, visibleRows) > usize(0) &&
    pointInArea(
    screenWidth() - 10,
    outputContentTop(),
    10,
    outputContentBottom() - outputContentTop()
    )
}

def outputHorizontalScrollbarHovered(
value : string,
visibleColumns : usize
) : bool {
    return maximumOutputFirstColumn(value, visibleColumns) > usize(0) &&
    pointInArea(
    editorLeft,
    outputContentBottom() - 2,
    screenWidth() - editorLeft - 6,
    12
    )
}

def outputVerticalScrollAtMouse(
value : string,
visibleRows : usize
) : usize {
    val maximumFirst : usize = maximumOutputFirstLine(value, visibleRows)
    if maximumFirst == usize(0) {
        return usize(0)
    }
    val trackTop : int = outputContentTop()
    val trackHeight : int = outputContentBottom() - trackTop
    val lineCount : int = truncatingCast[int](outputLineCount(value))
    var thumbHeight : int = trackHeight * truncatingCast[int](visibleRows) /
    lineCount
    if thumbHeight < 24 {
        thumbHeight = 24
    }
    val available : int = trackHeight - thumbHeight
    var requested : int = mouseY() - trackTop - thumbHeight / 2
    if requested < 0 {
        requested = 0
    } else if requested > available {
        requested = available
    }
    return if available > 0 {
        numericCast[usize](
        requested * truncatingCast[int](maximumFirst) / available
        )
    } else {
        usize(0)
    }
}

def outputHorizontalScrollAtMouse(
value : string,
visibleColumns : usize
) : usize {
    val maximumFirst : usize = maximumOutputFirstColumn(value, visibleColumns)
    if maximumFirst == usize(0) {
        return usize(0)
    }
    val trackWidth : int = screenWidth() - editorLeft - 6
    val columns : int = truncatingCast[int](outputMaximumColumns(value))
    var thumbWidth : int = trackWidth * truncatingCast[int](visibleColumns) /
    columns
    if thumbWidth < 36 {
        thumbWidth = 36
    }
    val available : int = trackWidth - thumbWidth
    var requested : int = mouseX() - editorLeft - thumbWidth / 2
    if requested < 0 {
        requested = 0
    } else if requested > available {
        requested = available
    }
    return if available > 0 {
        numericCast[usize](
        requested * truncatingCast[int](maximumFirst) / available
        )
    } else {
        usize(0)
    }
}

def moveCursorToEditorMouse(
buffer : EditorBuffer,
firstLine : usize,
firstColumn : usize,
glyphAdvance : float,
lineAdvance : float,
maximumLines : usize
) : Unit {
    val relativeY : int = mouseY() - editorTop - 12
    var row : usize = if relativeY > 0 {
        numericCast[usize](truncatingCast[int](
        numericCast[float](relativeY) / lineAdvance
        ))
    } else {
        usize(0)
    }
    if maximumLines > usize(0) && row >= maximumLines {
        row = maximumLines - usize(1)
    }
    val relativeX : int = mouseX() - editorCodeLeft()
    val clickedColumn : usize = if relativeX > 0 {
        numericCast[usize](truncatingCast[int](
        (numericCast[float](relativeX) + glyphAdvance * 0.5f) /
        glyphAdvance
        ))
    } else {
        usize(0)
    }
    buffer.moveTo(firstLine + row, firstColumn + clickedColumn)
}

def explorerVisibleRows() : usize {
    val available : int = screenHeight() - statusBarHeight -
    commandLineHeight - explorerTreeTop - 10
    if available <= 0 {
        return usize(0)
    }
    return numericCast[usize](available / explorerRowHeight)
}

def maximumExplorerFirst(
explorer : ProjectExplorer,
visibleRows : usize
) : usize {
    return if explorer.size() > visibleRows {
        explorer.size() - visibleRows
    } else {
        usize(0)
    }
}

def scrollExplorer(
explorer : ProjectExplorer,
first : usize,
visibleRows : usize
) : usize {
    if mouseX() >= editorLeft - 12 || mouseY() < explorerTreeTop ||
    mouseY() >= explorerTreeTop +
    truncatingCast[int](visibleRows) * explorerRowHeight {
        return first
    }
    val movement : float = mouseWheelMove()
    if movement > 0.0f {
        return if first > usize(2) { first - usize(3) } else { usize(0) }
    }
    if movement < 0.0f {
        val maximum : usize = maximumExplorerFirst(explorer, visibleRows)
        val requested : usize = first + usize(3)
        return if requested < maximum { requested } else { maximum }
    }
    return first
}

def explorerContentBottom() : int {
    return screenHeight() - statusBarHeight - commandLineHeight - 10
}

def mouseInExplorerPanel() : bool {
    return mouseX() >= 0 && mouseX() < editorLeft - 12 &&
    mouseY() >= explorerTreeTop && mouseY() < explorerContentBottom()
}

def explorerContentWidth(
explorer : ProjectExplorer,
label : TextBuilder,
font : Font
) : int {
    var maximum : int = 0
    var index : usize = usize(0)
    while index < explorer.size() {
        explorer.appendLabel(index, label)
        val measured : Vector2 = font.measure(label.view(), 15.0f, 0.25f)
        val width : int = 48 +
        truncatingCast[int](explorer.depth(index)) * explorerIndentWidth +
        truncatingCast[int](measured.x)
        if width > maximum {
            maximum = width
        }
        index = index + usize(1)
    }
    return maximum
}

def maximumExplorerHorizontalOffset(
explorer : ProjectExplorer,
label : TextBuilder,
font : Font
) : int {
    val visible : int = editorLeft - 28
    val content : int = explorerContentWidth(explorer, label, font)
    return if content > visible { content - visible } else { 0 }
}

def scrollExplorerHorizontally(
explorer : ProjectExplorer,
label : TextBuilder,
font : Font,
offset : int
) : int {
    if mouseX() < 0 || mouseX() >= editorLeft - 12 ||
    mouseY() < explorerTreeTop || mouseY() >= explorerContentBottom() {
        return offset
    }
    val movement : float = mouseWheelMove()
    if movement > 0.0f {
        return if offset > 23 { offset - 24 } else { 0 }
    }
    if movement < 0.0f {
        val maximum : int = maximumExplorerHorizontalOffset(
        explorer,
        label,
        font
        )
        val requested : int = offset + 24
        return if requested < maximum { requested } else { maximum }
    }
    return offset
}

def explorerVerticalScrollbarHovered(
explorer : ProjectExplorer,
visibleRows : usize
) : bool {
    return maximumExplorerFirst(explorer, visibleRows) > usize(0) &&
    pointInArea(
    editorLeft - 22,
    explorerTreeTop,
    10,
    explorerContentBottom() - explorerTreeTop
    )
}

def explorerHorizontalScrollbarHovered(
explorer : ProjectExplorer,
label : TextBuilder,
font : Font
) : bool {
    return maximumExplorerHorizontalOffset(explorer, label, font) > 0 &&
    pointInArea(
    8,
    explorerContentBottom() - 2,
    editorLeft - 28,
    12
    )
}

def explorerVerticalScrollAtMouse(
explorer : ProjectExplorer,
visibleRows : usize
) : usize {
    val maximumFirst : usize = maximumExplorerFirst(explorer, visibleRows)
    if maximumFirst == usize(0) {
        return usize(0)
    }
    val trackTop : int = explorerTreeTop
    val trackHeight : int = explorerContentBottom() - trackTop
    var thumbHeight : int = trackHeight * truncatingCast[int](visibleRows) /
    truncatingCast[int](explorer.size())
    if thumbHeight < 24 {
        thumbHeight = 24
    }
    val available : int = trackHeight - thumbHeight
    var requested : int = mouseY() - trackTop - thumbHeight / 2
    if requested < 0 {
        requested = 0
    } else if requested > available {
        requested = available
    }
    return if available > 0 {
        numericCast[usize](
        requested * truncatingCast[int](maximumFirst) / available
        )
    } else {
        usize(0)
    }
}

def explorerHorizontalScrollAtMouse(
explorer : ProjectExplorer,
label : TextBuilder,
font : Font
) : int {
    val maximumOffset : int = maximumExplorerHorizontalOffset(
    explorer,
    label,
    font
    )
    if maximumOffset <= 0 {
        return 0
    }
    val trackWidth : int = editorLeft - 28
    val contentWidth : int = explorerContentWidth(explorer, label, font)
    var thumbWidth : int = trackWidth * trackWidth / contentWidth
    if thumbWidth < 36 {
        thumbWidth = 36
    }
    val available : int = trackWidth - thumbWidth
    var requested : int = mouseX() - 8 - thumbWidth / 2
    if requested < 0 {
        requested = 0
    } else if requested > available {
        requested = available
    }
    return if available > 0 {
        requested * maximumOffset / available
    } else {
        0
    }
}

def explorerEntryAtMouse(
explorer : ProjectExplorer,
first : usize,
visibleRows : usize
) : usize {
    if mouseX() < 0 || mouseX() >= editorLeft - 12 ||
    mouseY() < explorerTreeTop ||
    mouseY() >= explorerTreeTop +
    truncatingCast[int](visibleRows) * explorerRowHeight {
        return usize(-1)
    }
    val row : usize = numericCast[usize](
    (mouseY() - explorerTreeTop) / explorerRowHeight
    )
    val index : usize = first + row
    return if index < explorer.size() { index } else { usize(-1) }
}

def buildStatusLine(
output : TextBuilder,
path : string,
buffer : EditorBuffer
) : Unit {
    output.clear()
    output.append(if path == "" { "Nouveau fichier" } else { path })
    output.append(if buffer.isModified() { "  • modifié" } else { "  • enregistré" })
    output.append("    ligne ")
    output.appendUSize(buffer.line() + usize(1))
    output.append(", colonne ")
    output.appendUSize(buffer.column() + usize(1))
}

def drawUiText(
font : Font,
text : string,
x : int,
y : int,
size : float,
color : Color
) : Unit {
    font.draw(
    text,
    vector2(numericCast[float](x), numericCast[float](y)),
    size,
    0.25f,
    color
    )
}

def drawCodeText(
font : Font,
text : string,
x : int,
y : int,
size : float,
color : Color
) : Unit {
    font.draw(
    text,
    vector2(numericCast[float](x), numericCast[float](y)),
    size,
    codeFontSpacing,
    color
    )
}

def editorColumnX(
column : usize,
firstColumn : usize,
glyphAdvance : float
) : int {
    val relative : int = truncatingCast[int](column) -
    truncatingCast[int](firstColumn)
    return editorCodeLeft() + truncatingCast[int](
    numericCast[float](relative) * glyphAdvance
    )
}

def drawRoundedRectangle(
x : int,
y : int,
width : int,
height : int,
roundness : float,
color : Color
) : Unit {
    drawRectangleRounded(
    rectangle(
    numericCast[float](x),
    numericCast[float](y),
    numericCast[float](width),
    numericCast[float](height)
    ),
    roundness,
    8,
    color
    )
}

def drawRoundedOutline(
x : int,
y : int,
width : int,
height : int,
roundness : float,
thickness : float,
color : Color
) : Unit {
    drawRectangleRoundedLines(
    rectangle(
    numericCast[float](x),
    numericCast[float](y),
    numericCast[float](width),
    numericCast[float](height)
    ),
    roundness,
    8,
    thickness,
    color
    )
}

def syntaxColor(kind : SyntaxKind) : Color {
    if kind == SyntaxKind.Keyword {
        return rgb(198, 160, 246)
    }
    if kind == SyntaxKind.Type {
        return rgb(126, 200, 227)
    }
    if kind == SyntaxKind.String {
        return rgb(166, 218, 149)
    }
    if kind == SyntaxKind.Character {
        return rgb(139, 213, 202)
    }
    if kind == SyntaxKind.Number {
        return rgb(245, 194, 231)
    }
    if kind == SyntaxKind.Comment {
        return rgb(108, 117, 145)
    }
    if kind == SyntaxKind.Operator {
        return rgb(238, 212, 159)
    }
    return rgb(205, 214, 244)
}

def modeColor(mode : EditorMode) : Color {
    if mode == EditorMode.Insert {
        return rgb(166, 218, 149)
    }
    if mode == EditorMode.Command || mode == EditorMode.Search {
        return rgb(249, 226, 175)
    }
    return rgb(137, 180, 250)
}

def drawHighlightedCode(
font : Font,
characters : Array[char],
spans : Array[SyntaxSpan],
glyph : TextBuilder,
x : int,
y : int,
glyphAdvance : float,
lineAdvance : float
) : Unit {
    var line : usize = usize(0)
    var column : usize = usize(0)
    var spanIndex : usize = usize(0)
    while spanIndex < spans.size() {
        val span : SyntaxSpan = spans.get(spanIndex)
        val color : Color = syntaxColor(span.kind)
        var index : usize = span.start
        val end : usize = span.start + span.length
        while index < end {
            val value : char = characters.get(index)
            if value == '\n' {
                line = line + usize(1)
                column = usize(0)
            } else {
                if value != ' ' && value != '\t' && value != '\r' {
                    glyph.clear()
                    glyph.appendChar(value)
                    drawCodeText(
                    font,
                    glyph.view(),
                    x + truncatingCast[int](
                    numericCast[float](truncatingCast[int](column)) * glyphAdvance
                    ),
                    y + truncatingCast[int](
                    numericCast[float](truncatingCast[int](line)) * lineAdvance
                    ),
                    codeFontSize,
                    color
                    )
                }
                column = column + usize(1)
            }
            index = index + usize(1)
        }
        spanIndex = spanIndex + usize(1)
    }
}

def drawLineNumbers(
font : Font,
label : TextBuilder,
firstLine : usize,
maximumLines : usize,
lineCount : usize,
y : int,
lineAdvance : float,
color : Color
) : Unit {
    var row : usize = usize(0)
    while row < maximumLines && firstLine + row < lineCount {
        label.clear()
        label.appendUSize(firstLine + row + usize(1))
        drawCodeText(
        font,
        label.view(),
        editorCodeLeft() - 48,
        y + truncatingCast[int](
        numericCast[float](truncatingCast[int](row)) * lineAdvance
        ),
        14.0f,
        color
        )
        row = row + usize(1)
    }
}

def drawEditorDiagnostics(
diagnostics : EditorDiagnostics,
firstLine : usize,
horizontalFirst : usize,
maximumLines : usize,
y : int,
glyphAdvance : float,
lineAdvance : float
) : Unit {
    var index : usize = usize(0)
    while index < diagnostics.size() {
        val line : usize = diagnostics.line(index)
        if line >= firstLine && line < firstLine + maximumLines {
            val row : usize = line - firstLine
            val diagnosticY : int = y + truncatingCast[int](
            numericCast[float](truncatingCast[int](row)) * lineAdvance
            )
            val color : Color = if diagnostics.isError(index) {
                rgb(243, 139, 168)
            } else {
                rgb(249, 226, 175)
            }
            drawRectangle(editorCodeLeft() - 12, diagnosticY + 7, 5, 12, color)
            if diagnostics.column(index) >= horizontalFirst {
                drawRectangle(
                editorColumnX(
                diagnostics.column(index),
                horizontalFirst,
                glyphAdvance
                ),
                diagnosticY + 21,
                truncatingCast[int](glyphAdvance),
                2,
                color
                )
            }
        }
        index = index + usize(1)
    }
}

def drawSearchMatches(
search : SearchModel,
buffer : EditorBuffer,
firstLine : usize,
horizontalFirst : usize,
maximumLines : usize,
y : int,
glyphAdvance : float,
lineAdvance : float
) : Unit {
    var index : usize = usize(0)
    while index < search.size() {
        val line : usize = buffer.lineAtOffset(search.offset(index))
        if line >= firstLine && line < firstLine + maximumLines {
            val column : usize = buffer.columnAtOffset(search.offset(index))
            val row : usize = line - firstLine
            drawRectangle(
            editorColumnX(column, horizontalFirst, glyphAdvance),
            y + truncatingCast[int](
            numericCast[float](truncatingCast[int](row)) * lineAdvance
            ),
            truncatingCast[int](
            numericCast[float](truncatingCast[int](search.length())) *
            glyphAdvance
            ),
            23,
            if index == search.selected() {
                rgb(74, 83, 117)
            } else {
                rgb(48, 55, 76)
            }
            )
        }
        index = index + usize(1)
    }
}

def drawSelection(
buffer : EditorBuffer,
firstLine : usize,
horizontalFirst : usize,
maximumLines : usize,
y : int,
glyphAdvance : float,
lineAdvance : float
) : Unit {
    if !buffer.hasSelection() { return }
    val startLine : usize = buffer.lineAtOffset(buffer.selectionStart())
    val endLine : usize = buffer.lineAtOffset(buffer.selectionEnd())
    val startColumn : usize = buffer.columnAtOffset(buffer.selectionStart())
    val endColumn : usize = buffer.columnAtOffset(buffer.selectionEnd())
    var line : usize = startLine
    while line <= endLine {
        if line >= firstLine && line < firstLine + maximumLines {
            val firstColumn : usize = if line == startLine {
                startColumn
            } else {
                usize(0)
            }
            val lastColumn : usize = if line == endLine {
                endColumn
            } else {
                buffer.lineLength(line)
            }
            if lastColumn > firstColumn {
                drawRectangle(
                editorColumnX(firstColumn, horizontalFirst, glyphAdvance),
                y + truncatingCast[int](
                numericCast[float](truncatingCast[int](line - firstLine)) *
                lineAdvance
                ),
                truncatingCast[int](
                numericCast[float](truncatingCast[int](
                lastColumn - firstColumn
                )) * glyphAdvance
                ),
                23,
                rgb(54, 66, 96)
                )
            }
        }
        line = line + usize(1)
    }
}

def drawExplorer(
explorer : ProjectExplorer,
firstEntry : usize,
horizontalOffset : int,
visibleRows : usize,
label : TextBuilder,
font : Font,
muted : Color
) : Unit {
    var index : usize = firstEntry
    var row : usize = usize(0)
    while index < explorer.size() && row < visibleRows {
        val y : int = explorerTreeTop +
        truncatingCast[int](row) * explorerRowHeight
        val rowHovered : bool = pointInArea(
        8,
        y - 2,
        editorLeft - 28,
        explorerRowHeight
        )
        if explorer.selected() == index {
            drawRoundedRectangle(
            8,
            y - 1,
            editorLeft - 28,
            explorerRowHeight - 2,
            0.22f,
            rgb(49, 55, 75)
            )
            drawRoundedRectangle(8, y + 4, 3, 14, 0.8f, rgb(137, 180, 250))
        } else if rowHovered {
            drawRoundedRectangle(
            8,
            y - 1,
            editorLeft - 28,
            explorerRowHeight - 2,
            0.22f,
            rgb(37, 42, 56)
            )
        }
        val x : int = 16 + truncatingCast[int](explorer.depth(index)) *
        explorerIndentWidth - horizontalOffset
        if explorer.isDirectory(index) {
            val icon : Color = if explorer.selected() == index {
                rgb(137, 180, 250)
            } else {
                rgb(166, 173, 200)
            }
            drawRectangle(x + 2, y + 7, 11, 9, icon)
            drawRectangle(x + 3, y + 5, 5, 3, icon)
            if explorer.isExpanded(index) {
                drawLine(x - 6, y + 9, x - 3, y + 12, muted)
                drawLine(x - 3, y + 12, x, y + 9, muted)
            } else {
                drawLine(x - 5, y + 8, x - 2, y + 11, muted)
                drawLine(x - 2, y + 11, x - 5, y + 14, muted)
            }
        } else {
            drawRoundedOutline(x + 3, y + 5, 9, 12, 0.18f, 1.0f, muted)
        }
        explorer.appendLabel(index, label)
        var labelColor : Color = muted
        if explorer.isDirectory(index) {
            labelColor = rgb(205, 214, 244)
        }
        if explorer.selected() == index {
            labelColor = rgb(239, 241, 245)
        }
        drawUiText(
        font,
        label.view(),
        x + 19,
        y + 4,
        15.0f,
        labelColor
        )
        index = index + usize(1)
        row = row + usize(1)
    }
}

def drawStudio(
path : string,
buffer : EditorBuffer,
tabs : DocumentTabs,
tabLabel : TextBuilder,
firstDocumentTab : usize,
firstLine : usize,
firstColumn : usize,
visibleCharacters : Array[char],
syntaxSpans : Array[SyntaxSpan],
glyph : TextBuilder,
diagnostics : EditorDiagnostics,
diagnosticText : TextBuilder,
search : SearchModel,
completion : CompletionModel,
completionText : TextBuilder,
signatureText : TextBuilder,
pathPrompt : PathPrompt,
statusLine : TextBuilder,
status : TextBuilder,
toolOutput : TextBuilder,
firstOutputLine : usize,
firstOutputColumn : usize,
modeLine : TextBuilder,
commandLine : TextBuilder,
explorer : ProjectExplorer,
firstExplorerEntry : usize,
explorerHorizontalOffset : int,
visibleExplorerRows : usize,
explorerLabel : TextBuilder,
fileMenuOpen : bool,
mode : EditorMode,
uiFont : Font,
codeFont : Font,
glyphAdvance : float,
lineAdvance : float,
outputGlyphAdvance : float,
outputLineAdvance : float,
maximumLines : usize
) : Unit {
    buffer.appendVisibleCharacters(visibleCharacters, firstLine, maximumLines)
    highlight(visibleCharacters, syntaxSpans)
    if tabs.size() == usize(0) {
        statusLine.clear()
        statusLine.append("Aucun fichier ouvert")
    } else {
        buildStatusLine(statusLine, path, buffer)
    }
    diagnostics.appendForLine(buffer.line(), diagnosticText)

    val background : Color = rgb(17, 19, 27)
    val sidebar : Color = rgb(24, 27, 37)
    val header : Color = rgb(20, 23, 32)
    val panel : Color = rgb(14, 16, 23)
    val surface : Color = rgb(30, 34, 46)
    val surfaceHover : Color = rgb(43, 48, 65)
    val border : Color = rgb(45, 51, 68)
    val accent : Color = rgb(137, 180, 250)
    val text : Color = rgb(205, 214, 244)
    val muted : Color = rgb(127, 132, 156)
    val bottomStatusY : int = screenHeight() - statusBarHeight - commandLineHeight
    val commandLineY : int = screenHeight() - commandLineHeight

    beginDrawing()
    clearBackground(background)
    drawRectangle(0, 0, screenWidth(), editorTop, header)
    drawRectangle(0, editorTop - 1, screenWidth(), 1, border)
    drawRectangle(
    0,
    editorTop,
    editorLeft - 12,
    screenHeight() - editorTop,
    sidebar
    )
    drawRectangle(editorLeft - 12, editorTop, 1, editorBottom - editorTop, border)
    drawRectangle(
    editorLeft - 11,
    editorTop,
    editorGutterWidth + 11,
    editorBottom - editorTop,
    rgb(20, 23, 32)
    )
    drawRectangle(editorCodeLeft() - 1, editorTop, 1, editorBottom - editorTop, border)
    drawRectangle(
    editorLeft - 12,
    editorBottom,
    screenWidth() - editorLeft + 12,
    screenHeight() - editorBottom,
    panel
    )
    drawRectangle(
    editorLeft - 13,
    editorTop,
    2,
    screenHeight() - editorTop - statusBarHeight - commandLineHeight,
    if explorerSeparatorHovered() { accent } else { border }
    )
    drawRectangle(
    editorLeft - 12,
    editorBottom - 1,
    screenWidth() - editorLeft + 12,
    2,
    if outputSeparatorHovered() { accent } else { border }
    )

    drawRoundedRectangle(14, 13, 34, 34, 0.28f, accent)
    drawUiText(uiFont, "J", 24, 16, 22.0f, header)
    drawUiText(uiFont, "Janus", 58, 13, 22.0f, text)
    drawUiText(uiFont, "STUDIO", 58, 36, 11.0f, muted)
    val fileMenuHovered : bool = pointInArea(
    fileMenuX,
    10,
    fileMenuButtonWidth,
    40
    )
    if fileMenuOpen || fileMenuHovered {
        drawRoundedRectangle(
        fileMenuX,
        10,
        fileMenuButtonWidth,
        40,
        0.25f,
        if fileMenuOpen { surfaceHover } else { surface }
        )
    }
    drawUiText(uiFont, "Fichier", fileMenuX + 11, 19, 16.0f, text)

    val visibleTabs : usize = visibleDocumentTabs()
    var tabIndex : usize = firstDocumentTab
    var tabSlot : usize = usize(0)
    while tabIndex < tabs.size() && tabSlot < visibleTabs {
        val tabX : int = editorLeft + truncatingCast[int](tabSlot) *
        (documentTabWidth + documentTabGap)
        val selectedTab : bool = tabIndex == tabs.selected()
        drawRoundedRectangle(
        tabX,
        10,
        documentTabWidth,
        42,
        0.18f,
        if selectedTab { surface } else { header }
        )
        if selectedTab {
            drawRoundedRectangle(tabX, 18, 3, 26, 0.8f, accent)
        }
        drawCircle(
        tabX + 17,
        31,
        4.0f,
        if tabs.isModified(tabIndex, buffer) {
            rgb(250, 179, 135)
        } else {
            rgb(166, 218, 149)
        }
        )
        tabs.appendLabel(tabIndex, tabLabel)
        beginScissor(rectangle(
        numericCast[float](tabX + 28),
        10.0f,
        numericCast[float](documentTabWidth - 66),
        42.0f
        ))
        drawUiText(
        uiFont,
        tabLabel.view(),
        tabX + 29,
        23,
        16.0f,
        if selectedTab { text } else { muted }
        )
        endScissor()
        drawUiText(
        uiFont,
        "x",
        tabX + documentTabWidth - 27,
        22,
        16.0f,
        if documentTabCloseHovered(
        tabs,
        firstDocumentTab,
        tabIndex
        ) { accent } else { muted }
        )
        tabIndex = tabIndex + usize(1)
        tabSlot = tabSlot + usize(1)
    }
    val maximumFirstTab : usize = maximumFirstDocumentTab(tabs)
    if maximumFirstTab > usize(0) {
        val tabTrackWidth : int = screenWidth() - editorLeft - 8
        var tabThumbWidth : int = tabTrackWidth *
        truncatingCast[int](visibleTabs) / truncatingCast[int](tabs.size())
        if tabThumbWidth < 36 { tabThumbWidth = 36 }
        val tabThumbX : int = editorLeft +
        (tabTrackWidth - tabThumbWidth) *
        truncatingCast[int](firstDocumentTab) /
        truncatingCast[int](maximumFirstTab)
        drawRectangle(
        editorLeft,
        editorTop - 8,
        tabTrackWidth,
        8,
        header
        )
        drawRoundedRectangle(
        tabThumbX,
        editorTop - 6,
        tabThumbWidth,
        4,
        0.8f,
        rgb(89, 96, 120)
        )
    }

    drawUiText(uiFont, "PROJET", 16, 78, 15.0f, muted)
    drawRectangle(16, 105, editorLeft - 44, 1, border)
    beginScissor(rectangle(
    0.0f,
    numericCast[float](explorerTreeTop),
    numericCast[float](editorLeft - 22),
    numericCast[float](explorerContentBottom() - explorerTreeTop)
    ))
    drawExplorer(
    explorer,
    firstExplorerEntry,
    explorerHorizontalOffset,
    visibleExplorerRows,
    explorerLabel,
    uiFont,
    muted
    )
    endScissor()

    val maximumExplorerFirstEntry : usize = maximumExplorerFirst(
    explorer,
    visibleExplorerRows
    )
    if maximumExplorerFirstEntry > usize(0) {
        val trackHeight : int = explorerContentBottom() - explorerTreeTop
        var thumbHeight : int = trackHeight *
        truncatingCast[int](visibleExplorerRows) /
        truncatingCast[int](explorer.size())
        if thumbHeight < 24 {
            thumbHeight = 24
        }
        val thumbY : int = explorerTreeTop +
        (trackHeight - thumbHeight) * truncatingCast[int](firstExplorerEntry) /
        truncatingCast[int](maximumExplorerFirstEntry)
        drawRectangle(editorLeft - 18, explorerTreeTop, 6, trackHeight, sidebar)
        drawRoundedRectangle(
        editorLeft - 17,
        thumbY,
        4,
        thumbHeight,
        0.8f,
        rgb(89, 96, 120)
        )
    }
    val maximumExplorerOffset : int = maximumExplorerHorizontalOffset(
    explorer,
    explorerLabel,
    uiFont
    )
    if maximumExplorerOffset > 0 {
        val trackWidth : int = editorLeft - 28
        val contentWidth : int = explorerContentWidth(
        explorer,
        explorerLabel,
        uiFont
        )
        var thumbWidth : int = trackWidth * trackWidth / contentWidth
        if thumbWidth < 36 {
            thumbWidth = 36
        }
        val thumbX : int = 8 +
        (trackWidth - thumbWidth) * explorerHorizontalOffset /
        maximumExplorerOffset
        drawRectangle(8, explorerContentBottom(), trackWidth, 10, sidebar)
        drawRoundedRectangle(
        thumbX,
        explorerContentBottom() + 3,
        thumbWidth,
        4,
        0.8f,
        rgb(89, 96, 120)
        )
    }

    if tabs.size() > usize(0) && buffer.line() >= firstLine &&
    buffer.line() < firstLine + maximumLines {
        val activeRow : int = truncatingCast[int](buffer.line() - firstLine)
        drawRectangle(
        editorLeft - 10,
        editorTop + 10 + truncatingCast[int](
        numericCast[float](activeRow) * lineAdvance
        ),
        screenWidth() - editorLeft + 2,
        25,
        rgb(23, 27, 38)
        )
    }

    drawLineNumbers(
    codeFont,
    glyph,
    firstLine,
    maximumLines,
    buffer.lineCount(),
    editorTop + 12,
    lineAdvance,
    muted
    )

    beginScissor(rectangle(
    numericCast[float](editorCodeLeft()),
    numericCast[float](editorTop),
    numericCast[float](screenWidth() - editorCodeLeft() - 6),
    numericCast[float](editorBottom - editorTop - 8)
    ))

    drawSelection(
    buffer,
    firstLine,
    firstColumn,
    maximumLines,
    editorTop + 12,
    glyphAdvance,
    lineAdvance
    )

    drawSearchMatches(
    search,
    buffer,
    firstLine,
    firstColumn,
    maximumLines,
    editorTop + 12,
    glyphAdvance,
    lineAdvance
    )

    drawHighlightedCode(
    codeFont,
    visibleCharacters,
    syntaxSpans,
    glyph,
    editorColumnX(usize(0), firstColumn, glyphAdvance),
    editorTop + 12,
    glyphAdvance,
    lineAdvance
    )
    endScissor()
    drawEditorDiagnostics(
    diagnostics,
    firstLine,
    firstColumn,
    maximumLines,
    editorTop + 12,
    glyphAdvance,
    lineAdvance
    )
    val cursorLineVisible : bool = tabs.size() > usize(0) &&
    buffer.line() >= firstLine &&
    buffer.line() < firstLine + maximumLines
    val visibleColumns : usize = visibleEditorColumns(glyphAdvance)
    val cursorVisible : bool = cursorLineVisible &&
    buffer.column() >= firstColumn &&
    buffer.column() < firstColumn + visibleColumns
    var cursorX : int = editorCodeLeft()
    var cursorY : int = editorTop + 12
    if cursorVisible {
        val cursorLine : float = numericCast[float](
        truncatingCast[int](buffer.line() - firstLine)
        )
        cursorX = editorColumnX(buffer.column(), firstColumn, glyphAdvance)
        cursorY = editorTop + 12 +
        truncatingCast[int](cursorLine * lineAdvance)
        val cursorWidth : int = if mode == EditorMode.Insert {
            2
        } else {
            truncatingCast[int](glyphAdvance)
        }
        drawRectangle(cursorX, cursorY, cursorWidth, 23, accent)
    }

    if buffer.lineCount() > maximumLines {
        val trackHeight : int = editorBottom - editorTop - 8
        val lineCount : int = truncatingCast[int](buffer.lineCount())
        var thumbHeight : int = trackHeight *
        truncatingCast[int](maximumLines) / lineCount
        if thumbHeight < 28 {
            thumbHeight = 28
        }
        val maximumFirst : int = truncatingCast[int](
        maximumEditorFirst(buffer, maximumLines)
        )
        val thumbY : int = editorTop +
        (trackHeight - thumbHeight) * truncatingCast[int](firstLine) /
        maximumFirst
        drawRectangle(screenWidth() - 6, editorTop, 6, trackHeight, panel)
        drawRoundedRectangle(
        screenWidth() - 5,
        thumbY,
        4,
        thumbHeight,
        0.8f,
        rgb(89, 96, 120)
        )
    }

    val maximumFirstColumn : usize = maximumEditorFirstColumn(
    buffer,
    visibleColumns
    )
    if maximumFirstColumn > usize(0) {
        val trackX : int = editorCodeLeft()
        val trackWidth : int = screenWidth() - trackX - 6
        val maximumLength : int =
        truncatingCast[int](buffer.maximumLineLength() + usize(1))
        var thumbWidth : int = trackWidth * truncatingCast[int](visibleColumns) /
        maximumLength
        if thumbWidth < 36 {
            thumbWidth = 36
        }
        val thumbX : int = trackX +
        (trackWidth - thumbWidth) * truncatingCast[int](firstColumn) /
        truncatingCast[int](maximumFirstColumn)
        drawRectangle(trackX, editorBottom - 8, trackWidth, 8, panel)
        drawRoundedRectangle(
        thumbX,
        editorBottom - 6,
        thumbWidth,
        4,
        0.8f,
        rgb(89, 96, 120)
        )
    }

    if completion.isVisible() && cursorVisible {
        val shown : usize = if completion.size() < usize(8) {
            completion.size()
        } else {
            usize(8)
        }
        val popupHeight : int = truncatingCast[int](shown) * 24 + 10
        val requestedX : int = cursorX
        val availablePopupWidth : int = screenWidth() - editorCodeLeft() - 16
        val popupWidth : int = if availablePopupWidth < 620 {
            availablePopupWidth
        } else {
            620
        }
        val fittedPopupX : int = if requestedX + popupWidth + 10 < screenWidth() {
            requestedX
        } else {
            screenWidth() - popupWidth - 10
        }
        val popupX : int = if fittedPopupX < editorCodeLeft() {
            editorCodeLeft()
        } else { fittedPopupX }
        val popupY : int = if cursorY + 27 + popupHeight < editorBottom {
            cursorY + 27
        } else {
            cursorY - popupHeight
        }
        drawRoundedRectangle(
        popupX + 5,
        popupY + 6,
        popupWidth,
        popupHeight,
        0.08f,
        rgba(5, 7, 12, 150)
        )
        drawRoundedRectangle(
        popupX,
        popupY,
        popupWidth,
        popupHeight,
        0.08f,
        surface
        )
        drawRoundedOutline(
        popupX,
        popupY,
        popupWidth,
        popupHeight,
        0.08f,
        1.0f,
        border
        )
        completion.appendVisible(completionText, usize(8))
        drawCodeText(
        codeFont,
        completionText.view(),
        popupX + 8,
        popupY + 5,
        17.0f,
        text
        )
    }

    if signatureText.size() > usize(0) && cursorVisible {
        val availableSignatureWidth : int =
        screenWidth() - editorCodeLeft() - 16
        val signatureWidth : int = if availableSignatureWidth < 620 {
            availableSignatureWidth
        } else {
            620
        }
        val fittedSignatureX : int =
        if cursorX + signatureWidth + 10 < screenWidth() {
            cursorX
        } else {
            screenWidth() - signatureWidth - 10
        }
        val signatureX : int = if fittedSignatureX < editorCodeLeft() {
            editorCodeLeft()
        } else { fittedSignatureX }
        val signatureY : int = if cursorY - 38 >= editorTop {
            cursorY - 38
        } else {
            cursorY + 27
        }
        drawRoundedRectangle(
        signatureX + 4,
        signatureY + 5,
        signatureWidth,
        32,
        0.18f,
        rgba(5, 7, 12, 150)
        )
        drawRoundedRectangle(
        signatureX,
        signatureY,
        signatureWidth,
        32,
        0.18f,
        surface
        )
        drawRoundedOutline(
        signatureX,
        signatureY,
        signatureWidth,
        32,
        0.18f,
        1.0f,
        border
        )
        drawCodeText(
        codeFont,
        signatureText.view(),
        signatureX + 8,
        signatureY + 5,
        17.0f,
        text
        )
    }

    if fileMenuOpen {
        drawRoundedRectangle(
        fileMenuX + 5,
        fileMenuTop + 6,
        fileMenuWidth,
        fileMenuRowHeight * 2 + 10,
        0.08f,
        rgba(5, 7, 12, 160)
        )
        drawRoundedRectangle(
        fileMenuX,
        fileMenuTop,
        fileMenuWidth,
        fileMenuRowHeight * 2 + 10,
        0.08f,
        surface
        )
        drawRoundedOutline(
        fileMenuX,
        fileMenuTop,
        fileMenuWidth,
        fileMenuRowHeight * 2 + 10,
        0.08f,
        1.0f,
        border
        )
        if pointInArea(fileMenuX, fileMenuTop, fileMenuWidth, fileMenuRowHeight) {
            drawRoundedRectangle(
            fileMenuX + 5,
            fileMenuTop + 4,
            fileMenuWidth - 10,
            fileMenuRowHeight - 4,
            0.16f,
            surfaceHover
            )
        }
        if pointInArea(
        fileMenuX,
        fileMenuTop + fileMenuRowHeight,
        fileMenuWidth,
        fileMenuRowHeight
        ) {
            drawRoundedRectangle(
            fileMenuX + 5,
            fileMenuTop + fileMenuRowHeight,
            fileMenuWidth - 10,
            fileMenuRowHeight - 4,
            0.16f,
            surfaceHover
            )
        }
        drawUiText(
        uiFont,
        "Ouvrir un dossier...",
        fileMenuX + 18,
        fileMenuTop + 11,
        16.0f,
        text
        )
        drawUiText(
        uiFont,
        "Fermer le dossier",
        fileMenuX + 18,
        fileMenuTop + fileMenuRowHeight + 11,
        16.0f,
        if explorer.size() > usize(0) { text } else { muted }
        )
    }

    if pathPrompt.isVisible() {
        val dialogX : int = (screenWidth() - 720) / 2
        val dialogY : int = 230
        val dialogWidth : int = 720
        drawRectangle(0, 0, screenWidth(), screenHeight(), rgba(6, 8, 13, 170))
        drawRoundedRectangle(
        dialogX + 8,
        dialogY + 10,
        dialogWidth,
        164,
        0.06f,
        rgba(5, 7, 12, 180)
        )
        drawRoundedRectangle(
        dialogX,
        dialogY,
        dialogWidth,
        164,
        0.06f,
        surface
        )
        drawRoundedOutline(
        dialogX,
        dialogY,
        dialogWidth,
        164,
        0.06f,
        1.0f,
        border
        )
        drawUiText(
        uiFont,
        pathPromptTitle(pathPrompt.action()),
        dialogX + 20,
        dialogY + 16,
        21.0f,
        accent
        )
        drawRoundedRectangle(
        dialogX + 20,
        dialogY + 55,
        dialogWidth - 40,
        42,
        0.14f,
        background
        )
        drawRoundedOutline(
        dialogX + 20,
        dialogY + 55,
        dialogWidth - 40,
        42,
        0.14f,
        1.0f,
        rgb(74, 84, 112)
        )
        drawCodeText(
        codeFont,
        pathPrompt.value(),
        dialogX + 30,
        dialogY + 64,
        17.0f,
        text
        )
        val promptGlyph : Vector2 = codeFont.measure(
        "M",
        17.0f,
        codeFontSpacing
        )
        val promptAdvance : float = codeFont.measure(
        "MM",
        17.0f,
        codeFontSpacing
        ).x - promptGlyph.x
        drawRectangle(
        dialogX + 30 + truncatingCast[int](
        numericCast[float](truncatingCast[int](pathPrompt.cursor())) *
        promptAdvance
        ),
        dialogY + 63,
        2,
        22,
        accent
        )
        drawUiText(
        uiFont,
        "Tab : compléter    Entrée : valider    Esc : annuler",
        dialogX + 20,
        dialogY + 122,
        15.0f,
        muted
        )
    }

    drawRoundedRectangle(
    editorLeft,
    editorBottom + 12,
    82,
    24,
    0.5f,
    surface
    )
    drawCircle(editorLeft + 12, editorBottom + 24, 3.0f, accent)
    drawUiText(
    uiFont,
    "SORTIE",
    editorLeft + 21,
    editorBottom + 15,
    14.0f,
    text
    )
    drawRectangle(editorLeft, editorBottom + 43, screenWidth() - editorLeft, 1, border)
    beginScissor(rectangle(
    numericCast[float](editorLeft),
    numericCast[float](outputContentTop()),
    numericCast[float](screenWidth() - editorLeft - 6),
    numericCast[float](outputContentBottom() - outputContentTop())
    ))
    drawCodeText(
    codeFont,
    toolOutput.view(),
    editorLeft - truncatingCast[int](
    numericCast[float](truncatingCast[int](firstOutputColumn)) *
    outputGlyphAdvance
    ),
    outputContentTop() - truncatingCast[int](
    numericCast[float](truncatingCast[int](firstOutputLine)) *
    outputLineAdvance
    ),
    15.0f,
    muted
    )
    endScissor()

    val outputRows : usize = visibleOutputRows(outputLineAdvance)
    val outputColumns : usize = visibleOutputColumns(outputGlyphAdvance)
    val maximumOutputLine : usize = maximumOutputFirstLine(
    toolOutput.view(),
    outputRows
    )
    if maximumOutputLine > usize(0) {
        val trackTop : int = outputContentTop()
        val trackHeight : int = outputContentBottom() - trackTop
        val lineCount : int = truncatingCast[int](
        outputLineCount(toolOutput.view())
        )
        var thumbHeight : int = trackHeight * truncatingCast[int](outputRows) /
        lineCount
        if thumbHeight < 24 {
            thumbHeight = 24
        }
        val thumbY : int = trackTop +
        (trackHeight - thumbHeight) * truncatingCast[int](firstOutputLine) /
        truncatingCast[int](maximumOutputLine)
        drawRectangle(screenWidth() - 6, trackTop, 6, trackHeight, panel)
        drawRoundedRectangle(
        screenWidth() - 5,
        thumbY,
        4,
        thumbHeight,
        0.8f,
        rgb(89, 96, 120)
        )
    }
    val maximumOutputColumn : usize = maximumOutputFirstColumn(
    toolOutput.view(),
    outputColumns
    )
    if maximumOutputColumn > usize(0) {
        val trackWidth : int = screenWidth() - editorLeft - 6
        val columns : int = truncatingCast[int](
        outputMaximumColumns(toolOutput.view())
        )
        var thumbWidth : int = trackWidth * truncatingCast[int](outputColumns) /
        columns
        if thumbWidth < 36 {
            thumbWidth = 36
        }
        val thumbX : int = editorLeft +
        (trackWidth - thumbWidth) * truncatingCast[int](firstOutputColumn) /
        truncatingCast[int](maximumOutputColumn)
        drawRectangle(
        editorLeft,
        outputContentBottom(),
        trackWidth,
        10,
        panel
        )
        drawRoundedRectangle(
        thumbX,
        outputContentBottom() + 3,
        thumbWidth,
        4,
        0.8f,
        rgb(89, 96, 120)
        )
    }

    drawRectangle(0, bottomStatusY, screenWidth(), statusBarHeight, surface)
    drawRectangle(0, bottomStatusY, screenWidth(), 1, border)
    drawRoundedRectangle(
    10,
    bottomStatusY + 4,
    96,
    20,
    0.5f,
    modeColor(mode)
    )
    drawCircle(22, bottomStatusY + 14, 3.0f, header)
    drawUiText(uiFont, modeLine.view(), 32, bottomStatusY + 7, 14.0f, header)
    drawUiText(
    uiFont,
    statusLine.view(),
    120,
    bottomStatusY + 5,
    14.0f,
    text
    )
    drawRectangle(0, commandLineY, screenWidth(), commandLineHeight, panel)
    drawRectangle(0, commandLineY, screenWidth(), 1, border)
    if mode == EditorMode.Command || mode == EditorMode.Search {
        drawRoundedRectangle(8, commandLineY + 4, 4, 20, 0.8f, accent)
        drawCodeText(
        codeFont,
        commandLine.view(),
        20,
        commandLineY + 4,
        17.0f,
        text
        )
    } else {
        drawUiText(
        uiFont,
        if diagnosticText.size() > usize(0) {
            diagnosticText.view()
        } else {
            status.view()
        },
        12,
        commandLineY + 5,
        15.0f,
        muted
        )
    }
    endDrawing()
}
