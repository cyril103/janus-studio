/// Gestion des documents ouverts et de leur état d'édition indépendant.
module studio.tabs

import editor.buffer
import studio.files
import text.utf8
import std.array
import std.text

private class Document(
    private val path : TextBuilder,
    private var archive : BufferArchive,
    private var modified : bool,
    private var firstVisibleLine : usize,
    private var firstVisibleColumn : usize
) {
    def pathEquals(value : string) : bool => path.view() == value

    def appendPath(output : TextBuilder) : Unit {
        output.clear()
        output.append(path.view())
    }

    def appendLabel(output : TextBuilder) : Unit {
        val value : string = path.view()
        val data : Ptr[byte] = stringData(value)
        var start : usize = usize(0)
        var index : usize = usize(0)
        while index < stringLength(value) {
            if data.load(index) == byte(47) || data.load(index) == byte(92) {
                start = index + usize(1)
            }
            index += usize(1)
        }
        output.clear()
        if start == stringLength(value) {
            output.append("Nouveau fichier")
        } else {
            appendDecodedUtf8Range(
                value,
                start,
                stringLength(value) - start,
                output
            )
        }
    }

    borrow def isModified() : bool => modified
    borrow def firstLine() : usize => firstVisibleLine
    borrow def firstColumn() : usize => firstVisibleColumn

    def updatePath(value : string) : Unit {
        path.clear()
        path.append(value)
    }

    def capture(
        buffer : EditorBuffer,
        firstLine : usize,
        firstColumn : usize
    ) : Unit {
        modified = buffer.isModified()
        firstVisibleLine = firstLine
        firstVisibleColumn = firstColumn
        delete archive
        archive = buffer.archive()
    }

    def restore(buffer : EditorBuffer, activePath : TextBuilder) : Unit {
        val requested : BufferArchive = move archive
        archive = emptyBufferArchive()
        buffer.restoreArchive(move requested)
        this.appendPath(activePath)
    }

    destructor {
        delete path
        delete archive
    }
}

private def document(path : string, modified : bool) : Document {
    val storedPath : TextBuilder = new TextBuilder()
    storedPath.append(path)
    return new Document(
        move storedPath,
        emptyBufferArchive(),
        modified,
        usize(0),
        usize(0)
    )
}

class DocumentTabs(private val documents : Array[Document]) {
    private var active : usize = usize(0)

    borrow def size() : usize => documents.size()
    borrow def selected() : usize => active

    private def documentPathEquals(index : usize, path : string) : bool {
        borrow var candidate : Document = documents.getMutable(index)
        return candidate.pathEquals(path)
    }

    private def find(path : string) : usize {
        var index : usize = usize(0)
        while index < documents.size() {
            if this.documentPathEquals(index, path) { return index }
            index += usize(1)
        }
        return usize(-1)
    }

    def pathAvailableForActive(path : string) : bool {
        val existing : usize = this.find(path)
        return existing == usize(-1) || existing == active
    }

    private def snapshot(
        buffer : EditorBuffer,
        firstLine : usize,
        firstColumn : usize
    ) : Unit {
        borrow var current : Document = documents.getMutable(active)
        current.capture(buffer, firstLine, firstColumn)
    }

    private def restoreActive(
        buffer : EditorBuffer,
        activePath : TextBuilder
    ) : Unit {
        borrow var current : Document = documents.getMutable(active)
        current.restore(buffer, activePath)
    }

    borrow def firstLine() : usize {
        if documents.isEmpty() { return usize(0) }
        borrow val current : Document = documents.getBorrowed(active)
        return current.firstLine()
    }

    borrow def firstColumn() : usize {
        if documents.isEmpty() { return usize(0) }
        borrow val current : Document = documents.getBorrowed(active)
        return current.firstColumn()
    }

    def appendPath(index : usize, output : TextBuilder) : Unit {
        borrow var requested : Document = documents.getMutable(index)
        requested.appendPath(output)
    }

    def appendLabel(index : usize, output : TextBuilder) : Unit {
        borrow var requested : Document = documents.getMutable(index)
        requested.appendLabel(output)
    }

    borrow def isModified(index : usize, buffer : EditorBuffer) : bool {
        if index == active { return buffer.isModified() }
        borrow val requested : Document = documents.getBorrowed(index)
        return requested.isModified()
    }

    borrow def anyModified(buffer : EditorBuffer) : bool {
        var index : usize = usize(0)
        while index < documents.size() {
            if this.isModified(index, buffer) { return true }
            index += usize(1)
        }
        return false
    }

    def switchTo(
        index : usize,
        buffer : EditorBuffer,
        activePath : TextBuilder,
        firstLine : usize,
        firstColumn : usize
    ) : bool {
        if index >= documents.size() || index == active { return false }
        this.snapshot(buffer, firstLine, firstColumn)
        active = index
        this.restoreActive(buffer, activePath)
        return true
    }

    def open(
        path : string,
        buffer : EditorBuffer,
        activePath : TextBuilder,
        status : TextBuilder,
        firstLine : usize,
        firstColumn : usize
    ) : bool {
        val existing : usize = this.find(path)
        if existing != usize(-1) {
            if existing == active {
                this.snapshot(buffer, firstLine, firstColumn)
                setStatus(status, "Onglet déjà actif.")
                return true
            }
            val changed : bool = this.switchTo(
                existing,
                buffer,
                activePath,
                firstLine,
                firstColumn
            )
            setStatus(status, "Onglet activé.")
            return changed
        }
        if !documents.isEmpty() {
            this.snapshot(buffer, firstLine, firstColumn)
        }
        if !openExistingFile(path, buffer, status) {
            if !documents.isEmpty() {
                this.restoreActive(buffer, activePath)
            } else {
                buffer.clear()
                activePath.clear()
            }
            return false
        }
        activePath.clear()
        activePath.append(path)
        documents.push(document(path, buffer.isModified()))
        active = documents.size() - usize(1)
        return true
    }

    def create(
        path : string,
        buffer : EditorBuffer,
        activePath : TextBuilder,
        firstLine : usize,
        firstColumn : usize,
        status : TextBuilder
    ) : bool {
        if this.find(path) != usize(-1) {
            setStatus(status, "Ce fichier est déjà ouvert dans un onglet.")
            return false
        }
        if !documents.isEmpty() {
            this.snapshot(buffer, firstLine, firstColumn)
        }
        buffer.clear()
        activePath.clear()
        activePath.append(path)
        documents.push(document(path, buffer.isModified()))
        active = documents.size() - usize(1)
        return true
    }

    def updateActivePath(path : string) : bool {
        if !this.pathAvailableForActive(path) { return false }
        borrow var current : Document = documents.getMutable(active)
        current.updatePath(path)
        return true
    }

    def close(
        index : usize,
        buffer : EditorBuffer,
        activePath : TextBuilder,
        status : TextBuilder,
        firstLine : usize,
        firstColumn : usize
    ) : bool {
        if index >= documents.size() { return false }
        if this.isModified(index, buffer) {
            setStatus(status, "Enregistrez les modifications avant de fermer l'onglet.")
            return false
        }
        if index != active {
            val removed : Document = documents.remove(index)
            delete removed
            if index < active { active = active - usize(1) }
            setStatus(status, "Onglet fermé.")
            return true
        }
        val removed : Document = documents.remove(index)
        delete removed
        if documents.isEmpty() {
            buffer.clear()
            activePath.clear()
            active = usize(0)
        } else {
            active = if index < documents.size() {
                index
            } else {
                documents.size() - usize(1)
            }
            this.restoreActive(buffer, activePath)
        }
        setStatus(status, "Onglet fermé.")
        return true
    }

    destructor { delete documents }
}

def documentTabs(path : string, buffer : EditorBuffer) : DocumentTabs {
    val documents : Array[Document] = new Array[Document](usize(8))
    if path != "" {
        documents.push(document(path, buffer.isModified()))
    }
    return new DocumentTabs(move documents)
}
