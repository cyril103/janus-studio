/// État interactif persistant de l'interface de Janus Studio.
module studio.state

import editor.completion
import editor.buffer
import editor.explorer
import editor.path_prompt
import editor.search
import editor.syntax
import editor.vim
import studio.files
import studio.tabs
import tooling.compiler
import tooling.diagnostics
import tooling.lsp
import std.array
import std.text

enum PaneResize derives Copy, Equality, Debug {
    None,
    Explorer,
    Output
}

class StudioUiState(
    var firstLine : usize,
    var firstColumn : usize,
    var firstOutputLine : usize,
    var firstOutputColumn : usize,
    var firstDocumentTab : usize,
    var firstExplorerEntry : usize,
    var explorerHorizontalOffset : int,
    var lastExplorerClick : usize,
    var lastExplorerClickAt : usize,
    var quitRequested : bool,
    var fileMenuOpen : bool,
    var editorScrollDetached : bool,
    var horizontalScrollDetached : bool,
    var paneResize : PaneResize,
    var horizontalScrollbarDragging : bool,
    var outputVerticalScrollbarDragging : bool,
    var outputHorizontalScrollbarDragging : bool,
    var explorerVerticalScrollbarDragging : bool,
    var explorerHorizontalScrollbarDragging : bool,
    var documentTabScrollbarDragging : bool,
    var mouseSelecting : bool
) {}

def studioUiState() : StudioUiState {
    return new StudioUiState(
        usize(0),
        usize(0),
        usize(0),
        usize(0),
        usize(0),
        usize(0),
        0,
        usize(-1),
        usize(0),
        false,
        false,
        false,
        false,
        PaneResize.None,
        false,
        false,
        false,
        false,
        false,
        false,
        false
    )
}

class StudioToolingState(
    val diagnostics : EditorDiagnostics,
    val diagnosticText : TextBuilder,
    val completion : CompletionModel,
    val completionLabels : TextBuilder,
    val completionError : TextBuilder,
    val languageServer : LspClient,
    val completionText : TextBuilder,
    val signatureText : TextBuilder,
    val pendingSignature : TextBuilder,
    val semanticTokens : Array[SemanticToken],
    var semanticRevision : usize,
    val toolOutput : TextBuilder,
    val compiler : CompilerJob
) {
    def updateSemanticRevision(value : usize) : Unit {
        semanticRevision = value
    }

    def invalidateSemanticTokens() : Unit {
        semanticTokens.clear()
        semanticRevision = usize(-1)
    }

    destructor {
        delete diagnostics
        delete diagnosticText
        delete completion
        delete completionLabels
        delete completionError
        delete languageServer
        delete completionText
        delete signatureText
        delete pendingSignature
        delete semanticTokens
        delete toolOutput
        delete compiler
    }
}

def studioToolingState(workspacePath : string) : StudioToolingState {
    val completionError : TextBuilder = new TextBuilder()
    val languageServer : LspClient = lspClient(
        workspacePath,
        completionError
    )
    return new StudioToolingState(
        editorDiagnostics(),
        new TextBuilder(),
        completionModel(),
        new TextBuilder(),
        move completionError,
        move languageServer,
        new TextBuilder(),
        new TextBuilder(),
        new TextBuilder(),
        new Array[SemanticToken](usize(256)),
        usize(-1),
        new TextBuilder(),
        compilerJobForProgram()
    )
}

class StudioAppState(
    val projectRoot : TextBuilder,
    val explorer : ProjectExplorer,
    val explorerLabel : TextBuilder,
    val tabLabel : TextBuilder,
    val explorerPath : TextBuilder,
    val activePath : TextBuilder,
    val promptedPath : TextBuilder,
    val buffer : EditorBuffer,
    val status : TextBuilder,
    val visibleCharacters : Array[char],
    val syntaxSpans : Array[SyntaxSpan],
    val glyph : TextBuilder,
    val search : SearchModel,
    val tooling : StudioToolingState,
    val filePrompt : PathPrompt,
    val statusLine : TextBuilder,
    val modeLine : TextBuilder,
    val commandLine : TextBuilder,
    val clipboard : TextBuilder,
    val controller : VimController,
    val tabs : DocumentTabs
) {
    destructor {
        delete projectRoot
        delete explorer
        delete explorerLabel
        delete tabLabel
        delete explorerPath
        delete activePath
        delete promptedPath
        delete tabs
        delete buffer
        delete status
        delete visibleCharacters
        delete syntaxSpans
        delete glyph
        delete search
        delete tooling
        delete filePrompt
        delete statusLine
        delete modeLine
        delete commandLine
        delete clipboard
        delete controller
    }
}

def studioAppState() : StudioAppState {
    val projectRoot : TextBuilder = new TextBuilder()
    if !captureProjectRoot(projectRoot) { projectRoot.append(".") }

    val activePath : TextBuilder = new TextBuilder()
    val startupPath : string = selectedPath()
    if startupPath != "" {
        val _captured : bool = captureDocumentPath(startupPath, activePath)
    }

    val buffer : EditorBuffer = emptyBuffer()
    val status : TextBuilder = new TextBuilder()
    if activePath.view() == "" {
        buffer.clear()
        setStatus(status, "Aucun fichier ouvert.")
    } else if !loadFile(activePath.view(), buffer, status) &&
    pathExists(activePath.view()) {
        activePath.clear()
    }

    val tooling : StudioToolingState = studioToolingState(projectRoot.view())
    tooling.toolOutput.append("F5 lance `janus check` sur le fichier actif.")
    val explorer : ProjectExplorer = projectExplorer(projectRoot.view())
    val tabs : DocumentTabs = documentTabs(activePath.view(), buffer)
    return new StudioAppState(
        move projectRoot,
        move explorer,
        new TextBuilder(),
        new TextBuilder(),
        new TextBuilder(),
        move activePath,
        new TextBuilder(),
        move buffer,
        move status,
        new Array[char](usize(2048)),
        new Array[SyntaxSpan](usize(512)),
        new TextBuilder(),
        searchModel(),
        move tooling,
        pathPrompt(),
        new TextBuilder(),
        new TextBuilder(),
        new TextBuilder(),
        new TextBuilder(),
        vimController(),
        move tabs
    )
}
