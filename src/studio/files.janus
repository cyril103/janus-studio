/// Chargement, sauvegarde et changement de document dans Janus Studio.
module studio.files

import editor.buffer
import editor.explorer
import editor.path_prompt
import editor.search
import tooling.diagnostics
import std.fs
import std.option
import std.path
import std.process
import std.result
import std.system
import std.text

def isFile(path : string) : bool =>
    metadata(path) .map[bool]((value) => value.kind == FileType.File) .unwrapOr(false)

def isDirectory(path : string) : bool =>
    metadata(path) .map[bool]((value) => value.kind == FileType.Directory) .unwrapOr(false)

def pathExists(path : string) : bool => metadata(path).isOk()

def validateNewPath(path : string, borrow var status : TextBuilder) : bool {
    if pathExists(path) {
        setStatus(status, "Ce chemin existe déjà : utilisez Ouvrir ou Enregistrer sous.")
        return false
    }
    return true
}

def validateSaveAsPath(
    path : string,
    currentPath : string,
    borrow var status : TextBuilder
) : bool {
    if path != currentPath && pathExists(path) {
        setStatus(status, "Le fichier cible existe déjà ; écrasement refusé.")
        return false
    }
    return true
}

pure def codeFontPath() : string => "assets/fonts/DejaVuSansMono.ttf"

private def useAssetRoot(
    root : string,
    relativePath : string,
    borrow var output : TextBuilder
) : bool {
    val joined : Result[Path, SystemError] = joinPath(root, relativePath)
    return match move joined {
        Ok(path) => useNormalizedProjectDirectory(move path, output),
        Error(error) => false
    }
}

private def captureConfiguredAssetPath(
    root : Option[EnvironmentValue],
    relativePath : string,
    borrow var output : TextBuilder
) : bool {
    return match move root {
        Some(path) => useConfiguredAssetRoot(move path, relativePath, output),
        None => captureProjectDirectory(relativePath, output)
    }
}

private def useConfiguredAssetRoot(
    root : EnvironmentValue,
    relativePath : string,
    borrow var output : TextBuilder
) : bool {
    val captured : bool = useAssetRoot(root.view(), relativePath, output)
    delete root
    return captured
}

private def captureAssetEnvironment(
    result : Result[Option[EnvironmentValue], SystemError],
    relativePath : string,
    borrow var output : TextBuilder
) : bool {
    return match move result {
        Ok(root) => captureConfiguredAssetPath(move root, relativePath, output),
        Error(error) => captureProjectDirectory(relativePath, output)
    }
}

def captureAssetPath(relativePath : string, borrow var output : TextBuilder) : bool {
    output.clear()
    return captureAssetEnvironment(
        environmentVariable("JANUS_STUDIO_RESOURCE_DIR"),
        relativePath,
        output
    )
}

private def appendCharacterRange(
    first : int,
    last : int,
    borrow var output : TextBuilder
) : Unit {
    var value : int = first
    while value <= last {
        output.appendChar(char(value))
        value += 1
    }
}

def studioFontCharacters() : TextBuilder {
    val characters : TextBuilder = new TextBuilder()
    appendCharacterRange(32, 126, characters)
    appendCharacterRange(160, 591, characters)
    appendCharacterRange(880, 1279, characters)
    appendCharacterRange(8192, 8303, characters)
    appendCharacterRange(8352, 8399, characters)
    appendCharacterRange(8592, 8959, characters)
    characters.appendChar(char(65533))
    return move characters
}

def selectedPath() : string {
    return match programArgument(usize(1)) {
        Some(path) => if isDirectory(path) { "" } else { path },
        None => ""
    }
}

def useWorkingDirectory(
    directory : WorkingDirectory,
    borrow var output : TextBuilder
) : bool {
    output.append(directory.view())
    delete directory
    return true
}

def captureWorkingDirectory(borrow var output : TextBuilder) : bool {
    val directory : Result[WorkingDirectory, SystemError] =
    currentWorkingDirectory()
    return match move directory {
        Ok(value) => useWorkingDirectory(move value, output),
        Error(error) => false
    }
}

def useProjectDirectory(path : string, borrow var output : TextBuilder) : bool {
    output.append(path)
    return true
}

def useNormalizedProjectDirectory(path : Path, borrow var output : TextBuilder) : bool {
    output.append(path.view())
    delete path
    return true
}

def joinProjectDirectory(
    directory : WorkingDirectory,
    path : string,
    borrow var output : TextBuilder
) : bool {
    val joined : Result[Path, SystemError] = joinPath(directory.view(), path)
    delete directory
    return match move joined {
        Ok(value) => useNormalizedProjectDirectory(move value, output),
        Error(error) => useProjectDirectory(path, output)
    }
}

def captureProjectDirectory(path : string, borrow var output : TextBuilder) : bool {
    output.clear()
    val directory : Result[WorkingDirectory, SystemError] =
    currentWorkingDirectory()
    return match move directory {
        Ok(value) => joinProjectDirectory(move value, path, output),
        Error(error) => useProjectDirectory(path, output)
    }
}

def captureDocumentPath(path : string, borrow var output : TextBuilder) : bool {
    if path == "" {
        output.clear()
        return false
    }
    return captureProjectDirectory(path, output)
}

def captureParentDirectory(path : string, borrow var output : TextBuilder) : bool {
    val normalized : TextBuilder = new TextBuilder()
    defer delete normalized
    if !captureProjectDirectory(path, normalized) { return false }
    val value : string = normalized.view()
    val data : Ptr[byte] = stringData(value)
    var separator : usize = usize(-1)
    var index : usize = usize(0)
    while index < stringLength(value) {
        if data.load(index) == byte(47) || data.load(index) == byte(92) {
            separator = index
        }
        index += usize(1)
    }
    if separator == usize(-1) { return captureWorkingDirectory(output) }
    var length : usize = separator
    if separator == usize(0) ||
    (separator == usize(2) && data.load(usize(1)) == byte(58)) {
        length = separator + usize(1)
    }
    output.clear()
    output.append(stringView(data, length))
    return true
}

def captureProjectRoot(borrow var output : TextBuilder) : bool {
    return match programArgument(usize(1)) {
        Some(path) => if isDirectory(path) {
            captureProjectDirectory(path, output)
        } else {
            captureParentDirectory(path, output)
        },
        None => captureWorkingDirectory(output)
    }
}

def setStatus(borrow var status : TextBuilder, message : string) : Unit {
    status.clear()
    status.append(message)
}

private def acceptDecodedFile(
    text : string,
    borrow var buffer : EditorBuffer,
    borrow var status : TextBuilder
) : bool {
    buffer.load(text)
    buffer.trackDiskContent(text)
    buffer.moveFileStart()
    setStatus(status, "Fichier chargé.")
    return true
}

private def rejectInvalidTextFile(borrow var status : TextBuilder) : bool {
    setStatus(status, "Impossible d'ouvrir ce fichier : UTF-8 invalide.")
    return false
}

def acceptFile(
    data : FileData,
    borrow var buffer : EditorBuffer,
    borrow var status : TextBuilder
) : bool {
    val accepted : bool = match data.asText() {
        Ok(text) => acceptDecodedFile(text, buffer, status),
        Error(error) => rejectInvalidTextFile(status)
    }
    delete data
    return accepted
}

def startEmptyFile(
    borrow var buffer : EditorBuffer,
    borrow var status : TextBuilder
) : bool {
    buffer.clear()
    setStatus(status, "Nouveau fichier : Ctrl+S pour le créer.")
    return false
}

def loadFile(
    path : string,
    borrow var buffer : EditorBuffer,
    borrow var status : TextBuilder
) : bool {
    val result : Result[FileData, SystemError] = readFile(path)
    return match move result {
        Ok(data) => acceptFile(move data, buffer, status),
        Error(error) => if pathExists(path) {
            openFailed(status)
        } else {
            startEmptyFile(buffer, status)
        }
    }
}

def openFailed(borrow var status : TextBuilder) : bool {
    setStatus(status, "Impossible d'ouvrir ce fichier.")
    return false
}

def openExistingFile(
    path : string,
    borrow var buffer : EditorBuffer,
    borrow var status : TextBuilder
) : bool {
    val result : Result[FileData, SystemError] = readFile(path)
    return match move result {
        Ok(data) => acceptFile(move data, buffer, status),
        Error(error) => openFailed(status)
    }
}

def saveSucceeded(
    borrow var buffer : EditorBuffer,
    content : string,
    borrow var status : TextBuilder
) : bool {
    buffer.markSaved()
    buffer.trackDiskContent(content)
    setStatus(status, "Fichier enregistré.")
    return true
}

def saveFailed(borrow var status : TextBuilder) : bool {
    setStatus(status, "Échec de l'enregistrement.")
    return false
}

private def writeBuffer(
    path : string,
    borrow var buffer : EditorBuffer,
    borrow var status : TextBuilder
) : bool {
    val content : TextBuilder = new TextBuilder()
    defer delete content
    buffer.appendText(content)
    return match writeTextFileAtomic(path, content.view()) {
        Ok(written) => if written {
            saveSucceeded(buffer, content.view(), status)
        } else {
            saveFailed(status)
        },
        Error(error) => saveFailed(status)
    }
}

private def acceptUnchangedText(
    text : string,
    borrow var buffer : EditorBuffer,
    borrow var status : TextBuilder
) : bool {
    val unchanged : bool = buffer.diskContentMatches(text)
    if !unchanged {
        setStatus(status, "Le fichier a été modifié sur le disque ; enregistrement refusé.")
    }
    return unchanged
}

private def reportUnverifiableFile(borrow var status : TextBuilder) : bool {
    setStatus(status, "Impossible de vérifier le fichier avant enregistrement.")
    return false
}

private def acceptUnchangedFile(
    data : FileData,
    borrow var buffer : EditorBuffer,
    borrow var status : TextBuilder
) : bool {
    val unchanged : bool = match data.asText() {
        Ok(text) => acceptUnchangedText(text, buffer, status),
        Error(error) => reportUnverifiableFile(status)
    }
    delete data
    return unchanged
}

private def currentDiskContentMatches(
    path : string,
    borrow var buffer : EditorBuffer,
    borrow var status : TextBuilder
) : bool {
    if !buffer.hasDiskContent() {
        if pathExists(path) {
            setStatus(status, "Le fichier a été créé sur le disque ; enregistrement refusé.")
            return false
        }
        return true
    }
    val current : Result[FileData, SystemError] = readFile(path)
    return match move current {
        Ok(data) => acceptUnchangedFile(move data, buffer, status),
        Error(error) => reportUnverifiableFile(status)
    }
}

def saveFile(
    path : string,
    borrow var buffer : EditorBuffer,
    borrow var status : TextBuilder
) : bool {
    if !currentDiskContentMatches(path, buffer, status) { return false }
    return writeBuffer(path, buffer, status)
}

def saveFileAs(
    path : string,
    currentPath : string,
    borrow var buffer : EditorBuffer,
    borrow var status : TextBuilder
) : bool {
    if path == currentPath { return saveFile(path, buffer, status) }
    if pathExists(path) {
        setStatus(status, "Le fichier cible existe déjà ; écrasement refusé.")
        return false
    }
    return writeBuffer(path, buffer, status)
}

def openProjectFolder(
    path : string,
    borrow var projectRoot : TextBuilder,
    borrow var explorer : ProjectExplorer,
    borrow var status : TextBuilder
) : bool {
    if path == "" {
        setStatus(status, "Saisissez un chemin de dossier.")
        return false
    }
    if !explorer.open(path) {
        setStatus(status, "Impossible d'ouvrir ce dossier.")
        return false
    }
    projectRoot.clear()
    projectRoot.append(path)
    setStatus(status, "Dossier ouvert.")
    return true
}

def applyPathPrompt(
    borrow var prompt : PathPrompt,
    path : string,
    borrow var activePath : TextBuilder,
    borrow var buffer : EditorBuffer,
    borrow var diagnostics : EditorDiagnostics,
    borrow var search : SearchModel,
    borrow var status : TextBuilder
) : bool {
    if path == "" {
        setStatus(status, "Saisissez un chemin de fichier.")
        return false
    }
    val action : PathPromptAction = prompt.action()
    if action == PathPromptAction.Open &&
    !openExistingFile(path, buffer, status) {
        return false
    }
    if action == PathPromptAction.SaveAs &&
    !validateSaveAsPath(path, activePath.view(), status) {
        return false
    }
    if action == PathPromptAction.SaveAs &&
    !saveFileAs(path, activePath.view(), buffer, status) {
        return false
    }
    if action == PathPromptAction.Create {
        buffer.clear()
        setStatus(status, "Nouveau fichier : Ctrl+S pour le créer.")
    }
    activePath.clear()
    activePath.append(path)
    diagnostics.clear()
    search.clear()
    prompt.dismiss()
    return true
}

def openExplorerFile(
    path : string,
    activePath : TextBuilder,
    borrow var buffer : EditorBuffer,
    borrow var status : TextBuilder
) : bool {
    if buffer.isModified() {
        setStatus(
            status,
            "Enregistrez les modifications avant d'ouvrir un autre fichier."
        )
        return false
    }
    if !openExistingFile(path, buffer, status) {
        return false
    }
    activePath.clear()
    activePath.append(path)
    return true
}
