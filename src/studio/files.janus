/// Chargement, sauvegarde et changement de document dans Janus Studio.
module studio.files

import editor.buffer
import editor.explorer
import editor.path_prompt
import editor.search
import tooling.diagnostics
import std.fs
import std.option
import std.path
import std.process
import std.result
import std.system
import std.text

def isFile(path : string) : bool {
    return match metadata(path) {
        Ok(value) => value.kind == FileType.File,
        Error(error) => false
    }
}

def isDirectory(path : string) : bool {
    return match metadata(path) {
        Ok(value) => value.kind == FileType.Directory,
        Error(error) => false
    }
}

def pathExists(path : string) : bool {
    return match metadata(path) {
        Ok(value) => true,
        Error(error) => false
    }
}

def validateNewPath(path : string, status : TextBuilder) : bool {
    if pathExists(path) {
        setStatus(status, "Ce chemin existe déjà : utilisez Ouvrir ou Enregistrer sous.")
        return false
    }
    return true
}

def validateSaveAsPath(
path : string,
currentPath : string,
status : TextBuilder
) : bool {
    if path != currentPath && pathExists(path) {
        setStatus(status, "Le fichier cible existe déjà ; écrasement refusé.")
        return false
    }
    return true
}

def codeFontPath() : string {
    val windowsPath : string = "C:/Windows/Fonts/consola.ttf"
    if isFile(windowsPath) {
        return windowsPath
    }
    val wslPath : string = "/mnt/c/Windows/Fonts/consola.ttf"
    if isFile(wslPath) {
        return wslPath
    }
    return "assets/fonts/DejaVuSansMono.ttf"
}

def selectedPath() : string {
    return match programArgument(usize(1)) {
        Some(path) => if isDirectory(path) { "" } else { path },
        None => ""
    }
}

def useWorkingDirectory(
directory : WorkingDirectory,
output : TextBuilder
) : bool {
    output.append(directory.view())
    delete directory
    return true
}

def captureWorkingDirectory(output : TextBuilder) : bool {
    val directory : Result[WorkingDirectory, SystemError] =
    currentWorkingDirectory()
    return match move directory {
        Ok(value) => useWorkingDirectory(move value, output),
        Error(error) => false
    }
}

def useProjectDirectory(path : string, output : TextBuilder) : bool {
    output.append(path)
    return true
}

def useNormalizedProjectDirectory(path : Path, output : TextBuilder) : bool {
    output.append(path.view())
    delete path
    return true
}

def joinProjectDirectory(
directory : WorkingDirectory,
path : string,
output : TextBuilder
) : bool {
    val joined : Result[Path, SystemError] = joinPath(directory.view(), path)
    delete directory
    return match move joined {
        Ok(value) => useNormalizedProjectDirectory(move value, output),
        Error(error) => useProjectDirectory(path, output)
    }
}

def captureProjectDirectory(path : string, output : TextBuilder) : bool {
    output.clear()
    val directory : Result[WorkingDirectory, SystemError] =
    currentWorkingDirectory()
    return match move directory {
        Ok(value) => joinProjectDirectory(move value, path, output),
        Error(error) => useProjectDirectory(path, output)
    }
}

def captureDocumentPath(path : string, output : TextBuilder) : bool {
    if path == "" {
        output.clear()
        return false
    }
    return captureProjectDirectory(path, output)
}

def captureProjectRoot(output : TextBuilder) : bool {
    return match programArgument(usize(1)) {
        Some(path) => if isDirectory(path) {
            captureProjectDirectory(path, output)
        } else {
            captureWorkingDirectory(output)
        },
        None => captureWorkingDirectory(output)
    }
}

def setStatus(status : TextBuilder, message : string) : Unit {
    status.clear()
    status.append(message)
}

def acceptFile(
data : FileData,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    buffer.load(data.view())
    buffer.moveFileStart()
    delete data
    setStatus(status, "Fichier chargé.")
    return true
}

def startEmptyFile(
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    buffer.clear()
    setStatus(status, "Nouveau fichier : Ctrl+S pour le créer.")
    return false
}

def loadFile(
path : string,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    val result : Result[FileData, SystemError] = readFile(path)
    return match move result {
        Ok(data) => acceptFile(move data, buffer, status),
        Error(error) => startEmptyFile(buffer, status)
    }
}

def openFailed(status : TextBuilder) : bool {
    setStatus(status, "Impossible d'ouvrir ce fichier.")
    return false
}

def openExistingFile(
path : string,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    val result : Result[FileData, SystemError] = readFile(path)
    return match move result {
        Ok(data) => acceptFile(move data, buffer, status),
        Error(error) => openFailed(status)
    }
}

def saveSucceeded(
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    buffer.markSaved()
    setStatus(status, "Fichier enregistré.")
    return true
}

def saveFailed(status : TextBuilder) : bool {
    setStatus(status, "Échec de l'enregistrement.")
    return false
}

def saveFile(
path : string,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    val content : TextBuilder = new TextBuilder()
    defer delete content
    buffer.appendText(content)
    return match writeTextFileAtomic(path, content.view()) {
        Ok(written) => if written {
            saveSucceeded(buffer, status)
        } else {
            saveFailed(status)
        },
        Error(error) => saveFailed(status)
    }
}

def openProjectFolder(
path : string,
projectRoot : TextBuilder,
explorer : ProjectExplorer,
status : TextBuilder
) : bool {
    if path == "" {
        setStatus(status, "Saisissez un chemin de dossier.")
        return false
    }
    if !explorer.open(path) {
        setStatus(status, "Impossible d'ouvrir ce dossier.")
        return false
    }
    projectRoot.clear()
    projectRoot.append(path)
    setStatus(status, "Dossier ouvert.")
    return true
}

def applyPathPrompt(
prompt : PathPrompt,
path : string,
activePath : TextBuilder,
buffer : EditorBuffer,
diagnostics : EditorDiagnostics,
search : SearchModel,
status : TextBuilder
) : bool {
    if path == "" {
        setStatus(status, "Saisissez un chemin de fichier.")
        return false
    }
    val action : PathPromptAction = prompt.action()
    if action == PathPromptAction.Open &&
    !openExistingFile(path, buffer, status) {
        return false
    }
    if action == PathPromptAction.SaveAs &&
    !validateSaveAsPath(path, activePath.view(), status) {
        return false
    }
    if action == PathPromptAction.SaveAs &&
    !saveFile(path, buffer, status) {
        return false
    }
    if action == PathPromptAction.Create {
        buffer.clear()
        setStatus(status, "Nouveau fichier : Ctrl+S pour le créer.")
    }
    activePath.clear()
    activePath.append(path)
    diagnostics.clear()
    search.clear()
    prompt.dismiss()
    return true
}

def openExplorerFile(
path : string,
activePath : TextBuilder,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    if buffer.isModified() {
        setStatus(
        status,
        "Enregistrez les modifications avant d'ouvrir un autre fichier."
        )
        return false
    }
    if !openExistingFile(path, buffer, status) {
        return false
    }
    activePath.clear()
    activePath.append(path)
    return true
}
