/// Initialisation et orchestration de Janus Studio.
module studio.application

import editor.vim
import studio.commands
import studio.files
import studio.frame
import studio.render
import studio.state
import studio.view
import std.graphics
import std.text

struct StudioDisplay(
    var uiFont : Font,
    var codeFont : Font,
    val glyphAdvance : float,
    val lineAdvance : float,
    val outputGlyphAdvance : float,
    val outputLineAdvance : float
) {
    def isValid() : bool => uiFont.isValid() && codeFont.isValid()
}

def openStudioWindow() : bool {
    if !initWindow(1200, 760, "Janus Studio") { return false }
    setWindowResizable(true)
    disableExitKey()
    setTargetFps(60)
    return true
}

def studioDisplay() : StudioDisplay {
    val characters : TextBuilder = studioFontCharacters()
    defer delete characters
    val uiFontPath : TextBuilder = new TextBuilder()
    defer delete uiFontPath
    val codeFontFile : TextBuilder = new TextBuilder()
    defer delete codeFontFile
    val _uiPathCaptured : bool = captureAssetPath(
        "assets/fonts/DejaVuSans.ttf",
        uiFontPath
    )
    val _codePathCaptured : bool = captureAssetPath(
        codeFontPath(),
        codeFontFile
    )
    val uiFont : Font = loadFontUtf8(uiFontPath.view(), 32, characters.view())
    val codeFont : Font = loadFontUtf8(codeFontFile.view(), 32, characters.view())
    val codeMetrics : Vector2 = codeFont.measure(
        "M",
        codeFontSize,
        codeFontSpacing
    )
    val outputMetrics : Vector2 = codeFont.measure(
        "M",
        15.0f,
        codeFontSpacing
    )
    val glyphAdvance : float = glyphWidth(
        codeFont,
        codeMetrics,
        codeFontSize
    )
    val lineAdvance : float = lineHeight(
        codeFont,
        codeMetrics,
        codeFontSize
    )
    val outputGlyphAdvance : float = glyphWidth(
        codeFont,
        outputMetrics,
        15.0f
    )
    val outputLineAdvance : float = lineHeight(
        codeFont,
        outputMetrics,
        15.0f
    )
    return new StudioDisplay(
        move uiFont,
        move codeFont,
        glyphAdvance,
        lineAdvance,
        outputGlyphAdvance,
        outputLineAdvance
    )
}

def glyphWidth(borrow var font : Font, oneGlyph : Vector2, size : float) : float =>
    font.measure("MM", size, codeFontSpacing).x - oneGlyph.x

def lineHeight(borrow var font : Font, oneGlyph : Vector2, size : float) : float =>
    font.measure("M\nM", size, codeFontSpacing).y - oneGlyph.y

def runStudioSession(
    borrow var app : StudioAppState,
    borrow var ui : StudioUiState,
    borrow var display : StudioDisplay
) : Unit {
    while !ui.quitRequested {
        val frame : StudioFrame = beginStudioFrame(
            app,
            display.glyphAdvance,
            display.lineAdvance,
            display.outputGlyphAdvance,
            display.outputLineAdvance
        )
        handleFrame(app, ui, frame, display)
        delete frame
    }
}

def handleFrame(
    borrow var app : StudioAppState,
    borrow var ui : StudioUiState,
    borrow var frame : StudioFrame,
    borrow var display : StudioDisplay
) : Unit {
    borrow var uiFont = display.uiFont
    handleLayoutMouse(app, ui, frame, uiFont)
    clampLayoutOffsets(
        app,
        ui,
        frame,
        uiFont,
        display.glyphAdvance,
        display.lineAdvance,
        display.outputGlyphAdvance,
        display.outputLineAdvance
    )
    handleWheelScrolling(app, ui, frame, uiFont)
    handleWorkspaceMouse(
        app,
        ui,
        frame,
        display.glyphAdvance,
        display.lineAdvance
    )
    handleFileCommands(app, ui, frame)
    handleEditorCommands(app, ui, frame)
    synchronizeDocumentState(app, ui, frame)
    drawStudioFrame(app, ui, frame, display)
}

def synchronizeDocumentState(
    borrow var app : StudioAppState,
    borrow var ui : StudioUiState,
    borrow var frame : StudioFrame
) : Unit {
    if app.buffer.isModified() { app.tooling.diagnostics.clear() }
    if app.buffer.size() != frame.bufferSizeBeforeInput { app.search.clear() }
    if searchModeEnded(app, frame) { app.search.clear() }
    if cursorMoved(app, frame) || isKeyPressed(Key.Delete) {
        ui.editorScrollDetached = false
        ui.horizontalScrollDetached = false
    }
    borrow var buffer = app.buffer
    if !ui.editorScrollDetached {
        ui.firstLine = keepCursorVisible(
            buffer,
            ui.firstLine,
            frame.maximumLines
        )
    }
    if !ui.horizontalScrollDetached {
        ui.firstColumn = keepCursorHorizontallyVisible(
            buffer,
            ui.firstColumn,
            frame.visibleColumns
        )
    }
}

def searchModeEnded(borrow var app : StudioAppState, borrow var frame : StudioFrame) : bool {
    if app.controller.mode() == frame.editorModeBeforeInput { return false }
    return app.controller.mode() != EditorMode.Normal ||
    (frame.editorModeBeforeInput == EditorMode.Search &&
        isKeyPressed(Key.Escape))
}

def cursorMoved(borrow var app : StudioAppState, borrow var frame : StudioFrame) : bool {
    return app.buffer.line() != frame.cursorLineBeforeInput ||
    app.buffer.column() != frame.cursorColumnBeforeInput
}

def drawStudioFrame(
    borrow var app : StudioAppState,
    borrow var ui : StudioUiState,
    borrow var frame : StudioFrame,
    borrow var display : StudioDisplay
) : Unit {
    borrow var controller = app.controller
    borrow var modeLine = app.modeLine
    borrow var commandLine = app.commandLine
    borrow var buffer = app.buffer
    borrow var tabs = app.tabs
    borrow var tabLabel = app.tabLabel
    borrow var visibleCharacters = app.visibleCharacters
    borrow var syntaxSpans = app.syntaxSpans
    borrow var semanticTokens = app.tooling.semanticTokens
    borrow var glyph = app.glyph
    borrow var diagnostics = app.tooling.diagnostics
    borrow var diagnosticText = app.tooling.diagnosticText
    borrow var search = app.search
    borrow var completion = app.tooling.completion
    borrow var completionText = app.tooling.completionText
    borrow var signatureText = app.tooling.signatureText
    borrow var filePrompt = app.filePrompt
    borrow var statusLine = app.statusLine
    borrow var status = app.status
    borrow var toolOutput = app.tooling.toolOutput
    borrow var explorer = app.explorer
    borrow var explorerLabel = app.explorerLabel
    borrow var uiFont = display.uiFont
    borrow var codeFont = display.codeFont
    controller.appendStatus(modeLine)
    controller.appendCommandLine(commandLine)
    drawStudio(
        app.activePath.view(),
        buffer,
        tabs,
        tabLabel,
        ui,
        visibleCharacters,
        syntaxSpans,
        semanticTokens,
        glyph,
        diagnostics,
        diagnosticText,
        search,
        completion,
        completionText,
        signatureText,
        filePrompt,
        statusLine,
        status,
        toolOutput,
        modeLine,
        commandLine,
        explorer,
        frame.visibleExplorerRows,
        explorerLabel,
        controller.mode(),
        uiFont,
        codeFont,
        display.glyphAdvance,
        display.lineAdvance,
        display.outputGlyphAdvance,
        display.outputLineAdvance,
        frame.maximumLines
    )
}
