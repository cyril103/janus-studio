/// État de la fenêtre d'autocomplétion de Janus Studio.
module editor.completion

import editor.buffer
import text.utf8
import std.array
import std.text

class CompletionModel(
private val allLabels : TextBuilder,
private val labels : TextBuilder,
private val selectedLabel : TextBuilder,
private val insertionLabel : TextBuilder,
private val prefix : Array[char],
private val candidate : Array[char]
) {
    private var itemCount : usize = usize(0)
    private var selectedIndex : usize = usize(0)
    private var visible : bool = false
    private var filtering : bool = false

    def isVisible() : bool {
        return visible
    }

    def size() : usize {
        return itemCount
    }

    def selected() : usize {
        return selectedIndex
    }

    def isFiltering() : bool {
        return filtering
    }

    private def rebuildFilter() : Unit {
        labels.clear()
        itemCount = usize(0)
        val source : string = allLabels.view()
        val data : Ptr[byte] = stringData(source)
        var lineStart : usize = usize(0)
        while lineStart < stringLength(source) {
            var labelEnd : usize = lineStart
            while labelEnd < stringLength(source) &&
            data.load(labelEnd) != byte(9) && data.load(labelEnd) != byte(10) {
                labelEnd = labelEnd + usize(1)
            }
            candidate.clear()
            val _decoded : usize = appendUtf8CharacterRange(
            source,
            lineStart,
            labelEnd,
            candidate
            )
            var matches : bool = prefix.size() <= candidate.size()
            var prefixIndex : usize = usize(0)
            while matches && prefixIndex < prefix.size() {
                if candidate.get(prefixIndex) != prefix.get(prefixIndex) {
                    matches = false
                }
                prefixIndex = prefixIndex + usize(1)
            }
            var lineEnd : usize = labelEnd
            while lineEnd < stringLength(source) &&
            data.load(lineEnd) != byte(10) {
                lineEnd = lineEnd + usize(1)
            }
            if lineEnd < stringLength(source) {
                lineEnd = lineEnd + usize(1)
            }
            if matches {
                appendUtf8TextRange(source, lineStart, lineEnd, labels)
                itemCount = itemCount + usize(1)
            }
            lineStart = lineEnd
        }
        selectedIndex = usize(0)
        visible = itemCount > usize(0)
    }

    def load(source : string) : Unit {
        allLabels.clear()
        allLabels.append(source)
        prefix.clear()
        filtering = true
        this.rebuildFilter()
    }

    def refine(value : char) : Unit {
        if !filtering { return }
        prefix.push(value)
        this.rebuildFilter()
    }

    def broaden() : Unit {
        if !filtering { return }
        if prefix.size() == usize(0) {
            this.dismiss()
            return
        }
        val _removed : char = prefix.pop()
        this.rebuildFilter()
    }

    def dismiss() : Unit {
        visible = false
        filtering = false
    }

    def selectNext() : Unit {
        if !visible || itemCount == usize(0) {
            return
        }
        selectedIndex = (selectedIndex + usize(1)) % itemCount
    }

    def selectPrevious() : Unit {
        if !visible || itemCount == usize(0) {
            return
        }
        selectedIndex = if selectedIndex == usize(0) {
            itemCount - usize(1)
        } else {
            selectedIndex - usize(1)
        }
    }

    def appendItem(index : usize, output : TextBuilder) : Unit {
        output.clear()
        if index >= itemCount {
            return
        }
        val source : string = labels.view()
        val data : Ptr[byte] = stringData(source)
        var current : usize = usize(0)
        var position : usize = usize(0)
        while position < stringLength(source) && current < index {
            if data.load(position) == byte(10) {
                current = current + usize(1)
            }
            position = position + usize(1)
        }
        val itemStart : usize = position
        while position < stringLength(source) && data.load(position) != byte(9) &&
        data.load(position) != byte(10) {
            position = position + usize(1)
        }
        appendUtf8TextRange(source, itemStart, position, output)
    }

    def appendDisplayItem(index : usize, output : TextBuilder) : Unit {
        output.clear()
        if index >= itemCount {
            return
        }
        val source : string = labels.view()
        val data : Ptr[byte] = stringData(source)
        var current : usize = usize(0)
        var position : usize = usize(0)
        while position < stringLength(source) && current < index {
            if data.load(position) == byte(10) {
                current = current + usize(1)
            }
            position = position + usize(1)
        }
        val lineStart : usize = position
        while position < stringLength(source) &&
        data.load(position) != byte(9) && data.load(position) != byte(10) {
            position = position + usize(1)
        }
        if position < stringLength(source) && data.load(position) == byte(9) {
            position = position + usize(1)
        } else {
            position = lineStart
        }
        val displayStart : usize = position
        while position < stringLength(source) && data.load(position) != byte(10) {
            position = position + usize(1)
        }
        appendUtf8TextRange(source, displayStart, position, output)
    }

    def appendVisible(output : TextBuilder, maximumItems : usize) : Unit {
        output.clear()
        val first : usize = if selectedIndex < maximumItems {
            usize(0)
        } else {
            selectedIndex - maximumItems + usize(1)
        }
        var index : usize = first
        while index < itemCount && index < first + maximumItems {
            output.append(if index == selectedIndex { "> " } else { "  " })
            this.appendDisplayItem(index, selectedLabel)
            output.append(selectedLabel.view())
            output.append("\n")
            index = index + usize(1)
        }
    }

    def accept(buffer : EditorBuffer) : bool {
        if !visible {
            return false
        }
        this.appendItem(selectedIndex, selectedLabel)
        insertionLabel.clear()
        val selected : string = selectedLabel.view()
        appendUtf8TextRange(
        selected,
        utf8ByteOffset(selected, prefix.size()),
        stringLength(selected),
        insertionLabel
        )
        buffer.insertText(insertionLabel.view())
        visible = false
        filtering = false
        return true
    }

    destructor {
        delete allLabels
        delete labels
        delete selectedLabel
        delete insertionLabel
        delete prefix
        delete candidate
    }
}

def completionModel() : CompletionModel {
    return new CompletionModel(
    new TextBuilder(),
    new TextBuilder(),
    new TextBuilder(),
    new TextBuilder(),
    new Array[char](usize(8)),
    new Array[char](usize(64))
    )
}
