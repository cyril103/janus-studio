/// Arborescence de projet chargée à la demande pour la barre latérale.
module editor.explorer

import text.utf8
import std.array
import std.fs
import std.option
import std.path
import std.result
import std.slice
import std.system
import std.text

enum ExplorerEntryKind derives Copy, Equality, Debug {
    Directory,
    File
}

private struct ExplorerEntry(
val nameStart : usize,
val nameLength : usize,
val pathStart : usize,
val pathLength : usize,
val depth : usize,
val kind : ExplorerEntryKind,
val expanded : bool
) derives Copy, Equality, Debug {}

private def baseNameStart(path : string) : usize {
    val data : Ptr[byte] = stringData(path)
    var start : usize = usize(0)
    var index : usize = usize(0)
    while index < stringLength(path) {
        val value : byte = data.load(index)
        if value == byte(47) || value == byte(92) {
            start = index + usize(1)
        }
        index = index + usize(1)
    }
    return if start < stringLength(path) { start } else { usize(0) }
}

private def explorerKind(metadata : FileMetadata) : int {
    if metadata.kind == FileType.Directory {
        return int(ExplorerEntryKind.Directory)
    }
    if metadata.kind == FileType.File {
        return int(ExplorerEntryKind.File)
    }
    return -1
}

private def explorerKindResult(
result : Result[FileMetadata, SystemError]
) : int {
    return match result {
        Ok(value) => explorerKind(value),
        Error(error) => -1
    }
}

class ProjectExplorer(
private val entries : Array[ExplorerEntry],
private var names : Array[char],
private var paths : Array[char]
) {
    private var selectedIndex : usize = usize(0)

    private def addRoot(root : string) : Unit {
        val nameStart : usize = names.size()
        var nameLength : usize = appendUtf8Characters(
        root,
        baseNameStart(root),
        names
        )
        if nameLength == usize(0) {
            nameLength = appendUtf8Characters(root, usize(0), names)
        }
        val pathStart : usize = paths.size()
        val pathLength : usize = appendUtf8Characters(root, usize(0), paths)
        entries.push(new ExplorerEntry(
        nameStart,
        nameLength,
        pathStart,
        pathLength,
        usize(0),
        ExplorerEntryKind.Directory,
        false
        ))
        selectedIndex = usize(0)
    }

    private borrow def appendCharacters(
    borrow source : Array[char],
    start : usize,
    length : usize,
    output : TextBuilder
    ) : Unit {
        output.clear()
        var index : usize = usize(0)
        while index < length {
            output.appendChar(source.get(start + index))
            index = index + usize(1)
        }
    }

    private borrow def appendSlice(
    borrow source : Slice[char],
    output : TextBuilder
    ) : Unit {
        output.clear()
        var index : usize = usize(0)
        while index < source.size() {
            output.appendChar(source.get(index))
            index = index + usize(1)
        }
    }

    private borrow def entryLess(
    left : ExplorerEntry,
    right : ExplorerEntry
    ) : bool {
        if left.kind != right.kind {
            return left.kind == ExplorerEntryKind.Directory
        }
        var index : usize = usize(0)
        val common : usize = if left.nameLength < right.nameLength {
            left.nameLength
        } else {
            right.nameLength
        }
        while index < common {
            val leftValue : char = names.get(left.nameStart + index)
            val rightValue : char = names.get(right.nameStart + index)
            if leftValue != rightValue {
                return int(leftValue) < int(rightValue)
            }
            index = index + usize(1)
        }
        return left.nameLength < right.nameLength
    }

    private def insertEntry(index : usize, entry : ExplorerEntry) : Unit {
        entries.push(entry)
        var cursor : usize = entries.size() - usize(1)
        while cursor > index {
            entries.set(cursor, entries.get(cursor - usize(1)))
            cursor = cursor - usize(1)
        }
        entries.set(index, entry)
    }

    private def addJoinedEntry(
    label : string,
    fullPath : Path,
    depth : usize,
    output : Array[ExplorerEntry]
    ) : bool {
        val kind : int = explorerKindResult(metadata(fullPath.view()))
        if kind < 0 {
            delete fullPath
            return false
        }
        return this.storeEntry(
        label,
        move fullPath,
        depth,
        ExplorerEntryKind(kind),
        output
        )
    }

    private def storeEntry(
    label : string,
    fullPath : Path,
    depth : usize,
    kind : ExplorerEntryKind,
    output : Array[ExplorerEntry]
    ) : bool {
        val nameStart : usize = names.size()
        val nameLength : usize = appendUtf8Characters(label, usize(0), names)
        val pathStart : usize = paths.size()
        val pathLength : usize = appendUtf8Characters(
        fullPath.view(),
        usize(0),
        paths
        )
        delete fullPath
        output.push(new ExplorerEntry(
        nameStart,
        nameLength,
        pathStart,
        pathLength,
        depth,
        kind,
        false
        ))
        return true
    }

    private def addDirectoryEntry(
    name : Path,
    parentPath : string,
    depth : usize,
    output : Array[ExplorerEntry]
    ) : bool {
        val label : string = name.view()
        val joined : Result[Path, SystemError] = joinPath(parentPath, label)
        val added : bool = match move joined {
            Ok(fullPath) => this.addJoinedEntry(
            label,
            move fullPath,
            depth,
            output
            ),
            Error(error) => false
        }
        delete name
        return added
    }

    private def continueDirectoryEntry(
    name : Path,
    parentPath : string,
    depth : usize,
    output : Array[ExplorerEntry]
    ) : int {
        this.addDirectoryEntry(move name, parentPath, depth, output)
        return 1
    }

    private def consumeOptionalDirectoryEntry(
    entry : Option[Path],
    parentPath : string,
    depth : usize,
    output : Array[ExplorerEntry]
    ) : int {
        return match move entry {
            Some(name) => this.continueDirectoryEntry(
            move name,
            parentPath,
            depth,
            output
            ),
            None => 0
        }
    }

    private def consumeDirectoryEntry(
    result : Result[Option[Path], SystemError],
    parentPath : string,
    depth : usize,
    output : Array[ExplorerEntry]
    ) : int {
        return match move result {
            Ok(entry) => this.consumeOptionalDirectoryEntry(
            move entry,
            parentPath,
            depth,
            output
            ),
            Error(error) => -1
        }
    }

    private def readChildren(
    iterator : DirectoryIterator,
    parentPath : string,
    depth : usize,
    output : Array[ExplorerEntry]
    ) : bool {
        var state : int = this.consumeDirectoryEntry(
        iterator.next(),
        parentPath,
        depth,
        output
        )
        while state == 1 {
            state = this.consumeDirectoryEntry(
            iterator.next(),
            parentPath,
            depth,
            output
            )
        }
        val closed : bool = match iterator.close() {
            Ok(value) => value,
            Error(error) => false
        }
        delete iterator
        output.sortWith((left : ExplorerEntry, right : ExplorerEntry) =>
        this.entryLess(left, right))
        return state == 0 && closed
    }

    private def copyStorageRange(
    source : Array[char],
    start : usize,
    length : usize,
    output : Array[char]
    ) : Unit {
        var index : usize = usize(0)
        while index < length {
            output.push(source.get(start + index))
            index = index + usize(1)
        }
    }

    private def compactStorage() : Unit {
        val compactedNames : Array[char] = new Array[char](names.size())
        val compactedPaths : Array[char] = new Array[char](paths.size())
        var index : usize = usize(0)
        while index < entries.size() {
            val entry : ExplorerEntry = entries.get(index)
            val nameStart : usize = compactedNames.size()
            val pathStart : usize = compactedPaths.size()
            this.copyStorageRange(
            names,
            entry.nameStart,
            entry.nameLength,
            compactedNames
            )
            this.copyStorageRange(
            paths,
            entry.pathStart,
            entry.pathLength,
            compactedPaths
            )
            entries.set(index, new ExplorerEntry(
            nameStart,
            entry.nameLength,
            pathStart,
            entry.pathLength,
            entry.depth,
            entry.kind,
            entry.expanded
            ))
            index = index + usize(1)
        }
        delete names
        names = move compactedNames
        delete paths
        paths = move compactedPaths
    }

    private def loadChildren(
    index : usize,
    parent : ExplorerEntry
    ) : bool {
        val parentPath : TextBuilder = new TextBuilder()
        defer delete parentPath
        val storedPath : Slice[char] = new Slice[char](
        paths,
        parent.pathStart,
        parent.pathLength
        )
        this.appendSlice(storedPath, parentPath)
        delete storedPath
        val children : Array[ExplorerEntry] = new Array[ExplorerEntry](usize(16))
        defer delete children
        val directory : Result[DirectoryIterator, SystemError] =
        readDirectory(parentPath.view())
        val loaded : bool = match move directory {
            Ok(iterator) => this.readChildren(
            move iterator,
            parentPath.view(),
            parent.depth + usize(1),
            children
            ),
            Error(error) => false
        }
        if !loaded {
            this.compactStorage()
            return false
        }
        var childIndex : usize = usize(0)
        while childIndex < children.size() {
            this.insertEntry(
            index + usize(1) + childIndex,
            children.get(childIndex)
            )
            childIndex = childIndex + usize(1)
        }
        return true
    }

    borrow def size() : usize {
        return entries.size()
    }

    borrow def storageSize() : usize { return names.size() + paths.size() }

    def open(root : string) : bool {
        if explorerKindResult(metadata(root)) != int(ExplorerEntryKind.Directory) {
            return false
        }
        val previousEntries : Array[ExplorerEntry] =
        new Array[ExplorerEntry](entries.size())
        defer delete previousEntries
        val previousNames : Array[char] = new Array[char](names.size())
        defer delete previousNames
        val previousPaths : Array[char] = new Array[char](paths.size())
        defer delete previousPaths
        var index : usize = usize(0)
        while index < entries.size() {
            previousEntries.push(entries.get(index))
            index = index + usize(1)
        }
        index = usize(0)
        while index < names.size() {
            previousNames.push(names.get(index))
            index = index + usize(1)
        }
        index = usize(0)
        while index < paths.size() {
            previousPaths.push(paths.get(index))
            index = index + usize(1)
        }
        val previousSelection : usize = selectedIndex
        entries.clear()
        names.clear()
        paths.clear()
        this.addRoot(root)
        if !this.toggle(usize(0)) {
            entries.clear()
            names.clear()
            paths.clear()
            index = usize(0)
            while index < previousEntries.size() {
                entries.push(previousEntries.get(index))
                index = index + usize(1)
            }
            index = usize(0)
            while index < previousNames.size() {
                names.push(previousNames.get(index))
                index = index + usize(1)
            }
            index = usize(0)
            while index < previousPaths.size() {
                paths.push(previousPaths.get(index))
                index = index + usize(1)
            }
            selectedIndex = previousSelection
            return false
        }
        this.compactStorage()
        return true
    }

    def close() : Unit {
        entries.clear()
        names.clear()
        paths.clear()
        selectedIndex = usize(-1)
    }

    borrow def selected() : usize {
        return selectedIndex
    }

    def select(index : usize) : Unit {
        if index < entries.size() {
            selectedIndex = index
        }
    }

    borrow def depth(index : usize) : usize {
        return entries.get(index).depth
    }

    borrow def isDirectory(index : usize) : bool {
        return entries.get(index).kind == ExplorerEntryKind.Directory
    }

    borrow def isExpanded(index : usize) : bool {
        return entries.get(index).expanded
    }

    borrow def appendLabel(index : usize, output : TextBuilder) : Unit {
        val entry : ExplorerEntry = entries.get(index)
        this.appendCharacters(names, entry.nameStart, entry.nameLength, output)
    }

    borrow def appendPath(index : usize, output : TextBuilder) : Unit {
        val entry : ExplorerEntry = entries.get(index)
        this.appendCharacters(paths, entry.pathStart, entry.pathLength, output)
    }

    def toggle(index : usize) : bool {
        if index >= entries.size() || !this.isDirectory(index) {
            return false
        }
        val entry : ExplorerEntry = entries.get(index)
        if entry.expanded {
            var removed : usize = usize(0)
            while index + usize(1) < entries.size() &&
            entries.get(index + usize(1)).depth > entry.depth {
                val _discarded : ExplorerEntry = entries.remove(index + usize(1))
                removed = removed + usize(1)
            }
            entries.set(index, new ExplorerEntry(
            entry.nameStart,
            entry.nameLength,
            entry.pathStart,
            entry.pathLength,
            entry.depth,
            entry.kind,
            false
            ))
            if selectedIndex > index && selectedIndex <= index + removed {
                selectedIndex = index
            } else if selectedIndex > index + removed {
                selectedIndex = selectedIndex - removed
            }
            this.compactStorage()
            return true
        }
        if !this.loadChildren(index, entry) {
            return false
        }
        entries.set(index, new ExplorerEntry(
        entry.nameStart,
        entry.nameLength,
        entry.pathStart,
        entry.pathLength,
        entry.depth,
        entry.kind,
        true
        ))
        return true
    }

    destructor {
        delete entries
        delete names
        delete paths
    }
}

def projectExplorer(root : string) : ProjectExplorer {
    val entries : Array[ExplorerEntry] = new Array[ExplorerEntry](usize(64))
    val names : Array[char] = new Array[char](usize(256))
    val paths : Array[char] = new Array[char](usize(1024))
    val explorer : ProjectExplorer = new ProjectExplorer(
    move entries,
    move names,
    move paths
    )
    explorer.open(root)
    return explorer
}
