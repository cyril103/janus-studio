/// Saisie modale d'un chemin pour les opérations de fichier de Janus Studio.
module editor.path_prompt

import text.utf8
import std.array
import std.fs
import std.option
import std.path
import std.result
import std.system
import std.text

enum PathPromptAction derives Copy, Equality, Debug {
    None,
    Open,
    OpenFolder,
    Create,
    SaveAs
}

private def startsWithCharacters(
    borrow value : Array[char],
    borrow prefix : Array[char]
) : bool {
    if value.size() < prefix.size() {
        return false
    }
    var index : usize = usize(0)
    while index < prefix.size() {
        if value[index] != prefix[index] {
            return false
        }
        index += usize(1)
    }
    return true
}

private def keepCommonPrefix(
    borrow var common : Array[char],
    borrow candidate : Array[char]
) : Unit {
    var shared : usize = usize(0)
    while shared < common.size() && shared < candidate.size() &&
    common[shared] == candidate[shared] {
        shared += usize(1)
    }
    while common.size() > shared {
        val _removed : char = common.pop()
    }
}

private def consumeDirectoryPath(path : Path) : bool {
    val result : Result[FileMetadata, SystemError] = metadata(path.view())
    delete path
    return match result {
        Ok(value) => value.kind == FileType.Directory,
        Error(error) => false
    }
}

private def joinedPathIsDirectory(
    result : Result[Path, SystemError]
) : bool {
    return match move result {
        Ok(path) => consumeDirectoryPath(move path),
        Error(error) => false
    }
}

private class PathCompletionState(
    private val directory : string,
    private val partial : Array[char],
    private val common : Array[char],
    private val candidate : Array[char]
) {
    private var matches : usize = usize(0)
    private var uniqueDirectory : bool = false

    def consumeName(name : Path) : bool {
        candidate.clear()
        appendUtf8Characters(name.view(), usize(0), candidate)
        if startsWithCharacters(candidate, partial) {
            if matches == usize(0) {
                var index : usize = usize(0)
                while index < candidate.size() {
                    common.push(candidate[index])
                    index += usize(1)
                }
                uniqueDirectory = joinedPathIsDirectory(joinPath(
                    directory,
                    name.view()
                ))
            } else {
                keepCommonPrefix(common, candidate)
                uniqueDirectory = false
            }
            matches += usize(1)
        }
        delete name
        return true
    }

    pure borrow def count() : usize => matches
    pure borrow def commonSize() : usize => common.size()
    borrow def commonAt(index : usize) : char => common[index]
    pure borrow def isUniqueDirectory() : bool => uniqueDirectory

    destructor {
        delete partial
        delete common
        delete candidate
    }
}

private def pathCompletionState(
    directory : string,
    partialText : string
) : PathCompletionState {
    val partial : Array[char] = new Array[char](usize(32))
    appendUtf8Characters(partialText, usize(0), partial)
    return new PathCompletionState(
        directory,
        move partial,
        new Array[char](usize(64)),
        new Array[char](usize(64))
    )
}

class PathPrompt(
    private var currentAction : PathPromptAction,
    private val text : TextBuilder,
    private val characters : Array[char]
) {
    private var cursorIndex : usize = usize(0)

    private def loadCharacters(value : string) : Unit {
        appendUtf8Characters(value, usize(0), characters)
    }

    private def rebuildText() : Unit {
        text.clear()
        var index : usize = usize(0)
        while index < characters.size() {
            text.appendChar(characters[index])
            index += usize(1)
        }
    }

    pure borrow def isVisible() : bool => currentAction != PathPromptAction.None
    pure borrow def action() : PathPromptAction => currentAction

    def value() : string {
        return text.view()
    }

    pure borrow def cursor() : usize => cursorIndex

    def begin(action : PathPromptAction, initialValue : string) : Unit {
        currentAction = action
        characters.clear()
        this.loadCharacters(initialValue)
        cursorIndex = characters.size()
        this.rebuildText()
    }

    def append(value : char) : Unit {
        characters.push(value)
        var index : usize = characters.size() - usize(1)
        while index > cursorIndex {
            characters[index] = characters[index - usize(1)]
            index -= usize(1)
        }
        characters[cursorIndex] = value
        cursorIndex += usize(1)
        this.rebuildText()
    }

    def backspace() : Unit {
        if cursorIndex == usize(0) {
            return
        }
        val _removed : char = characters.remove(cursorIndex - usize(1))
        cursorIndex -= usize(1)
        this.rebuildText()
    }

    def deleteForward() : Unit {
        if cursorIndex >= characters.size() {
            return
        }
        val _removed : char = characters.remove(cursorIndex)
        this.rebuildText()
    }

    def moveLeft() : Unit {
        if cursorIndex > usize(0) {
            cursorIndex -= usize(1)
        }
    }

    def moveRight() : Unit {
        if cursorIndex < characters.size() {
            cursorIndex += usize(1)
        }
    }

    def moveHome() : Unit {
        cursorIndex = usize(0)
    }

    def moveEnd() : Unit {
        cursorIndex = characters.size()
    }

    private def completeFromDirectory(
        iterator : DirectoryIterator,
        directory : string,
        partialText : string,
        segmentStart : usize
    ) : usize {
        val state : PathCompletionState = pathCompletionState(
            directory,
            partialText
        )
        defer delete state
        var reading : bool = true
        while reading {
            val nextEntry : Result[Option[Path], SystemError] = iterator.next()
            reading = match move nextEntry {
                Ok(entry) => match move entry {
                    Some(name) => state.consumeName(move name),
                    None => false
                },
                Error(error) => false
            }
        }
        val _closed : bool = match iterator.close() {
            Ok(value) => value,
            Error(error) => false
        }
        delete iterator
        if state.count() == usize(0) {
            return usize(0)
        }
        var removeCount : usize = cursorIndex - segmentStart
        while removeCount > usize(0) {
            val _removed : char = characters.remove(segmentStart)
            removeCount -= usize(1)
        }
        cursorIndex = segmentStart
        var commonIndex : usize = usize(0)
        while commonIndex < state.commonSize() {
            this.append(state.commonAt(commonIndex))
            commonIndex += usize(1)
        }
        if state.count() == usize(1) && state.isUniqueDirectory() &&
        cursorIndex == characters.size() {
            this.append('/')
        }
        return state.count()
    }

    def completePath() : usize {
        var segmentStart : usize = cursorIndex
        while segmentStart > usize(0) &&
        characters[segmentStart - usize(1)] != '/' &&
        characters[segmentStart - usize(1)] != '\\' {
            segmentStart -= usize(1)
        }
        val directoryText : TextBuilder = new TextBuilder()
        defer delete directoryText
        if segmentStart == usize(0) {
            directoryText.append(".")
        } else {
            var directoryIndex : usize = usize(0)
            while directoryIndex < segmentStart {
                directoryText.appendChar(characters[directoryIndex])
                directoryIndex += usize(1)
            }
        }
        val partialText : TextBuilder = new TextBuilder()
        defer delete partialText
        var partialIndex : usize = segmentStart
        while partialIndex < cursorIndex {
            partialText.appendChar(characters[partialIndex])
            partialIndex += usize(1)
        }
        val iteratorResult : Result[DirectoryIterator, SystemError] =
        readDirectory(directoryText.view())
        return match move iteratorResult {
            Ok(iterator) => this.completeFromDirectory(
                move iterator,
                directoryText.view(),
                partialText.view(),
                segmentStart
            ),
            Error(error) => usize(0)
        }
    }

    def dismiss() : Unit {
        currentAction = PathPromptAction.None
        text.clear()
        characters.clear()
        cursorIndex = usize(0)
    }

    destructor {
        delete text
        delete characters
    }
}

def pathPrompt() : PathPrompt {
    return new PathPrompt(
        PathPromptAction.None,
        new TextBuilder(),
        new Array[char](usize(128))
    )
}
