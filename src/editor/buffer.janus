/// Buffer de texte éditable utilisé par Janus Studio.
///
/// Le contenu UTF-8 est décodé en caractères Unicode lors du chargement.
module editor.buffer

import text.utf8
import std.array
import std.text

const historyLimit : usize = usize(100)
const historyCharacterLimit : usize = usize(4000000)

private def decodeUtf8(text : string, output : Array[char]) : Unit {
    var index : usize = usize(0)
    while index < stringLength(text) {
        val decoded : Utf8Codepoint = decodeUtf8At(text, index)
        if decoded.value == '\r' {
            output.push('\n')
            index = index + decoded.width
            if index < stringLength(text) &&
            decodeUtf8At(text, index).value == '\n' {
                index = index + usize(1)
            }
        } else {
            output.push(decoded.value)
            index = index + decoded.width
        }
    }
}

private def contentFingerprint(text : string) : usize {
    val data : Ptr[byte] = stringData(text)
    var value : usize = usize(216613626)
    var index : usize = usize(0)
    while index < stringLength(text) {
        value = (value << usize(5)) ^ (value >> usize(2)) ^
        numericCast[usize](int(data.load(index)) & 255)
        index = index + usize(1)
    }
    return value
}

class BufferSnapshot(
    private val characters : Array[char],
    private val cursorPosition : usize,
    private val documentRevision : usize
) {
    borrow def size() : usize {
        return characters.size()
    }

    borrow def get(index : usize) : char {
        return characters.get(index)
    }

    borrow def cursor() : usize {
        return cursorPosition
    }

    borrow def revision() : usize {
        return documentRevision
    }

    borrow def copy() : BufferSnapshot {
        val copied : Array[char] = new Array[char](characters.size())
        var index : usize = usize(0)
        while index < characters.size() {
            copied.push(characters.get(index))
            index = index + usize(1)
        }
        return new BufferSnapshot(
            move copied,
            cursorPosition,
            documentRevision
        )
    }

    destructor {
        delete characters
    }
}

class BufferArchive(
    private val characters : Array[char],
    private val undoStates : Array[BufferSnapshot],
    private val redoStates : Array[BufferSnapshot],
    private val cursorPosition : usize,
    private val currentRevision : usize,
    private val savedRevision : usize,
    private val nextRevision : usize,
    private val selectionAnchor : usize,
    private val selecting : bool,
    private val diskSize : usize,
    private val diskFingerprint : usize,
    private val tracksDiskContent : bool
) {
    borrow def appendCharacters(output : Array[char]) : Unit {
        var index : usize = usize(0)
        while index < characters.size() {
            output.push(characters.get(index))
            index = index + usize(1)
        }
    }

    borrow def cursor() : usize { return cursorPosition }
    borrow def revision() : usize { return currentRevision }
    borrow def saved() : usize { return savedRevision }
    borrow def next() : usize { return nextRevision }
    borrow def anchor() : usize { return selectionAnchor }
    borrow def hasSelection() : bool { return selecting }
    borrow def trackedDiskSize() : usize { return diskSize }
    borrow def trackedDiskFingerprint() : usize { return diskFingerprint }
    borrow def hasTrackedDiskContent() : bool { return tracksDiskContent }

    def moveUndoStates(output : Array[BufferSnapshot]) : Unit {
        while !undoStates.isEmpty() {
            output.push(undoStates.remove(usize(0)))
        }
    }

    def moveRedoStates(output : Array[BufferSnapshot]) : Unit {
        while !redoStates.isEmpty() {
            output.push(redoStates.remove(usize(0)))
        }
    }

    destructor {
        delete characters
        delete undoStates
        delete redoStates
    }
}

private def copySnapshotArray(
    source : Array[BufferSnapshot],
    output : Array[BufferSnapshot]
) : Unit {
    val retained : Array[BufferSnapshot] = new Array[BufferSnapshot](source.size())
    defer delete retained
    while !source.isEmpty() {
        val state : BufferSnapshot = source.remove(usize(0))
        output.push(state.copy())
        retained.push(move state)
    }
    while !retained.isEmpty() {
        source.push(retained.remove(usize(0)))
    }
}

private def trimSnapshotArray(states : Array[BufferSnapshot]) : Unit {
    var characters : usize = usize(0)
    val retained : Array[BufferSnapshot] = new Array[BufferSnapshot](states.size())
    defer delete retained
    while !states.isEmpty() {
        val state : BufferSnapshot = states.remove(usize(0))
        characters = characters + state.size()
        retained.push(move state)
    }
    while !retained.isEmpty() {
        states.push(retained.remove(usize(0)))
    }
    while characters > historyCharacterLimit && states.size() > usize(1) {
        val oldest : BufferSnapshot = states.remove(usize(0))
        characters = characters - oldest.size()
        delete oldest
    }
}

def emptyBufferArchive() : BufferArchive {
    return new BufferArchive(
        new Array[char](usize(0)),
        new Array[BufferSnapshot](usize(0)),
        new Array[BufferSnapshot](usize(0)),
        usize(0),
        usize(0),
        usize(0),
        usize(1),
        usize(0),
        false,
        usize(0),
        usize(0),
        false
    )
}

class EditorBuffer(
    private val characters : Array[char],
    private val undoStates : Array[BufferSnapshot],
    private val redoStates : Array[BufferSnapshot]
) {
    private var cursorPosition : usize = usize(0)
    private var currentRevision : usize = usize(0)
    private var savedRevision : usize = usize(0)
    private var nextRevision : usize = usize(1)
    private var selectionAnchor : usize = usize(0)
    private var selecting : bool = false
    private var diskSize : usize = usize(0)
    private var diskFingerprint : usize = usize(0)
    private var tracksDiskContent : bool = false

    private def copySnapshots(
        source : Array[BufferSnapshot]
    ) : Array[BufferSnapshot] {
        val copied : Array[BufferSnapshot] = new Array[BufferSnapshot](source.size())
        copySnapshotArray(source, copied)
        return move copied
    }

    def archive() : BufferArchive {
        val copiedCharacters : Array[char] = new Array[char](characters.size())
        var index : usize = usize(0)
        while index < characters.size() {
            copiedCharacters.push(characters.get(index))
            index = index + usize(1)
        }
        return new BufferArchive(
            move copiedCharacters,
            this.copySnapshots(undoStates),
            this.copySnapshots(redoStates),
            cursorPosition,
            currentRevision,
            savedRevision,
            nextRevision,
            selectionAnchor,
            selecting,
            diskSize,
            diskFingerprint,
            tracksDiskContent
        )
    }

    def restoreArchive(archive : BufferArchive) : Unit {
        characters.clear()
        archive.appendCharacters(characters)
        undoStates.clear()
        archive.moveUndoStates(undoStates)
        redoStates.clear()
        archive.moveRedoStates(redoStates)
        cursorPosition = archive.cursor()
        currentRevision = archive.revision()
        savedRevision = archive.saved()
        nextRevision = archive.next()
        selectionAnchor = archive.anchor()
        selecting = archive.hasSelection()
        diskSize = archive.trackedDiskSize()
        diskFingerprint = archive.trackedDiskFingerprint()
        tracksDiskContent = archive.hasTrackedDiskContent()
        delete archive
    }

    borrow def hasSelection() : bool {
        return selecting && selectionAnchor != cursorPosition
    }

    borrow def selectionStart() : usize {
        return if selectionAnchor < cursorPosition {
            selectionAnchor
        } else {
            cursorPosition
        }
    }

    borrow def selectionEnd() : usize {
        return if selectionAnchor > cursorPosition {
            selectionAnchor
        } else {
            cursorPosition
        }
    }

    def beginSelection() : Unit {
        if !selecting {
            selectionAnchor = cursorPosition
            selecting = true
        }
    }

    def clearSelection() : Unit {
        selectionAnchor = cursorPosition
        selecting = false
    }

    private def removeSelection() : bool {
        if !this.hasSelection() { return false }
        this.eraseRange(this.selectionStart(), this.selectionEnd())
        this.clearSelection()
        return true
    }

    private borrow def snapshot() : BufferSnapshot {
        val copied : Array[char] = new Array[char](characters.size())
        var index : usize = usize(0)
        while index < characters.size() {
            copied.push(characters.get(index))
            index = index + usize(1)
        }
        return new BufferSnapshot(move copied, cursorPosition, currentRevision)
    }

    private def restore(state : BufferSnapshot) : Unit {
        characters.clear()
        var index : usize = usize(0)
        while index < state.size() {
            characters.push(state.get(index))
            index = index + usize(1)
        }
        cursorPosition = state.cursor()
        currentRevision = state.revision()
        this.clearSelection()
        delete state
    }

    private def rememberChange() : Unit {
        val state : BufferSnapshot = this.snapshot()
        undoStates.push(move state)
        if undoStates.size() > historyLimit {
            val oldest : BufferSnapshot = undoStates.remove(usize(0))
            delete oldest
        }
        trimSnapshotArray(undoStates)
        redoStates.clear()
        currentRevision = nextRevision
        nextRevision = nextRevision + usize(1)
    }

    private def eraseRange(start : usize, end : usize) : Unit {
        val removed : usize = end - start
        var source : usize = end
        while source < characters.size() {
            characters.set(start + source - end, characters.get(source))
            source = source + usize(1)
        }
        var remaining : usize = removed
        while remaining > usize(0) {
            val _discarded : char = characters.pop()
            remaining = remaining - usize(1)
        }
        cursorPosition = start
    }

    private def insertCharactersAt(
        position : usize,
        borrow inserted : Array[char]
    ) : Unit {
        if inserted.isEmpty() { return }
        val previousSize : usize = characters.size()
        characters.reserve(previousSize + inserted.size())
        var appended : usize = usize(0)
        while appended < inserted.size() {
            characters.push('\0')
            appended = appended + usize(1)
        }
        var source : usize = previousSize
        while source > position {
            source = source - usize(1)
            characters.set(source + inserted.size(), characters.get(source))
        }
        var index : usize = usize(0)
        while index < inserted.size() {
            characters.set(position + index, inserted.get(index))
            index = index + usize(1)
        }
    }

    private def insertAt(position : usize, value : char) : Unit {
        characters.push('\0')
        var index : usize = characters.size() - usize(1)
        while index > position {
            characters.set(index, characters.get(index - usize(1)))
            index = index - usize(1)
        }
        characters.set(position, value)
    }

    private def insertLineAt(position : usize, line : Array[char]) : Unit {
        val inserted : Array[char] = new Array[char](line.size() + usize(1))
        defer delete inserted
        var index : usize = usize(0)
        while index < line.size() {
            inserted.push(line.get(index))
            index = index + usize(1)
        }
        inserted.push('\n')
        this.insertCharactersAt(position, inserted)
    }

    borrow def size() : usize {
        return characters.size()
    }

    borrow def cursor() : usize {
        return cursorPosition
    }

    borrow def isModified() : bool {
        return currentRevision != savedRevision
    }

    borrow def revision() : usize { return currentRevision }

    def markSaved() : Unit {
        savedRevision = currentRevision
    }

    def trackDiskContent(text : string) : Unit {
        diskSize = stringLength(text)
        diskFingerprint = contentFingerprint(text)
        tracksDiskContent = true
    }

    borrow def diskContentMatches(text : string) : bool {
        return tracksDiskContent && diskSize == stringLength(text) &&
        diskFingerprint == contentFingerprint(text)
    }

    borrow def hasDiskContent() : bool { return tracksDiskContent }

    def undo() : bool {
        if undoStates.isEmpty() {
            return false
        }
        val current : BufferSnapshot = this.snapshot()
        redoStates.push(move current)
        trimSnapshotArray(redoStates)
        val previous : BufferSnapshot = undoStates.remove(
            undoStates.size() - usize(1)
        )
        this.restore(move previous)
        return true
    }

    def redo() : bool {
        if redoStates.isEmpty() {
            return false
        }
        val current : BufferSnapshot = this.snapshot()
        undoStates.push(move current)
        trimSnapshotArray(undoStates)
        val next : BufferSnapshot = redoStates.remove(
            redoStates.size() - usize(1)
        )
        this.restore(move next)
        return true
    }

    def clear() : Unit {
        characters.clear()
        undoStates.clear()
        redoStates.clear()
        cursorPosition = usize(0)
        currentRevision = usize(0)
        savedRevision = usize(0)
        nextRevision = usize(1)
        tracksDiskContent = false
        this.clearSelection()
    }

    def load(text : string) : Unit {
        characters.clear()
        decodeUtf8(text, characters)
        undoStates.clear()
        redoStates.clear()
        cursorPosition = characters.size()
        currentRevision = usize(0)
        savedRevision = usize(0)
        nextRevision = usize(1)
        tracksDiskContent = false
        this.clearSelection()
    }

    def restoreDocument(text : string, position : usize, wasModified : bool) : Unit {
        this.load(text)
        cursorPosition = if position < characters.size() {
            position
        } else {
            characters.size()
        }
        if wasModified {
            currentRevision = usize(1)
            savedRevision = usize(0)
            nextRevision = usize(2)
        }
    }

    def insert(value : char) : Unit {
        this.rememberChange()
        this.removeSelection()
        this.insertAt(cursorPosition, value)
        cursorPosition = cursorPosition + usize(1)
    }

    private borrow def matchingClosing(value : char) : char {
        if value == char(40) { return char(41) }
        if value == char(91) { return char(93) }
        if value == char(123) { return char(125) }
        if value == char(34) { return char(34) }
        if value == char(39) { return char(39) }
        return '\0'
    }

    private borrow def isAutomaticClosing(value : char) : bool {
        return value == char(41) || value == char(93) ||
        value == char(125) || value == char(34) || value == char(39)
    }

    def insertPaired(value : char) : Unit {
        if !this.hasSelection() && this.isAutomaticClosing(value) &&
        cursorPosition < characters.size() &&
        characters.get(cursorPosition) == value {
            cursorPosition = cursorPosition + usize(1)
            return
        }
        val closing : char = this.matchingClosing(value)
        if closing == '\0' {
            this.insert(value)
            return
        }
        this.rememberChange()
        this.removeSelection()
        this.insertAt(cursorPosition, value)
        this.insertAt(cursorPosition + usize(1), closing)
        cursorPosition = cursorPosition + usize(1)
    }

    def insertText(text : string) : Unit {
        if stringLength(text) == usize(0) {
            return
        }
        val decoded : Array[char] = new Array[char](stringLength(text))
        defer delete decoded
        decodeUtf8(text, decoded)
        this.rememberChange()
        this.removeSelection()
        this.insertCharactersAt(cursorPosition, decoded)
        cursorPosition = cursorPosition + decoded.size()
    }

    def insertSpaces(count : usize) : Unit {
        if count == usize(0) {
            return
        }
        this.rememberChange()
        this.removeSelection()
        val spaces : Array[char] = new Array[char](count)
        defer delete spaces
        var index : usize = usize(0)
        while index < count {
            spaces.push(' ')
            index = index + usize(1)
        }
        this.insertCharactersAt(cursorPosition, spaces)
        cursorPosition = cursorPosition + count
    }

    def insertIndentedNewline() : Unit {
        if this.hasSelection() {
            this.rememberChange()
            this.removeSelection()
            this.insertAt(cursorPosition, '\n')
            cursorPosition = cursorPosition + usize(1)
            return
        }
        val start : usize = this.lineStart(cursorPosition)
        var indentation : usize = usize(0)
        while start + indentation < cursorPosition &&
        (characters.get(start + indentation) == ' ' ||
            characters.get(start + indentation) == '\t') {
            indentation = indentation + usize(1)
        }
        val afterOpening : bool = cursorPosition > usize(0) &&
        characters.get(cursorPosition - usize(1)) == char(123)
        val beforeClosing : bool = cursorPosition < characters.size() &&
        characters.get(cursorPosition) == char(125)

        this.rememberChange()
        this.insertAt(cursorPosition, '\n')
        cursorPosition = cursorPosition + usize(1)
        var index : usize = usize(0)
        while index < indentation {
            this.insertAt(cursorPosition, characters.get(start + index))
            cursorPosition = cursorPosition + usize(1)
            index = index + usize(1)
        }
        if afterOpening {
            index = usize(0)
            while index < usize(4) {
                this.insertAt(cursorPosition, ' ')
                cursorPosition = cursorPosition + usize(1)
                index = index + usize(1)
            }
        }
        if afterOpening && beforeClosing {
            val contentCursor : usize = cursorPosition
            this.insertAt(contentCursor, '\n')
            index = usize(0)
            while index < indentation {
                this.insertAt(
                    contentCursor + usize(1) + index,
                    characters.get(start + index)
                )
                index = index + usize(1)
            }
            cursorPosition = contentCursor
        }
    }

    def backspace() : Unit {
        if this.hasSelection() {
            this.rememberChange()
            this.removeSelection()
            return
        }
        if cursorPosition == usize(0) {
            return
        }
        this.rememberChange()
        val opening : char = characters.get(cursorPosition - usize(1))
        val closing : char = this.matchingClosing(opening)
        if closing != '\0' && cursorPosition < characters.size() &&
        characters.get(cursorPosition) == closing {
            val _closingRemoved : char = characters.remove(cursorPosition)
        }
        val _removed : char = characters.remove(cursorPosition - usize(1))
        cursorPosition = cursorPosition - usize(1)
    }

    def deleteForward() : Unit {
        if this.hasSelection() {
            this.rememberChange()
            this.removeSelection()
            return
        }
        if cursorPosition >= characters.size() {
            return
        }
        this.rememberChange()
        val _removed : char = characters.remove(cursorPosition)
    }

    def moveLeft() : Unit {
        if cursorPosition > usize(0) {
            cursorPosition = cursorPosition - usize(1)
        }
    }

    def moveRight() : Unit {
        if cursorPosition < characters.size() {
            cursorPosition = cursorPosition + usize(1)
        }
    }

    def moveRightInLine() : Unit {
        if cursorPosition < characters.size() &&
        characters.get(cursorPosition) != '\n' {
            cursorPosition = cursorPosition + usize(1)
        }
    }

    def moveFileStart() : Unit {
        cursorPosition = usize(0)
    }

    def moveFileEnd() : Unit {
        cursorPosition = characters.size()
    }

    def moveHome() : Unit {
        while cursorPosition > usize(0) &&
        characters.get(cursorPosition - usize(1)) != '\n' {
            cursorPosition = cursorPosition - usize(1)
        }
    }

    def moveEnd() : Unit {
        while cursorPosition < characters.size() &&
        characters.get(cursorPosition) != '\n' {
            cursorPosition = cursorPosition + usize(1)
        }
    }

    def moveTo(line : usize, column : usize) : Unit {
        var currentLine : usize = usize(0)
        var start : usize = usize(0)
        while currentLine < line && start < characters.size() {
            while start < characters.size() && characters.get(start) != '\n' {
                start = start + usize(1)
            }
            if start < characters.size() {
                start = start + usize(1)
                currentLine = currentLine + usize(1)
            }
        }
        if currentLine < line {
            cursorPosition = characters.size()
            return
        }
        val end : usize = this.lineEnd(start)
        val requested : usize = start + column
        cursorPosition = if requested < end { requested } else { end }
    }

    borrow def line() : usize {
        var result : usize = usize(0)
        var index : usize = usize(0)
        while index < cursorPosition {
            if characters.get(index) == '\n' {
                result = result + usize(1)
            }
            index = index + usize(1)
        }
        return result
    }

    borrow def lineCount() : usize {
        var result : usize = usize(1)
        var index : usize = usize(0)
        while index < characters.size() {
            if characters.get(index) == '\n' {
                result = result + usize(1)
            }
            index = index + usize(1)
        }
        return result
    }

    borrow def maximumLineLength() : usize {
        var maximum : usize = usize(0)
        var current : usize = usize(0)
        var index : usize = usize(0)
        while index < characters.size() {
            if characters.get(index) == '\n' {
                if current > maximum {
                    maximum = current
                }
                current = usize(0)
            } else {
                current = current + usize(1)
            }
            index = index + usize(1)
        }
        return if current > maximum { current } else { maximum }
    }

    borrow def column() : usize {
        var result : usize = usize(0)
        var index : usize = cursorPosition
        while index > usize(0) && characters.get(index - usize(1)) != '\n' {
            result = result + usize(1)
            index = index - usize(1)
        }
        return result
    }

    borrow def utf16Column(line : usize, column : usize) : usize {
        var currentLine : usize = usize(0)
        var index : usize = usize(0)
        while currentLine < line && index < characters.size() {
            if characters.get(index) == '\n' {
                currentLine = currentLine + usize(1)
            }
            index = index + usize(1)
        }
        var consumed : usize = usize(0)
        var result : usize = usize(0)
        while consumed < column && index < characters.size() &&
        characters.get(index) != '\n' {
            val codepoint : int = int(characters.get(index))
            result = result + if codepoint > 65535 { usize(2) } else { usize(1) }
            consumed = consumed + usize(1)
            index = index + usize(1)
        }
        return result
    }

    private borrow def lineStart(position : usize) : usize {
        var result : usize = position
        while result > usize(0) && characters.get(result - usize(1)) != '\n' {
            result = result - usize(1)
        }
        return result
    }

    private borrow def lineEnd(start : usize) : usize {
        var result : usize = start
        while result < characters.size() && characters.get(result) != '\n' {
            result = result + usize(1)
        }
        return result
    }

    private borrow def isWhitespace(value : char) : bool {
        return value == ' ' || value == '\t' || value == '\n' || value == '\r'
    }

    private borrow def isWord(value : char) : bool {
        return value == '_' ||
        (value >= 'a' && value <= 'z') ||
        (value >= 'A' && value <= 'Z') ||
        (value >= '0' && value <= '9')
    }

    def moveWordForward() : Unit {
        if cursorPosition >= characters.size() {
            return
        }
        val startsOnWord : bool = this.isWord(characters.get(cursorPosition))
        while cursorPosition < characters.size() &&
        !this.isWhitespace(characters.get(cursorPosition)) &&
        this.isWord(characters.get(cursorPosition)) == startsOnWord {
            cursorPosition = cursorPosition + usize(1)
        }
        while cursorPosition < characters.size() &&
        this.isWhitespace(characters.get(cursorPosition)) {
            cursorPosition = cursorPosition + usize(1)
        }
    }

    def moveWordBackward() : Unit {
        if cursorPosition == usize(0) {
            return
        }
        cursorPosition = cursorPosition - usize(1)
        while cursorPosition > usize(0) &&
        this.isWhitespace(characters.get(cursorPosition)) {
            cursorPosition = cursorPosition - usize(1)
        }
        val endsOnWord : bool = this.isWord(characters.get(cursorPosition))
        while cursorPosition > usize(0) &&
        !this.isWhitespace(characters.get(cursorPosition - usize(1))) &&
        this.isWord(characters.get(cursorPosition - usize(1))) == endsOnWord {
            cursorPosition = cursorPosition - usize(1)
        }
    }

    def deleteCharacter() : Unit {
        if cursorPosition >= characters.size() ||
        characters.get(cursorPosition) == '\n' {
            return
        }
        this.deleteForward()
    }

    def deleteCurrentLine() : Unit {
        if characters.isEmpty() {
            return
        }
        var start : usize = this.lineStart(cursorPosition)
        var end : usize = this.lineEnd(start)
        if end < characters.size() {
            end = end + usize(1)
        } else if start > usize(0) {
            start = start - usize(1)
        }
        this.rememberChange()
        this.eraseRange(start, end)
    }

    borrow def copyCurrentLine(output : Array[char]) : bool {
        output.clear()
        if characters.isEmpty() {
            return false
        }
        val start : usize = this.lineStart(cursorPosition)
        val end : usize = this.lineEnd(start)
        var index : usize = start
        while index < end {
            output.push(characters.get(index))
            index = index + usize(1)
        }
        return true
    }

    def pasteLineBelow(line : Array[char]) : Unit {
        if characters.isEmpty() {
            this.rememberChange()
            this.insertLineAt(usize(0), line)
            val _newline : char = characters.remove(characters.size() - usize(1))
            cursorPosition = usize(0)
            return
        }
        val start : usize = this.lineStart(cursorPosition)
        val end : usize = this.lineEnd(start)
        this.rememberChange()
        if end < characters.size() {
            val insertion : usize = end + usize(1)
            this.insertLineAt(insertion, line)
            cursorPosition = insertion
        } else {
            this.insertAt(end, '\n')
            val insertion : usize = end + usize(1)
            var index : usize = usize(0)
            while index < line.size() {
                this.insertAt(insertion + index, line.get(index))
                index = index + usize(1)
            }
            cursorPosition = insertion
        }
    }

    def pasteLineAbove(line : Array[char]) : Unit {
        val insertion : usize = this.lineStart(cursorPosition)
        this.rememberChange()
        this.insertLineAt(insertion, line)
        cursorPosition = insertion
    }

    def openLineBelow() : Unit {
        this.moveEnd()
        this.insertIndentedNewline()
    }

    def openLineAbove() : Unit {
        this.moveHome()
        this.insert('\n')
        this.moveLeft()
    }

    def moveUp() : Unit {
        val currentStart : usize = this.lineStart(cursorPosition)
        if currentStart == usize(0) {
            return
        }
        val requestedColumn : usize = cursorPosition - currentStart
        val previousEnd : usize = currentStart - usize(1)
        val previousStart : usize = this.lineStart(previousEnd)
        val previousLength : usize = previousEnd - previousStart
        cursorPosition = previousStart +
        if requestedColumn < previousLength { requestedColumn } else { previousLength }
    }

    def moveDown() : Unit {
        val currentStart : usize = this.lineStart(cursorPosition)
        val currentEnd : usize = this.lineEnd(currentStart)
        if currentEnd >= characters.size() {
            return
        }
        val requestedColumn : usize = cursorPosition - currentStart
        val nextStart : usize = currentEnd + usize(1)
        val nextEnd : usize = this.lineEnd(nextStart)
        val nextLength : usize = nextEnd - nextStart
        cursorPosition = nextStart +
        if requestedColumn < nextLength { requestedColumn } else { nextLength }
    }

    borrow def appendText(output : TextBuilder) : Unit {
        var index : usize = usize(0)
        while index < characters.size() {
            output.appendChar(characters.get(index))
            index = index + usize(1)
        }
    }

    borrow def appendCharacters(output : Array[char]) : Unit {
        output.clear()
        var index : usize = usize(0)
        while index < characters.size() {
            output.push(characters.get(index))
            index = index + usize(1)
        }
    }

    borrow def findMatches(query : string, output : Array[usize]) : usize {
        output.clear()
        val requested : Array[char] = new Array[char](stringLength(query))
        defer delete requested
        decodeUtf8(query, requested)
        if requested.size() == usize(0) { return usize(0) }
        var start : usize = usize(0)
        while start + requested.size() <= characters.size() {
            var index : usize = usize(0)
            var matches : bool = true
            while matches && index < requested.size() {
                if characters.get(start + index) != requested.get(index) {
                    matches = false
                }
                index = index + usize(1)
            }
            if matches { output.push(start) }
            start = start + usize(1)
        }
        return requested.size()
    }

    def moveToOffset(position : usize) : Unit {
        cursorPosition = if position < characters.size() {
            position
        } else {
            characters.size()
        }
    }

    borrow def lineLength(requestedLine : usize) : usize {
        var line : usize = usize(0)
        var start : usize = usize(0)
        while line < requestedLine && start < characters.size() {
            if characters.get(start) == '\n' { line = line + usize(1) }
            start = start + usize(1)
        }
        if line != requestedLine { return usize(0) }
        return this.lineEnd(start) - start
    }

    borrow def appendSelection(output : TextBuilder) : bool {
        output.clear()
        if !this.hasSelection() { return false }
        var index : usize = this.selectionStart()
        while index < this.selectionEnd() {
            output.appendChar(characters.get(index))
            index = index + usize(1)
        }
        return true
    }

    def deleteSelection() : bool {
        if !this.hasSelection() { return false }
        this.rememberChange()
        return this.removeSelection()
    }

    borrow def lineAtOffset(position : usize) : usize {
        var line : usize = usize(0)
        var index : usize = usize(0)
        val end : usize = if position < characters.size() {
            position
        } else {
            characters.size()
        }
        while index < end {
            if characters.get(index) == '\n' { line = line + usize(1) }
            index = index + usize(1)
        }
        return line
    }

    borrow def columnAtOffset(position : usize) : usize {
        var column : usize = usize(0)
        var index : usize = if position < characters.size() {
            position
        } else {
            characters.size()
        }
        while index > usize(0) && characters.get(index - usize(1)) != '\n' {
            column = column + usize(1)
            index = index - usize(1)
        }
        return column
    }

    borrow def appendVisibleText(
        output : TextBuilder,
        firstLine : usize,
        maximumLines : usize
    ) : Unit {
        var index : usize = usize(0)
        var lineIndex : usize = usize(0)
        while index < characters.size() && lineIndex < firstLine {
            if characters.get(index) == '\n' {
                lineIndex = lineIndex + usize(1)
            }
            index = index + usize(1)
        }

        var emittedLines : usize = usize(0)
        while index < characters.size() && emittedLines < maximumLines {
            val value : char = characters.get(index)
            output.appendChar(value)
            if value == '\n' {
                emittedLines = emittedLines + usize(1)
            }
            index = index + usize(1)
        }
    }

    borrow def appendVisibleCharacters(
        output : Array[char],
        firstLine : usize,
        maximumLines : usize
    ) : Unit {
        output.clear()
        var index : usize = usize(0)
        var lineIndex : usize = usize(0)
        while index < characters.size() && lineIndex < firstLine {
            if characters.get(index) == '\n' {
                lineIndex = lineIndex + usize(1)
            }
            index = index + usize(1)
        }

        var emittedLines : usize = usize(0)
        while index < characters.size() && emittedLines < maximumLines {
            val value : char = characters.get(index)
            output.push(value)
            if value == '\n' {
                emittedLines = emittedLines + usize(1)
            }
            index = index + usize(1)
        }
    }

    destructor {
        delete characters
        delete undoStates
        delete redoStates
    }
}

def emptyBuffer() : EditorBuffer {
    return new EditorBuffer(
        new Array[char](usize(256)),
        new Array[BufferSnapshot](usize(32)),
        new Array[BufferSnapshot](usize(32))
    )
}
