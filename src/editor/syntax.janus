/// Coloration syntaxique légère pour le code Janus.
module editor.syntax

import std.array
import std.text

enum SyntaxKind derives Copy, Equality, Debug {
    Plain,
    Namespace,
    Type,
    Class,
    Enum,
    Interface,
    Function,
    Method,
    Variable,
    Parameter,
    Property,
    Keyword,
    String,
    Number,
    Comment,
    Operator
}

struct SyntaxSpan(
    val start : usize,
    val length : usize,
    val kind : SyntaxKind
) derives Copy {}

/// Token sémantique LSP, positionné en unités UTF-16 comme dans VS Code.
struct SemanticToken(
    val line : usize,
    val column : usize,
    val length : usize,
    val kind : SyntaxKind
) derives Copy, Equality, Debug {}

def semanticSyntaxKind(tokenType : usize) : SyntaxKind {
    if tokenType == usize(0) { return SyntaxKind.Namespace }
    if tokenType == usize(1) { return SyntaxKind.Type }
    if tokenType == usize(2) { return SyntaxKind.Class }
    if tokenType == usize(3) { return SyntaxKind.Enum }
    if tokenType == usize(4) { return SyntaxKind.Interface }
    if tokenType == usize(5) { return SyntaxKind.Function }
    if tokenType == usize(6) { return SyntaxKind.Method }
    if tokenType == usize(7) { return SyntaxKind.Variable }
    if tokenType == usize(8) { return SyntaxKind.Parameter }
    if tokenType == usize(9) { return SyntaxKind.Property }
    if tokenType == usize(10) { return SyntaxKind.Keyword }
    if tokenType == usize(11) { return SyntaxKind.String }
    if tokenType == usize(12) { return SyntaxKind.Number }
    if tokenType == usize(13) { return SyntaxKind.Operator }
    return SyntaxKind.Plain
}

pure def isIdentifierStart(value : char) : bool =>
    value == '_' || (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z')

pure def isIdentifierPart(value : char) : bool =>
    isIdentifierStart(value) || (value >= '0' && value <= '9')

pure def isOperator(value : char) : bool =>
    value == '+' || value == '-' || value == '*' || value == '/' || value == '%' || value == '=' || value == '!' || value == '<' || value == '>' || value == '&' || value == '|' || value == '^' || value == '~' || value == '?' || value == ':' || value == '.'

def identifierEquals(
    borrow source : Array[char],
    start : usize,
    end : usize,
    expected : string
) : bool {
    if end - start != stringLength(expected) {
        return false
    }
    val bytes : Ptr[byte] = stringData(expected)
    var index : usize = usize(0)
    while index < stringLength(expected) {
        if source[start + index] != char(bytes.load(index)) {
            return false
        }
        index += usize(1)
    }
    return true
}

def isKeyword(borrow source : Array[char], start : usize, end : usize) : bool {
    return identifierEquals(source, start, end, "module") ||
    identifierEquals(source, start, end, "import") ||
    identifierEquals(source, start, end, "as") ||
    identifierEquals(source, start, end, "extern") ||
    identifierEquals(source, start, end, "pure") ||
    identifierEquals(source, start, end, "tailrec") ||
    identifierEquals(source, start, end, "def") ||
    identifierEquals(source, start, end, "trait") ||
    identifierEquals(source, start, end, "extends") ||
    identifierEquals(source, start, end, "extend") ||
    identifierEquals(source, start, end, "enum") ||
    identifierEquals(source, start, end, "class") ||
    identifierEquals(source, start, end, "struct") ||
    identifierEquals(source, start, end, "derives") ||
    identifierEquals(source, start, end, "new") ||
    identifierEquals(source, start, end, "move") ||
    identifierEquals(source, start, end, "consume") ||
    identifierEquals(source, start, end, "borrow") ||
    identifierEquals(source, start, end, "scoped") ||
    identifierEquals(source, start, end, "defer") ||
    identifierEquals(source, start, end, "delete") ||
    identifierEquals(source, start, end, "destructor") ||
    identifierEquals(source, start, end, "private") ||
    identifierEquals(source, start, end, "internal") ||
    identifierEquals(source, start, end, "if") ||
    identifierEquals(source, start, end, "else") ||
    identifierEquals(source, start, end, "match") ||
    identifierEquals(source, start, end, "for") ||
    identifierEquals(source, start, end, "in") ||
    identifierEquals(source, start, end, "while") ||
    identifierEquals(source, start, end, "break") ||
    identifierEquals(source, start, end, "continue") ||
    identifierEquals(source, start, end, "return") ||
    identifierEquals(source, start, end, "const") ||
    identifierEquals(source, start, end, "staticAssert") ||
    identifierEquals(source, start, end, "val") ||
    identifierEquals(source, start, end, "var") ||
    identifierEquals(source, start, end, "true") ||
    identifierEquals(source, start, end, "false")
}

def isBuiltinType(borrow source : Array[char], start : usize, end : usize) : bool {
    return identifierEquals(source, start, end, "Unit") ||
    identifierEquals(source, start, end, "bool") ||
    identifierEquals(source, start, end, "byte") ||
    identifierEquals(source, start, end, "ubyte") ||
    identifierEquals(source, start, end, "char") ||
    identifierEquals(source, start, end, "short") ||
    identifierEquals(source, start, end, "ushort") ||
    identifierEquals(source, start, end, "int") ||
    identifierEquals(source, start, end, "uint") ||
    identifierEquals(source, start, end, "long") ||
    identifierEquals(source, start, end, "ulong") ||
    identifierEquals(source, start, end, "usize") ||
    identifierEquals(source, start, end, "float") ||
    identifierEquals(source, start, end, "double") ||
    identifierEquals(source, start, end, "string") ||
    identifierEquals(source, start, end, "Ptr") ||
    identifierEquals(source, start, end, "Array")
}

def previousNonWhitespace(borrow source : Array[char], start : usize) : usize {
    var index : usize = start
    while index > usize(0) {
        index -= usize(1)
        val value : char = source[index]
        if value != ' ' && value != '\t' && value != '\r' {
            return index
        }
    }
    return usize(-1)
}

def nextNonWhitespace(borrow source : Array[char], end : usize) : usize {
    var index : usize = end
    while index < source.size() {
        val value : char = source[index]
        if value != ' ' && value != '\t' && value != '\r' {
            return index
        }
        index += usize(1)
    }
    return usize(-1)
}

def previousIdentifierEquals(
    borrow source : Array[char],
    start : usize,
    expected : string
) : bool {
    val previous : usize = previousNonWhitespace(source, start)
    if previous == usize(-1) || !isIdentifierPart(source[previous]) {
        return false
    }
    var wordStart : usize = previous
    while wordStart > usize(0) && isIdentifierPart(
        source[wordStart - usize(1)]
    ) {
        wordStart -= usize(1)
    }
    return identifierEquals(source, wordStart, previous + usize(1), expected)
}

def lineStartsWith(
    borrow source : Array[char],
    start : usize,
    expected : string
) : bool {
    var lineStart : usize = start
    while lineStart > usize(0) && source[lineStart - usize(1)] != '\n' {
        lineStart -= usize(1)
    }
    while lineStart < start &&
    (source[lineStart] == ' ' || source[lineStart] == '\t') {
        lineStart += usize(1)
    }
    val end : usize = lineStart + stringLength(expected)
    return end <= start && identifierEquals(source, lineStart, end, expected) &&
    (end == source.size() || !isIdentifierPart(source[end]))
}

def isNamespacePosition(borrow source : Array[char], start : usize) : bool {
    return lineStartsWith(source, start, "module") ||
    lineStartsWith(source, start, "import")
}

def followsDot(borrow source : Array[char], start : usize) : bool {
    val previous : usize = previousNonWhitespace(source, start)
    return previous != usize(-1) && source[previous] == '.'
}

def isCallablePosition(borrow source : Array[char], end : usize) : bool {
    val next : usize = nextNonWhitespace(source, end)
    return next != usize(-1) && source[next] == '('
}

def identifierKind(
    borrow source : Array[char],
    start : usize,
    end : usize
) : SyntaxKind {
    if isKeyword(source, start, end) {
        return SyntaxKind.Keyword
    }
    if previousIdentifierEquals(source, start, "class") {
        return SyntaxKind.Class
    }
    if previousIdentifierEquals(source, start, "enum") {
        return SyntaxKind.Enum
    }
    if previousIdentifierEquals(source, start, "trait") {
        return SyntaxKind.Interface
    }
    if isNamespacePosition(source, start) {
        return SyntaxKind.Namespace
    }
    if isBuiltinType(source, start, end) ||
    (source[start] >= 'A' && source[start] <= 'Z') {
        return SyntaxKind.Type
    }
    if isCallablePosition(source, end) {
        return if followsDot(source, start) {
            SyntaxKind.Method
        } else {
            SyntaxKind.Function
        }
    }
    if followsDot(source, start) { return SyntaxKind.Property }
    if previousIdentifierEquals(source, start, "val") ||
    previousIdentifierEquals(source, start, "var") {
        return SyntaxKind.Variable
    }
    return SyntaxKind.Plain
}

def appendSpan(
    borrow var output : Array[SyntaxSpan],
    start : usize,
    end : usize,
    kind : SyntaxKind
) : Unit {
    if end > start {
        output.push(new SyntaxSpan(start, end - start, kind))
    }
}

/// Classe chaque portion du texte visible sans modifier son contenu.
def highlight(borrow source : Array[char], borrow var output : Array[SyntaxSpan]) : Unit {
    output.clear()
    var index : usize = usize(0)
    while index < source.size() {
        val start : usize = index
        val value : char = source[index]

        if value == '/' && index + usize(1) < source.size() &&
        source[index + usize(1)] == '/' {
            index += usize(2)
            while index < source.size() && source[index] != '\n' {
                index += usize(1)
            }
            appendSpan(output, start, index, SyntaxKind.Comment)
        } else if value == '"' || value == '\'' {
            val delimiter : char = value
            var escaped : bool = false
            index += usize(1)
            while index < source.size() && source[index] != '\n' {
                val current : char = source[index]
                index += usize(1)
                if !escaped && current == delimiter {
                    break
                }
                if !escaped && current == '\\' {
                    escaped = true
                } else {
                    escaped = false
                }
            }
            appendSpan(
                output,
                start,
                index,
                SyntaxKind.String
            )
        } else if value >= '0' && value <= '9' {
            index += usize(1)
            while index < source.size() &&
            (isIdentifierPart(source[index]) || source[index] == '.') {
                index += usize(1)
            }
            appendSpan(output, start, index, SyntaxKind.Number)
        } else if isIdentifierStart(value) {
            index += usize(1)
            while index < source.size() && isIdentifierPart(source[index]) {
                index += usize(1)
            }
            appendSpan(output, start, index, identifierKind(source, start, index))
        } else if isOperator(value) {
            index += usize(1)
            while index < source.size() && isOperator(source[index]) {
                index += usize(1)
            }
            appendSpan(output, start, index, SyntaxKind.Operator)
        } else {
            index += usize(1)
            appendSpan(output, start, index, SyntaxKind.Plain)
        }
    }
}

/// Retourne le style d'un caractère, principalement utile aux tests et au rendu.
def syntaxKindAt(borrow var spans : Array[SyntaxSpan], index : usize) : SyntaxKind {
    var spanIndex : usize = usize(0)
    while spanIndex < spans.size() {
        val span : SyntaxSpan = spans[spanIndex]
        if index >= span.start && index < span.start + span.length {
            return span.kind
        }
        spanIndex += usize(1)
    }
    return SyntaxKind.Plain
}
