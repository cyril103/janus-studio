import editor.buffer
import editor.completion
import editor.explorer
import editor.path_prompt
import editor.search
import editor.syntax
import editor.vim
import studio.files
import studio.input
import studio.tabs
import studio.view
import tooling.compiler
import tooling.diagnostics
import tooling.lsp
import std.array
import std.graphics
import std.text
import std.wall_time

def main() : int {
    val projectRoot : TextBuilder = new TextBuilder()
    defer delete projectRoot
    if !captureProjectRoot(projectRoot) {
        projectRoot.append(".")
    }
    val explorer : ProjectExplorer = projectExplorer(projectRoot.view())
    defer delete explorer
    val explorerLabel : TextBuilder = new TextBuilder()
    defer delete explorerLabel
    val tabLabel : TextBuilder = new TextBuilder()
    defer delete tabLabel
    val explorerPath : TextBuilder = new TextBuilder()
    defer delete explorerPath
    val activePath : TextBuilder = new TextBuilder()
    defer delete activePath
    val promptedPath : TextBuilder = new TextBuilder()
    defer delete promptedPath
    val startupPath : string = selectedPath()
    if startupPath != "" {
        val _capturedStartupPath : bool = captureDocumentPath(
        startupPath,
        activePath
        )
    }
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    val status : TextBuilder = new TextBuilder()
    defer delete status
    val visibleCharacters : Array[char] = new Array[char](usize(2048))
    defer delete visibleCharacters
    val syntaxSpans : Array[SyntaxSpan] = new Array[SyntaxSpan](usize(512))
    defer delete syntaxSpans
    val glyph : TextBuilder = new TextBuilder()
    defer delete glyph
    val diagnostics : EditorDiagnostics = editorDiagnostics()
    defer delete diagnostics
    val diagnosticText : TextBuilder = new TextBuilder()
    defer delete diagnosticText
    val search : SearchModel = searchModel()
    defer delete search
    val completion : CompletionModel = completionModel()
    defer delete completion
    val completionLabels : TextBuilder = new TextBuilder()
    defer delete completionLabels
    val completionError : TextBuilder = new TextBuilder()
    defer delete completionError
    val languageServer : LspClient = lspClient(
    projectRoot.view(),
    completionError
    )
    defer delete languageServer
    val completionText : TextBuilder = new TextBuilder()
    defer delete completionText
    val signatureText : TextBuilder = new TextBuilder()
    defer delete signatureText
    val pendingSignature : TextBuilder = new TextBuilder()
    defer delete pendingSignature
    val filePrompt : PathPrompt = pathPrompt()
    defer delete filePrompt
    val statusLine : TextBuilder = new TextBuilder()
    defer delete statusLine
    val toolOutput : TextBuilder = new TextBuilder()
    defer delete toolOutput
    val modeLine : TextBuilder = new TextBuilder()
    defer delete modeLine
    val commandLine : TextBuilder = new TextBuilder()
    defer delete commandLine
    val clipboard : TextBuilder = new TextBuilder()
    defer delete clipboard
    val controller : VimController = vimController()
    defer delete controller

    if activePath.view() == "" {
        buffer.clear()
        setStatus(status, "Aucun fichier ouvert.")
    } else {
        loadFile(activePath.view(), buffer, status)
    }
    val tabs : DocumentTabs = documentTabs(activePath.view(), buffer)
    defer delete tabs
    toolOutput.append("F5 lance `janus check` sur le fichier actif.")

    if !initWindow(1200, 760, "Janus Studio") {
        println("Impossible d'ouvrir la fenêtre Janus Studio.")
        return 1
    }
    defer closeWindow()
    setWindowResizable(true)
    disableExitKey()

    val fontCharacters : string =
    " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~•€ÀÂÇÉÈÊËÎÏÔÙÛÜŸàâçéèêëîïôùûüÿŒœ"
    val uiFont : Font = loadFontUtf8(
    "assets/fonts/DejaVuSans.ttf",
    32,
    fontCharacters
    )
    defer delete uiFont
    val codeFont : Font = loadFontUtf8(
    codeFontPath(),
    32,
    fontCharacters
    )
    defer delete codeFont
    if !uiFont.isValid() || !codeFont.isValid() {
        println("Impossible de charger les polices de Janus Studio.")
        return 1
    }
    val oneGlyph : Vector2 = codeFont.measure(
    "M",
    codeFontSize,
    codeFontSpacing
    )
    val glyphAdvance : float = codeFont.measure(
    "MM",
    codeFontSize,
    codeFontSpacing
    ).x - oneGlyph.x
    val lineAdvance : float = codeFont.measure(
    "M\nM",
    codeFontSize,
    codeFontSpacing
    ).y - oneGlyph.y
    val outputOneGlyph : Vector2 = codeFont.measure(
    "M",
    15.0f,
    codeFontSpacing
    )
    val outputGlyphAdvance : float = codeFont.measure(
    "MM",
    15.0f,
    codeFontSpacing
    ).x - outputOneGlyph.x
    val outputLineAdvance : float = codeFont.measure(
    "M\nM",
    15.0f,
    codeFontSpacing
    ).y - outputOneGlyph.y
    var maximumLines : usize = numericCast[usize](truncatingCast[int](
    numericCast[float](editorBottom - editorTop - 12) / lineAdvance
    ))
    setTargetFps(60)

    var firstLine : usize = usize(0)
    var firstColumn : usize = usize(0)
    var firstOutputLine : usize = usize(0)
    var firstOutputColumn : usize = usize(0)
    var firstDocumentTab : usize = usize(0)
    var firstExplorerEntry : usize = usize(0)
    var explorerHorizontalOffset : int = 0
    var lastExplorerClick : usize = usize(-1)
    var lastExplorerClickAt : usize = usize(0)
    var quitRequested : bool = false
    var fileMenuOpen : bool = false
    var editorScrollDetached : bool = false
    var horizontalScrollDetached : bool = false
    var paneResize : PaneResize = PaneResize.None
    var horizontalScrollbarDragging : bool = false
    var outputVerticalScrollbarDragging : bool = false
    var outputHorizontalScrollbarDragging : bool = false
    var explorerVerticalScrollbarDragging : bool = false
    var explorerHorizontalScrollbarDragging : bool = false
    var documentTabScrollbarDragging : bool = false
    var mouseSelecting : bool = false
    while !quitRequested {
        val nativeCloseRequested : bool = windowShouldClose()
        val control : bool = controlDown()
        val shift : bool = shiftDown()
        val cursorLineBeforeInput : usize = buffer.line()
        val cursorColumnBeforeInput : usize = buffer.column()
        val bufferSizeBeforeInput : usize = buffer.size()
        val editorModeBeforeInput : EditorMode = controller.mode()
        val leftMousePressed : bool = isMouseButtonPressed(MouseButton.Left)
        var visibleColumns : usize = visibleEditorColumns(glyphAdvance)
        var outputRows : usize = visibleOutputRows(outputLineAdvance)
        var outputColumns : usize = visibleOutputColumns(outputGlyphAdvance)
        var visibleExplorerRows : usize = explorerVisibleRows()
        var fileInputConsumed : bool = false
        var layoutMouseConsumed : bool = false
        if leftMousePressed && documentTabScrollbarHovered(tabs) {
            documentTabScrollbarDragging = true
        }
        if documentTabScrollbarDragging {
            if isMouseButtonDown(MouseButton.Left) {
                firstDocumentTab = documentTabScrollAtMouse(tabs)
                layoutMouseConsumed = true
            } else {
                documentTabScrollbarDragging = false
            }
        }
        if leftMousePressed {
            val clickedTab : usize = documentTabAtMouse(
            tabs,
            firstDocumentTab
            )
            if clickedTab != usize(-1) {
                val previouslySelected : usize = tabs.selected()
                val closingTab : bool = documentTabCloseHovered(
                tabs,
                firstDocumentTab,
                clickedTab
                )
                val changed : bool = if closingTab {
                    tabs.close(
                    clickedTab,
                    buffer,
                    activePath,
                    status,
                    firstLine,
                    firstColumn
                    )
                } else {
                    tabs.switchTo(
                    clickedTab,
                    buffer,
                    activePath,
                    firstLine,
                    firstColumn
                    )
                }
                if changed && (!closingTab ||
                clickedTab == previouslySelected) {
                    firstLine = tabs.firstLine()
                    firstColumn = tabs.firstColumn()
                    diagnostics.clear()
                    search.clear()
                    completion.dismiss()
                    signatureText.clear()
                    controller.escape()
                    firstDocumentTab = keepSelectedDocumentTabVisible(
                    tabs,
                    firstDocumentTab
                    )
                }
                fileInputConsumed = true
                layoutMouseConsumed = true
            }
        }
        if !documentTabScrollbarDragging && leftMousePressed &&
        outputVerticalScrollbarHovered(
        toolOutput.view(),
        outputRows
        ) {
            outputVerticalScrollbarDragging = true
        } else if leftMousePressed && outputHorizontalScrollbarHovered(
        toolOutput.view(),
        outputColumns
        ) {
            outputHorizontalScrollbarDragging = true
        }
        if leftMousePressed && !outputVerticalScrollbarDragging &&
        !outputHorizontalScrollbarDragging && explorerVerticalScrollbarHovered(
        explorer,
        visibleExplorerRows
        ) {
            explorerVerticalScrollbarDragging = true
        } else if leftMousePressed && !outputVerticalScrollbarDragging &&
        !outputHorizontalScrollbarDragging && explorerHorizontalScrollbarHovered(
        explorer,
        explorerLabel,
        uiFont
        ) {
            explorerHorizontalScrollbarDragging = true
        }
        if outputVerticalScrollbarDragging {
            if isMouseButtonDown(MouseButton.Left) {
                firstOutputLine = outputVerticalScrollAtMouse(
                toolOutput.view(),
                outputRows
                )
                layoutMouseConsumed = true
            } else {
                outputVerticalScrollbarDragging = false
            }
        }
        if outputHorizontalScrollbarDragging {
            if isMouseButtonDown(MouseButton.Left) {
                firstOutputColumn = outputHorizontalScrollAtMouse(
                toolOutput.view(),
                outputColumns
                )
                layoutMouseConsumed = true
            } else {
                outputHorizontalScrollbarDragging = false
            }
        }
        if explorerVerticalScrollbarDragging {
            if isMouseButtonDown(MouseButton.Left) {
                firstExplorerEntry = explorerVerticalScrollAtMouse(
                explorer,
                visibleExplorerRows
                )
                layoutMouseConsumed = true
            } else {
                explorerVerticalScrollbarDragging = false
            }
        }
        if explorerHorizontalScrollbarDragging {
            if isMouseButtonDown(MouseButton.Left) {
                explorerHorizontalOffset = explorerHorizontalScrollAtMouse(
                explorer,
                explorerLabel,
                uiFont
                )
                layoutMouseConsumed = true
            } else {
                explorerHorizontalScrollbarDragging = false
            }
        }
        if paneResize == PaneResize.None &&
        !outputVerticalScrollbarDragging &&
        !outputHorizontalScrollbarDragging &&
        !explorerVerticalScrollbarDragging &&
        !explorerHorizontalScrollbarDragging && leftMousePressed &&
        horizontalScrollbarHovered(buffer, visibleColumns) {
            horizontalScrollbarDragging = true
        }
        if horizontalScrollbarDragging {
            if isMouseButtonDown(MouseButton.Left) {
                firstColumn = horizontalScrollAtMouse(buffer, visibleColumns)
                horizontalScrollDetached = true
                completion.dismiss()
                layoutMouseConsumed = true
            } else {
                horizontalScrollbarDragging = false
            }
        }
        if paneResize == PaneResize.None && !horizontalScrollbarDragging &&
        !outputVerticalScrollbarDragging &&
        !outputHorizontalScrollbarDragging &&
        !explorerVerticalScrollbarDragging &&
        !explorerHorizontalScrollbarDragging &&
        leftMousePressed {
            if explorerSeparatorHovered() {
                paneResize = PaneResize.Explorer
            } else if outputSeparatorHovered() {
                paneResize = PaneResize.Output
            }
        }
        if paneResize != PaneResize.None {
            if isMouseButtonDown(MouseButton.Left) {
                if paneResize == PaneResize.Explorer {
                    resizeExplorerToMouse()
                } else {
                    resizeOutputToMouse()
                }
                layoutMouseConsumed = true
            } else {
                paneResize = PaneResize.None
            }
        }
        if explorerVerticalScrollbarDragging ||
        explorerVerticalScrollbarHovered(explorer, visibleExplorerRows) ||
        outputVerticalScrollbarDragging ||
        outputVerticalScrollbarHovered(toolOutput.view(), outputRows) {
            setMouseCursor(MouseCursor.ResizeNorthSouth)
        } else if documentTabScrollbarDragging ||
        documentTabScrollbarHovered(tabs) ||
        explorerHorizontalScrollbarDragging ||
        explorerHorizontalScrollbarHovered(explorer, explorerLabel, uiFont) ||
        outputHorizontalScrollbarDragging ||
        outputHorizontalScrollbarHovered(toolOutput.view(), outputColumns) ||
        horizontalScrollbarDragging ||
        horizontalScrollbarHovered(buffer, visibleColumns) {
            setMouseCursor(MouseCursor.ResizeEastWest)
        } else if paneResize == PaneResize.Explorer || explorerSeparatorHovered() {
            setMouseCursor(MouseCursor.ResizeEastWest)
        } else if paneResize == PaneResize.Output || outputSeparatorHovered() {
            setMouseCursor(MouseCursor.ResizeNorthSouth)
        } else {
            setMouseCursor(MouseCursor.Default)
        }
        maximumLines = numericCast[usize](truncatingCast[int](
        numericCast[float](editorBottom - editorTop - 12) / lineAdvance
        ))
        visibleColumns = visibleEditorColumns(glyphAdvance)
        outputRows = visibleOutputRows(outputLineAdvance)
        outputColumns = visibleOutputColumns(outputGlyphAdvance)
        visibleExplorerRows = explorerVisibleRows()
        val maximumFirstAfterResize : usize = maximumEditorFirst(
        buffer,
        maximumLines
        )
        if firstLine > maximumFirstAfterResize {
            firstLine = maximumFirstAfterResize
        }
        val maximumColumnAfterResize : usize = maximumEditorFirstColumn(
        buffer,
        visibleColumns
        )
        if firstColumn > maximumColumnAfterResize {
            firstColumn = maximumColumnAfterResize
        }
        val maximumOutputLineAfterResize : usize = maximumOutputFirstLine(
        toolOutput.view(),
        outputRows
        )
        if firstOutputLine > maximumOutputLineAfterResize {
            firstOutputLine = maximumOutputLineAfterResize
        }
        val maximumOutputColumnAfterResize : usize = maximumOutputFirstColumn(
        toolOutput.view(),
        outputColumns
        )
        if firstOutputColumn > maximumOutputColumnAfterResize {
            firstOutputColumn = maximumOutputColumnAfterResize
        }
        val maximumExplorerEntryAfterResize : usize = maximumExplorerFirst(
        explorer,
        visibleExplorerRows
        )
        if firstExplorerEntry > maximumExplorerEntryAfterResize {
            firstExplorerEntry = maximumExplorerEntryAfterResize
        }
        val maximumExplorerOffsetAfterResize : int =
        maximumExplorerHorizontalOffset(explorer, explorerLabel, uiFont)
        if explorerHorizontalOffset > maximumExplorerOffsetAfterResize {
            explorerHorizontalOffset = maximumExplorerOffsetAfterResize
        }
        val maximumFirstTabAfterResize : usize = maximumFirstDocumentTab(tabs)
        if firstDocumentTab > maximumFirstTabAfterResize {
            firstDocumentTab = maximumFirstTabAfterResize
        }
        if !filePrompt.isVisible() && !fileMenuOpen {
            if mouseInDocumentTabs() {
                firstDocumentTab = scrollDocumentTabs(
                tabs,
                firstDocumentTab
                )
            } else if mouseInExplorerPanel() && shift {
                explorerHorizontalOffset = scrollExplorerHorizontally(
                explorer,
                explorerLabel,
                uiFont,
                explorerHorizontalOffset
                )
            } else if mouseInExplorerPanel() {
                firstExplorerEntry = scrollExplorer(
                explorer,
                firstExplorerEntry,
                visibleExplorerRows
                )
            } else if mouseInOutputPanel() && shift {
                firstOutputColumn = scrollOutputHorizontally(
                toolOutput.view(),
                firstOutputColumn,
                outputColumns
                )
            } else if mouseInOutputPanel() {
                firstOutputLine = scrollOutputVertically(
                toolOutput.view(),
                firstOutputLine,
                outputRows
                )
            } else if shift {
                val scrolledEditorColumn : usize = scrollEditorHorizontally(
                buffer,
                firstColumn,
                visibleColumns
                )
                if scrolledEditorColumn != firstColumn {
                    firstColumn = scrolledEditorColumn
                    horizontalScrollDetached = true
                    completion.dismiss()
                }
            } else {
                val scrolledEditorFirst : usize = scrollEditor(
                buffer,
                firstLine,
                maximumLines
                )
                if scrolledEditorFirst != firstLine {
                    firstLine = scrolledEditorFirst
                    editorScrollDetached = true
                    completion.dismiss()
                }
            }
        }
        if !layoutMouseConsumed && !filePrompt.isVisible() && leftMousePressed &&
        pointInArea(fileMenuX, 0, fileMenuButtonWidth, editorTop) {
            fileMenuOpen = !fileMenuOpen
            fileInputConsumed = true
        } else if !layoutMouseConsumed && !filePrompt.isVisible() && fileMenuOpen &&
        leftMousePressed {
            if pointInArea(
            fileMenuX,
            fileMenuTop,
            fileMenuWidth,
            fileMenuRowHeight
            ) {
                filePrompt.begin(PathPromptAction.OpenFolder, projectRoot.view())
                completion.dismiss()
            } else if pointInArea(
            fileMenuX,
            fileMenuTop + fileMenuRowHeight,
            fileMenuWidth,
            fileMenuRowHeight
            ) && explorer.size() > usize(0) {
                explorer.close()
                projectRoot.clear()
                firstExplorerEntry = usize(0)
                explorerHorizontalOffset = 0
                setStatus(status, "Dossier fermé.")
            }
            fileMenuOpen = false
            fileInputConsumed = true
        } else if !layoutMouseConsumed && !filePrompt.isVisible() && leftMousePressed &&
        mouseX() >= 0 && mouseX() < editorLeft - 12 {
            val clicked : usize = explorerEntryAtMouse(
            explorer,
            firstExplorerEntry,
            visibleExplorerRows
            )
            if clicked != usize(-1) {
                explorer.select(clicked)
                if explorer.isDirectory(clicked) {
                    explorer.toggle(clicked)
                    val maximum : usize = maximumExplorerFirst(
                    explorer,
                    visibleExplorerRows
                    )
                    if firstExplorerEntry > maximum {
                        firstExplorerEntry = maximum
                    }
                    lastExplorerClick = usize(-1)
                } else {
                    val clickedAt : usize = wallNow().unixMilliseconds()
                    val isDoubleClick : bool =
                    clicked == lastExplorerClick &&
                    clickedAt >= lastExplorerClickAt &&
                    clickedAt - lastExplorerClickAt <=
                    doubleClickDelayMilliseconds
                    if isDoubleClick {
                        explorer.appendPath(clicked, explorerPath)
                        if tabs.open(
                        explorerPath.view(),
                        buffer,
                        activePath,
                        status,
                        firstLine,
                        firstColumn
                        ) {
                            firstLine = tabs.firstLine()
                            firstColumn = tabs.firstColumn()
                            editorScrollDetached = false
                            horizontalScrollDetached = false
                            completion.dismiss()
                            diagnostics.clear()
                            search.clear()
                            controller.escape()
                            firstDocumentTab = keepSelectedDocumentTabVisible(
                            tabs,
                            firstDocumentTab
                            )
                        }
                        lastExplorerClick = usize(-1)
                    } else {
                        lastExplorerClick = clicked
                        lastExplorerClickAt = clickedAt
                    }
                }
                fileInputConsumed = true
            }
        } else if !layoutMouseConsumed && !filePrompt.isVisible() &&
        tabs.size() > usize(0) && leftMousePressed &&
        pointInArea(
        editorLeft,
        editorTop,
        screenWidth() - editorLeft - 8,
        editorBottom - editorTop
        ) {
            moveCursorToEditorMouse(
            buffer,
            firstLine,
            firstColumn,
            glyphAdvance,
            lineAdvance,
            maximumLines
            )
            buffer.clearSelection()
            buffer.beginSelection()
            mouseSelecting = true
            editorScrollDetached = false
            horizontalScrollDetached = false
            completion.dismiss()
            fileInputConsumed = true
        }
        if mouseSelecting {
            if isMouseButtonDown(MouseButton.Left) &&
            pointInArea(
            editorLeft,
            editorTop,
            screenWidth() - editorLeft - 8,
            editorBottom - editorTop
            ) {
                moveCursorToEditorMouse(
                buffer,
                firstLine,
                firstColumn,
                glyphAdvance,
                lineAdvance,
                maximumLines
                )
                editorScrollDetached = false
                horizontalScrollDetached = false
                fileInputConsumed = true
            } else {
                mouseSelecting = false
            }
        }
        if fileMenuOpen {
            if isKeyPressed(Key.Escape) {
                fileMenuOpen = false
            }
            fileInputConsumed = true
        }
        if filePrompt.isVisible() {
            if handlePathPromptKeys(filePrompt) {
                if filePrompt.action() == PathPromptAction.OpenFolder {
                    if openProjectFolder(
                    filePrompt.value(),
                    projectRoot,
                    explorer,
                    status
                    ) {
                        filePrompt.dismiss()
                        firstExplorerEntry = usize(0)
                        explorerHorizontalOffset = 0
                    }
                } else {
                    val action : PathPromptAction = filePrompt.action()
                    var applied : bool = false
                    if filePrompt.value() == "" {
                        setStatus(status, "Saisissez un chemin de fichier.")
                    } else if !captureDocumentPath(
                    filePrompt.value(),
                    promptedPath
                    ) {
                        setStatus(status, "Chemin de fichier invalide.")
                    } else if action == PathPromptAction.Open {
                        applied = tabs.open(
                        promptedPath.view(),
                        buffer,
                        activePath,
                        status,
                        firstLine,
                        firstColumn
                        )
                        if applied { filePrompt.dismiss() }
                    } else if action == PathPromptAction.Create {
                        if validateNewPath(promptedPath.view(), status) {
                            applied = tabs.create(
                            promptedPath.view(),
                            buffer,
                            activePath,
                            firstLine,
                            firstColumn,
                            status
                            )
                            if applied {
                                setStatus(status, "Nouveau fichier : Ctrl+S pour le créer.")
                                filePrompt.dismiss()
                            }
                        }
                    } else if !tabs.pathAvailableForActive(
                    promptedPath.view()
                    ) {
                        setStatus(status, "Ce fichier est déjà ouvert dans un autre onglet.")
                    } else if applyPathPrompt(
                    filePrompt,
                    promptedPath.view(),
                    activePath,
                    buffer,
                    diagnostics,
                    search,
                    status
                    ) {
                        applied = tabs.updateActivePath(activePath.view())
                    }
                    if applied {
                        firstLine = tabs.firstLine()
                        firstColumn = tabs.firstColumn()
                        editorScrollDetached = false
                        horizontalScrollDetached = false
                        completion.dismiss()
                        diagnostics.clear()
                        search.clear()
                        controller.escape()
                        firstDocumentTab = keepSelectedDocumentTabVisible(
                        tabs,
                        firstDocumentTab
                        )
                    }
                }
            }
            fileInputConsumed = true
        } else if !fileInputConsumed && tabs.size() > usize(0) &&
        control && shift &&
        isKeyPressed(Key.S) {
            filePrompt.begin(PathPromptAction.SaveAs, activePath.view())
            completion.dismiss()
            fileInputConsumed = true
        } else if !fileInputConsumed && control && isKeyPressed(Key.O) {
            filePrompt.begin(PathPromptAction.Open, "")
            completion.dismiss()
            fileInputConsumed = true
        } else if !fileInputConsumed && control && isKeyPressed(Key.N) {
            filePrompt.begin(PathPromptAction.Create, "")
            completion.dismiss()
            fileInputConsumed = true
        } else if !fileInputConsumed && tabs.size() > usize(0) &&
        control && isKeyPressed(Key.W) {
            val closed : bool = tabs.close(
            tabs.selected(),
            buffer,
            activePath,
            status,
            firstLine,
            firstColumn
            )
            if closed {
                firstLine = tabs.firstLine()
                firstColumn = tabs.firstColumn()
                diagnostics.clear()
                search.clear()
                completion.dismiss()
                signatureText.clear()
                controller.escape()
                firstDocumentTab = keepSelectedDocumentTabVisible(
                tabs,
                firstDocumentTab
                )
            }
            fileInputConsumed = true
        } else if !fileInputConsumed && tabs.size() > usize(0) &&
        control && isKeyPressed(Key.Tab) {
            val nextTab : usize = if shift {
                if tabs.selected() == usize(0) {
                    tabs.size() - usize(1)
                } else {
                    tabs.selected() - usize(1)
                }
            } else {
                (tabs.selected() + usize(1)) % tabs.size()
            }
            if tabs.switchTo(
            nextTab,
            buffer,
            activePath,
            firstLine,
            firstColumn
            ) {
                firstLine = tabs.firstLine()
                firstColumn = tabs.firstColumn()
                diagnostics.clear()
                search.clear()
                completion.dismiss()
                signatureText.clear()
                controller.escape()
                firstDocumentTab = keepSelectedDocumentTabVisible(
                tabs,
                firstDocumentTab
                )
            }
            fileInputConsumed = true
        }

        if !fileInputConsumed && tabs.size() > usize(0) &&
        control && isKeyPressed(Key.C) &&
        buffer.appendSelection(clipboard) {
            setClipboardText(clipboard.view())
            setStatus(status, "Sélection copiée.")
            fileInputConsumed = true
        }
        if !fileInputConsumed && tabs.size() > usize(0) &&
        control && isKeyPressed(Key.X) &&
        buffer.appendSelection(clipboard) {
            setClipboardText(clipboard.view())
            buffer.deleteSelection()
            setStatus(status, "Sélection coupée.")
            fileInputConsumed = true
        }
        if !fileInputConsumed && tabs.size() > usize(0) &&
        control && isKeyPressed(Key.V) &&
        controller.mode() == EditorMode.Insert {
            val systemClipboard : string = clipboardText()
            if systemClipboard != "" {
                buffer.insertText(systemClipboard)
            } else if clipboard.size() > usize(0) {
                buffer.insertText(clipboard.view())
            }
            setStatus(status, "Presse-papiers collé.")
            fileInputConsumed = true
        }

        if !fileInputConsumed && tabs.size() > usize(0) &&
        control && isKeyPressed(Key.S) {
            saveFile(activePath.view(), buffer, status)
            fileInputConsumed = true
        }
        if !fileInputConsumed && tabs.size() > usize(0) &&
        isKeyPressed(Key.F5) {
            if saveFile(activePath.view(), buffer, status) {
                checkFileWithDiagnostics(
                activePath.view(),
                toolOutput,
                diagnostics
                )
            }
            firstOutputLine = usize(0)
            firstOutputColumn = usize(0)
            fileInputConsumed = true
        }

        val completionConsumed : bool =
        if fileInputConsumed || tabs.size() == usize(0) {
            true
        } else {
            handleCompletionKeys(completion, buffer, pendingSignature)
        }
        var keyAction : EditorAction = EditorAction.None
        var characterAction : EditorAction = EditorAction.None
        if !completionConsumed {
            keyAction = handleModeKeys(controller, buffer)
            characterAction = handlePrintableKeys(controller, buffer, completion)
        }
        if !completionConsumed && isKeyPressed(Key.Backspace) &&
        completion.isFiltering() {
            completion.broaden()
        }
        val manualCompletion : bool =
        controller.mode() == EditorMode.Insert && control &&
        isKeyPressed(Key.Space)
        if characterAction == EditorAction.Complete || manualCompletion {
            refreshCompletion(
            languageServer,
            activePath.view(),
            buffer,
            completion,
            completionLabels,
            completionError,
            status
            )
            characterAction = EditorAction.None
        } else if characterAction == EditorAction.SignatureHelp {
            completion.dismiss()
            refreshSignatureHelp(
            languageServer,
            activePath.view(),
            buffer,
            signatureText,
            pendingSignature,
            completionError
            )
            characterAction = EditorAction.None
        } else if characterAction == EditorAction.DismissSignatureHelp {
            completion.dismiss()
            signatureText.clear()
            pendingSignature.clear()
            characterAction = EditorAction.None
        } else if characterAction == EditorAction.DismissCompletion {
            completion.dismiss()
            characterAction = EditorAction.None
        } else if !completionConsumed && completion.isFiltering() &&
        (isKeyPressed(Key.Left) || isKeyPressed(Key.Right) ||
        isKeyPressed(Key.Home) || isKeyPressed(Key.End) ||
        isKeyPressed(Key.Delete) || isKeyPressed(Key.Enter) ||
        isKeyPressed(Key.Tab)) {
            completion.dismiss()
        }
        if controller.mode() != EditorMode.Insert ||
        isKeyPressed(Key.Escape) || isKeyPressed(Key.Backspace) ||
        isKeyPressed(Key.Delete) || isKeyPressed(Key.Left) ||
        isKeyPressed(Key.Right) || isKeyPressed(Key.Home) ||
        isKeyPressed(Key.End) {
            signatureText.clear()
        }
        pollLanguageServer(
        languageServer,
        completion,
        completionLabels,
        signatureText,
        pendingSignature,
        completionError,
        status
        )
        if keyAction == EditorAction.Search {
            search.begin(buffer, controller.commandView())
            search.appendStatus(status)
            keyAction = EditorAction.None
        } else if keyAction == EditorAction.SearchNext ||
        characterAction == EditorAction.SearchNext {
            search.selectNext(buffer)
            search.appendStatus(status)
            keyAction = EditorAction.None
            characterAction = EditorAction.None
        } else if keyAction == EditorAction.SearchPrevious ||
        characterAction == EditorAction.SearchPrevious {
            search.selectPrevious(buffer)
            search.appendStatus(status)
            keyAction = EditorAction.None
            characterAction = EditorAction.None
        }
        val requestedAction : EditorAction =
        if keyAction != EditorAction.None { keyAction } else { characterAction }
        val editorQuitRequested : bool = applyEditorAction(
        requestedAction,
        activePath.view(),
        buffer,
        status
        )
        val hasModifiedDocuments : bool = tabs.anyModified(buffer)
        quitRequested = resolveQuitRequest(
        editorQuitRequested,
        requestedAction == EditorAction.ForceQuit,
        nativeCloseRequested,
        hasModifiedDocuments
        )
        if (editorQuitRequested || nativeCloseRequested) &&
        !quitRequested && hasModifiedDocuments {
            setStatus(status, "Des onglets contiennent des modifications non enregistrées.")
        }
        if buffer.isModified() {
            diagnostics.clear()
        }
        if buffer.size() != bufferSizeBeforeInput {
            search.clear()
        }
        if controller.mode() != editorModeBeforeInput &&
        (controller.mode() != EditorMode.Normal ||
        (editorModeBeforeInput == EditorMode.Search &&
        isKeyPressed(Key.Escape))) {
            search.clear()
        }
        if buffer.line() != cursorLineBeforeInput ||
        buffer.column() != cursorColumnBeforeInput ||
        isKeyPressed(Key.Delete) {
            editorScrollDetached = false
            horizontalScrollDetached = false
        }
        if !editorScrollDetached {
            firstLine = keepCursorVisible(buffer, firstLine, maximumLines)
        }
        if !horizontalScrollDetached {
            firstColumn = keepCursorHorizontallyVisible(
            buffer,
            firstColumn,
            visibleColumns
            )
        }
        controller.appendStatus(modeLine)
        controller.appendCommandLine(commandLine)
        drawStudio(
        activePath.view(),
        buffer,
        tabs,
        tabLabel,
        firstDocumentTab,
        firstLine,
        firstColumn,
        visibleCharacters,
        syntaxSpans,
        glyph,
        diagnostics,
        diagnosticText,
        search,
        completion,
        completionText,
        signatureText,
        filePrompt,
        statusLine,
        status,
        toolOutput,
        firstOutputLine,
        firstOutputColumn,
        modeLine,
        commandLine,
        explorer,
        firstExplorerEntry,
        explorerHorizontalOffset,
        visibleExplorerRows,
        explorerLabel,
        fileMenuOpen,
        controller.mode(),
        uiFont,
        codeFont,
        glyphAdvance,
        lineAdvance,
        outputGlyphAdvance,
        outputLineAdvance,
        maximumLines
        )
    }

    val _languageServerStopped : bool = languageServer.shutdown(completionError)
    return 0
}
