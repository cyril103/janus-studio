import editor.buffer
import editor.completion
import editor.explorer
import editor.path_prompt
import editor.search
import editor.syntax
import editor.vim
import studio.files
import studio.input
import studio.render
import studio.state
import studio.tabs
import studio.view
import tooling.compiler
import tooling.diagnostics
import tooling.lsp
import std.array
import std.graphics
import std.text
import std.wall_time

def main() : int {
    if compilerWorkerRequested() { return runRequestedCompilerWorker() }
    val app : StudioAppState = studioAppState()
    defer delete app

    if !initWindow(1200, 760, "Janus Studio") {
        println("Impossible d'ouvrir la fenêtre Janus Studio.")
        return 1
    }
    defer closeWindow()
    setWindowResizable(true)
    disableExitKey()

    val fontCharacters : TextBuilder = studioFontCharacters()
    defer delete fontCharacters
    val uiFontPath : TextBuilder = new TextBuilder()
    defer delete uiFontPath
    val codeFontFile : TextBuilder = new TextBuilder()
    defer delete codeFontFile
    val _uiFontPathCaptured : bool = captureAssetPath(
        "assets/fonts/DejaVuSans.ttf",
        uiFontPath
    )
    val _codeFontPathCaptured : bool = captureAssetPath(
        codeFontPath(),
        codeFontFile
    )
    val uiFont : Font = loadFontUtf8(
        uiFontPath.view(),
        32,
        fontCharacters.view()
    )
    defer delete uiFont
    val codeFont : Font = loadFontUtf8(
        codeFontFile.view(),
        32,
        fontCharacters.view()
    )
    defer delete codeFont
    if !uiFont.isValid() || !codeFont.isValid() {
        println("Impossible de charger les polices de Janus Studio.")
        return 1
    }
    val oneGlyph : Vector2 = codeFont.measure(
        "M",
        codeFontSize,
        codeFontSpacing
    )
    val glyphAdvance : float = codeFont.measure(
        "MM",
        codeFontSize,
        codeFontSpacing
    ).x - oneGlyph.x
    val lineAdvance : float = codeFont.measure(
        "M\nM",
        codeFontSize,
        codeFontSpacing
    ).y - oneGlyph.y
    val outputOneGlyph : Vector2 = codeFont.measure(
        "M",
        15.0f,
        codeFontSpacing
    )
    val outputGlyphAdvance : float = codeFont.measure(
        "MM",
        15.0f,
        codeFontSpacing
    ).x - outputOneGlyph.x
    val outputLineAdvance : float = codeFont.measure(
        "M\nM",
        15.0f,
        codeFontSpacing
    ).y - outputOneGlyph.y
    var maximumLines : usize = numericCast[usize](truncatingCast[int](
        numericCast[float](editorBottom - editorTop - 12) / lineAdvance
    ))
    setTargetFps(60)

    val uiState : StudioUiState = studioUiState()
    defer delete uiState
    while !uiState.quitRequested {
        val nativeCloseRequested : bool = windowShouldClose()
        constrainStudioLayout()
        val control : bool = controlDown()
        val shift : bool = shiftDown()
        val cursorLineBeforeInput : usize = app.buffer.line()
        val cursorColumnBeforeInput : usize = app.buffer.column()
        val bufferSizeBeforeInput : usize = app.buffer.size()
        val editorModeBeforeInput : EditorMode = app.controller.mode()
        val leftMousePressed : bool = isMouseButtonPressed(MouseButton.Left)
        var visibleColumns : usize = visibleEditorColumns(glyphAdvance)
        var outputRows : usize = visibleOutputRows(outputLineAdvance)
        var outputColumns : usize = visibleOutputColumns(outputGlyphAdvance)
        var visibleExplorerRows : usize = explorerVisibleRows()
        var fileInputConsumed : bool = false
        var layoutMouseConsumed : bool = false
        if leftMousePressed && documentTabScrollbarHovered(app.tabs) {
            uiState.documentTabScrollbarDragging = true
        }
        if uiState.documentTabScrollbarDragging {
            if isMouseButtonDown(MouseButton.Left) {
                uiState.firstDocumentTab = documentTabScrollAtMouse(app.tabs)
                layoutMouseConsumed = true
            } else {
                uiState.documentTabScrollbarDragging = false
            }
        }
        if leftMousePressed {
            val clickedTab : usize = documentTabAtMouse(
                app.tabs,
                uiState.firstDocumentTab
            )
            if clickedTab != usize(-1) {
                val previouslySelected : usize = app.tabs.selected()
                val closingTab : bool = documentTabCloseHovered(
                    app.tabs,
                    uiState.firstDocumentTab,
                    clickedTab
                )
                val changed : bool = if closingTab {
                    app.tabs.close(
                        clickedTab,
                        app.buffer,
                        app.activePath,
                        app.status,
                        uiState.firstLine,
                        uiState.firstColumn
                    )
                } else {
                    app.tabs.switchTo(
                        clickedTab,
                        app.buffer,
                        app.activePath,
                        uiState.firstLine,
                        uiState.firstColumn
                    )
                }
                if changed && (!closingTab ||
                    clickedTab == previouslySelected) {
                    uiState.firstLine = app.tabs.firstLine()
                    uiState.firstColumn = app.tabs.firstColumn()
                    app.tooling.diagnostics.clear()
                    app.search.clear()
                    app.tooling.completion.dismiss()
                    app.tooling.signatureText.clear()
                    app.controller.escape()
                    uiState.firstDocumentTab = keepSelectedDocumentTabVisible(
                        app.tabs,
                        uiState.firstDocumentTab
                    )
                }
                fileInputConsumed = true
                layoutMouseConsumed = true
            }
        }
        if !uiState.documentTabScrollbarDragging && leftMousePressed &&
        outputVerticalScrollbarHovered(
            app.tooling.toolOutput.view(),
            outputRows
        ) {
            uiState.outputVerticalScrollbarDragging = true
        } else if leftMousePressed && outputHorizontalScrollbarHovered(
            app.tooling.toolOutput.view(),
            outputColumns
        ) {
            uiState.outputHorizontalScrollbarDragging = true
        }
        if leftMousePressed && !uiState.outputVerticalScrollbarDragging &&
        !uiState.outputHorizontalScrollbarDragging && explorerVerticalScrollbarHovered(
            app.explorer,
            visibleExplorerRows
        ) {
            uiState.explorerVerticalScrollbarDragging = true
        } else if leftMousePressed && !uiState.outputVerticalScrollbarDragging &&
        !uiState.outputHorizontalScrollbarDragging && explorerHorizontalScrollbarHovered(
            app.explorer,
            app.explorerLabel,
            uiFont
        ) {
            uiState.explorerHorizontalScrollbarDragging = true
        }
        if uiState.outputVerticalScrollbarDragging {
            if isMouseButtonDown(MouseButton.Left) {
                uiState.firstOutputLine = outputVerticalScrollAtMouse(
                    app.tooling.toolOutput.view(),
                    outputRows
                )
                layoutMouseConsumed = true
            } else {
                uiState.outputVerticalScrollbarDragging = false
            }
        }
        if uiState.outputHorizontalScrollbarDragging {
            if isMouseButtonDown(MouseButton.Left) {
                uiState.firstOutputColumn = outputHorizontalScrollAtMouse(
                    app.tooling.toolOutput.view(),
                    outputColumns
                )
                layoutMouseConsumed = true
            } else {
                uiState.outputHorizontalScrollbarDragging = false
            }
        }
        if uiState.explorerVerticalScrollbarDragging {
            if isMouseButtonDown(MouseButton.Left) {
                uiState.firstExplorerEntry = explorerVerticalScrollAtMouse(
                    app.explorer,
                    visibleExplorerRows
                )
                layoutMouseConsumed = true
            } else {
                uiState.explorerVerticalScrollbarDragging = false
            }
        }
        if uiState.explorerHorizontalScrollbarDragging {
            if isMouseButtonDown(MouseButton.Left) {
                uiState.explorerHorizontalOffset = explorerHorizontalScrollAtMouse(
                    app.explorer,
                    app.explorerLabel,
                    uiFont
                )
                layoutMouseConsumed = true
            } else {
                uiState.explorerHorizontalScrollbarDragging = false
            }
        }
        if uiState.paneResize == PaneResize.None &&
        !uiState.outputVerticalScrollbarDragging &&
        !uiState.outputHorizontalScrollbarDragging &&
        !uiState.explorerVerticalScrollbarDragging &&
        !uiState.explorerHorizontalScrollbarDragging && leftMousePressed &&
        horizontalScrollbarHovered(app.buffer, visibleColumns) {
            uiState.horizontalScrollbarDragging = true
        }
        if uiState.horizontalScrollbarDragging {
            if isMouseButtonDown(MouseButton.Left) {
                uiState.firstColumn = horizontalScrollAtMouse(app.buffer, visibleColumns)
                uiState.horizontalScrollDetached = true
                app.tooling.completion.dismiss()
                layoutMouseConsumed = true
            } else {
                uiState.horizontalScrollbarDragging = false
            }
        }
        if uiState.paneResize == PaneResize.None && !uiState.horizontalScrollbarDragging &&
        !uiState.outputVerticalScrollbarDragging &&
        !uiState.outputHorizontalScrollbarDragging &&
        !uiState.explorerVerticalScrollbarDragging &&
        !uiState.explorerHorizontalScrollbarDragging &&
        leftMousePressed {
            if explorerSeparatorHovered() {
                uiState.paneResize = PaneResize.Explorer
            } else if outputSeparatorHovered() {
                uiState.paneResize = PaneResize.Output
            }
        }
        if uiState.paneResize != PaneResize.None {
            if isMouseButtonDown(MouseButton.Left) {
                if uiState.paneResize == PaneResize.Explorer {
                    resizeExplorerToMouse()
                } else {
                    resizeOutputToMouse()
                }
                layoutMouseConsumed = true
            } else {
                uiState.paneResize = PaneResize.None
            }
        }
        if uiState.explorerVerticalScrollbarDragging ||
        explorerVerticalScrollbarHovered(app.explorer, visibleExplorerRows) ||
        uiState.outputVerticalScrollbarDragging ||
        outputVerticalScrollbarHovered(app.tooling.toolOutput.view(), outputRows) {
            setMouseCursor(MouseCursor.ResizeNorthSouth)
        } else if uiState.documentTabScrollbarDragging ||
        documentTabScrollbarHovered(app.tabs) ||
        uiState.explorerHorizontalScrollbarDragging ||
        explorerHorizontalScrollbarHovered(app.explorer, app.explorerLabel, uiFont) ||
        uiState.outputHorizontalScrollbarDragging ||
        outputHorizontalScrollbarHovered(app.tooling.toolOutput.view(), outputColumns) ||
        uiState.horizontalScrollbarDragging ||
        horizontalScrollbarHovered(app.buffer, visibleColumns) {
            setMouseCursor(MouseCursor.ResizeEastWest)
        } else if uiState.paneResize == PaneResize.Explorer || explorerSeparatorHovered() {
            setMouseCursor(MouseCursor.ResizeEastWest)
        } else if uiState.paneResize == PaneResize.Output || outputSeparatorHovered() {
            setMouseCursor(MouseCursor.ResizeNorthSouth)
        } else {
            setMouseCursor(MouseCursor.Default)
        }
        maximumLines = numericCast[usize](truncatingCast[int](
            numericCast[float](editorBottom - editorTop - 12) / lineAdvance
        ))
        visibleColumns = visibleEditorColumns(glyphAdvance)
        outputRows = visibleOutputRows(outputLineAdvance)
        outputColumns = visibleOutputColumns(outputGlyphAdvance)
        visibleExplorerRows = explorerVisibleRows()
        val maximumFirstAfterResize : usize = maximumEditorFirst(
            app.buffer,
            maximumLines
        )
        if uiState.firstLine > maximumFirstAfterResize {
            uiState.firstLine = maximumFirstAfterResize
        }
        val maximumColumnAfterResize : usize = maximumEditorFirstColumn(
            app.buffer,
            visibleColumns
        )
        if uiState.firstColumn > maximumColumnAfterResize {
            uiState.firstColumn = maximumColumnAfterResize
        }
        val maximumOutputLineAfterResize : usize = maximumOutputFirstLine(
            app.tooling.toolOutput.view(),
            outputRows
        )
        if uiState.firstOutputLine > maximumOutputLineAfterResize {
            uiState.firstOutputLine = maximumOutputLineAfterResize
        }
        val maximumOutputColumnAfterResize : usize = maximumOutputFirstColumn(
            app.tooling.toolOutput.view(),
            outputColumns
        )
        if uiState.firstOutputColumn > maximumOutputColumnAfterResize {
            uiState.firstOutputColumn = maximumOutputColumnAfterResize
        }
        val maximumExplorerEntryAfterResize : usize = maximumExplorerFirst(
            app.explorer,
            visibleExplorerRows
        )
        if uiState.firstExplorerEntry > maximumExplorerEntryAfterResize {
            uiState.firstExplorerEntry = maximumExplorerEntryAfterResize
        }
        val maximumExplorerOffsetAfterResize : int =
        maximumExplorerHorizontalOffset(app.explorer, app.explorerLabel, uiFont)
        if uiState.explorerHorizontalOffset > maximumExplorerOffsetAfterResize {
            uiState.explorerHorizontalOffset = maximumExplorerOffsetAfterResize
        }
        val maximumFirstTabAfterResize : usize = maximumFirstDocumentTab(app.tabs)
        if uiState.firstDocumentTab > maximumFirstTabAfterResize {
            uiState.firstDocumentTab = maximumFirstTabAfterResize
        }
        if !app.filePrompt.isVisible() && !uiState.fileMenuOpen {
            if mouseInDocumentTabs() {
                uiState.firstDocumentTab = scrollDocumentTabs(
                    app.tabs,
                    uiState.firstDocumentTab
                )
            } else if mouseInExplorerPanel() && shift {
                uiState.explorerHorizontalOffset = scrollExplorerHorizontally(
                    app.explorer,
                    app.explorerLabel,
                    uiFont,
                    uiState.explorerHorizontalOffset
                )
            } else if mouseInExplorerPanel() {
                uiState.firstExplorerEntry = scrollExplorer(
                    app.explorer,
                    uiState.firstExplorerEntry,
                    visibleExplorerRows
                )
            } else if mouseInOutputPanel() && shift {
                uiState.firstOutputColumn = scrollOutputHorizontally(
                    app.tooling.toolOutput.view(),
                    uiState.firstOutputColumn,
                    outputColumns
                )
            } else if mouseInOutputPanel() {
                uiState.firstOutputLine = scrollOutputVertically(
                    app.tooling.toolOutput.view(),
                    uiState.firstOutputLine,
                    outputRows
                )
            } else if shift {
                val scrolledEditorColumn : usize = scrollEditorHorizontally(
                    app.buffer,
                    uiState.firstColumn,
                    visibleColumns
                )
                if scrolledEditorColumn != uiState.firstColumn {
                    uiState.firstColumn = scrolledEditorColumn
                    uiState.horizontalScrollDetached = true
                    app.tooling.completion.dismiss()
                }
            } else {
                val scrolledEditorFirst : usize = scrollEditor(
                    app.buffer,
                    uiState.firstLine,
                    maximumLines
                )
                if scrolledEditorFirst != uiState.firstLine {
                    uiState.firstLine = scrolledEditorFirst
                    uiState.editorScrollDetached = true
                    app.tooling.completion.dismiss()
                }
            }
        }
        if !layoutMouseConsumed && !app.filePrompt.isVisible() && leftMousePressed &&
        pointInArea(fileMenuX, 0, fileMenuButtonWidth, editorTop) {
            uiState.fileMenuOpen = !uiState.fileMenuOpen
            fileInputConsumed = true
        } else if !layoutMouseConsumed && !app.filePrompt.isVisible() && uiState.fileMenuOpen &&
        leftMousePressed {
            if pointInArea(
                fileMenuX,
                fileMenuTop,
                fileMenuWidth,
                fileMenuRowHeight
            ) {
                app.filePrompt.begin(PathPromptAction.OpenFolder, app.projectRoot.view())
                app.tooling.completion.dismiss()
            } else if pointInArea(
                fileMenuX,
                fileMenuTop + fileMenuRowHeight,
                fileMenuWidth,
                fileMenuRowHeight
            ) && app.explorer.size() > usize(0) {
                app.explorer.close()
                app.projectRoot.clear()
                uiState.firstExplorerEntry = usize(0)
                uiState.explorerHorizontalOffset = 0
                app.promptedPath.clear()
                if app.activePath.view() != "" {
                    val _capturedParent : bool = captureParentDirectory(
                        app.activePath.view(),
                        app.promptedPath
                    )
                }
                if app.tooling.languageServer.restart(app.promptedPath.view(), app.tooling.completionError) {
                    setStatus(app.status, "Dossier fermé.")
                } else {
                    setStatus(app.status, app.tooling.completionError.view())
                }
            }
            uiState.fileMenuOpen = false
            fileInputConsumed = true
        } else if !layoutMouseConsumed && !app.filePrompt.isVisible() && leftMousePressed &&
        mouseX() >= 0 && mouseX() < editorLeft - 12 {
            val clicked : usize = explorerEntryAtMouse(
                app.explorer,
                uiState.firstExplorerEntry,
                visibleExplorerRows
            )
            if clicked != usize(-1) {
                app.explorer.select(clicked)
                if app.explorer.isDirectory(clicked) {
                    app.explorer.toggle(clicked)
                    val maximum : usize = maximumExplorerFirst(
                        app.explorer,
                        visibleExplorerRows
                    )
                    if uiState.firstExplorerEntry > maximum {
                        uiState.firstExplorerEntry = maximum
                    }
                    uiState.lastExplorerClick = usize(-1)
                } else {
                    val clickedAt : usize = wallNow().unixMilliseconds()
                    val isDoubleClick : bool =
                    clicked == uiState.lastExplorerClick &&
                    clickedAt >= uiState.lastExplorerClickAt &&
                    clickedAt - uiState.lastExplorerClickAt <=
                    doubleClickDelayMilliseconds
                    if isDoubleClick {
                        app.explorer.appendPath(clicked, app.explorerPath)
                        if app.tabs.open(
                            app.explorerPath.view(),
                            app.buffer,
                            app.activePath,
                            app.status,
                            uiState.firstLine,
                            uiState.firstColumn
                        ) {
                            uiState.firstLine = app.tabs.firstLine()
                            uiState.firstColumn = app.tabs.firstColumn()
                            uiState.editorScrollDetached = false
                            uiState.horizontalScrollDetached = false
                            app.tooling.completion.dismiss()
                            app.tooling.diagnostics.clear()
                            app.search.clear()
                            app.controller.escape()
                            uiState.firstDocumentTab = keepSelectedDocumentTabVisible(
                                app.tabs,
                                uiState.firstDocumentTab
                            )
                        }
                        uiState.lastExplorerClick = usize(-1)
                    } else {
                        uiState.lastExplorerClick = clicked
                        uiState.lastExplorerClickAt = clickedAt
                    }
                }
                fileInputConsumed = true
            }
        } else if !layoutMouseConsumed && !app.filePrompt.isVisible() &&
        app.tabs.size() > usize(0) && leftMousePressed &&
        pointInArea(
            editorLeft,
            editorTop,
            screenWidth() - editorLeft - 8,
            editorBottom - editorTop
        ) {
            moveCursorToEditorMouse(
                app.buffer,
                uiState.firstLine,
                uiState.firstColumn,
                glyphAdvance,
                lineAdvance,
                maximumLines
            )
            app.buffer.clearSelection()
            app.buffer.beginSelection()
            uiState.mouseSelecting = true
            uiState.editorScrollDetached = false
            uiState.horizontalScrollDetached = false
            app.tooling.completion.dismiss()
            fileInputConsumed = true
        }
        if uiState.mouseSelecting {
            if isMouseButtonDown(MouseButton.Left) &&
            pointInArea(
                editorLeft,
                editorTop,
                screenWidth() - editorLeft - 8,
                editorBottom - editorTop
            ) {
                moveCursorToEditorMouse(
                    app.buffer,
                    uiState.firstLine,
                    uiState.firstColumn,
                    glyphAdvance,
                    lineAdvance,
                    maximumLines
                )
                uiState.editorScrollDetached = false
                uiState.horizontalScrollDetached = false
                fileInputConsumed = true
            } else {
                uiState.mouseSelecting = false
            }
        }
        if uiState.fileMenuOpen {
            if isKeyPressed(Key.Escape) {
                uiState.fileMenuOpen = false
            }
            fileInputConsumed = true
        }
        if app.filePrompt.isVisible() {
            if handlePathPromptKeys(app.filePrompt) {
                if app.filePrompt.action() == PathPromptAction.OpenFolder {
                    if openProjectFolder(
                        app.filePrompt.value(),
                        app.projectRoot,
                        app.explorer,
                        app.status
                    ) {
                        app.filePrompt.dismiss()
                        uiState.firstExplorerEntry = usize(0)
                        uiState.explorerHorizontalOffset = 0
                        if !app.tooling.languageServer.restart(
                            app.projectRoot.view(),
                            app.tooling.completionError
                        ) {
                            setStatus(app.status, app.tooling.completionError.view())
                        }
                    }
                } else {
                    val action : PathPromptAction = app.filePrompt.action()
                    var applied : bool = false
                    if app.filePrompt.value() == "" {
                        setStatus(app.status, "Saisissez un chemin de fichier.")
                    } else if !captureDocumentPath(
                        app.filePrompt.value(),
                        app.promptedPath
                    ) {
                        setStatus(app.status, "Chemin de fichier invalide.")
                    } else if action == PathPromptAction.Open {
                        applied = app.tabs.open(
                            app.promptedPath.view(),
                            app.buffer,
                            app.activePath,
                            app.status,
                            uiState.firstLine,
                            uiState.firstColumn
                        )
                        if applied { app.filePrompt.dismiss() }
                    } else if action == PathPromptAction.Create {
                        if validateNewPath(app.promptedPath.view(), app.status) {
                            applied = app.tabs.create(
                                app.promptedPath.view(),
                                app.buffer,
                                app.activePath,
                                uiState.firstLine,
                                uiState.firstColumn,
                                app.status
                            )
                            if applied {
                                setStatus(app.status, "Nouveau fichier : Ctrl+S pour le créer.")
                                app.filePrompt.dismiss()
                            }
                        }
                    } else if !app.tabs.pathAvailableForActive(
                        app.promptedPath.view()
                    ) {
                        setStatus(app.status, "Ce fichier est déjà ouvert dans un autre onglet.")
                    } else if applyPathPrompt(
                        app.filePrompt,
                        app.promptedPath.view(),
                        app.activePath,
                        app.buffer,
                        app.tooling.diagnostics,
                        app.search,
                        app.status
                    ) {
                        applied = app.tabs.updateActivePath(app.activePath.view())
                    }
                    if applied {
                        uiState.firstLine = app.tabs.firstLine()
                        uiState.firstColumn = app.tabs.firstColumn()
                        uiState.editorScrollDetached = false
                        uiState.horizontalScrollDetached = false
                        app.tooling.completion.dismiss()
                        app.tooling.diagnostics.clear()
                        app.search.clear()
                        app.controller.escape()
                        uiState.firstDocumentTab = keepSelectedDocumentTabVisible(
                            app.tabs,
                            uiState.firstDocumentTab
                        )
                    }
                }
            }
            fileInputConsumed = true
        } else if !fileInputConsumed && app.tabs.size() > usize(0) &&
        control && shift &&
        isKeyPressed(Key.S) {
            app.filePrompt.begin(PathPromptAction.SaveAs, app.activePath.view())
            app.tooling.completion.dismiss()
            fileInputConsumed = true
        } else if !fileInputConsumed && control && isKeyPressed(Key.O) {
            app.filePrompt.begin(PathPromptAction.Open, "")
            app.tooling.completion.dismiss()
            fileInputConsumed = true
        } else if !fileInputConsumed && control && isKeyPressed(Key.N) {
            app.filePrompt.begin(PathPromptAction.Create, "")
            app.tooling.completion.dismiss()
            fileInputConsumed = true
        } else if !fileInputConsumed && app.tabs.size() > usize(0) &&
        control && isKeyPressed(Key.W) {
            val closed : bool = app.tabs.close(
                app.tabs.selected(),
                app.buffer,
                app.activePath,
                app.status,
                uiState.firstLine,
                uiState.firstColumn
            )
            if closed {
                uiState.firstLine = app.tabs.firstLine()
                uiState.firstColumn = app.tabs.firstColumn()
                app.tooling.diagnostics.clear()
                app.search.clear()
                app.tooling.completion.dismiss()
                app.tooling.signatureText.clear()
                app.controller.escape()
                uiState.firstDocumentTab = keepSelectedDocumentTabVisible(
                    app.tabs,
                    uiState.firstDocumentTab
                )
            }
            fileInputConsumed = true
        } else if !fileInputConsumed && app.tabs.size() > usize(0) &&
        control && isKeyPressed(Key.Tab) {
            val nextTab : usize = if shift {
                if app.tabs.selected() == usize(0) {
                    app.tabs.size() - usize(1)
                } else {
                    app.tabs.selected() - usize(1)
                }
            } else {
                (app.tabs.selected() + usize(1)) % app.tabs.size()
            }
            if app.tabs.switchTo(
                nextTab,
                app.buffer,
                app.activePath,
                uiState.firstLine,
                uiState.firstColumn
            ) {
                uiState.firstLine = app.tabs.firstLine()
                uiState.firstColumn = app.tabs.firstColumn()
                app.tooling.diagnostics.clear()
                app.search.clear()
                app.tooling.completion.dismiss()
                app.tooling.signatureText.clear()
                app.controller.escape()
                uiState.firstDocumentTab = keepSelectedDocumentTabVisible(
                    app.tabs,
                    uiState.firstDocumentTab
                )
            }
            fileInputConsumed = true
        }

        if !fileInputConsumed && app.tabs.size() > usize(0) &&
        control && isKeyPressed(Key.C) &&
        app.buffer.appendSelection(app.clipboard) {
            setClipboardText(app.clipboard.view())
            setStatus(app.status, "Sélection copiée.")
            fileInputConsumed = true
        }
        if !fileInputConsumed && app.tabs.size() > usize(0) &&
        control && isKeyPressed(Key.X) &&
        app.buffer.appendSelection(app.clipboard) {
            setClipboardText(app.clipboard.view())
            app.buffer.deleteSelection()
            setStatus(app.status, "Sélection coupée.")
            fileInputConsumed = true
        }
        if !fileInputConsumed && app.tabs.size() > usize(0) &&
        control && isKeyPressed(Key.V) &&
        app.controller.mode() == EditorMode.Insert {
            val systemClipboard : string = clipboardText()
            if systemClipboard != "" {
                app.buffer.insertText(systemClipboard)
            } else if app.clipboard.size() > usize(0) {
                app.buffer.insertText(app.clipboard.view())
            }
            setStatus(app.status, "Presse-papiers collé.")
            fileInputConsumed = true
        }

        if !fileInputConsumed && app.tabs.size() > usize(0) &&
        control && isKeyPressed(Key.S) {
            saveFile(app.activePath.view(), app.buffer, app.status)
            fileInputConsumed = true
        }
        if !fileInputConsumed && app.tabs.size() > usize(0) &&
        isKeyPressed(Key.F5) {
            if saveFile(app.activePath.view(), app.buffer, app.status) {
                app.tooling.compiler.start(
                    app.activePath.view(),
                    app.projectRoot.view(),
                    app.tooling.toolOutput,
                    app.tooling.diagnostics
                )
            }
            uiState.firstOutputLine = usize(0)
            uiState.firstOutputColumn = usize(0)
            fileInputConsumed = true
        }

        val completionConsumed : bool =
        if fileInputConsumed || app.tabs.size() == usize(0) {
            true
        } else {
            handleCompletionKeys(app.tooling.completion, app.buffer, app.tooling.pendingSignature)
        }
        var keyAction : EditorAction = EditorAction.None
        var characterAction : EditorAction = EditorAction.None
        if !completionConsumed {
            keyAction = handleModeKeys(app.controller, app.buffer)
            characterAction = handlePrintableKeys(app.controller, app.buffer, app.tooling.completion)
        }
        if !completionConsumed && isKeyPressed(Key.Backspace) &&
        app.tooling.completion.isFiltering() {
            app.tooling.completion.broaden()
        }
        val manualCompletion : bool =
        app.controller.mode() == EditorMode.Insert && control &&
        isKeyPressed(Key.Space)
        if characterAction == EditorAction.Complete || manualCompletion {
            refreshCompletion(
                app.tooling.languageServer,
                app.activePath.view(),
                app.buffer,
                app.tooling.completion,
                app.tooling.completionLabels,
                app.tooling.completionError,
                app.status
            )
            characterAction = EditorAction.None
        } else if characterAction == EditorAction.SignatureHelp {
            app.tooling.completion.dismiss()
            refreshSignatureHelp(
                app.tooling.languageServer,
                app.activePath.view(),
                app.buffer,
                app.tooling.signatureText,
                app.tooling.pendingSignature,
                app.tooling.completionError
            )
            characterAction = EditorAction.None
        } else if characterAction == EditorAction.DismissSignatureHelp {
            app.tooling.completion.dismiss()
            app.tooling.signatureText.clear()
            app.tooling.pendingSignature.clear()
            characterAction = EditorAction.None
        } else if characterAction == EditorAction.DismissCompletion {
            app.tooling.completion.dismiss()
            characterAction = EditorAction.None
        } else if !completionConsumed && app.tooling.completion.isFiltering() &&
        (isKeyPressed(Key.Left) || isKeyPressed(Key.Right) ||
            isKeyPressed(Key.Home) || isKeyPressed(Key.End) ||
            isKeyPressed(Key.Delete) || isKeyPressed(Key.Enter) ||
            isKeyPressed(Key.Tab)) {
            app.tooling.completion.dismiss()
        }
        if app.controller.mode() != EditorMode.Insert ||
        isKeyPressed(Key.Escape) || isKeyPressed(Key.Backspace) ||
        isKeyPressed(Key.Delete) || isKeyPressed(Key.Left) ||
        isKeyPressed(Key.Right) || isKeyPressed(Key.Home) ||
        isKeyPressed(Key.End) {
            app.tooling.signatureText.clear()
        }
        pollLanguageServer(
            app.tooling.languageServer,
            app.activePath.view(),
            app.buffer,
            app.tooling.completion,
            app.tooling.completionLabels,
            app.tooling.signatureText,
            app.tooling.pendingSignature,
            app.tooling.completionError,
            app.status
        )
        val compilerState : CompilerCheckState = app.tooling.compiler.poll(
            app.tooling.toolOutput,
            app.tooling.diagnostics
        )
        if compilerState == CompilerCheckState.Completed ||
        compilerState == CompilerCheckState.Failed {
            uiState.firstOutputLine = usize(0)
            uiState.firstOutputColumn = usize(0)
        }
        if keyAction == EditorAction.Search {
            app.search.begin(app.buffer, app.controller.commandView())
            app.search.appendStatus(app.status)
            keyAction = EditorAction.None
        } else if keyAction == EditorAction.SearchNext ||
        characterAction == EditorAction.SearchNext {
            app.search.selectNext(app.buffer)
            app.search.appendStatus(app.status)
            keyAction = EditorAction.None
            characterAction = EditorAction.None
        } else if keyAction == EditorAction.SearchPrevious ||
        characterAction == EditorAction.SearchPrevious {
            app.search.selectPrevious(app.buffer)
            app.search.appendStatus(app.status)
            keyAction = EditorAction.None
            characterAction = EditorAction.None
        }
        val requestedAction : EditorAction =
        if keyAction != EditorAction.None { keyAction } else { characterAction }
        val editorQuitRequested : bool = applyEditorAction(
            requestedAction,
            app.activePath.view(),
            app.buffer,
            app.status
        )
        val hasModifiedDocuments : bool = app.tabs.anyModified(app.buffer)
        uiState.quitRequested = resolveQuitRequest(
            editorQuitRequested,
            requestedAction == EditorAction.ForceQuit,
            nativeCloseRequested,
            hasModifiedDocuments
        )
        if (editorQuitRequested || nativeCloseRequested) &&
        !uiState.quitRequested && hasModifiedDocuments {
            setStatus(app.status, "Des onglets contiennent des modifications non enregistrées.")
        }
        if app.buffer.isModified() {
            app.tooling.diagnostics.clear()
        }
        if app.buffer.size() != bufferSizeBeforeInput {
            app.search.clear()
        }
        if app.controller.mode() != editorModeBeforeInput &&
        (app.controller.mode() != EditorMode.Normal ||
            (editorModeBeforeInput == EditorMode.Search &&
            isKeyPressed(Key.Escape))) {
            app.search.clear()
        }
        if app.buffer.line() != cursorLineBeforeInput ||
        app.buffer.column() != cursorColumnBeforeInput ||
        isKeyPressed(Key.Delete) {
            uiState.editorScrollDetached = false
            uiState.horizontalScrollDetached = false
        }
        if !uiState.editorScrollDetached {
            uiState.firstLine = keepCursorVisible(app.buffer, uiState.firstLine, maximumLines)
        }
        if !uiState.horizontalScrollDetached {
            uiState.firstColumn = keepCursorHorizontallyVisible(
                app.buffer,
                uiState.firstColumn,
                visibleColumns
            )
        }
        app.controller.appendStatus(app.modeLine)
        app.controller.appendCommandLine(app.commandLine)
        drawStudio(
            app.activePath.view(),
            app.buffer,
            app.tabs,
            app.tabLabel,
            uiState,
            app.visibleCharacters,
            app.syntaxSpans,
            app.glyph,
            app.tooling.diagnostics,
            app.tooling.diagnosticText,
            app.search,
            app.tooling.completion,
            app.tooling.completionText,
            app.tooling.signatureText,
            app.filePrompt,
            app.statusLine,
            app.status,
            app.tooling.toolOutput,
            app.modeLine,
            app.commandLine,
            app.explorer,
            visibleExplorerRows,
            app.explorerLabel,
            app.controller.mode(),
            uiFont,
            codeFont,
            glyphAdvance,
            lineAdvance,
            outputGlyphAdvance,
            outputLineAdvance,
            maximumLines
        )
    }

    val _languageServerStopped : bool = app.tooling.languageServer.shutdown(app.tooling.completionError)
    return 0
}
