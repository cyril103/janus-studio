import editor.buffer
import editor.completion
import editor.explorer
import editor.path_prompt
import editor.syntax
import editor.vim
import tooling.compiler
import tooling.lsp
import std.array
import std.fs
import std.graphics
import std.option
import std.process
import std.result
import std.system
import std.text
import std.wall_time

var editorLeft : int = 236
const editorTop : int = 54
var editorBottom : int = 590
const codeFontSize : float = 20.0f
const codeFontSpacing : float = 1.0f
const statusBarHeight : int = 28
const commandLineHeight : int = 28
const explorerTreeTop : int = 104
const explorerRowHeight : int = 22
const explorerIndentWidth : int = 14
const doubleClickDelayMilliseconds : usize = usize(500)
const fileMenuX : int = 188
const fileMenuWidth : int = 250
const fileMenuButtonWidth : int = 86
const fileMenuTop : int = 46
const fileMenuRowHeight : int = 36
const separatorHitWidth : int = 5
const minimumExplorerWidth : int = 150
const minimumEditorWidth : int = 360
const minimumEditorHeight : int = 180
const minimumOutputHeight : int = 80

enum PaneResize derives Copy, Equality, Debug {
    None,
    Explorer,
    Output
}

def isFile(path : string) : bool {
    return match metadata(path) {
        Ok(value) => value.kind == FileType.File,
        Error(error) => false
    }
}

def codeFontPath() : string {
    val windowsPath : string = "C:/Windows/Fonts/consola.ttf"
    if isFile(windowsPath) {
        return windowsPath
    }
    val wslPath : string = "/mnt/c/Windows/Fonts/consola.ttf"
    if isFile(wslPath) {
        return wslPath
    }
    return "assets/fonts/DejaVuSansMono.ttf"
}

def selectedPath() : string {
    return match programArgument(usize(1)) {
        Some(path) => path,
        None => "samples/welcome.janus"
    }
}

def useWorkingDirectory(
directory : WorkingDirectory,
output : TextBuilder
) : bool {
    output.append(directory.view())
    delete directory
    return true
}

def captureProjectRoot(output : TextBuilder) : bool {
    val directory : Result[WorkingDirectory, SystemError] =
    currentWorkingDirectory()
    return match move directory {
        Ok(value) => useWorkingDirectory(move value, output),
        Error(error) => false
    }
}

def setStatus(status : TextBuilder, message : string) : Unit {
    status.clear()
    status.append(message)
}

def acceptFile(
data : FileData,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    buffer.load(data.view())
    buffer.moveFileStart()
    delete data
    setStatus(status, "Fichier chargé.")
    return true
}

def startEmptyFile(
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    buffer.clear()
    setStatus(status, "Nouveau fichier : Ctrl+S pour le créer.")
    return false
}

def loadFile(
path : string,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    val result : Result[FileData, SystemError] = readFile(path)
    return match move result {
        Ok(data) => acceptFile(move data, buffer, status),
        Error(error) => startEmptyFile(buffer, status)
    }
}

def openFailed(status : TextBuilder) : bool {
    setStatus(status, "Impossible d'ouvrir ce fichier.")
    return false
}

def openExistingFile(
path : string,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    val result : Result[FileData, SystemError] = readFile(path)
    return match move result {
        Ok(data) => acceptFile(move data, buffer, status),
        Error(error) => openFailed(status)
    }
}

def saveSucceeded(
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    buffer.markSaved()
    setStatus(status, "Fichier enregistré.")
    return true
}

def saveFailed(status : TextBuilder) : bool {
    setStatus(status, "Échec de l'enregistrement.")
    return false
}

def saveFile(
path : string,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    val content : TextBuilder = new TextBuilder()
    defer delete content
    buffer.appendText(content)
    return match writeTextFileAtomic(path, content.view()) {
        Ok(written) => if written {
            saveSucceeded(buffer, status)
        } else {
            saveFailed(status)
        },
        Error(error) => saveFailed(status)
    }
}

def controlDown() : bool {
    return isKeyDown(Key.LeftControl) || isKeyDown(Key.RightControl)
}

def shiftDown() : bool {
    return isKeyDown(Key.LeftShift) || isKeyDown(Key.RightShift)
}

def pathPromptTitle(action : PathPromptAction) : string {
    return match action {
        Open => "OUVRIR UN FICHIER",
        OpenFolder => "OUVRIR UN DOSSIER",
        Create => "NOUVEAU FICHIER",
        SaveAs => "ENREGISTRER SOUS",
        None => "FICHIER"
    }
}

def pointInArea(x : int, y : int, width : int, height : int) : bool {
    return mouseX() >= x && mouseX() < x + width &&
    mouseY() >= y && mouseY() < y + height
}

def distance(left : int, right : int) : int {
    return if left >= right { left - right } else { right - left }
}

def explorerSeparatorHovered() : bool {
    return distance(mouseX(), editorLeft - 12) <= separatorHitWidth &&
    mouseY() >= editorTop &&
    mouseY() < screenHeight() - statusBarHeight - commandLineHeight
}

def outputSeparatorHovered() : bool {
    return distance(mouseY(), editorBottom) <= separatorHitWidth &&
    mouseX() >= editorLeft - 12 && mouseX() < screenWidth()
}

def resizeExplorerToMouse() : Unit {
    val requested : int = mouseX() + 12
    val maximum : int = screenWidth() - minimumEditorWidth
    if requested < minimumExplorerWidth + 12 {
        editorLeft = minimumExplorerWidth + 12
    } else if requested > maximum {
        editorLeft = maximum
    } else {
        editorLeft = requested
    }
}

def resizeOutputToMouse() : Unit {
    val requested : int = mouseY()
    val maximum : int = screenHeight() - statusBarHeight -
    commandLineHeight - minimumOutputHeight
    if requested < editorTop + minimumEditorHeight {
        editorBottom = editorTop + minimumEditorHeight
    } else if requested > maximum {
        editorBottom = maximum
    } else {
        editorBottom = requested
    }
}

def openProjectFolder(
path : string,
projectRoot : TextBuilder,
explorer : ProjectExplorer,
status : TextBuilder
) : bool {
    if path == "" {
        setStatus(status, "Saisissez un chemin de dossier.")
        return false
    }
    if !explorer.open(path) {
        setStatus(status, "Impossible d'ouvrir ce dossier.")
        return false
    }
    projectRoot.clear()
    projectRoot.append(path)
    setStatus(status, "Dossier ouvert.")
    return true
}

def handlePathPromptKeys(prompt : PathPrompt) : bool {
    if isKeyPressed(Key.Escape) {
        prompt.dismiss()
        return false
    }
    if isKeyPressed(Key.Backspace) {
        prompt.backspace()
    }
    if isKeyPressed(Key.Delete) {
        prompt.deleteForward()
    }
    if isKeyPressed(Key.Left) {
        prompt.moveLeft()
    }
    if isKeyPressed(Key.Right) {
        prompt.moveRight()
    }
    if isKeyPressed(Key.Home) {
        prompt.moveHome()
    }
    if isKeyPressed(Key.End) {
        prompt.moveEnd()
    }
    if isKeyPressed(Key.Tab) {
        prompt.completePath()
    }
    if isKeyPressed(Key.Enter) {
        return true
    }
    var codepoint : int = characterPressed()
    while codepoint != 0 {
        if !controlDown() && codepoint >= 32 && codepoint != 127 {
            prompt.append(char(codepoint))
        }
        codepoint = characterPressed()
    }
    return false
}

def applyPathPrompt(
prompt : PathPrompt,
activePath : TextBuilder,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    if prompt.value() == "" {
        setStatus(status, "Saisissez un chemin de fichier.")
        return false
    }
    val action : PathPromptAction = prompt.action()
    if action == PathPromptAction.Open &&
    !openExistingFile(prompt.value(), buffer, status) {
        return false
    }
    if action == PathPromptAction.SaveAs &&
    !saveFile(prompt.value(), buffer, status) {
        return false
    }
    if action == PathPromptAction.Create {
        buffer.clear()
        setStatus(status, "Nouveau fichier : Ctrl+S pour le créer.")
    }
    activePath.clear()
    activePath.append(prompt.value())
    prompt.dismiss()
    return true
}

def handleModeKeys(
controller : VimController,
buffer : EditorBuffer
) : EditorAction {
    if isKeyPressed(Key.Escape) {
        controller.escape()
        return EditorAction.None
    }
    if controller.mode() == EditorMode.Command {
        if isKeyPressed(Key.Backspace) {
            controller.commandBackspace()
        }
        if isKeyPressed(Key.Enter) {
            return controller.executeCommand()
        }
        return EditorAction.None
    }
    if isKeyPressed(Key.Left) {
        buffer.moveLeft()
    }
    if isKeyPressed(Key.Right) {
        buffer.moveRightInLine()
    }
    if isKeyPressed(Key.Up) {
        buffer.moveUp()
    }
    if isKeyPressed(Key.Down) {
        buffer.moveDown()
    }
    if isKeyPressed(Key.Home) {
        buffer.moveHome()
    }
    if isKeyPressed(Key.End) {
        buffer.moveEnd()
    }
    if controller.mode() == EditorMode.Normal {
        if isKeyPressed(Key.Delete) {
            buffer.deleteCharacter()
        }
        if controlDown() && isKeyPressed(Key.R) {
            buffer.redo()
        }
        return EditorAction.None
    }
    if isKeyPressed(Key.Backspace) {
        buffer.backspace()
    }
    if isKeyPressed(Key.Delete) {
        buffer.deleteForward()
    }
    if isKeyPressed(Key.Enter) {
        buffer.insert('\n')
    }
    if isKeyPressed(Key.Tab) {
        buffer.insertSpaces(usize(4))
    }
    return EditorAction.None
}

def handlePrintableKeys(
controller : VimController,
buffer : EditorBuffer
) : EditorAction {
    val control : bool = controlDown()
    var action : EditorAction = EditorAction.None
    var codepoint : int = characterPressed()
    while codepoint != 0 {
        if !control && codepoint >= 32 && codepoint != 127 {
            val value : char = char(codepoint)
            if controller.mode() == EditorMode.Insert {
                controller.handleInsert(value, buffer)
                action = if value == '.' {
                    EditorAction.Complete
                } else {
                    EditorAction.DismissCompletion
                }
            } else if controller.mode() == EditorMode.Command {
                controller.handleCommand(value)
            } else {
                action = controller.handleNormal(value, buffer)
            }
        }
        codepoint = characterPressed()
    }
    return action
}

def handleCompletionKeys(
completion : CompletionModel,
buffer : EditorBuffer
) : bool {
    if !completion.isVisible() {
        return false
    }
    if isKeyPressed(Key.Escape) {
        completion.dismiss()
        return true
    }
    if isKeyPressed(Key.Down) {
        completion.selectNext()
        return true
    }
    if isKeyPressed(Key.Up) {
        completion.selectPrevious()
        return true
    }
    if isKeyPressed(Key.Enter) || isKeyPressed(Key.Tab) {
        completion.accept(buffer)
        return true
    }
    return false
}

def refreshCompletion(
lsp : LspClient,
path : string,
buffer : EditorBuffer,
completion : CompletionModel,
labels : TextBuilder,
error : TextBuilder,
status : TextBuilder
) : Unit {
    if lsp.requestCompletion(
    path,
    buffer,
    buffer.line(),
    buffer.column(),
    labels,
    error
    ) {
        completion.load(labels.view())
        status.clear()
        status.appendUSize(completion.size())
        status.append(" propositions — flèches puis Entrée")
    } else {
        completion.dismiss()
        setStatus(
        status,
        if error.size() > usize(0) {
            error.view()
        } else {
            "Aucune proposition à cette position."
        }
        )
    }
}

def applyEditorAction(
action : EditorAction,
path : string,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    if action == EditorAction.Save {
        saveFile(path, buffer, status)
        return false
    }
    if action == EditorAction.Quit {
        if buffer.isModified() {
            setStatus(status, "Modifications non enregistrées — utilisez :q!")
            return false
        }
        return true
    }
    if action == EditorAction.ForceQuit {
        return true
    }
    if action == EditorAction.SaveAndQuit {
        return saveFile(path, buffer, status)
    }
    return false
}

def keepCursorVisible(
buffer : EditorBuffer,
firstLine : usize,
maximumLines : usize
) : usize {
    val cursorLine : usize = buffer.line()
    if cursorLine < firstLine {
        return cursorLine
    }
    if cursorLine >= firstLine + maximumLines {
        return cursorLine - maximumLines + usize(1)
    }
    return firstLine
}

def maximumEditorFirst(
buffer : EditorBuffer,
maximumLines : usize
) : usize {
    return if buffer.lineCount() > maximumLines {
        buffer.lineCount() - maximumLines
    } else {
        usize(0)
    }
}

def scrollEditor(
buffer : EditorBuffer,
first : usize,
maximumLines : usize
) : usize {
    if mouseX() < editorLeft - 12 || mouseX() >= screenWidth() ||
    mouseY() < editorTop || mouseY() >= editorBottom {
        return first
    }
    val movement : float = mouseWheelMove()
    if movement > 0.0f {
        return if first > usize(2) { first - usize(3) } else { usize(0) }
    }
    if movement < 0.0f {
        val maximum : usize = maximumEditorFirst(buffer, maximumLines)
        val requested : usize = first + usize(3)
        return if requested < maximum { requested } else { maximum }
    }
    return first
}

def moveCursorToEditorMouse(
buffer : EditorBuffer,
firstLine : usize,
glyphAdvance : float,
lineAdvance : float,
maximumLines : usize
) : Unit {
    val relativeY : int = mouseY() - editorTop - 12
    var row : usize = if relativeY > 0 {
        numericCast[usize](truncatingCast[int](
        numericCast[float](relativeY) / lineAdvance
        ))
    } else {
        usize(0)
    }
    if maximumLines > usize(0) && row >= maximumLines {
        row = maximumLines - usize(1)
    }
    val relativeX : int = mouseX() - editorLeft
    val column : usize = if relativeX > 0 {
        numericCast[usize](truncatingCast[int](
        (numericCast[float](relativeX) + glyphAdvance * 0.5f) /
        glyphAdvance
        ))
    } else {
        usize(0)
    }
    buffer.moveTo(firstLine + row, column)
}

def explorerVisibleRows() : usize {
    val available : int = screenHeight() - statusBarHeight -
    commandLineHeight - explorerTreeTop
    if available <= 0 {
        return usize(0)
    }
    return numericCast[usize](available / explorerRowHeight)
}

def maximumExplorerFirst(
explorer : ProjectExplorer,
visibleRows : usize
) : usize {
    return if explorer.size() > visibleRows {
        explorer.size() - visibleRows
    } else {
        usize(0)
    }
}

def scrollExplorer(
explorer : ProjectExplorer,
first : usize,
visibleRows : usize
) : usize {
    if mouseX() >= editorLeft - 12 || mouseY() < explorerTreeTop ||
    mouseY() >= explorerTreeTop +
    truncatingCast[int](visibleRows) * explorerRowHeight {
        return first
    }
    val movement : float = mouseWheelMove()
    if movement > 0.0f {
        return if first > usize(2) { first - usize(3) } else { usize(0) }
    }
    if movement < 0.0f {
        val maximum : usize = maximumExplorerFirst(explorer, visibleRows)
        val requested : usize = first + usize(3)
        return if requested < maximum { requested } else { maximum }
    }
    return first
}

def explorerEntryAtMouse(
explorer : ProjectExplorer,
first : usize,
visibleRows : usize
) : usize {
    if mouseX() < 0 || mouseX() >= editorLeft - 12 ||
    mouseY() < explorerTreeTop ||
    mouseY() >= explorerTreeTop +
    truncatingCast[int](visibleRows) * explorerRowHeight {
        return usize(-1)
    }
    val row : usize = numericCast[usize](
    (mouseY() - explorerTreeTop) / explorerRowHeight
    )
    val index : usize = first + row
    return if index < explorer.size() { index } else { usize(-1) }
}

def openExplorerFile(
path : string,
activePath : TextBuilder,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    if buffer.isModified() {
        setStatus(
        status,
        "Enregistrez les modifications avant d'ouvrir un autre fichier."
        )
        return false
    }
    if !openExistingFile(path, buffer, status) {
        return false
    }
    activePath.clear()
    activePath.append(path)
    return true
}

def buildStatusLine(
output : TextBuilder,
path : string,
buffer : EditorBuffer
) : Unit {
    output.clear()
    output.append(path)
    output.append(if buffer.isModified() { "  • modifié" } else { "  • enregistré" })
    output.append("    ligne ")
    output.appendUSize(buffer.line() + usize(1))
    output.append(", colonne ")
    output.appendUSize(buffer.column() + usize(1))
}

def drawUiText(
font : Font,
text : string,
x : int,
y : int,
size : float,
color : Color
) : Unit {
    font.draw(
    text,
    vector2(numericCast[float](x), numericCast[float](y)),
    size,
    0.25f,
    color
    )
}

def drawCodeText(
font : Font,
text : string,
x : int,
y : int,
size : float,
color : Color
) : Unit {
    font.draw(
    text,
    vector2(numericCast[float](x), numericCast[float](y)),
    size,
    codeFontSpacing,
    color
    )
}

def syntaxColor(kind : SyntaxKind) : Color {
    if kind == SyntaxKind.Keyword {
        return rgb(198, 120, 221)
    }
    if kind == SyntaxKind.Type {
        return rgb(97, 175, 239)
    }
    if kind == SyntaxKind.String {
        return rgb(152, 195, 121)
    }
    if kind == SyntaxKind.Character {
        return rgb(86, 182, 194)
    }
    if kind == SyntaxKind.Number {
        return rgb(209, 154, 102)
    }
    if kind == SyntaxKind.Comment {
        return rgb(92, 110, 124)
    }
    if kind == SyntaxKind.Operator {
        return rgb(229, 192, 123)
    }
    return rgb(220, 223, 228)
}

def modeColor(mode : EditorMode) : Color {
    if mode == EditorMode.Insert {
        return rgb(82, 183, 136)
    }
    if mode == EditorMode.Command {
        return rgb(229, 192, 123)
    }
    return rgb(97, 175, 239)
}

def drawHighlightedCode(
font : Font,
characters : Array[char],
spans : Array[SyntaxSpan],
glyph : TextBuilder,
x : int,
y : int,
glyphAdvance : float,
lineAdvance : float
) : Unit {
    var line : usize = usize(0)
    var column : usize = usize(0)
    var spanIndex : usize = usize(0)
    while spanIndex < spans.size() {
        val span : SyntaxSpan = spans.get(spanIndex)
        val color : Color = syntaxColor(span.kind)
        var index : usize = span.start
        val end : usize = span.start + span.length
        while index < end {
            val value : char = characters.get(index)
            if value == '\n' {
                line = line + usize(1)
                column = usize(0)
            } else {
                if value != ' ' && value != '\t' && value != '\r' {
                    glyph.clear()
                    glyph.appendChar(value)
                    drawCodeText(
                    font,
                    glyph.view(),
                    x + truncatingCast[int](
                    numericCast[float](truncatingCast[int](column)) * glyphAdvance
                    ),
                    y + truncatingCast[int](
                    numericCast[float](truncatingCast[int](line)) * lineAdvance
                    ),
                    codeFontSize,
                    color
                    )
                }
                column = column + usize(1)
            }
            index = index + usize(1)
        }
        spanIndex = spanIndex + usize(1)
    }
}

def drawExplorer(
explorer : ProjectExplorer,
firstEntry : usize,
visibleRows : usize,
label : TextBuilder,
font : Font,
muted : Color
) : Unit {
    var index : usize = firstEntry
    var row : usize = usize(0)
    while index < explorer.size() && row < visibleRows {
        val y : int = explorerTreeTop +
        truncatingCast[int](row) * explorerRowHeight
        if explorer.selected() == index {
            drawRectangle(
            0,
            y - 1,
            editorLeft - 12,
            explorerRowHeight,
            rgb(46, 59, 75)
            )
        }
        val x : int = 12 + truncatingCast[int](explorer.depth(index)) *
        explorerIndentWidth
        if explorer.isDirectory(index) {
            drawUiText(
            font,
            if explorer.isExpanded(index) { "v" } else { ">" },
            x,
            y + 2,
            14.0f,
            White
            )
        } else {
            drawUiText(font, "-", x, y + 2, 14.0f, muted)
        }
        explorer.appendLabel(index, label)
        drawUiText(
        font,
        label.view(),
        x + 16,
        y + 2,
        14.0f,
        if explorer.isDirectory(index) { White } else { muted }
        )
        index = index + usize(1)
        row = row + usize(1)
    }
}

def drawStudio(
path : string,
buffer : EditorBuffer,
firstLine : usize,
visibleCharacters : Array[char],
syntaxSpans : Array[SyntaxSpan],
glyph : TextBuilder,
completion : CompletionModel,
completionText : TextBuilder,
pathPrompt : PathPrompt,
statusLine : TextBuilder,
status : TextBuilder,
toolOutput : TextBuilder,
modeLine : TextBuilder,
commandLine : TextBuilder,
explorer : ProjectExplorer,
firstExplorerEntry : usize,
visibleExplorerRows : usize,
explorerLabel : TextBuilder,
fileMenuOpen : bool,
mode : EditorMode,
uiFont : Font,
codeFont : Font,
glyphAdvance : float,
lineAdvance : float,
maximumLines : usize
) : Unit {
    buffer.appendVisibleCharacters(visibleCharacters, firstLine, maximumLines)
    highlight(visibleCharacters, syntaxSpans)
    buildStatusLine(statusLine, path, buffer)

    val background : Color = rgb(18, 24, 33)
    val sidebar : Color = rgb(25, 34, 46)
    val header : Color = rgb(31, 43, 57)
    val panel : Color = rgb(13, 18, 25)
    val accent : Color = rgb(82, 183, 136)
    val muted : Color = rgb(151, 166, 181)
    val bottomStatusY : int = screenHeight() - statusBarHeight - commandLineHeight
    val commandLineY : int = screenHeight() - commandLineHeight

    beginDrawing()
    clearBackground(background)
    drawRectangle(0, 0, screenWidth(), editorTop, header)
    drawRectangle(0, editorTop, editorLeft - 12, screenHeight() - editorTop, sidebar)
    drawRectangle(editorLeft - 12, editorBottom, screenWidth() - editorLeft + 12, screenHeight() - editorBottom, panel)
    drawRectangle(
    editorLeft - 14,
    editorTop,
    4,
    screenHeight() - editorTop - statusBarHeight - commandLineHeight,
    if explorerSeparatorHovered() { accent } else { header }
    )
    drawRectangle(
    editorLeft - 12,
    editorBottom - 2,
    screenWidth() - editorLeft + 12,
    4,
    if outputSeparatorHovered() { accent } else { header }
    )

    drawUiText(uiFont, "JANUS STUDIO", 18, 13, 23.0f, accent)
    if fileMenuOpen {
        drawRectangle(fileMenuX, 0, fileMenuButtonWidth, editorTop, rgb(46, 59, 75))
    }
    drawUiText(uiFont, "FICHIER", fileMenuX + 10, 18, 14.0f, White)

    drawUiText(uiFont, "EXPLORATEUR", 18, 72, 16.0f, muted)
    drawExplorer(
    explorer,
    firstExplorerEntry,
    visibleExplorerRows,
    explorerLabel,
    uiFont,
    muted
    )

    drawHighlightedCode(
    codeFont,
    visibleCharacters,
    syntaxSpans,
    glyph,
    editorLeft,
    editorTop + 12,
    glyphAdvance,
    lineAdvance
    )
    val cursorVisible : bool = buffer.line() >= firstLine &&
    buffer.line() < firstLine + maximumLines
    var cursorX : int = editorLeft
    var cursorY : int = editorTop + 12
    if cursorVisible {
        val cursorColumn : float = numericCast[float](
        truncatingCast[int](buffer.column())
        )
        val cursorLine : float = numericCast[float](
        truncatingCast[int](buffer.line() - firstLine)
        )
        cursorX = editorLeft + truncatingCast[int](cursorColumn * glyphAdvance)
        cursorY = editorTop + 12 +
        truncatingCast[int](cursorLine * lineAdvance)
        val cursorWidth : int = if mode == EditorMode.Insert {
            2
        } else {
            truncatingCast[int](glyphAdvance)
        }
        drawRectangle(cursorX, cursorY, cursorWidth, 23, accent)
    }

    if buffer.lineCount() > maximumLines {
        val trackHeight : int = editorBottom - editorTop
        val lineCount : int = truncatingCast[int](buffer.lineCount())
        var thumbHeight : int = trackHeight *
        truncatingCast[int](maximumLines) / lineCount
        if thumbHeight < 28 {
            thumbHeight = 28
        }
        val maximumFirst : int = truncatingCast[int](
        maximumEditorFirst(buffer, maximumLines)
        )
        val thumbY : int = editorTop +
        (trackHeight - thumbHeight) * truncatingCast[int](firstLine) /
        maximumFirst
        drawRectangle(screenWidth() - 8, editorTop, 8, trackHeight, panel)
        drawRectangle(screenWidth() - 7, thumbY, 6, thumbHeight, muted)
    }

    if completion.isVisible() && cursorVisible {
        val shown : usize = if completion.size() < usize(8) {
            completion.size()
        } else {
            usize(8)
        }
        val popupHeight : int = truncatingCast[int](shown) * 24 + 10
        val requestedX : int = cursorX
        val popupX : int = if requestedX + 330 < screenWidth() {
            requestedX
        } else {
            screenWidth() - 330
        }
        val popupY : int = if cursorY + 27 + popupHeight < editorBottom {
            cursorY + 27
        } else {
            cursorY - popupHeight
        }
        drawRectangle(popupX, popupY, 320, popupHeight, rgb(31, 43, 57))
        completion.appendVisible(completionText, usize(8))
        drawCodeText(
        codeFont,
        completionText.view(),
        popupX + 8,
        popupY + 5,
        17.0f,
        rgb(220, 223, 228)
        )
    }

    if fileMenuOpen {
        drawRectangle(
        fileMenuX,
        fileMenuTop,
        fileMenuWidth,
        fileMenuRowHeight * 2 + 8,
        rgb(31, 43, 57)
        )
        if pointInArea(fileMenuX, fileMenuTop, fileMenuWidth, fileMenuRowHeight) {
            drawRectangle(
            fileMenuX,
            fileMenuTop,
            fileMenuWidth,
            fileMenuRowHeight,
            rgb(46, 59, 75)
            )
        }
        if pointInArea(
        fileMenuX,
        fileMenuTop + fileMenuRowHeight,
        fileMenuWidth,
        fileMenuRowHeight
        ) {
            drawRectangle(
            fileMenuX,
            fileMenuTop + fileMenuRowHeight,
            fileMenuWidth,
            fileMenuRowHeight,
            rgb(46, 59, 75)
            )
        }
        drawUiText(
        uiFont,
        "Ouvrir un dossier...",
        fileMenuX + 14,
        fileMenuTop + 9,
        15.0f,
        White
        )
        drawUiText(
        uiFont,
        "Fermer le dossier",
        fileMenuX + 14,
        fileMenuTop + fileMenuRowHeight + 9,
        15.0f,
        if explorer.size() > usize(0) { White } else { muted }
        )
    }

    if pathPrompt.isVisible() {
        val dialogX : int = (screenWidth() - 720) / 2
        val dialogY : int = 230
        val dialogWidth : int = 720
        drawRectangle(dialogX, dialogY, dialogWidth, 154, rgb(31, 43, 57))
        drawUiText(
        uiFont,
        pathPromptTitle(pathPrompt.action()),
        dialogX + 20,
        dialogY + 18,
        18.0f,
        accent
        )
        drawRectangle(
        dialogX + 20,
        dialogY + 55,
        dialogWidth - 40,
        42,
        rgb(18, 24, 33)
        )
        drawCodeText(
        codeFont,
        pathPrompt.value(),
        dialogX + 30,
        dialogY + 64,
        17.0f,
        White
        )
        val promptGlyph : Vector2 = codeFont.measure(
        "M",
        17.0f,
        codeFontSpacing
        )
        val promptAdvance : float = codeFont.measure(
        "MM",
        17.0f,
        codeFontSpacing
        ).x - promptGlyph.x
        drawRectangle(
        dialogX + 30 + truncatingCast[int](
        numericCast[float](truncatingCast[int](pathPrompt.cursor())) *
        promptAdvance
        ),
        dialogY + 63,
        2,
        22,
        accent
        )
        drawUiText(
        uiFont,
        "Tab : compléter    Entrée : valider    Esc : annuler",
        dialogX + 20,
        dialogY + 116,
        15.0f,
        muted
        )
    }

    drawUiText(
    uiFont,
    "SORTIE JANUS",
    editorLeft,
    editorBottom + 16,
    15.0f,
    accent
    )
    drawCodeText(
    codeFont,
    toolOutput.view(),
    editorLeft,
    editorBottom + 42,
    15.0f,
    muted
    )

    drawRectangle(0, bottomStatusY, screenWidth(), statusBarHeight, header)
    drawRectangle(
    0,
    bottomStatusY,
    editorLeft - 12,
    statusBarHeight,
    modeColor(mode)
    )
    drawUiText(uiFont, modeLine.view(), 14, bottomStatusY + 5, 15.0f, background)
    drawUiText(
    uiFont,
    statusLine.view(),
    editorLeft,
    bottomStatusY + 5,
    15.0f,
    White
    )
    drawRectangle(0, commandLineY, screenWidth(), commandLineHeight, panel)
    if mode == EditorMode.Command {
        drawCodeText(
        codeFont,
        commandLine.view(),
        12,
        commandLineY + 3,
        17.0f,
        White
        )
    } else {
        drawUiText(
        uiFont,
        status.view(),
        12,
        commandLineY + 5,
        15.0f,
        muted
        )
    }
    endDrawing()
}

def main() : int {
    val projectRoot : TextBuilder = new TextBuilder()
    defer delete projectRoot
    if !captureProjectRoot(projectRoot) {
        projectRoot.append(".")
    }
    val explorer : ProjectExplorer = projectExplorer(projectRoot.view())
    defer delete explorer
    val explorerLabel : TextBuilder = new TextBuilder()
    defer delete explorerLabel
    val explorerPath : TextBuilder = new TextBuilder()
    defer delete explorerPath
    val activePath : TextBuilder = new TextBuilder()
    defer delete activePath
    activePath.append(selectedPath())
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    val status : TextBuilder = new TextBuilder()
    defer delete status
    val visibleCharacters : Array[char] = new Array[char](usize(2048))
    defer delete visibleCharacters
    val syntaxSpans : Array[SyntaxSpan] = new Array[SyntaxSpan](usize(512))
    defer delete syntaxSpans
    val glyph : TextBuilder = new TextBuilder()
    defer delete glyph
    val completion : CompletionModel = completionModel()
    defer delete completion
    val completionLabels : TextBuilder = new TextBuilder()
    defer delete completionLabels
    val completionError : TextBuilder = new TextBuilder()
    defer delete completionError
    val languageServer : LspClient = lspClient(completionError)
    defer delete languageServer
    val completionText : TextBuilder = new TextBuilder()
    defer delete completionText
    val filePrompt : PathPrompt = pathPrompt()
    defer delete filePrompt
    val statusLine : TextBuilder = new TextBuilder()
    defer delete statusLine
    val toolOutput : TextBuilder = new TextBuilder()
    defer delete toolOutput
    val modeLine : TextBuilder = new TextBuilder()
    defer delete modeLine
    val commandLine : TextBuilder = new TextBuilder()
    defer delete commandLine
    val controller : VimController = vimController()
    defer delete controller

    loadFile(activePath.view(), buffer, status)
    toolOutput.append("F5 lance `janus check` sur le fichier actif.")

    if !initWindow(1200, 760, "Janus Studio") {
        println("Impossible d'ouvrir la fenêtre Janus Studio.")
        return 1
    }
    defer closeWindow()
    disableExitKey()

    val fontCharacters : string =
    " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~•€ÀÂÇÉÈÊËÎÏÔÙÛÜŸàâçéèêëîïôùûüÿŒœ"
    val uiFont : Font = loadFontUtf8(
    "assets/fonts/DejaVuSans.ttf",
    32,
    fontCharacters
    )
    defer delete uiFont
    val codeFont : Font = loadFontUtf8(
    codeFontPath(),
    32,
    fontCharacters
    )
    defer delete codeFont
    if !uiFont.isValid() || !codeFont.isValid() {
        println("Impossible de charger les polices de Janus Studio.")
        return 1
    }
    val oneGlyph : Vector2 = codeFont.measure(
    "M",
    codeFontSize,
    codeFontSpacing
    )
    val glyphAdvance : float = codeFont.measure(
    "MM",
    codeFontSize,
    codeFontSpacing
    ).x - oneGlyph.x
    val lineAdvance : float = codeFont.measure(
    "M\nM",
    codeFontSize,
    codeFontSpacing
    ).y - oneGlyph.y
    var maximumLines : usize = numericCast[usize](truncatingCast[int](
    numericCast[float](editorBottom - editorTop - 12) / lineAdvance
    ))
    setTargetFps(60)

    var firstLine : usize = usize(0)
    var firstExplorerEntry : usize = usize(0)
    var lastExplorerClick : usize = usize(-1)
    var lastExplorerClickAt : usize = usize(0)
    var quitRequested : bool = false
    var fileMenuOpen : bool = false
    var editorScrollDetached : bool = false
    var paneResize : PaneResize = PaneResize.None
    while !windowShouldClose() && !quitRequested {
        val control : bool = controlDown()
        val shift : bool = shiftDown()
        val cursorLineBeforeInput : usize = buffer.line()
        val cursorColumnBeforeInput : usize = buffer.column()
        val leftMousePressed : bool = isMouseButtonPressed(MouseButton.Left)
        var fileInputConsumed : bool = false
        var layoutMouseConsumed : bool = false
        if paneResize == PaneResize.None && leftMousePressed {
            if explorerSeparatorHovered() {
                paneResize = PaneResize.Explorer
            } else if outputSeparatorHovered() {
                paneResize = PaneResize.Output
            }
        }
        if paneResize != PaneResize.None {
            if isMouseButtonDown(MouseButton.Left) {
                if paneResize == PaneResize.Explorer {
                    resizeExplorerToMouse()
                } else {
                    resizeOutputToMouse()
                }
                layoutMouseConsumed = true
            } else {
                paneResize = PaneResize.None
            }
        }
        if paneResize == PaneResize.Explorer || explorerSeparatorHovered() {
            setMouseCursor(MouseCursor.ResizeEastWest)
        } else if paneResize == PaneResize.Output || outputSeparatorHovered() {
            setMouseCursor(MouseCursor.ResizeNorthSouth)
        } else {
            setMouseCursor(MouseCursor.Default)
        }
        maximumLines = numericCast[usize](truncatingCast[int](
        numericCast[float](editorBottom - editorTop - 12) / lineAdvance
        ))
        val maximumFirstAfterResize : usize = maximumEditorFirst(
        buffer,
        maximumLines
        )
        if firstLine > maximumFirstAfterResize {
            firstLine = maximumFirstAfterResize
        }
        val visibleExplorerRows : usize = explorerVisibleRows()
        firstExplorerEntry = scrollExplorer(
        explorer,
        firstExplorerEntry,
        visibleExplorerRows
        )
        if !filePrompt.isVisible() && !fileMenuOpen {
            val scrolledEditorFirst : usize = scrollEditor(
            buffer,
            firstLine,
            maximumLines
            )
            if scrolledEditorFirst != firstLine {
                firstLine = scrolledEditorFirst
                editorScrollDetached = true
                completion.dismiss()
            }
        }
        if !layoutMouseConsumed && !filePrompt.isVisible() && leftMousePressed &&
        pointInArea(fileMenuX, 0, fileMenuButtonWidth, editorTop) {
            fileMenuOpen = !fileMenuOpen
            fileInputConsumed = true
        } else if !layoutMouseConsumed && !filePrompt.isVisible() && fileMenuOpen &&
        leftMousePressed {
            if pointInArea(
            fileMenuX,
            fileMenuTop,
            fileMenuWidth,
            fileMenuRowHeight
            ) {
                filePrompt.begin(PathPromptAction.OpenFolder, projectRoot.view())
                completion.dismiss()
            } else if pointInArea(
            fileMenuX,
            fileMenuTop + fileMenuRowHeight,
            fileMenuWidth,
            fileMenuRowHeight
            ) && explorer.size() > usize(0) {
                explorer.close()
                projectRoot.clear()
                firstExplorerEntry = usize(0)
                setStatus(status, "Dossier fermé.")
            }
            fileMenuOpen = false
            fileInputConsumed = true
        } else if !layoutMouseConsumed && !filePrompt.isVisible() && leftMousePressed &&
        mouseX() >= 0 && mouseX() < editorLeft - 12 {
            val clicked : usize = explorerEntryAtMouse(
            explorer,
            firstExplorerEntry,
            visibleExplorerRows
            )
            if clicked != usize(-1) {
                explorer.select(clicked)
                if explorer.isDirectory(clicked) {
                    explorer.toggle(clicked)
                    val maximum : usize = maximumExplorerFirst(
                    explorer,
                    visibleExplorerRows
                    )
                    if firstExplorerEntry > maximum {
                        firstExplorerEntry = maximum
                    }
                    lastExplorerClick = usize(-1)
                } else {
                    val clickedAt : usize = wallNow().unixMilliseconds()
                    val isDoubleClick : bool =
                    clicked == lastExplorerClick &&
                    clickedAt >= lastExplorerClickAt &&
                    clickedAt - lastExplorerClickAt <=
                    doubleClickDelayMilliseconds
                    if isDoubleClick {
                        explorer.appendPath(clicked, explorerPath)
                        if openExplorerFile(
                        explorerPath.view(),
                        activePath,
                        buffer,
                        status
                        ) {
                            firstLine = usize(0)
                            editorScrollDetached = false
                            completion.dismiss()
                            controller.escape()
                        }
                        lastExplorerClick = usize(-1)
                    } else {
                        lastExplorerClick = clicked
                        lastExplorerClickAt = clickedAt
                    }
                }
                fileInputConsumed = true
            }
        } else if !layoutMouseConsumed && !filePrompt.isVisible() && leftMousePressed &&
        pointInArea(
        editorLeft,
        editorTop,
        screenWidth() - editorLeft - 8,
        editorBottom - editorTop
        ) {
            moveCursorToEditorMouse(
            buffer,
            firstLine,
            glyphAdvance,
            lineAdvance,
            maximumLines
            )
            editorScrollDetached = false
            completion.dismiss()
            fileInputConsumed = true
        }
        if fileMenuOpen {
            if isKeyPressed(Key.Escape) {
                fileMenuOpen = false
            }
            fileInputConsumed = true
        }
        if filePrompt.isVisible() {
            if handlePathPromptKeys(filePrompt) {
                if filePrompt.action() == PathPromptAction.OpenFolder {
                    if openProjectFolder(
                    filePrompt.value(),
                    projectRoot,
                    explorer,
                    status
                    ) {
                        filePrompt.dismiss()
                        firstExplorerEntry = usize(0)
                    }
                } else {
                    applyPathPrompt(filePrompt, activePath, buffer, status)
                    firstLine = usize(0)
                    editorScrollDetached = false
                }
            }
            fileInputConsumed = true
        } else if !fileInputConsumed && control && shift &&
        isKeyPressed(Key.S) {
            filePrompt.begin(PathPromptAction.SaveAs, activePath.view())
            completion.dismiss()
            fileInputConsumed = true
        } else if !fileInputConsumed && control && isKeyPressed(Key.O) {
            if buffer.isModified() {
                setStatus(status, "Enregistrez les modifications avant d'ouvrir un fichier.")
            } else {
                filePrompt.begin(PathPromptAction.Open, "")
                completion.dismiss()
            }
            fileInputConsumed = true
        } else if !fileInputConsumed && control && isKeyPressed(Key.N) {
            if buffer.isModified() {
                setStatus(status, "Enregistrez les modifications avant de créer un fichier.")
            } else {
                filePrompt.begin(PathPromptAction.Create, "")
                completion.dismiss()
            }
            fileInputConsumed = true
        }

        if !fileInputConsumed && control && isKeyPressed(Key.S) {
            saveFile(activePath.view(), buffer, status)
            fileInputConsumed = true
        }
        if !fileInputConsumed && isKeyPressed(Key.F5) {
            if saveFile(activePath.view(), buffer, status) {
                checkFile(activePath.view(), toolOutput)
            }
            fileInputConsumed = true
        }

        val completionConsumed : bool =
        if fileInputConsumed { true } else { handleCompletionKeys(completion, buffer) }
        var keyAction : EditorAction = EditorAction.None
        var characterAction : EditorAction = EditorAction.None
        if !completionConsumed {
            keyAction = handleModeKeys(controller, buffer)
            characterAction = handlePrintableKeys(controller, buffer)
        }
        val manualCompletion : bool =
        controller.mode() == EditorMode.Insert && control &&
        isKeyPressed(Key.Space)
        if characterAction == EditorAction.Complete || manualCompletion {
            refreshCompletion(
            languageServer,
            activePath.view(),
            buffer,
            completion,
            completionLabels,
            completionError,
            status
            )
            characterAction = EditorAction.None
        } else if characterAction == EditorAction.DismissCompletion {
            completion.dismiss()
            characterAction = EditorAction.None
        } else if !completionConsumed && completion.isVisible() &&
        (isKeyPressed(Key.Left) || isKeyPressed(Key.Right) ||
        isKeyPressed(Key.Home) || isKeyPressed(Key.End) ||
        isKeyPressed(Key.Backspace) || isKeyPressed(Key.Delete)) {
            completion.dismiss()
        }
        quitRequested = applyEditorAction(
        if keyAction != EditorAction.None { keyAction } else { characterAction },
        activePath.view(),
        buffer,
        status
        )
        if buffer.line() != cursorLineBeforeInput ||
        buffer.column() != cursorColumnBeforeInput ||
        isKeyPressed(Key.Delete) {
            editorScrollDetached = false
        }
        if !editorScrollDetached {
            firstLine = keepCursorVisible(buffer, firstLine, maximumLines)
        }
        controller.appendStatus(modeLine)
        controller.appendCommandLine(commandLine)
        drawStudio(
        activePath.view(),
        buffer,
        firstLine,
        visibleCharacters,
        syntaxSpans,
        glyph,
        completion,
        completionText,
        filePrompt,
        statusLine,
        status,
        toolOutput,
        modeLine,
        commandLine,
        explorer,
        firstExplorerEntry,
        visibleExplorerRows,
        explorerLabel,
        fileMenuOpen,
        controller.mode(),
        uiFont,
        codeFont,
        glyphAdvance,
        lineAdvance,
        maximumLines
        )
    }

    return 0
}
