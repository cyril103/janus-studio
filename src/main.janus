import studio.application
import studio.state
import tooling.compiler
import std.graphics

def main() : int {
    if compilerWorkerRequested() { return runRequestedCompilerWorker() }
    if !openStudioWindow() {
        println("Impossible d'ouvrir la fenêtre Janus Studio.")
        return 1
    }
    defer closeWindow()

    var display : StudioDisplay = studioDisplay()
    defer delete display
    if !display.isValid() {
        println("Impossible de charger les polices de Janus Studio.")
        return 1
    }
    var app : StudioAppState = studioAppState()
    defer delete app
    val ui : StudioUiState = studioUiState()
    defer delete ui

    runStudioSession(app, ui, display)
    borrow var completionError = app.tooling.completionError
    val _serverStopped : bool = app.tooling.languageServer.shutdown(
        completionError
    )
    return 0
}
