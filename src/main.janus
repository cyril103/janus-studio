import editor.buffer
import editor.syntax
import editor.vim
import tooling.compiler
import std.array
import std.fs
import std.graphics
import std.option
import std.process
import std.result
import std.system
import std.text

const editorLeft : int = 236
const editorTop : int = 54
const editorBottom : int = 590
const codeFontSize : float = 20.0f
const codeFontSpacing : float = 1.0f

def isFile(path : string) : bool {
    return match metadata(path) {
        Ok(value) => value.kind == FileType.File,
        Error(error) => false
    }
}

def codeFontPath() : string {
    val windowsPath : string = "C:/Windows/Fonts/consola.ttf"
    if isFile(windowsPath) {
        return windowsPath
    }
    val wslPath : string = "/mnt/c/Windows/Fonts/consola.ttf"
    if isFile(wslPath) {
        return wslPath
    }
    return "assets/fonts/DejaVuSansMono.ttf"
}

def selectedPath() : string {
    return match programArgument(usize(1)) {
        Some(path) => path,
        None => "samples/welcome.janus"
    }
}

def setStatus(status : TextBuilder, message : string) : Unit {
    status.clear()
    status.append(message)
}

def acceptFile(
data : FileData,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    buffer.load(data.view())
    buffer.moveFileStart()
    delete data
    setStatus(status, "Fichier chargé.")
    return true
}

def startEmptyFile(
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    buffer.clear()
    setStatus(status, "Nouveau fichier : Ctrl+S pour le créer.")
    return false
}

def loadFile(
path : string,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    val result : Result[FileData, SystemError] = readFile(path)
    return match move result {
        Ok(data) => acceptFile(move data, buffer, status),
        Error(error) => startEmptyFile(buffer, status)
    }
}

def saveSucceeded(
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    buffer.markSaved()
    setStatus(status, "Fichier enregistré.")
    return true
}

def saveFailed(status : TextBuilder) : bool {
    setStatus(status, "Échec de l'enregistrement.")
    return false
}

def saveFile(
path : string,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    val content : TextBuilder = new TextBuilder()
    defer delete content
    buffer.appendText(content)
    return match writeTextFileAtomic(path, content.view()) {
        Ok(written) => if written {
            saveSucceeded(buffer, status)
        } else {
            saveFailed(status)
        },
        Error(error) => saveFailed(status)
    }
}

def controlDown() : bool {
    return isKeyDown(Key.LeftControl) || isKeyDown(Key.RightControl)
}

def handleModeKeys(
controller : VimController,
buffer : EditorBuffer
) : EditorAction {
    if isKeyPressed(Key.Escape) {
        controller.escape()
        return EditorAction.None
    }
    if controller.mode() == EditorMode.Command {
        if isKeyPressed(Key.Backspace) {
            controller.commandBackspace()
        }
        if isKeyPressed(Key.Enter) {
            return controller.executeCommand()
        }
        return EditorAction.None
    }
    if isKeyPressed(Key.Left) {
        buffer.moveLeft()
    }
    if isKeyPressed(Key.Right) {
        buffer.moveRightInLine()
    }
    if isKeyPressed(Key.Up) {
        buffer.moveUp()
    }
    if isKeyPressed(Key.Down) {
        buffer.moveDown()
    }
    if isKeyPressed(Key.Home) {
        buffer.moveHome()
    }
    if isKeyPressed(Key.End) {
        buffer.moveEnd()
    }
    if controller.mode() == EditorMode.Normal {
        if isKeyPressed(Key.Delete) {
            buffer.deleteCharacter()
        }
        if controlDown() && isKeyPressed(Key.R) {
            buffer.redo()
        }
        return EditorAction.None
    }
    if isKeyPressed(Key.Backspace) {
        buffer.backspace()
    }
    if isKeyPressed(Key.Delete) {
        buffer.deleteForward()
    }
    if isKeyPressed(Key.Enter) {
        buffer.insert('\n')
    }
    if isKeyPressed(Key.Tab) {
        buffer.insertSpaces(usize(4))
    }
    return EditorAction.None
}

def handlePrintableKeys(
controller : VimController,
buffer : EditorBuffer
) : EditorAction {
    val control : bool = controlDown()
    var action : EditorAction = EditorAction.None
    var codepoint : int = characterPressed()
    while codepoint != 0 {
        if !control && codepoint >= 32 && codepoint != 127 {
            val value : char = char(codepoint)
            if controller.mode() == EditorMode.Insert {
                controller.handleInsert(value, buffer)
            } else if controller.mode() == EditorMode.Command {
                controller.handleCommand(value)
            } else {
                action = controller.handleNormal(value, buffer)
            }
        }
        codepoint = characterPressed()
    }
    return action
}

def applyEditorAction(
action : EditorAction,
path : string,
buffer : EditorBuffer,
status : TextBuilder
) : bool {
    if action == EditorAction.Save {
        saveFile(path, buffer, status)
        return false
    }
    if action == EditorAction.Quit {
        if buffer.isModified() {
            setStatus(status, "Modifications non enregistrées — utilisez :q!")
            return false
        }
        return true
    }
    if action == EditorAction.ForceQuit {
        return true
    }
    if action == EditorAction.SaveAndQuit {
        return saveFile(path, buffer, status)
    }
    return false
}

def keepCursorVisible(
buffer : EditorBuffer,
firstLine : usize,
maximumLines : usize
) : usize {
    val cursorLine : usize = buffer.line()
    if cursorLine < firstLine {
        return cursorLine
    }
    if cursorLine >= firstLine + maximumLines {
        return cursorLine - maximumLines + usize(1)
    }
    return firstLine
}

def buildStatusLine(
output : TextBuilder,
path : string,
buffer : EditorBuffer
) : Unit {
    output.clear()
    output.append(path)
    output.append(if buffer.isModified() { "  • modifié" } else { "  • enregistré" })
    output.append("    ligne ")
    output.appendUSize(buffer.line() + usize(1))
    output.append(", colonne ")
    output.appendUSize(buffer.column() + usize(1))
}

def drawUiText(
font : Font,
text : string,
x : int,
y : int,
size : float,
color : Color
) : Unit {
    font.draw(
    text,
    vector2(numericCast[float](x), numericCast[float](y)),
    size,
    0.25f,
    color
    )
}

def drawCodeText(
font : Font,
text : string,
x : int,
y : int,
size : float,
color : Color
) : Unit {
    font.draw(
    text,
    vector2(numericCast[float](x), numericCast[float](y)),
    size,
    codeFontSpacing,
    color
    )
}

def syntaxColor(kind : SyntaxKind) : Color {
    if kind == SyntaxKind.Keyword {
        return rgb(198, 120, 221)
    }
    if kind == SyntaxKind.Type {
        return rgb(97, 175, 239)
    }
    if kind == SyntaxKind.String {
        return rgb(152, 195, 121)
    }
    if kind == SyntaxKind.Character {
        return rgb(86, 182, 194)
    }
    if kind == SyntaxKind.Number {
        return rgb(209, 154, 102)
    }
    if kind == SyntaxKind.Comment {
        return rgb(92, 110, 124)
    }
    if kind == SyntaxKind.Operator {
        return rgb(229, 192, 123)
    }
    return rgb(220, 223, 228)
}

def drawHighlightedCode(
font : Font,
characters : Array[char],
spans : Array[SyntaxSpan],
glyph : TextBuilder,
x : int,
y : int,
glyphAdvance : float,
lineAdvance : float
) : Unit {
    var line : usize = usize(0)
    var column : usize = usize(0)
    var spanIndex : usize = usize(0)
    while spanIndex < spans.size() {
        val span : SyntaxSpan = spans.get(spanIndex)
        val color : Color = syntaxColor(span.kind)
        var index : usize = span.start
        val end : usize = span.start + span.length
        while index < end {
            val value : char = characters.get(index)
            if value == '\n' {
                line = line + usize(1)
                column = usize(0)
            } else {
                if value != ' ' && value != '\t' && value != '\r' {
                    glyph.clear()
                    glyph.appendChar(value)
                    drawCodeText(
                    font,
                    glyph.view(),
                    x + truncatingCast[int](
                    numericCast[float](truncatingCast[int](column)) * glyphAdvance
                    ),
                    y + truncatingCast[int](
                    numericCast[float](truncatingCast[int](line)) * lineAdvance
                    ),
                    codeFontSize,
                    color
                    )
                }
                column = column + usize(1)
            }
            index = index + usize(1)
        }
        spanIndex = spanIndex + usize(1)
    }
}

def drawStudio(
path : string,
buffer : EditorBuffer,
firstLine : usize,
visibleCharacters : Array[char],
syntaxSpans : Array[SyntaxSpan],
glyph : TextBuilder,
statusLine : TextBuilder,
status : TextBuilder,
toolOutput : TextBuilder,
modeLine : TextBuilder,
mode : EditorMode,
uiFont : Font,
codeFont : Font,
glyphAdvance : float,
lineAdvance : float,
maximumLines : usize
) : Unit {
    buffer.appendVisibleCharacters(visibleCharacters, firstLine, maximumLines)
    highlight(visibleCharacters, syntaxSpans)
    buildStatusLine(statusLine, path, buffer)

    val background : Color = rgb(18, 24, 33)
    val sidebar : Color = rgb(25, 34, 46)
    val header : Color = rgb(31, 43, 57)
    val panel : Color = rgb(13, 18, 25)
    val accent : Color = rgb(82, 183, 136)
    val muted : Color = rgb(151, 166, 181)

    beginDrawing()
    clearBackground(background)
    drawRectangle(0, 0, screenWidth(), editorTop, header)
    drawRectangle(0, editorTop, editorLeft - 12, screenHeight() - editorTop, sidebar)
    drawRectangle(editorLeft - 12, editorBottom, screenWidth() - editorLeft + 12, screenHeight() - editorBottom, panel)

    drawUiText(uiFont, "JANUS STUDIO", 18, 13, 23.0f, accent)
    drawUiText(uiFont, statusLine.view(), editorLeft, 16, 17.0f, muted)

    drawUiText(uiFont, "EXPLORATEUR", 18, 72, 16.0f, muted)
    drawUiText(uiFont, path, 18, 104, 17.0f, White)
    drawUiText(uiFont, "RACCOURCIS", 18, 164, 16.0f, muted)
    drawUiText(uiFont, "i/a/o   insertion", 18, 196, 16.0f, White)
    drawUiText(uiFont, "h/j/k/l déplacement", 18, 222, 16.0f, White)
    drawUiText(uiFont, "dd/yy   couper/copier", 18, 248, 15.0f, White)
    drawUiText(uiFont, "p/P     coller", 18, 274, 16.0f, White)
    drawUiText(uiFont, "MODE", 18, 330, 16.0f, muted)
    drawUiText(uiFont, modeLine.view(), 18, 358, 16.0f, accent)
    drawUiText(uiFont, "ÉTAT", 18, 414, 16.0f, muted)
    drawUiText(uiFont, status.view(), 18, 442, 15.0f, White)

    drawHighlightedCode(
    codeFont,
    visibleCharacters,
    syntaxSpans,
    glyph,
    editorLeft,
    editorTop + 12,
    glyphAdvance,
    lineAdvance
    )
    val cursorColumn : float = numericCast[float](truncatingCast[int](buffer.column()))
    val cursorLine : float = numericCast[float](
    truncatingCast[int](buffer.line() - firstLine)
    )
    val cursorX : int = editorLeft + truncatingCast[int](cursorColumn * glyphAdvance)
    val cursorY : int = editorTop + 12 +
    truncatingCast[int](cursorLine * lineAdvance)
    val cursorWidth : int =
    if mode == EditorMode.Insert { 2 } else { truncatingCast[int](glyphAdvance) }
    drawRectangle(cursorX, cursorY, cursorWidth, 23, accent)

    drawUiText(uiFont, "SORTIE JANUS", editorLeft, 606, 15.0f, accent)
    drawCodeText(codeFont, toolOutput.view(), editorLeft, 632, 15.0f, muted)
    endDrawing()
}

def main() : int {
    val path : string = selectedPath()
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    val status : TextBuilder = new TextBuilder()
    defer delete status
    val visibleCharacters : Array[char] = new Array[char](usize(2048))
    defer delete visibleCharacters
    val syntaxSpans : Array[SyntaxSpan] = new Array[SyntaxSpan](usize(512))
    defer delete syntaxSpans
    val glyph : TextBuilder = new TextBuilder()
    defer delete glyph
    val statusLine : TextBuilder = new TextBuilder()
    defer delete statusLine
    val toolOutput : TextBuilder = new TextBuilder()
    defer delete toolOutput
    val modeLine : TextBuilder = new TextBuilder()
    defer delete modeLine
    val controller : VimController = vimController()
    defer delete controller

    loadFile(path, buffer, status)
    toolOutput.append("F5 lance `janus check` sur le fichier actif.")

    if !initWindow(1200, 760, "Janus Studio") {
        println("Impossible d'ouvrir la fenêtre Janus Studio.")
        return 1
    }
    defer closeWindow()
    disableExitKey()

    val fontCharacters : string =
    " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~•€ÀÂÇÉÈÊËÎÏÔÙÛÜŸàâçéèêëîïôùûüÿŒœ"
    val uiFont : Font = loadFontUtf8(
    "assets/fonts/DejaVuSans.ttf",
    32,
    fontCharacters
    )
    defer delete uiFont
    val codeFont : Font = loadFontUtf8(
    codeFontPath(),
    32,
    fontCharacters
    )
    defer delete codeFont
    if !uiFont.isValid() || !codeFont.isValid() {
        println("Impossible de charger les polices de Janus Studio.")
        return 1
    }
    val oneGlyph : Vector2 = codeFont.measure(
    "M",
    codeFontSize,
    codeFontSpacing
    )
    val glyphAdvance : float = codeFont.measure(
    "MM",
    codeFontSize,
    codeFontSpacing
    ).x - oneGlyph.x
    val lineAdvance : float = codeFont.measure(
    "M\nM",
    codeFontSize,
    codeFontSpacing
    ).y - oneGlyph.y
    val maximumLines : usize = numericCast[usize](truncatingCast[int](
    numericCast[float](editorBottom - editorTop - 12) / lineAdvance
    ))
    setTargetFps(60)

    var firstLine : usize = usize(0)
    var quitRequested : bool = false
    while !windowShouldClose() && !quitRequested {
        val control : bool = controlDown()
        if control && isKeyPressed(Key.S) {
            saveFile(path, buffer, status)
        }
        if control && isKeyPressed(Key.O) {
            loadFile(path, buffer, status)
        }
        if isKeyPressed(Key.F5) {
            if saveFile(path, buffer, status) {
                checkFile(path, toolOutput)
            }
        }

        val keyAction : EditorAction = handleModeKeys(controller, buffer)
        val characterAction : EditorAction = handlePrintableKeys(controller, buffer)
        quitRequested = applyEditorAction(
        if keyAction != EditorAction.None { keyAction } else { characterAction },
        path,
        buffer,
        status
        )
        firstLine = keepCursorVisible(buffer, firstLine, maximumLines)
        controller.appendStatus(modeLine)
        drawStudio(
        path,
        buffer,
        firstLine,
        visibleCharacters,
        syntaxSpans,
        glyph,
        statusLine,
        status,
        toolOutput,
        modeLine,
        controller.mode(),
        uiFont,
        codeFont,
        glyphAdvance,
        lineAdvance,
        maximumLines
        )
    }

    return 0
}
