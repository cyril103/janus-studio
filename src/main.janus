import editor.buffer
import editor.completion
import editor.explorer
import editor.path_prompt
import editor.search
import editor.syntax
import editor.vim
import studio.files
import studio.input
import studio.view
import tooling.compiler
import tooling.diagnostics
import tooling.lsp
import std.array
import std.graphics
import std.text
import std.wall_time

def main() : int {
    val projectRoot : TextBuilder = new TextBuilder()
    defer delete projectRoot
    if !captureProjectRoot(projectRoot) {
        projectRoot.append(".")
    }
    val explorer : ProjectExplorer = projectExplorer(projectRoot.view())
    defer delete explorer
    val explorerLabel : TextBuilder = new TextBuilder()
    defer delete explorerLabel
    val explorerPath : TextBuilder = new TextBuilder()
    defer delete explorerPath
    val activePath : TextBuilder = new TextBuilder()
    defer delete activePath
    activePath.append(selectedPath())
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    val status : TextBuilder = new TextBuilder()
    defer delete status
    val visibleCharacters : Array[char] = new Array[char](usize(2048))
    defer delete visibleCharacters
    val syntaxSpans : Array[SyntaxSpan] = new Array[SyntaxSpan](usize(512))
    defer delete syntaxSpans
    val glyph : TextBuilder = new TextBuilder()
    defer delete glyph
    val diagnostics : EditorDiagnostics = editorDiagnostics()
    defer delete diagnostics
    val diagnosticText : TextBuilder = new TextBuilder()
    defer delete diagnosticText
    val search : SearchModel = searchModel()
    defer delete search
    val completion : CompletionModel = completionModel()
    defer delete completion
    val completionLabels : TextBuilder = new TextBuilder()
    defer delete completionLabels
    val completionError : TextBuilder = new TextBuilder()
    defer delete completionError
    val languageServer : LspClient = lspClient(completionError)
    defer delete languageServer
    val completionText : TextBuilder = new TextBuilder()
    defer delete completionText
    val signatureText : TextBuilder = new TextBuilder()
    defer delete signatureText
    val pendingSignature : TextBuilder = new TextBuilder()
    defer delete pendingSignature
    val filePrompt : PathPrompt = pathPrompt()
    defer delete filePrompt
    val statusLine : TextBuilder = new TextBuilder()
    defer delete statusLine
    val toolOutput : TextBuilder = new TextBuilder()
    defer delete toolOutput
    val modeLine : TextBuilder = new TextBuilder()
    defer delete modeLine
    val commandLine : TextBuilder = new TextBuilder()
    defer delete commandLine
    val clipboard : TextBuilder = new TextBuilder()
    defer delete clipboard
    val controller : VimController = vimController()
    defer delete controller

    loadFile(activePath.view(), buffer, status)
    toolOutput.append("F5 lance `janus check` sur le fichier actif.")

    if !initWindow(1200, 760, "Janus Studio") {
        println("Impossible d'ouvrir la fenêtre Janus Studio.")
        return 1
    }
    defer closeWindow()
    setWindowResizable(true)
    disableExitKey()

    val fontCharacters : string =
    " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~•€ÀÂÇÉÈÊËÎÏÔÙÛÜŸàâçéèêëîïôùûüÿŒœ"
    val uiFont : Font = loadFontUtf8(
    "assets/fonts/DejaVuSans.ttf",
    32,
    fontCharacters
    )
    defer delete uiFont
    val codeFont : Font = loadFontUtf8(
    codeFontPath(),
    32,
    fontCharacters
    )
    defer delete codeFont
    if !uiFont.isValid() || !codeFont.isValid() {
        println("Impossible de charger les polices de Janus Studio.")
        return 1
    }
    val oneGlyph : Vector2 = codeFont.measure(
    "M",
    codeFontSize,
    codeFontSpacing
    )
    val glyphAdvance : float = codeFont.measure(
    "MM",
    codeFontSize,
    codeFontSpacing
    ).x - oneGlyph.x
    val lineAdvance : float = codeFont.measure(
    "M\nM",
    codeFontSize,
    codeFontSpacing
    ).y - oneGlyph.y
    var maximumLines : usize = numericCast[usize](truncatingCast[int](
    numericCast[float](editorBottom - editorTop - 12) / lineAdvance
    ))
    setTargetFps(60)

    var firstLine : usize = usize(0)
    var firstExplorerEntry : usize = usize(0)
    var lastExplorerClick : usize = usize(-1)
    var lastExplorerClickAt : usize = usize(0)
    var quitRequested : bool = false
    var fileMenuOpen : bool = false
    var editorScrollDetached : bool = false
    var paneResize : PaneResize = PaneResize.None
    var mouseSelecting : bool = false
    while !windowShouldClose() && !quitRequested {
        val control : bool = controlDown()
        val shift : bool = shiftDown()
        val cursorLineBeforeInput : usize = buffer.line()
        val cursorColumnBeforeInput : usize = buffer.column()
        val bufferSizeBeforeInput : usize = buffer.size()
        val editorModeBeforeInput : EditorMode = controller.mode()
        val leftMousePressed : bool = isMouseButtonPressed(MouseButton.Left)
        var fileInputConsumed : bool = false
        var layoutMouseConsumed : bool = false
        if paneResize == PaneResize.None && leftMousePressed {
            if explorerSeparatorHovered() {
                paneResize = PaneResize.Explorer
            } else if outputSeparatorHovered() {
                paneResize = PaneResize.Output
            }
        }
        if paneResize != PaneResize.None {
            if isMouseButtonDown(MouseButton.Left) {
                if paneResize == PaneResize.Explorer {
                    resizeExplorerToMouse()
                } else {
                    resizeOutputToMouse()
                }
                layoutMouseConsumed = true
            } else {
                paneResize = PaneResize.None
            }
        }
        if paneResize == PaneResize.Explorer || explorerSeparatorHovered() {
            setMouseCursor(MouseCursor.ResizeEastWest)
        } else if paneResize == PaneResize.Output || outputSeparatorHovered() {
            setMouseCursor(MouseCursor.ResizeNorthSouth)
        } else {
            setMouseCursor(MouseCursor.Default)
        }
        maximumLines = numericCast[usize](truncatingCast[int](
        numericCast[float](editorBottom - editorTop - 12) / lineAdvance
        ))
        val maximumFirstAfterResize : usize = maximumEditorFirst(
        buffer,
        maximumLines
        )
        if firstLine > maximumFirstAfterResize {
            firstLine = maximumFirstAfterResize
        }
        val visibleExplorerRows : usize = explorerVisibleRows()
        firstExplorerEntry = scrollExplorer(
        explorer,
        firstExplorerEntry,
        visibleExplorerRows
        )
        if !filePrompt.isVisible() && !fileMenuOpen {
            val scrolledEditorFirst : usize = scrollEditor(
            buffer,
            firstLine,
            maximumLines
            )
            if scrolledEditorFirst != firstLine {
                firstLine = scrolledEditorFirst
                editorScrollDetached = true
                completion.dismiss()
            }
        }
        if !layoutMouseConsumed && !filePrompt.isVisible() && leftMousePressed &&
        pointInArea(fileMenuX, 0, fileMenuButtonWidth, editorTop) {
            fileMenuOpen = !fileMenuOpen
            fileInputConsumed = true
        } else if !layoutMouseConsumed && !filePrompt.isVisible() && fileMenuOpen &&
        leftMousePressed {
            if pointInArea(
            fileMenuX,
            fileMenuTop,
            fileMenuWidth,
            fileMenuRowHeight
            ) {
                filePrompt.begin(PathPromptAction.OpenFolder, projectRoot.view())
                completion.dismiss()
            } else if pointInArea(
            fileMenuX,
            fileMenuTop + fileMenuRowHeight,
            fileMenuWidth,
            fileMenuRowHeight
            ) && explorer.size() > usize(0) {
                explorer.close()
                projectRoot.clear()
                firstExplorerEntry = usize(0)
                setStatus(status, "Dossier fermé.")
            }
            fileMenuOpen = false
            fileInputConsumed = true
        } else if !layoutMouseConsumed && !filePrompt.isVisible() && leftMousePressed &&
        mouseX() >= 0 && mouseX() < editorLeft - 12 {
            val clicked : usize = explorerEntryAtMouse(
            explorer,
            firstExplorerEntry,
            visibleExplorerRows
            )
            if clicked != usize(-1) {
                explorer.select(clicked)
                if explorer.isDirectory(clicked) {
                    explorer.toggle(clicked)
                    val maximum : usize = maximumExplorerFirst(
                    explorer,
                    visibleExplorerRows
                    )
                    if firstExplorerEntry > maximum {
                        firstExplorerEntry = maximum
                    }
                    lastExplorerClick = usize(-1)
                } else {
                    val clickedAt : usize = wallNow().unixMilliseconds()
                    val isDoubleClick : bool =
                    clicked == lastExplorerClick &&
                    clickedAt >= lastExplorerClickAt &&
                    clickedAt - lastExplorerClickAt <=
                    doubleClickDelayMilliseconds
                    if isDoubleClick {
                        explorer.appendPath(clicked, explorerPath)
                        if openExplorerFile(
                        explorerPath.view(),
                        activePath,
                        buffer,
                        status
                        ) {
                            firstLine = usize(0)
                            editorScrollDetached = false
                            completion.dismiss()
                            diagnostics.clear()
                            search.clear()
                            controller.escape()
                        }
                        lastExplorerClick = usize(-1)
                    } else {
                        lastExplorerClick = clicked
                        lastExplorerClickAt = clickedAt
                    }
                }
                fileInputConsumed = true
            }
        } else if !layoutMouseConsumed && !filePrompt.isVisible() && leftMousePressed &&
        pointInArea(
        editorLeft,
        editorTop,
        screenWidth() - editorLeft - 8,
        editorBottom - editorTop
        ) {
            moveCursorToEditorMouse(
            buffer,
            firstLine,
            glyphAdvance,
            lineAdvance,
            maximumLines
            )
            buffer.clearSelection()
            buffer.beginSelection()
            mouseSelecting = true
            editorScrollDetached = false
            completion.dismiss()
            fileInputConsumed = true
        }
        if mouseSelecting {
            if isMouseButtonDown(MouseButton.Left) &&
            pointInArea(
            editorLeft,
            editorTop,
            screenWidth() - editorLeft - 8,
            editorBottom - editorTop
            ) {
                moveCursorToEditorMouse(
                buffer,
                firstLine,
                glyphAdvance,
                lineAdvance,
                maximumLines
                )
                editorScrollDetached = false
                fileInputConsumed = true
            } else {
                mouseSelecting = false
            }
        }
        if fileMenuOpen {
            if isKeyPressed(Key.Escape) {
                fileMenuOpen = false
            }
            fileInputConsumed = true
        }
        if filePrompt.isVisible() {
            if handlePathPromptKeys(filePrompt) {
                if filePrompt.action() == PathPromptAction.OpenFolder {
                    if openProjectFolder(
                    filePrompt.value(),
                    projectRoot,
                    explorer,
                    status
                    ) {
                        filePrompt.dismiss()
                        firstExplorerEntry = usize(0)
                    }
                } else {
                    applyPathPrompt(
                    filePrompt,
                    activePath,
                    buffer,
                    diagnostics,
                    search,
                    status
                    )
                    firstLine = usize(0)
                    editorScrollDetached = false
                }
            }
            fileInputConsumed = true
        } else if !fileInputConsumed && control && shift &&
        isKeyPressed(Key.S) {
            filePrompt.begin(PathPromptAction.SaveAs, activePath.view())
            completion.dismiss()
            fileInputConsumed = true
        } else if !fileInputConsumed && control && isKeyPressed(Key.O) {
            if buffer.isModified() {
                setStatus(status, "Enregistrez les modifications avant d'ouvrir un fichier.")
            } else {
                filePrompt.begin(PathPromptAction.Open, "")
                completion.dismiss()
            }
            fileInputConsumed = true
        } else if !fileInputConsumed && control && isKeyPressed(Key.N) {
            if buffer.isModified() {
                setStatus(status, "Enregistrez les modifications avant de créer un fichier.")
            } else {
                filePrompt.begin(PathPromptAction.Create, "")
                completion.dismiss()
            }
            fileInputConsumed = true
        }

        if !fileInputConsumed && control && isKeyPressed(Key.C) &&
        buffer.appendSelection(clipboard) {
            setClipboardText(clipboard.view())
            setStatus(status, "Sélection copiée.")
            fileInputConsumed = true
        }
        if !fileInputConsumed && control && isKeyPressed(Key.X) &&
        buffer.appendSelection(clipboard) {
            setClipboardText(clipboard.view())
            buffer.deleteSelection()
            setStatus(status, "Sélection coupée.")
            fileInputConsumed = true
        }
        if !fileInputConsumed && control && isKeyPressed(Key.V) &&
        controller.mode() == EditorMode.Insert {
            val systemClipboard : string = clipboardText()
            if systemClipboard != "" {
                buffer.insertText(systemClipboard)
            } else if clipboard.size() > usize(0) {
                buffer.insertText(clipboard.view())
            }
            setStatus(status, "Presse-papiers collé.")
            fileInputConsumed = true
        }

        if !fileInputConsumed && control && isKeyPressed(Key.S) {
            saveFile(activePath.view(), buffer, status)
            fileInputConsumed = true
        }
        if !fileInputConsumed && isKeyPressed(Key.F5) {
            if saveFile(activePath.view(), buffer, status) {
                checkFileWithDiagnostics(
                activePath.view(),
                toolOutput,
                diagnostics
                )
            }
            fileInputConsumed = true
        }

        val completionConsumed : bool =
        if fileInputConsumed {
            true
        } else {
            handleCompletionKeys(completion, buffer, pendingSignature)
        }
        var keyAction : EditorAction = EditorAction.None
        var characterAction : EditorAction = EditorAction.None
        if !completionConsumed {
            keyAction = handleModeKeys(controller, buffer)
            characterAction = handlePrintableKeys(controller, buffer, completion)
        }
        if !completionConsumed && isKeyPressed(Key.Backspace) &&
        completion.isFiltering() {
            completion.broaden()
        }
        val manualCompletion : bool =
        controller.mode() == EditorMode.Insert && control &&
        isKeyPressed(Key.Space)
        if characterAction == EditorAction.Complete || manualCompletion {
            refreshCompletion(
            languageServer,
            activePath.view(),
            buffer,
            completion,
            completionLabels,
            completionError,
            status
            )
            characterAction = EditorAction.None
        } else if characterAction == EditorAction.SignatureHelp {
            completion.dismiss()
            refreshSignatureHelp(
            languageServer,
            activePath.view(),
            buffer,
            signatureText,
            pendingSignature,
            completionError
            )
            characterAction = EditorAction.None
        } else if characterAction == EditorAction.DismissSignatureHelp {
            completion.dismiss()
            signatureText.clear()
            pendingSignature.clear()
            characterAction = EditorAction.None
        } else if characterAction == EditorAction.DismissCompletion {
            completion.dismiss()
            characterAction = EditorAction.None
        } else if !completionConsumed && completion.isFiltering() &&
        (isKeyPressed(Key.Left) || isKeyPressed(Key.Right) ||
        isKeyPressed(Key.Home) || isKeyPressed(Key.End) ||
        isKeyPressed(Key.Delete) || isKeyPressed(Key.Enter) ||
        isKeyPressed(Key.Tab)) {
            completion.dismiss()
        }
        if controller.mode() != EditorMode.Insert ||
        isKeyPressed(Key.Escape) || isKeyPressed(Key.Backspace) ||
        isKeyPressed(Key.Delete) || isKeyPressed(Key.Left) ||
        isKeyPressed(Key.Right) || isKeyPressed(Key.Home) ||
        isKeyPressed(Key.End) {
            signatureText.clear()
        }
        if keyAction == EditorAction.Search {
            search.begin(buffer, controller.commandView())
            search.appendStatus(status)
            keyAction = EditorAction.None
        } else if keyAction == EditorAction.SearchNext ||
        characterAction == EditorAction.SearchNext {
            search.selectNext(buffer)
            search.appendStatus(status)
            keyAction = EditorAction.None
            characterAction = EditorAction.None
        } else if keyAction == EditorAction.SearchPrevious ||
        characterAction == EditorAction.SearchPrevious {
            search.selectPrevious(buffer)
            search.appendStatus(status)
            keyAction = EditorAction.None
            characterAction = EditorAction.None
        }
        quitRequested = applyEditorAction(
        if keyAction != EditorAction.None { keyAction } else { characterAction },
        activePath.view(),
        buffer,
        status
        )
        if buffer.isModified() {
            diagnostics.clear()
        }
        if buffer.size() != bufferSizeBeforeInput {
            search.clear()
        }
        if controller.mode() != editorModeBeforeInput &&
        (controller.mode() != EditorMode.Normal ||
        (editorModeBeforeInput == EditorMode.Search &&
        isKeyPressed(Key.Escape))) {
            search.clear()
        }
        if buffer.line() != cursorLineBeforeInput ||
        buffer.column() != cursorColumnBeforeInput ||
        isKeyPressed(Key.Delete) {
            editorScrollDetached = false
        }
        if !editorScrollDetached {
            firstLine = keepCursorVisible(buffer, firstLine, maximumLines)
        }
        controller.appendStatus(modeLine)
        controller.appendCommandLine(commandLine)
        drawStudio(
        activePath.view(),
        buffer,
        firstLine,
        visibleCharacters,
        syntaxSpans,
        glyph,
        diagnostics,
        diagnosticText,
        search,
        completion,
        completionText,
        signatureText,
        filePrompt,
        statusLine,
        status,
        toolOutput,
        modeLine,
        commandLine,
        explorer,
        firstExplorerEntry,
        visibleExplorerRows,
        explorerLabel,
        fileMenuOpen,
        controller.mode(),
        uiFont,
        codeFont,
        glyphAdvance,
        lineAdvance,
        maximumLines
        )
    }

    return 0
}
