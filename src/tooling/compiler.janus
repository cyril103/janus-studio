/// Intégration minimale de la toolchain Janus.
module tooling.compiler

import tooling.diagnostics
import std.array
import std.io
import std.option
import std.process
import std.result
import std.system
import std.text

enum CompilerCheckState derives Copy, Equality, Debug {
    Idle,
    Running,
    Completed,
    Failed
}

private def isPathSeparator(value : byte) : bool {
    return value == byte(47) || value == byte(92)
}

private def isTestSourcePath(path : string) : bool {
    val data : Ptr[byte] = stringData(path)
    val length : usize = stringLength(path)
    if length < usize(6) || data.load(length - usize(6)) != byte(46) ||
    data.load(length - usize(5)) != byte(106) ||
    data.load(length - usize(4)) != byte(97) ||
    data.load(length - usize(3)) != byte(110) ||
    data.load(length - usize(2)) != byte(117) ||
    data.load(length - usize(1)) != byte(115) {
        return false
    }
    var index : usize = usize(0)
    while index + usize(5) < length {
        val startsSegment : bool = index == usize(0) ||
        isPathSeparator(data.load(index - usize(1)))
        if startsSegment && data.load(index) == byte(116) &&
        data.load(index + usize(1)) == byte(101) &&
        data.load(index + usize(2)) == byte(115) &&
        data.load(index + usize(3)) == byte(116) &&
        data.load(index + usize(4)) == byte(115) &&
        isPathSeparator(data.load(index + usize(5))) {
            return true
        }
        index = index + usize(1)
    }
    return false
}

private def appendCheckTarget(
    path : string,
    arguments : Array[string]
) : Unit {
    if isTestSourcePath(path) {
        arguments.push("--all")
    } else {
        arguments.push(path)
    }
}

private def emitWorkerResult(process : ProcessResult) : int {
    val exitCode : int = process.exitCode()
    val output : TextBuilder = new TextBuilder()
    defer delete output
    if process.stdoutSize() > usize(0) {
        output.append(stringView(process.stdoutData(), process.stdoutSize()))
    }
    if process.stderrSize() > usize(0) {
        output.append(stringView(process.stderrData(), process.stderrSize()))
    }
    println(output.view())
    delete process
    return exitCode
}

def runCompilerWorker(path : string, workspace : string) : int {
    val arguments : Array[string] = new Array[string](usize(4))
    defer delete arguments
    arguments.push("check")
    appendCheckTarget(path, arguments)
    arguments.push("--diagnostic-format")
    arguments.push("json")
    val result : Result[ProcessResult, SystemError] =
    runProcess("janus", arguments, workspace, true, true)
    return match move result {
        Ok(process) => emitWorkerResult(move process),
        Error(error) => 1
    }
}

private def argumentEqualsWorker(argument : Option[string]) : bool {
    return match argument {
        Some(value) => value == "--check-worker",
        None => false
    }
}

def compilerWorkerRequested() : bool {
    return argumentEqualsWorker(programArgument(usize(1)))
}

private def runWorkerArguments(
    pathArgument : Option[string],
    workspaceArgument : Option[string]
) : int {
    return match pathArgument {
        Some(path) => match workspaceArgument {
            Some(workspace) => runCompilerWorker(path, workspace),
            None => runCompilerWorker(path, "")
        },
        None => 2
    }
}

def runRequestedCompilerWorker() : int {
    return runWorkerArguments(
        programArgument(usize(2)),
        programArgument(usize(3))
    )
}

class CompilerJob(
    private var process : Option[ChildProcess],
    private val executable : TextBuilder,
    private val received : ByteBuffer
) {
    private def takeProcess() : Option[ChildProcess] {
        val previous : Option[ChildProcess] = move process
        process = Option.None[ChildProcess]()
        return move previous
    }

    private def acceptProcess(child : ChildProcess) : bool {
        delete process
        process = Option.Some[ChildProcess](move child)
        return true
    }

    private def acceptStart(result : Result[ChildProcess, SystemError]) : bool {
        return match move result {
            Ok(child) => this.acceptProcess(move child),
            Error(error) => false
        }
    }

    def start(
        path : string,
        workspace : string,
        output : TextBuilder,
        diagnostics : EditorDiagnostics
    ) : bool {
        if this.isRunning() { return false }
        received.clear()
        output.clear()
        output.append("Vérification en cours…")
        diagnostics.clear()
        val arguments : Array[string] = new Array[string](usize(3))
        defer delete arguments
        arguments.push("--check-worker")
        arguments.push(path)
        arguments.push(workspace)
        if !this.acceptStart(spawnProcess(
            executable.view(),
            arguments,
            workspace
        )) {
            output.clear()
            output.append("Impossible de lancer la vérification Janus.")
            return false
        }
        return true
    }

    borrow def isRunning() : bool {
        return match process {
            Some(child) => true,
            None => false
        }
    }

    private def keepRunning(child : ChildProcess) : CompilerCheckState {
        delete process
        process = Option.Some[ChildProcess](move child)
        return CompilerCheckState.Running
    }

    private def finish(
        child : ChildProcess,
        exitCode : int,
        output : TextBuilder,
        diagnostics : EditorDiagnostics
    ) : CompilerCheckState {
        delete child
        val decoded : Result[string, TextDecodeError] = received.asText()
        val loaded : bool = match decoded {
            Ok(json) => this.loadDiagnostics(json, output, diagnostics),
            Error(error) => false
        }
        if !loaded {
            output.clear()
            output.append(if exitCode == 0 {
                    "Aucun diagnostic."
                } else {
                    "La commande a échoué sans diagnostic structuré."
            })
        }
        return if exitCode == 0 {
            CompilerCheckState.Completed
        } else {
            CompilerCheckState.Failed
        }
    }

    private def loadDiagnostics(
        json : string,
        output : TextBuilder,
        diagnostics : EditorDiagnostics
    ) : bool {
        diagnostics.load(json)
        diagnostics.appendAll(output)
        return output.size() > usize(0)
    }

    private def exitOptionState(code : Option[int]) : int {
        return match code {
            Some(value) => value,
            None => -2
        }
    }

    private def waitState(result : Result[Option[int], SystemError]) : int {
        return match result {
            Ok(code) => this.exitOptionState(code),
            Error(error) => -1
        }
    }

    private def handleWait(
        child : ChildProcess,
        result : Result[Option[int], SystemError],
        output : TextBuilder,
        diagnostics : EditorDiagnostics
    ) : CompilerCheckState {
        val state : int = this.waitState(result)
        if state == -2 { return this.keepRunning(move child) }
        if state == -1 { return this.failChild(move child, output) }
        return this.finish(move child, state, output, diagnostics)
    }

    private def failChild(
        child : ChildProcess,
        output : TextBuilder
    ) : CompilerCheckState {
        delete child
        output.clear()
        output.append("La vérification Janus a été interrompue.")
        return CompilerCheckState.Failed
    }

    private def pollChild(
        child : ChildProcess,
        output : TextBuilder,
        diagnostics : EditorDiagnostics
    ) : CompilerCheckState {
        val chunk : Ptr[byte] = alloc[byte](usize(4096))
        defer free(chunk)
        var attempts : usize = usize(0)
        var reading : bool = true
        var failed : bool = false
        while reading && attempts < usize(8) {
            val read : Result[usize, SystemError] = child.tryRead(chunk, usize(4096))
            val count : isize = match read {
                Ok(value) => truncatingCast[isize](value),
                Error(error) => if error.category == SystemErrorCategory.WouldBlock {
                    isize(-2)
                } else {
                    isize(-1)
                }
            }
            if count > isize(0) {
                if !received.append(chunk, numericCast[usize](count)) {
                    failed = true
                    reading = false
                }
            } else if count == isize(-1) {
                failed = true
                reading = false
            } else {
                reading = false
            }
            attempts = attempts + usize(1)
        }
        if failed { return this.failChild(move child, output) }
        if reading { return this.keepRunning(move child) }
        val wait : Result[Option[int], SystemError] = child.tryWait()
        return this.handleWait(
            move child,
            wait,
            output,
            diagnostics
        )
    }

    def poll(
        output : TextBuilder,
        diagnostics : EditorDiagnostics
    ) : CompilerCheckState {
        val previous : Option[ChildProcess] = this.takeProcess()
        return match move previous {
            Some(child) => this.pollChild(move child, output, diagnostics),
            None => CompilerCheckState.Idle
        }
    }

    destructor {
        delete process
        delete executable
        delete received
    }
}

def compilerJob(executablePath : string) : CompilerJob {
    val executable : TextBuilder = new TextBuilder()
    executable.append(executablePath)
    return new CompilerJob(
        Option.None[ChildProcess](),
        move executable,
        new ByteBuffer(usize(4096))
    )
}

private def jobForExecutable(executable : Option[string]) : CompilerJob {
    return match executable {
        Some(path) => compilerJob(path),
        None => compilerJob("janus-studio")
    }
}

def compilerJobForProgram() : CompilerJob {
    return jobForExecutable(programArgument(usize(0)))
}

private def collectProcessResult(
    process : ProcessResult,
    output : TextBuilder
) : bool {
    val succeeded : bool = process.exitCode() == 0
    if process.stdoutSize() > usize(0) {
        output.append(stringView(process.stdoutData(), process.stdoutSize()))
    }
    if process.stderrSize() > usize(0) {
        if output.size() > usize(0) {
            output.append("\n")
        }
        output.append(stringView(process.stderrData(), process.stderrSize()))
    }
    if output.size() == usize(0) {
        output.append(if succeeded { "Aucun diagnostic." } else { "La commande a échoué sans diagnostic." })
    }
    delete process
    return succeeded
}

private def reportStartFailure(output : TextBuilder) : bool {
    output.append("Impossible de lancer `janus`. Vérifiez que le binaire est dans PATH.")
    return false
}

/// Exécute `janus check` sur le fichier actif et copie ses diagnostics.
def checkFile(path : string, output : TextBuilder) : bool {
    output.clear()
    val arguments : Array[string] = new Array[string](usize(4))
    defer delete arguments
    arguments.push("check")
    appendCheckTarget(path, arguments)
    arguments.push("--diagnostic-format")
    arguments.push("human")

    val result : Result[ProcessResult, SystemError] =
    runProcess("janus", arguments, "", true, true)
    return match move result {
        Ok(process) => collectProcessResult(move process, output),
        Error(error) => reportStartFailure(output)
    }
}

private def collectStructuredResult(
    process : ProcessResult,
    output : TextBuilder,
    diagnostics : EditorDiagnostics
) : bool {
    val succeeded : bool = process.exitCode() == 0
    val json : TextBuilder = new TextBuilder()
    defer delete json
    if process.stdoutSize() > usize(0) {
        json.append(stringView(process.stdoutData(), process.stdoutSize()))
    }
    if process.stderrSize() > usize(0) {
        json.append(stringView(process.stderrData(), process.stderrSize()))
    }
    diagnostics.load(json.view())
    diagnostics.appendAll(output)
    if output.size() == usize(0) {
        output.append(if succeeded { "Aucun diagnostic." } else { "La commande a échoué sans diagnostic structuré." })
    }
    delete process
    return succeeded
}

def checkFileWithDiagnostics(
    path : string,
    output : TextBuilder,
    diagnostics : EditorDiagnostics
) : bool {
    output.clear()
    diagnostics.clear()
    val arguments : Array[string] = new Array[string](usize(4))
    defer delete arguments
    arguments.push("check")
    appendCheckTarget(path, arguments)
    arguments.push("--diagnostic-format")
    arguments.push("json")

    val result : Result[ProcessResult, SystemError] =
    runProcess("janus", arguments, "", true, true)
    return match move result {
        Ok(process) => collectStructuredResult(move process, output, diagnostics),
        Error(error) => reportStartFailure(output)
    }
}
