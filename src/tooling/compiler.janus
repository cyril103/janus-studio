/// Intégration minimale de la toolchain Janus.
module tooling.compiler

import std.array
import std.fs
import std.process
import std.result
import std.system
import std.text

private def collectProcessResult(
process : ProcessResult,
output : TextBuilder
) : bool {
    val succeeded : bool = process.exitCode() == 0
    if process.stdoutSize() > usize(0) {
        output.append(stringView(process.stdoutData(), process.stdoutSize()))
    }
    if process.stderrSize() > usize(0) {
        if output.size() > usize(0) {
            output.append("\n")
        }
        output.append(stringView(process.stderrData(), process.stderrSize()))
    }
    if output.size() == usize(0) {
        output.append(if succeeded { "Aucun diagnostic." } else { "La commande a échoué sans diagnostic." })
    }
    delete process
    return succeeded
}

private def reportStartFailure(output : TextBuilder) : bool {
    output.append("Impossible de lancer `janus`. Vérifiez que le binaire est dans PATH.")
    return false
}

private def resolveAbsolutePath(path : string, output : TextBuilder) : Unit {
    output.clear()
    val data : Ptr[byte] = stringData(path)
    if stringLength(path) > usize(0) && data.load(usize(0)) == byte(47) {
        output.append(path)
        return
    }
    val cwdResult : Result[WorkingDirectory, SystemError] = currentWorkingDirectory()
    val baseBuilder : TextBuilder = new TextBuilder()
    defer delete baseBuilder
    val _hasCwd : bool = match move cwdResult {
        Ok(dir) => {
            baseBuilder.append(dir.view())
            delete dir
            true
        },
        Error(err) => {
            baseBuilder.append(".")
            false
        }
    }
    val joined : Result[Path, SystemError] = joinPath(baseBuilder.view(), path)
    match move joined {
        Ok(p) => {
            output.append(p.view())
            delete p
        },
        Error(err) => {
            output.append(path)
        }
    }
}

/// Exécute `janus check` sur le fichier actif et copie ses diagnostics.
def checkFile(path : string, output : TextBuilder) : bool {
    output.clear()
    val targetPath : TextBuilder = new TextBuilder()
    defer delete targetPath
    resolveAbsolutePath(path, targetPath)

    val arguments : Array[string] = new Array[string](usize(5))
    defer delete arguments
    arguments.push("check")
    arguments.push("--diagnostic-format")
    arguments.push("human")
    arguments.push("--")
    arguments.push(targetPath.view())

    val result : Result[ProcessResult, SystemError] =
    runProcess("janus", arguments, "", true, true)
    return match move result {
        Ok(process) => collectProcessResult(move process, output),
        Error(error) => reportStartFailure(output)
    }
}
