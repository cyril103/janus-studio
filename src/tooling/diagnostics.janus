/// Diagnostics structurés affichables dans l'éditeur.
module tooling.diagnostics

import tooling.json
import std.array
import std.text

private def matchesAt(source : string, marker : string, start : usize) : bool {
    if start + stringLength(marker) > stringLength(source) { return false }
    val data : Ptr[byte] = stringData(source)
    val expected : Ptr[byte] = stringData(marker)
    var index : usize = usize(0)
    while index < stringLength(marker) {
        if data.load(start + index) != expected.load(index) { return false }
        index = index + usize(1)
    }
    return true
}

private def parseNumber(source : string, start : usize) : usize {
    val data : Ptr[byte] = stringData(source)
    var index : usize = start
    var value : usize = usize(0)
    while index < stringLength(source) &&
    data.load(index) >= byte(48) && data.load(index) <= byte(57) {
        value = value * usize(10) +
        numericCast[usize](int(data.load(index)) - 48)
        index = index + usize(1)
    }
    return value
}

class EditorDiagnostics(
private val lines : Array[usize],
private val columns : Array[usize],
private val severities : Array[int],
private val messageStarts : Array[usize],
private val messageLengths : Array[usize],
private val messages : TextBuilder
) {
    def clear() : Unit {
        lines.clear()
        columns.clear()
        severities.clear()
        messageStarts.clear()
        messageLengths.clear()
        messages.clear()
    }

    borrow def size() : usize { return lines.size() }
    borrow def line(index : usize) : usize { return lines.get(index) }
    borrow def column(index : usize) : usize { return columns.get(index) }
    borrow def isError(index : usize) : bool { return severities.get(index) == 2 }

    def appendForLine(requestedLine : usize, output : TextBuilder) : bool {
        output.clear()
        val source : string = messages.view()
        var index : usize = usize(0)
        while index < this.size() {
            if this.line(index) == requestedLine {
                output.append(if this.isError(index) { "Erreur : " } else { "Avertissement : " })
                appendDecodedUtf8Range(
                source,
                messageStarts.get(index),
                messageLengths.get(index),
                output
                )
                return true
            }
            index = index + usize(1)
        }
        return false
    }

    def load(json : string) : Unit {
        this.clear()
        val data : Ptr[byte] = stringData(json)
        val size : usize = stringLength(json)
        val diagnostics : usize = findJsonObjectProperty(
        json,
        "diagnostics",
        usize(0)
        )
        if diagnostics >= size || data.load(diagnostics) != byte(91) { return }
        var cursor : usize = skipJsonWhitespace(json, diagnostics + usize(1))
        while cursor < size && data.load(cursor) != byte(93) {
            val severity : usize = findJsonObjectProperty(json, "severity", cursor)
            val message : usize = findJsonObjectProperty(json, "message", cursor)
            val primary : usize = findJsonObjectProperty(
            json,
            "primaryLocation",
            cursor
            )
            val position : usize = findJsonObjectProperty(json, "position", primary)
            val line : usize = findJsonObjectProperty(json, "line", position)
            val column : usize = findJsonObjectProperty(json, "column", position)
            if severity < size && message < size && primary < size &&
            position < size && line < size && column < size &&
            data.load(severity) == byte(34) && data.load(message) == byte(34) {
                val start : usize = messages.size()
                val _messageEnd : usize = appendDecodedJsonString(
                json,
                message + usize(1),
                messages
                )
                val parsedLine : usize = parseNumber(json, line)
                val parsedColumn : usize = parseNumber(json, column)
                lines.push(
                if parsedLine > usize(0) { parsedLine - usize(1) } else { usize(0) }
                )
                columns.push(
                if parsedColumn > usize(0) { parsedColumn - usize(1) } else { usize(0) }
                )
                severities.push(
                if matchesAt(json, "error", severity + usize(1)) { 2 } else { 1 }
                )
                messageStarts.push(start)
                messageLengths.push(messages.size() - start)
                messages.append("\n")
            }
            cursor = skipJsonWhitespace(json, jsonValueEnd(json, cursor))
            if cursor < size && data.load(cursor) == byte(44) {
                cursor = skipJsonWhitespace(json, cursor + usize(1))
            }
        }
    }

    def appendAll(output : TextBuilder) : Unit {
        output.clear()
        val source : string = messages.view()
        var index : usize = usize(0)
        while index < this.size() {
            output.append(if this.isError(index) { "erreur" } else { "avertissement" })
            output.append(" ligne ")
            output.appendUSize(this.line(index) + usize(1))
            output.append(":")
            output.appendUSize(this.column(index) + usize(1))
            output.append(" — ")
            appendDecodedUtf8Range(
            source,
            messageStarts.get(index),
            messageLengths.get(index),
            output
            )
            output.append("\n")
            index = index + usize(1)
        }
    }

    destructor {
        delete lines
        delete columns
        delete severities
        delete messageStarts
        delete messageLengths
        delete messages
    }
}

def editorDiagnostics() : EditorDiagnostics {
    return new EditorDiagnostics(
    new Array[usize](usize(8)),
    new Array[usize](usize(8)),
    new Array[int](usize(8)),
    new Array[usize](usize(8)),
    new Array[usize](usize(8)),
    new TextBuilder()
    )
}
