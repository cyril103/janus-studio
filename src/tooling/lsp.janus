/// Session persistante avec janus-lsp pour l'IntelliSense.
module tooling.lsp

import editor.buffer
import tooling.json
import std.array
import std.io
import std.option
import std.path
import std.process
import std.result
import std.system
import std.text

def containsLabel(
    labels : string,
    source : string,
    start : usize,
    end : usize
) : bool {
    val labelData : Ptr[byte] = stringData(labels)
    val sourceData : Ptr[byte] = stringData(source)
    val requestedLength : usize = end - start
    var lineStart : usize = usize(0)
    var index : usize = usize(0)
    while index <= stringLength(labels) {
        if index == stringLength(labels) || labelData.load(index) == byte(9) ||
        labelData.load(index) == byte(10) {
            if index - lineStart == requestedLength {
                var offset : usize = usize(0)
                var matches : bool = true
                while offset < requestedLength {
                    if labelData.load(lineStart + offset) !=
                    sourceData.load(start + offset) {
                        matches = false
                    }
                    offset = offset + usize(1)
                }
                if matches { return true }
            }
            while index < stringLength(labels) &&
            labelData.load(index) != byte(10) {
                index = index + usize(1)
            }
            lineStart = index + usize(1)
        }
        index = index + usize(1)
    }
    return false
}

private def appendCompletionItem(
    json : string,
    item : usize,
    output : TextBuilder
) : Unit {
    val data : Ptr[byte] = stringData(json)
    val size : usize = stringLength(json)
    val label : usize = findJsonObjectProperty(json, "label", item)
    val detail : usize = findJsonObjectProperty(json, "detail", item)
    if label < size && data.load(label) == byte(34) {
        val _labelEnd : usize = appendDecodedJsonString(
            json,
            label + usize(1),
            output
        )
        if detail < size && data.load(detail) == byte(34) {
            output.append("\t")
            val _detailEnd : usize = appendDecodedJsonString(
                json,
                detail + usize(1),
                output
            )
        }
        output.append("\n")
    }
}

private def completionArray(json : string) : usize {
    val size : usize = stringLength(json)
    val data : Ptr[byte] = stringData(json)
    val result : usize = findJsonObjectProperty(json, "result", usize(0))
    if result >= size {
        return findJsonObjectProperty(json, "items", usize(0))
    }
    if data.load(result) == byte(91) { return result }
    return findJsonObjectProperty(json, "items", result)
}

def extractCompletionLabels(json : string, output : TextBuilder) : Unit {
    output.clear()
    val data : Ptr[byte] = stringData(json)
    val size : usize = stringLength(json)
    val items : usize = completionArray(json)
    if items >= size || data.load(items) != byte(91) { return }
    var cursor : usize = skipJsonWhitespace(json, items + usize(1))
    while cursor < size && data.load(cursor) != byte(93) {
        if data.load(cursor) == byte(123) {
            appendCompletionItem(json, cursor, output)
        }
        cursor = skipJsonWhitespace(json, jsonValueEnd(json, cursor))
        if cursor < size && data.load(cursor) == byte(44) {
            cursor = skipJsonWhitespace(json, cursor + usize(1))
        }
    }
}

def extractSignatureLabel(json : string, output : TextBuilder) : Unit {
    output.clear()
    val data : Ptr[byte] = stringData(json)
    val size : usize = stringLength(json)
    val result : usize = findJsonObjectProperty(json, "result", usize(0))
    val signatures : usize = if result < size {
        findJsonObjectProperty(json, "signatures", result)
    } else {
        findJsonObjectProperty(json, "signatures", usize(0))
    }
    if signatures >= size || data.load(signatures) != byte(91) { return }
    val signature : usize = skipJsonWhitespace(json, signatures + usize(1))
    val label : usize = findJsonObjectProperty(json, "label", signature)
    if label < size && data.load(label) == byte(34) {
        val _labelEnd : usize = appendDecodedJsonString(
            json,
            label + usize(1),
            output
        )
    }
}

private def unsignedByte(value : byte) : int {
    val numeric : int = int(value)
    return if numeric < 0 { numeric + 256 } else { numeric }
}

private def appendHexDigit(value : int, output : ByteBuffer) : bool {
    return output.appendByte(truncatingCast[byte](
        if value < 10 { 48 + value } else { 55 + value }
    ))
}

def appendJsonString(value : string, output : ByteBuffer) : bool {
    if !output.appendByte(byte(34)) { return false }
    val data : Ptr[byte] = stringData(value)
    var index : usize = usize(0)
    while index < stringLength(value) {
        val current : int = unsignedByte(data.load(index))
        if current == 34 {
            if !output.appendText("\\\"") { return false }
        } else if current == 92 {
            if !output.appendText("\\\\") { return false }
        } else if current == 8 {
            if !output.appendText("\\b") { return false }
        } else if current == 9 {
            if !output.appendText("\\t") { return false }
        } else if current == 10 {
            if !output.appendText("\\n") { return false }
        } else if current == 12 {
            if !output.appendText("\\f") { return false }
        } else if current == 13 {
            if !output.appendText("\\r") { return false }
        } else if current < 32 {
            if !output.appendText("\\u00") ||
            !appendHexDigit(current / 16, output) ||
            !appendHexDigit(current % 16, output) { return false }
        } else if !output.appendByte(data.load(index)) {
            return false
        }
        index = index + usize(1)
    }
    return output.appendByte(byte(34))
}

private def textMatchesAt(text : string, marker : string, start : usize) : bool {
    if start + stringLength(marker) > stringLength(text) { return false }
    val data : Ptr[byte] = stringData(text)
    val markerData : Ptr[byte] = stringData(marker)
    var index : usize = usize(0)
    while index < stringLength(marker) {
        if data.load(start + index) != markerData.load(index) { return false }
        index = index + usize(1)
    }
    return true
}

def parseContentLength(header : string) : usize {
    val marker : string = "Content-Length:"
    val data : Ptr[byte] = stringData(header)
    var start : usize = usize(0)
    while start + stringLength(marker) <= stringLength(header) {
        if textMatchesAt(header, marker, start) {
            var index : usize = start + stringLength(marker)
            while index < stringLength(header) &&
            (data.load(index) == byte(32) || data.load(index) == byte(9)) {
                index = index + usize(1)
            }
            var result : usize = usize(0)
            var found : bool = false
            while index < stringLength(header) &&
            data.load(index) >= byte(48) && data.load(index) <= byte(57) {
                val digit : usize = numericCast[usize](int(data.load(index)) - 48)
                val next : usize = result * usize(10) + digit
                if next < result { return usize(0) }
                result = next
                found = true
                index = index + usize(1)
            }
            return if found { result } else { usize(0) }
        }
        start = start + usize(1)
    }
    return usize(0)
}

def messageHasId(json : string, requested : usize) : bool {
    val data : Ptr[byte] = stringData(json)
    var index : usize = findJsonObjectProperty(json, "id", usize(0))
    var value : usize = usize(0)
    var found : bool = false
    while index < stringLength(json) && data.load(index) >= byte(48) &&
    data.load(index) <= byte(57) {
        value = value * usize(10) +
        numericCast[usize](int(data.load(index)) - 48)
        found = true
        index = index + usize(1)
    }
    index = skipJsonWhitespace(json, index)
    return found && value == requested && index < stringLength(json) &&
    (data.load(index) == byte(44) || data.load(index) == byte(125))
}

enum LspResponseKind derives Copy, Equality, Debug {
    None,
    Ready,
    Completion,
    Signature,
    Discarded,
    Failure
}

private enum PendingResponse derives Copy, Equality, Debug {
    None,
    Initialize,
    Completion,
    Signature
}

private def appendFileUri(path : string, output : TextBuilder) : Unit {
    output.clear()
    output.append("file://")
    val data : Ptr[byte] = stringData(path)
    if stringLength(path) >= usize(2) && data.load(usize(1)) == byte(58) {
        output.append("/")
    }
    val hex : string = "0123456789ABCDEF"
    val hexData : Ptr[byte] = stringData(hex)
    var index : usize = usize(0)
    while index < stringLength(path) {
        val current : int = unsignedByte(data.load(index))
        val normalized : int = if current == 92 { 47 } else { current }
        val unreserved : bool =
        (normalized >= 65 && normalized <= 90) ||
        (normalized >= 97 && normalized <= 122) ||
        (normalized >= 48 && normalized <= 57) ||
        normalized == 45 || normalized == 46 || normalized == 95 ||
        normalized == 126 || normalized == 47 || normalized == 58
        if unreserved {
            output.appendChar(char(normalized))
        } else {
            output.append("%")
            output.appendChar(char(hexData.load(numericCast[usize](normalized / 16))))
            output.appendChar(char(hexData.load(numericCast[usize](normalized % 16))))
        }
        index = index + usize(1)
    }
}

private def useDocumentPath(path : Path, output : TextBuilder) : bool {
    appendFileUri(path.view(), output)
    delete path
    return true
}

private def documentUri(
    workspace : string,
    path : string,
    output : TextBuilder
) : bool {
    val joined : Result[Path, SystemError] = joinPath(workspace, path)
    return match move joined {
        Ok(value) => useDocumentPath(move value, output),
        Error(error) => false
    }
}

class LspClient(
    private var process : Option[ChildProcess],
    private val workspace : TextBuilder,
    private val body : ByteBuffer,
    private val response : ByteBuffer,
    private val incoming : ByteBuffer,
    private val outgoing : ByteBuffer,
    private val header : TextBuilder,
    private val number : TextBuilder,
    private val activeUri : TextBuilder,
    private val requestedUri : TextBuilder,
    private val pendingUri : TextBuilder,
    private val snapshot : TextBuilder,
    private val responseJson : TextBuilder
) {
    private var requestId : usize = usize(1)
    private var documentVersion : usize = usize(0)
    private var incomingStart : usize = usize(0)
    private var outgoingStart : usize = usize(0)
    private var pendingId : usize = usize(0)
    private var pendingRevision : usize = usize(0)
    private var pendingResponse : PendingResponse = PendingResponse.None
    private var ready : bool = false

    private def disable() : Unit {
        delete process
        process = Option.None[ChildProcess]()
        ready = false
    }

    private def resetSession(workspacePath : string) : Unit {
        this.disable()
        workspace.clear()
        workspace.append(if workspacePath == "" { "." } else { workspacePath })
        body.clear()
        response.clear()
        incoming.clear()
        outgoing.clear()
        header.clear()
        activeUri.clear()
        requestedUri.clear()
        pendingUri.clear()
        snapshot.clear()
        responseJson.clear()
        requestId = usize(1)
        documentVersion = usize(0)
        incomingStart = usize(0)
        outgoingStart = usize(0)
        pendingId = usize(0)
        pendingRevision = usize(0)
        pendingResponse = PendingResponse.None
        ready = false
    }

    private def acceptRestartedProcess(child : ChildProcess) : bool {
        delete process
        process = Option.Some[ChildProcess](move child)
        return true
    }

    private def useRestartedProcess(
        started : Result[ChildProcess, SystemError]
    ) : bool {
        return match move started {
            Ok(child) => this.acceptRestartedProcess(move child),
            Error(systemError) => false
        }
    }

    def restart(workspacePath : string, error : TextBuilder) : bool {
        this.resetSession(workspacePath)
        val arguments : Array[string] = new Array[string](usize(0))
        defer delete arguments
        if !this.useRestartedProcess(
            spawnProcess("janus-lsp", arguments, workspace.view())
        ) { return this.reportUnavailable(error) }
        return this.initialize(error)
    }

    private def takeProcess() : Option[ChildProcess] {
        val previous : Option[ChildProcess] = move process
        process = Option.None[ChildProcess]()
        return move previous
    }

    private def reportTransportFailure(error : TextBuilder) : bool {
        error.clear()
        error.append("La connexion à `janus-lsp` a été interrompue.")
        return false
    }

    private def reportUnavailable(error : TextBuilder) : bool {
        error.clear()
        error.append("Impossible de lancer `janus-lsp`.")
        return false
    }

    private def restoreProcess(child : ChildProcess) : bool {
        delete process
        process = Option.Some[ChildProcess](move child)
        return true
    }

    private def retainAvailableProcess(
        previous : Option[ChildProcess]
    ) : bool {
        return match move previous {
            Some(child) => this.restoreProcess(move child),
            None => false
        }
    }

    private def processAvailable() : bool {
        val previous : Option[ChildProcess] = this.takeProcess()
        return this.retainAvailableProcess(move previous)
    }

    private def flushChild(
        child : ChildProcess,
        error : TextBuilder
    ) : bool {
        val chunk : Ptr[byte] = alloc[byte](usize(4096))
        defer free(chunk)
        var attempts : usize = usize(0)
        var failed : bool = false
        var waiting : bool = false
        while outgoingStart < outgoing.size() && attempts < usize(8) &&
        !failed && !waiting {
            val remaining : usize = outgoing.size() - outgoingStart
            val requested : usize = if remaining < usize(4096) {
                remaining
            } else {
                usize(4096)
            }
            var index : usize = usize(0)
            while index < requested {
                chunk.store(index, outgoing.data().load(outgoingStart + index))
                index = index + usize(1)
            }
            val written : Result[usize, SystemError] = child.tryWrite(chunk, requested)
            val count : isize = match written {
                Ok(value) => truncatingCast[isize](value),
                Error(systemError) => if systemError.category ==
                SystemErrorCategory.WouldBlock {
                    isize(-2)
                } else {
                    isize(-1)
                }
            }
            if count > isize(0) {
                outgoingStart = outgoingStart + numericCast[usize](count)
            } else if count == isize(-2) {
                waiting = true
            } else {
                failed = true
            }
            attempts = attempts + usize(1)
        }
        if outgoingStart == outgoing.size() {
            outgoing.clear()
            outgoingStart = usize(0)
        }
        val _restored : bool = this.restoreProcess(move child)
        if failed { return this.reportTransportFailure(error) }
        return true
    }

    private def flushOutgoing(error : TextBuilder) : bool {
        if outgoingStart >= outgoing.size() { return true }
        val previous : Option[ChildProcess] = this.takeProcess()
        return match move previous {
            Some(child) => this.flushChild(move child, error),
            None => this.reportUnavailable(error)
        }
    }

    private def reportReadFailure(error : TextBuilder) : isize {
        this.reportTransportFailure(error)
        return isize(-1)
    }

    private def reportReadUnavailable(error : TextBuilder) : isize {
        this.reportUnavailable(error)
        return isize(-1)
    }

    private def tryReadChild(
        child : ChildProcess,
        target : Ptr[byte],
        capacity : usize,
        error : TextBuilder
    ) : isize {
        val result : isize = match child.tryRead(target, capacity) {
            Ok(count) => truncatingCast[isize](count),
            Error(systemError) => if systemError.category ==
            SystemErrorCategory.WouldBlock {
                isize(-2)
            } else {
                this.reportReadFailure(error)
            }
        }
        delete process
        process = Option.Some[ChildProcess](move child)
        return result
    }

    private def tryReadChunk(
        target : Ptr[byte],
        capacity : usize,
        error : TextBuilder
    ) : isize {
        val previous : Option[ChildProcess] = this.takeProcess()
        return match move previous {
            Some(child) => this.tryReadChild(move child, target, capacity, error),
            None => this.reportReadUnavailable(error)
        }
    }

    private def compactIncoming() : bool {
        if incomingStart == usize(0) { return true }
        val compacted : ByteBuffer = new ByteBuffer(incoming.size() - incomingStart)
        defer delete compacted
        var index : usize = incomingStart
        while index < incoming.size() {
            if !compacted.appendByte(incoming.data().load(index)) { return false }
            index = index + usize(1)
        }
        incoming.clear()
        if !incoming.append(compacted.data(), compacted.size()) { return false }
        incomingStart = usize(0)
        return true
    }

    private def collectAvailable(error : TextBuilder) : bool {
        if !this.compactIncoming() {
            error.clear()
            error.append("Mémoire insuffisante pour compacter les réponses LSP.")
            return false
        }
        val chunk : Ptr[byte] = alloc[byte](usize(4096))
        defer free(chunk)
        var attempts : usize = usize(0)
        while attempts < usize(8) {
            val count : isize = this.tryReadChunk(chunk, usize(4096), error)
            if count == isize(-2) { return true }
            if count <= isize(0) { return false }
            if !incoming.append(chunk, numericCast[usize](count)) {
                error.clear()
                error.append("Mémoire insuffisante pour lire la réponse LSP.")
                return false
            }
            if count < isize(4096) { return true }
            attempts = attempts + usize(1)
        }
        return true
    }

    private def headerBoundary() : usize {
        borrow val data : Ptr[byte] = incoming.data()
        var index : usize = incomingStart
        while index + usize(3) < incoming.size() {
            if data.load(index) == byte(13) &&
            data.load(index + usize(1)) == byte(10) &&
            data.load(index + usize(2)) == byte(13) &&
            data.load(index + usize(3)) == byte(10) {
                return index + usize(4)
            }
            index = index + usize(1)
        }
        return usize(-1)
    }

    private def copyAvailableMessage(error : TextBuilder) : int {
        val bodyStart : usize = this.headerBoundary()
        if bodyStart == usize(-1) { return 0 }
        header.clear()
        var headerIndex : usize = incomingStart
        while headerIndex < bodyStart {
            header.appendChar(char(incoming.data().load(headerIndex)))
            headerIndex = headerIndex + usize(1)
        }
        val length : usize = parseContentLength(header.view())
        if length == usize(0) {
            error.clear()
            error.append("Réponse LSP invalide.")
            return -1
        }
        if bodyStart + length > incoming.size() { return 0 }
        response.clear()
        var bodyIndex : usize = usize(0)
        while bodyIndex < length {
            if !response.appendByte(incoming.data().load(bodyStart + bodyIndex)) {
                error.clear()
                error.append("Mémoire insuffisante pour décoder la réponse LSP.")
                return -1
            }
            bodyIndex = bodyIndex + usize(1)
        }
        incomingStart = bodyStart + length
        if incomingStart == incoming.size() {
            incoming.clear()
            incomingStart = usize(0)
        }
        return 1
    }

    private def pollPendingResponse(error : TextBuilder) : int {
        if pendingResponse == PendingResponse.None { return 0 }
        if !this.flushOutgoing(error) { return -1 }
        if !this.collectAvailable(error) { return -1 }
        var attempts : usize = usize(0)
        while attempts < usize(64) {
            val copied : int = this.copyAvailableMessage(error)
            if copied <= 0 { return copied }
            if this.inspectResponse(response.asText(), pendingId) { return 1 }
            attempts = attempts + usize(1)
        }
        return 0
    }

    private def sendBody(error : TextBuilder) : bool {
        if !this.processAvailable() { return this.reportUnavailable(error) }
        header.clear()
        header.append("Content-Length: ")
        header.appendUSize(body.size())
        header.append("\r\n\r\n")
        return outgoing.append(
            stringData(header.view()),
            stringLength(header.view())
        ) && outgoing.append(body.data(), body.size())
    }

    private def inspectResponse(
        result : Result[string, TextDecodeError],
        id : usize
    ) : bool {
        return match result {
            Ok(json) => this.copyMatchingResponse(json, id),
            Error(decodeError) => false
        }
    }

    private def copyMatchingResponse(json : string, id : usize) : bool {
        if !messageHasId(json, id) { return false }
        responseJson.clear()
        responseJson.append(json)
        return true
    }

    private def appendNumber(value : usize) : bool {
        number.clear()
        number.appendUSize(value)
        return body.appendText(number.view())
    }

    def initialize(error : TextBuilder) : bool {
        body.clear()
        if !body.appendText(
            "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"rootPath\":"
        ) || !appendJsonString(workspace.view(), body) ||
        !body.appendText("}}") || !this.sendBody(error) {
            this.disable()
            return false
        }
        requestId = usize(2)
        pendingId = usize(1)
        pendingResponse = PendingResponse.Initialize
        return true
    }

    borrow def isReady() : bool { return ready }

    private def sendClose(error : TextBuilder) : bool {
        body.clear()
        return body.appendText(
            "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":"
        ) && appendJsonString(activeUri.view(), body) &&
        body.appendText("}}}") && this.sendBody(error)
    }

    private def sendOpen(buffer : EditorBuffer, error : TextBuilder) : bool {
        snapshot.clear()
        buffer.appendText(snapshot)
        body.clear()
        return body.appendText(
            "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":"
        ) && appendJsonString(activeUri.view(), body) &&
        body.appendText(",\"languageId\":\"janus\",\"version\":1,\"text\":") &&
        appendJsonString(snapshot.view(), body) &&
        body.appendText("}}}") && this.sendBody(error)
    }

    private def sendChange(buffer : EditorBuffer, error : TextBuilder) : bool {
        snapshot.clear()
        buffer.appendText(snapshot)
        body.clear()
        if !body.appendText(
            "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":"
        ) || !appendJsonString(activeUri.view(), body) ||
        !body.appendText(",\"version\":") ||
        !this.appendNumber(documentVersion) ||
        !body.appendText("},\"contentChanges\":[{\"text\":") ||
        !appendJsonString(snapshot.view(), body) ||
        !body.appendText("}]}}") { return false }
        return this.sendBody(error)
    }

    private def synchronizeDocument(
        path : string,
        buffer : EditorBuffer,
        error : TextBuilder
    ) : bool {
        if !documentUri(workspace.view(), path, requestedUri) {
            error.clear()
            error.append("Impossible de construire l'URI du fichier actif.")
            return false
        }
        if requestedUri.view() != activeUri.view() {
            if activeUri.size() > usize(0) && !this.sendClose(error) {
                return false
            }
            activeUri.clear()
            activeUri.append(requestedUri.view())
            documentVersion = usize(1)
            return this.sendOpen(buffer, error)
        }
        documentVersion = documentVersion + usize(1)
        return this.sendChange(buffer, error)
    }

    private def rememberPendingDocument(buffer : EditorBuffer) : Unit {
        pendingUri.clear()
        pendingUri.append(activeUri.view())
        pendingRevision = buffer.revision()
    }

    private def pendingDocumentMatches(
        path : string,
        buffer : EditorBuffer
    ) : bool {
        if !documentUri(workspace.view(), path, requestedUri) { return false }
        return requestedUri.view() == pendingUri.view() &&
        buffer.revision() == pendingRevision
    }

    def requestCompletion(
        path : string,
        buffer : EditorBuffer,
        line : usize,
        column : usize,
        labels : TextBuilder,
        error : TextBuilder
    ) : bool {
        labels.clear()
        error.clear()
        if !ready {
            error.append("Le serveur de langage est en cours d'initialisation.")
            return false
        }
        if !this.synchronizeDocument(path, buffer, error) { return false }
        val id : usize = requestId
        val utf16Column : usize = buffer.utf16Column(line, column)
        requestId = requestId + usize(1)
        body.clear()
        if !body.appendText("{\"jsonrpc\":\"2.0\",\"id\":") ||
        !this.appendNumber(id) || !body.appendText(
            ",\"method\":\"textDocument/completion\",\"params\":{\"textDocument\":{\"uri\":"
        ) || !appendJsonString(activeUri.view(), body) ||
        !body.appendText("},\"position\":{\"line\":") ||
        !this.appendNumber(line) || !body.appendText(",\"character\":") ||
        !this.appendNumber(utf16Column) || !body.appendText("}}}") ||
        !this.sendBody(error) { return false }
        pendingId = id
        pendingResponse = PendingResponse.Completion
        this.rememberPendingDocument(buffer)
        return true
    }

    def requestSignatureHelp(
        path : string,
        buffer : EditorBuffer,
        line : usize,
        column : usize,
        signature : TextBuilder,
        error : TextBuilder
    ) : bool {
        signature.clear()
        error.clear()
        if !ready {
            error.append("Le serveur de langage est en cours d'initialisation.")
            return false
        }
        if !this.synchronizeDocument(path, buffer, error) { return false }
        val id : usize = requestId
        val utf16Column : usize = buffer.utf16Column(line, column)
        requestId = requestId + usize(1)
        body.clear()
        if !body.appendText("{\"jsonrpc\":\"2.0\",\"id\":") ||
        !this.appendNumber(id) || !body.appendText(
            ",\"method\":\"textDocument/signatureHelp\",\"params\":{\"textDocument\":{\"uri\":"
        ) || !appendJsonString(activeUri.view(), body) ||
        !body.appendText("},\"position\":{\"line\":") ||
        !this.appendNumber(line) || !body.appendText(",\"character\":") ||
        !this.appendNumber(utf16Column) || !body.appendText("}}}") ||
        !this.sendBody(error) { return false }
        pendingId = id
        pendingResponse = PendingResponse.Signature
        this.rememberPendingDocument(buffer)
        return true
    }

    def poll(
        path : string,
        buffer : EditorBuffer,
        labels : TextBuilder,
        signature : TextBuilder,
        error : TextBuilder
    ) : LspResponseKind {
        val state : int = this.pollPendingResponse(error)
        if state == 0 { return LspResponseKind.None }
        if state < 0 {
            pendingResponse = PendingResponse.None
            ready = false
            return LspResponseKind.Failure
        }
        val completed : PendingResponse = pendingResponse
        pendingResponse = PendingResponse.None
        if completed == PendingResponse.Initialize {
            ready = true
            return LspResponseKind.Ready
        }
        if !this.pendingDocumentMatches(path, buffer) {
            return LspResponseKind.Discarded
        }
        if completed == PendingResponse.Completion {
            extractCompletionLabels(responseJson.view(), labels)
            return LspResponseKind.Completion
        }
        extractSignatureLabel(responseJson.view(), signature)
        return LspResponseKind.Signature
    }

    def shutdown(error : TextBuilder) : bool {
        if activeUri.size() > usize(0) && !this.sendClose(error) {
            this.disable()
            return false
        }
        val id : usize = requestId
        body.clear()
        if !body.appendText("{\"jsonrpc\":\"2.0\",\"id\":") ||
        !this.appendNumber(id) ||
        !body.appendText(",\"method\":\"shutdown\",\"params\":null}") ||
        !this.sendBody(error) {
            this.disable()
            return false
        }
        body.clear()
        val sent : bool = body.appendText(
            "{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":null}"
        ) && this.sendBody(error) && this.flushOutgoing(error)
        this.disable()
        return sent
    }

    destructor {
        delete process
        delete workspace
        delete body
        delete response
        delete incoming
        delete outgoing
        delete header
        delete number
        delete activeUri
        delete requestedUri
        delete pendingUri
        delete snapshot
        delete responseJson
    }
}

private def clientWithProcess(
    result : Result[ChildProcess, SystemError],
    workspace : TextBuilder
) : LspClient {
    val state : Option[ChildProcess] = match move result {
        Ok(child) => Option.Some[ChildProcess](move child),
        Error(error) => Option.None[ChildProcess]()
    }
    return new LspClient(
        move state,
        move workspace,
        new ByteBuffer(usize(4096)),
        new ByteBuffer(usize(4096)),
        new ByteBuffer(usize(4096)),
        new ByteBuffer(usize(4096)),
        new TextBuilder(),
        new TextBuilder(),
        new TextBuilder(),
        new TextBuilder(),
        new TextBuilder(),
        new TextBuilder(),
        new TextBuilder()
    )
}

def lspClient(workspacePath : string, error : TextBuilder) : LspClient {
    val workspace : TextBuilder = new TextBuilder()
    if workspacePath == "" {
        workspace.append(".")
    } else {
        workspace.append(workspacePath)
    }
    val arguments : Array[string] = new Array[string](usize(0))
    defer delete arguments
    val client : LspClient = clientWithProcess(
        spawnProcess("janus-lsp", arguments, workspace.view()),
        move workspace
    )
    client.initialize(error)
    return move client
}
