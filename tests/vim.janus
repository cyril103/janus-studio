import editor.buffer
import editor.vim
import std.testing
import std.text

/// @test
def switchesModesAndEditsText() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    val controller : VimController = vimController()
    defer delete controller
    buffer.load("ac")
    buffer.moveFileStart()

    controller.handleNormal('i', buffer)
    assertEqual[EditorMode](controller.mode(), EditorMode.Insert)
    controller.handleInsert('b', buffer)
    controller.escape()
    assertEqual[EditorMode](controller.mode(), EditorMode.Normal)

    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "bac")
}

/// @test
def handlesNormalCommandSequences() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    val controller : VimController = vimController()
    defer delete controller
    buffer.load("first\nsecond")
    buffer.moveFileStart()

    controller.handleNormal('d', buffer)
    controller.handleNormal('d', buffer)
    assertEqual[usize](buffer.line(), usize(0))

    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "second")

    controller.handleNormal('u', buffer)
    output.clear()
    buffer.appendText(output)
    assertEqual[string](output.view(), "first\nsecond")

    controller.handleNormal('G', buffer)
    assertEqual[usize](buffer.line(), usize(1))
    controller.handleNormal('g', buffer)
    controller.handleNormal('g', buffer)
    assertEqual[usize](buffer.line(), usize(0))
}

/// @test
def pastesDeletedAndYankedLines() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    val controller : VimController = vimController()
    defer delete controller
    buffer.load("first\nsecond\nthird")
    buffer.moveFileStart()

    controller.handleNormal('d', buffer)
    controller.handleNormal('d', buffer)
    controller.handleNormal('p', buffer)

    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "second\nfirst\nthird")

    buffer.moveFileStart()
    controller.handleNormal('y', buffer)
    controller.handleNormal('y', buffer)
    controller.handleNormal('p', buffer)
    output.clear()
    buffer.appendText(output)
    assertEqual[string](output.view(), "second\nsecond\nfirst\nthird")

    controller.handleNormal('P', buffer)
    output.clear()
    buffer.appendText(output)
    assertEqual[string](
    output.view(),
    "second\nsecond\nsecond\nfirst\nthird"
    )
}

/// @test
def parsesColonCommands() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    val controller : VimController = vimController()
    defer delete controller

    controller.handleNormal(':', buffer)
    assertEqual[EditorMode](controller.mode(), EditorMode.Command)
    val status : TextBuilder = new TextBuilder()
    defer delete status
    val commandLine : TextBuilder = new TextBuilder()
    defer delete commandLine
    controller.appendStatus(status)
    controller.appendCommandLine(commandLine)
    assertEqual[string](status.view(), "COMMAND")
    assertEqual[string](commandLine.view(), ":")
    controller.handleCommand('w')
    controller.handleCommand('q')
    controller.appendCommandLine(commandLine)
    assertEqual[string](commandLine.view(), ":wq")
    assertEqual[EditorAction](
    controller.executeCommand(),
    EditorAction.SaveAndQuit
    )
    assertEqual[EditorMode](controller.mode(), EditorMode.Normal)
    controller.appendCommandLine(commandLine)
    assertEqual[string](commandLine.view(), "")
}

/// @test
def deletesFullUnicodeCharactersInCommandLine() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    val controller : VimController = vimController()
    defer delete controller
    val commandLine : TextBuilder = new TextBuilder()
    defer delete commandLine

    controller.handleNormal(':', buffer)
    assertEqual[EditorMode](controller.mode(), EditorMode.Command)

    // 2-byte UTF-8 ('é')
    controller.handleCommand('é')
    commandLine.clear()
    controller.appendCommandLine(commandLine)
    assertEqual[string](commandLine.view(), ":é")
    controller.commandBackspace()
    commandLine.clear()
    controller.appendCommandLine(commandLine)
    assertEqual[string](commandLine.view(), ":")

    // 3-byte UTF-8 ('世')
    controller.handleCommand('世')
    commandLine.clear()
    controller.appendCommandLine(commandLine)
    assertEqual[string](commandLine.view(), ":世")
    controller.commandBackspace()
    commandLine.clear()
    controller.appendCommandLine(commandLine)
    assertEqual[string](commandLine.view(), ":")

    // 4-byte UTF-8 ('😀')
    controller.handleCommand('😀')
    commandLine.clear()
    controller.appendCommandLine(commandLine)
    assertEqual[string](commandLine.view(), ":😀")
    controller.commandBackspace()
    commandLine.clear()
    controller.appendCommandLine(commandLine)
    assertEqual[string](commandLine.view(), ":")

    // Final backspace exits command mode cleanly
    controller.commandBackspace()
    assertEqual[EditorMode](controller.mode(), EditorMode.Normal)
}
