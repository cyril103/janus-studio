import editor.buffer
import editor.completion
import tooling.lsp
import std.io
import std.testing
import std.text

def awaitLspResponse(
client : LspClient,
labels : TextBuilder,
signature : TextBuilder,
error : TextBuilder
) : LspResponseKind {
    var attempts : usize = usize(0)
    var response : LspResponseKind = LspResponseKind.None
    while response == LspResponseKind.None && attempts < usize(200000) {
        response = client.poll(labels, signature, error)
        attempts = attempts + usize(1)
    }
    return response
}

/// @test
def extractsCompletionLabels() : Unit {
    val labels : TextBuilder = new TextBuilder()
    defer delete labels
    extractCompletionLabels(
    "{\"items\":[{\"detail\":\"def get(index : usize) : int\",\"label\":\"get\"},{\"detail\":\"def size() : usize\",\"label\":\"size\"},{\"detail\":\"def get(index : int) : int\",\"label\":\"get\"}]}",
    labels
    )
    assertEqual[string](
    labels.view(),
    "get\tdef get(index : usize) : int\nsize\tdef size() : usize\nget\tdef get(index : int) : int\n"
    )
    assertTrue(containsLabel(labels.view(), "size", usize(0), usize(4)))
}

/// @test
def decodesStructuredUnicodeCompletionFields() : Unit {
    val labels : TextBuilder = new TextBuilder()
    defer delete labels
    extractCompletionLabels(
    "{\"items\":[{\"detail\":\"café \\\"label\\\":\\\"piège\\\"\",\"label\":\"élément \\uD83D\\uDE00\"}]}",
    labels
    )
    assertEqual[string](
    labels.view(),
    "élément 😀\tcafé \"label\":\"piège\"\n"
    )
}

/// @test
def extractsSignatureLabel() : Unit {
    val signature : TextBuilder = new TextBuilder()
    defer delete signature
    extractSignatureLabel(
    "{\"activeParameter\":1,\"activeSignature\":0,\"signatures\":[{\"label\":\"combine(left : int, right : int) : int\",\"parameters\":[{\"label\":\"left : int\"},{\"label\":\"right : int\"}]}]}",
    signature
    )
    assertEqual[string](
    signature.view(),
    "combine(left : int, right : int) : int"
    )
}

/// @test
def parsesLspFramesAndResponseIds() : Unit {
    assertEqual[usize](
    parseContentLength("Content-Length: 123\r\n\r\n"),
    usize(123)
    )
    assertEqual[usize](parseContentLength("Missing: 12\r\n\r\n"), usize(0))
    assertTrue(messageHasId("{\"jsonrpc\":\"2.0\",\"id\":12,\"result\":[]}", usize(12)))
    assertTrue(!messageHasId("{\"id\":120,\"result\":[]}", usize(12)))
}

/// @test
def escapesJsonStringsAsUtf8() : Unit {
    val encoded : ByteBuffer = new ByteBuffer(usize(32))
    defer delete encoded
    assertTrue(appendJsonString("hé\n\"Janus\"", encoded))
    val text : Result[string, TextDecodeError] = encoded.asText()
    val matches : bool = match text {
        Ok(value) => value == "\"hé\\n\\\"Janus\\\"\"",
        Error(error) => false
    }
    assertTrue(matches)
}

/// @test
def reusesPersistentLspSession() : Unit {
    val error : TextBuilder = new TextBuilder()
    defer delete error
    val client : LspClient = lspClient(".", error)
    defer delete client
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load(
    "import std.array\n\ndef main() : int {\n    val xs = [1]\n    xs.\n    return 0\n}"
    )
    val labels : TextBuilder = new TextBuilder()
    defer delete labels
    val signature : TextBuilder = new TextBuilder()
    defer delete signature

    assertTrue(client.requestCompletion(
    "samples/persistent-completion.janus",
    buffer,
    usize(4),
    usize(7),
    labels,
    error
    ))
    assertEqual[LspResponseKind](
    awaitLspResponse(client, labels, signature, error),
    LspResponseKind.Completion
    )
    assertTrue(containsLabel(labels.view(), "get", usize(0), usize(3)))

    labels.clear()
    assertTrue(client.requestCompletion(
    "samples/persistent-completion.janus",
    buffer,
    usize(4),
    usize(7),
    labels,
    error
    ))
    assertEqual[LspResponseKind](
    awaitLspResponse(client, labels, signature, error),
    LspResponseKind.Completion
    )
    assertTrue(containsLabel(labels.view(), "size", usize(0), usize(4)))

    buffer.load(
    "class Values() {\n    def get(index : usize) : int { return 0 }\n}\n\ndef main() : int {\n    val xs : Values = new Values()\n    xs.get(0)\n    return 0\n}"
    )
    assertTrue(client.requestSignatureHelp(
    "samples/persistent-completion.janus",
    buffer,
    usize(6),
    usize(11),
    signature,
    error
    ))
    assertEqual[LspResponseKind](
    awaitLspResponse(client, labels, signature, error),
    LspResponseKind.Signature
    )
    assertEqual[string](signature.view(), "get(index : usize) : int")
    assertTrue(client.shutdown(error))
}

/// @test
def navigatesAndAcceptsCompletion() : Unit {
    val completion : CompletionModel = completionModel()
    defer delete completion
    completion.load("get\nsize\npush\n")
    assertTrue(completion.isVisible())
    assertEqual[usize](completion.size(), usize(3))

    completion.selectNext()
    val selected : TextBuilder = new TextBuilder()
    defer delete selected
    completion.appendItem(completion.selected(), selected)
    assertEqual[string](selected.view(), "size")
    completion.appendDisplayItem(completion.selected(), selected)
    assertEqual[string](selected.view(), "size")

    completion.load(
    "get\tdef get(index : usize) : int\nsize\tdef size() : usize\n"
    )
    completion.selectNext()
    completion.appendDisplayItem(completion.selected(), selected)
    assertEqual[string](selected.view(), "def size() : usize")
    completion.appendItem(completion.selected(), selected)
    assertEqual[string](selected.view(), "size")

    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("xs.")
    assertTrue(completion.accept(buffer))
    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "xs.size")
    assertTrue(!completion.isVisible())
}

/// @test
def filtersCompletionWhileTyping() : Unit {
    val completion : CompletionModel = completionModel()
    defer delete completion
    completion.load(
    "get\tdef get(index : usize) : int\ngrow\tdef grow() : Unit\nsize\tdef size() : usize\n"
    )
    completion.refine('g')
    assertEqual[usize](completion.size(), usize(2))
    completion.refine('e')
    assertEqual[usize](completion.size(), usize(1))

    val selected : TextBuilder = new TextBuilder()
    defer delete selected
    completion.appendItem(completion.selected(), selected)
    assertEqual[string](selected.view(), "get")

    completion.broaden()
    assertEqual[usize](completion.size(), usize(2))
    completion.refine('e')
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("xs.ge")
    assertTrue(completion.accept(buffer))
    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "xs.get")

    completion.load("get\nsize\n")
    completion.refine('x')
    assertTrue(!completion.isVisible())
    completion.broaden()
    assertEqual[usize](completion.size(), usize(2))
    completion.broaden()
    assertTrue(!completion.isFiltering())
}

/// @test
def filtersAndAcceptsUnicodeCompletionLabels() : Unit {
    val completion : CompletionModel = completionModel()
    defer delete completion
    completion.load("élément\tdéfinit élément\néclair\ndelta\n")
    completion.refine('é')
    assertEqual[usize](completion.size(), usize(2))

    val selected : TextBuilder = new TextBuilder()
    defer delete selected
    completion.appendDisplayItem(usize(0), selected)
    assertEqual[string](selected.view(), "définit élément")

    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("é")
    assertTrue(completion.accept(buffer))
    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "élément")
}
