import editor.buffer
import editor.completion
import tooling.lsp
import std.io
import std.testing
import std.text

/// @test
def extractsCompletionLabels() : Unit {
    val labels : TextBuilder = new TextBuilder()
    defer delete labels
    extractCompletionLabels(
    "{\"items\":[{\"detail\":\"def get\",\"label\":\"get\"},{\"detail\":\"def size\",\"label\":\"size\"},{\"detail\":\"get overload\",\"label\":\"get\"}]}",
    labels
    )
    assertEqual[string](labels.view(), "get\nsize\n")
}

/// @test
def parsesLspFramesAndResponseIds() : Unit {
    assertEqual[usize](
    parseContentLength("Content-Length: 123\r\n\r\n"),
    usize(123)
    )
    assertEqual[usize](parseContentLength("Missing: 12\r\n\r\n"), usize(0))
    assertTrue(messageHasId("{\"jsonrpc\":\"2.0\",\"id\":12,\"result\":[]}", usize(12)))
    assertTrue(!messageHasId("{\"id\":120,\"result\":[]}", usize(12)))
}

/// @test
def escapesJsonStringsAsUtf8() : Unit {
    val encoded : ByteBuffer = new ByteBuffer(usize(32))
    defer delete encoded
    assertTrue(appendJsonString("hé\n\"Janus\"", encoded))
    val text : Result[string, TextDecodeError] = encoded.asText()
    val matches : bool = match text {
        Ok(value) => value == "\"hé\\n\\\"Janus\\\"\"",
        Error(error) => false
    }
    assertTrue(matches)
}

/// @test
def reusesPersistentLspSession() : Unit {
    val error : TextBuilder = new TextBuilder()
    defer delete error
    val client : LspClient = lspClient(error)
    defer delete client
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load(
    "import std.array\n\ndef main() : int {\n    val xs = [1]\n    xs.\n    return 0\n}"
    )
    val labels : TextBuilder = new TextBuilder()
    defer delete labels

    assertTrue(client.requestCompletion(
    "samples/persistent-completion.janus",
    buffer,
    usize(4),
    usize(7),
    labels,
    error
    ))
    assertTrue(containsLabel(labels.view(), "get", usize(0), usize(3)))

    labels.clear()
    assertTrue(client.requestCompletion(
    "samples/persistent-completion.janus",
    buffer,
    usize(4),
    usize(7),
    labels,
    error
    ))
    assertTrue(containsLabel(labels.view(), "size", usize(0), usize(4)))
}

/// @test
def navigatesAndAcceptsCompletion() : Unit {
    val completion : CompletionModel = completionModel()
    defer delete completion
    completion.load("get\nsize\npush\n")
    assertTrue(completion.isVisible())
    assertEqual[usize](completion.size(), usize(3))

    completion.selectNext()
    val selected : TextBuilder = new TextBuilder()
    defer delete selected
    completion.appendItem(completion.selected(), selected)
    assertEqual[string](selected.view(), "size")

    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("xs.")
    assertTrue(completion.accept(buffer))
    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "xs.size")
    assertTrue(!completion.isVisible())
}
