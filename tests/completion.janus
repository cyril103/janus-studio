import editor.buffer
import editor.completion
import tooling.lsp
import std.io
import std.testing
import std.text
import std.time

private def containsCompletionLabel(labels : string, label : string) : bool {
    val candidate : Ptr[byte] = stringData(labels)
    val expected : Ptr[byte] = stringData(label)
    var index : usize = usize(0)
    while index + stringLength(label) <= stringLength(labels) {
        var offset : usize = usize(0)
        while offset < stringLength(label) &&
        candidate.load(index + offset) == expected.load(offset) {
            offset = offset + usize(1)
        }
        if offset == stringLength(label) { return true }
        index = index + usize(1)
    }
    return false
}

/// @test
def extractsCompletionLabels() : Unit {
    val labels : TextBuilder = new TextBuilder()
    defer delete labels
    extractCompletionLabels(
    "{\"items\":[{\"detail\":\"def get\",\"label\":\"get\"},{\"detail\":\"def size\",\"label\":\"size\"},{\"detail\":\"get overload\",\"label\":\"get\"}]}",
    labels
    )
    assertEqual[string](labels.view(), "get\nsize\n")
}

/// @test
def boundsAndDeduplicatesCompletionLabels() : Unit {
    val json : TextBuilder = new TextBuilder()
    defer delete json
    json.append("[{\"label\":\"same\"},{\"label\":\"same\"}")
    var index : usize = usize(0)
    while index < usize(5000) {
        json.append(",{\"label\":\"item")
        json.appendUSize(index)
        json.append("\"}")
        index = index + usize(1)
    }
    json.append("]")
    val labels : TextBuilder = new TextBuilder()
    defer delete labels
    extractCompletionLabels(json.view(), labels)
    assertTrue(labels.size() <= usize(1048576))
    assertTrue(containsCompletionLabel(labels.view(), "same\n"))
    assertTrue(!containsCompletionLabel(labels.view(), "item4999\n"))
}

/// @test
def parsesLspFramesAndResponseIds() : Unit {
    assertEqual[usize](
    parseContentLength("Content-Length: 123\r\n\r\n"),
    usize(123)
    )
    assertEqual[usize](parseContentLength("Missing: 12\r\n\r\n"), usize(0))
    assertEqual[usize](parseContentLength("Content-Length: 0\r\n\r\n"), usize(0))
    assertEqual[usize](parseContentLength("content-length: 12\r\n\r\n"), usize(0))
    assertEqual[usize](parseContentLength("X-Content-Length: 12\r\n\r\n"), usize(0))
    assertEqual[usize](parseContentLength("Content-Length: 12x\r\n\r\n"), usize(0))
    assertEqual[usize](parseContentLength("Content-Length:\t12\r\n\r\n"), usize(0))
    assertEqual[usize](
    parseContentLength("Content-Length: 12\r\nContent-Length: 12\r\n\r\n"),
    usize(0)
    )
    assertEqual[usize](
    parseContentLength("Content-Length: 4194305\r\n\r\n"),
    usize(0)
    )
    assertEqual[usize](
    parseContentLength("Content-Length: 68513542064283550907\r\n\r\n"),
    usize(0)
    )
    assertTrue(messageHasId("{\"jsonrpc\":\"2.0\",\"id\":12,\"result\":[]}", usize(12)))
    assertTrue(!messageHasId("{\"id\":120,\"result\":[]}", usize(12)))
    assertTrue(!messageHasId(
    "{\"id\":68513542064283550907,\"result\":[]}", usize(12)
    ))
    assertTrue(!messageHasId(
    "{\"params\":{\"id\":12},\"result\":[]}", usize(12)
    ))
    assertTrue(!messageHasId(
    "{\"result\":[{\"id\":12}],\"other\":\"id\\\":12\"}", usize(12)
    ))
    assertTrue(messageHasId(
    " { \"note\" : \"escaped \\\"id\\\": 99\", \"id\" : 12 } ", usize(12)
    ))
    assertTrue(!messageHasId(
    "{\"id\":13,\"params\":{\"id\":12}}", usize(12)
    ))
    assertTrue(!messageHasId("{\"id\":12,\"result\":[}", usize(12)))
    assertTrue(!messageHasId("{\"id\":12,\"id\":12}", usize(12)))
    assertTrue(!messageHasId("{\"id\":12,\"i\\u0064\":13}", usize(12)))
    assertTrue(messageHasId("{\"\\u0069\\u0064\":12}", usize(12)))
    assertTrue(messageHasId("{\"\\u0069d\":12}", usize(12)))
    assertTrue(!messageHasId("{\"before\":wat,\"id\":12}", usize(12)))
    assertTrue(!messageHasId("{\"id\":12} trailing", usize(12)))
    assertTrue(messageHasId(
    "{\"before\":{\"array\":[true,false,null,-12.5e+2]},\"id\":12}",
    usize(12)
    ))
}

/// @test
def parsesJsonRpcWithWhitespaceAndEscapes() : Unit {
    val labels : TextBuilder = new TextBuilder()
    defer delete labels

    assertTrue(messageHasId("{\"id\" : 7, \"result\": []}", usize(7)))

    extractCompletionLabels("[{\"label\":\"a\\\"b\"}]", labels)
    assertEqual[string](labels.view(), "a\"b\n")

    labels.clear()
    extractCompletionLabels("[{\"label\":\"line\\nnext\"}]", labels)
    assertEqual[string](labels.view(), "line\nnext\n")

    labels.clear()
    extractCompletionLabels("[{\"label\":\"h\\u00e9llo\"}]", labels)
    assertEqual[string](labels.view(), "héllo\n")
}

/// @test
def parsesCompletionListAndItemArray() : Unit {
    val labels : TextBuilder = new TextBuilder()
    defer delete labels

    extractCompletionLabels(
    "{\"isIncomplete\": false, \"items\": [{\"label\": \"foo\"}, {\"label\": \"bar\"}]}",
    labels
    )
    assertEqual[string](labels.view(), "foo\nbar\n")

    labels.clear()
    extractCompletionLabels(
    "{\"jsonrpc\":\"2.0\",\"id\":10,\"result\":{\"isIncomplete\":true,\"items\":[{\"label\":\"one\"}]}}",
    labels
    )
    assertEqual[string](labels.view(), "one\n")
}

/// @test
def classifiesJsonRpcMessageTypes() : Unit {
    val msg : JsonRpcMessage = jsonRpcMessage()
    defer delete msg

    assertTrue(parseJsonRpcMessage("{\"jsonrpc\":\"2.0\",\"method\":\"window/logMessage\",\"params\":{\"message\":\"hi\"}}", msg))
    assertEqual[JsonRpcKind](msg.kind, JsonRpcKind.Notification)
    assertEqual[JsonIdKind](msg.idKind, JsonIdKind.None)

    assertTrue(parseJsonRpcMessage("{\"jsonrpc\":\"2.0\",\"id\":42,\"result\":[{\"label\":\"test\"}]}", msg))
    assertEqual[JsonRpcKind](msg.kind, JsonRpcKind.Response)
    assertEqual[JsonIdKind](msg.idKind, JsonIdKind.Number)
    assertEqual[usize](msg.idNumber, usize(42))

    assertTrue(parseJsonRpcMessage("{\"jsonrpc\":\"2.0\",\"id\":42,\"error\":{\"code\":-32601,\"message\":\"Not found\"}}", msg))
    assertEqual[JsonRpcKind](msg.kind, JsonRpcKind.ErrorResponse)
    assertEqual[JsonIdKind](msg.idKind, JsonIdKind.Number)
    assertEqual[usize](msg.idNumber, usize(42))

    assertTrue(!messageHasId("{\"id\": true, \"result\": []}", usize(1)))
    assertTrue(!messageHasId("{\"id\": [1, 2], \"result\": []}", usize(1)))
}

/// Faux serveur déterministe injecté à la frontière transport : le parseur reçoit
/// directement ses octets et la machine son temps synthétique/EOF. Cela reproduit
/// lecture, silence et fermeture sans processus ni horloge dépendant de la machine.
/// @test
def incrementallyFramesBoundedLspMessages() : Unit {
    val parser : LspFrameParser = lspFrameParser()
    defer delete parser
    assertEqual[LspFrameResult](
    parser.feed("Content-Length: 8\r\n", false),
    LspFrameResult.Pending
    )
    assertEqual[LspFrameResult](
    parser.feed("\r\n{\"id\":", false),
    LspFrameResult.Pending
    )
    assertEqual[LspFrameResult](
    parser.feed("1}", false),
    LspFrameResult.Ready
    )
    val firstMessage : Result[string, TextDecodeError] = parser.message()
    val firstMatches : bool = match firstMessage {
        Ok(value) => value == "{\"id\":1}",
        Error(error) => false
    }
    assertTrue(firstMatches)

    parser.reset()
    assertEqual[LspFrameResult](
    parser.feed("Content-Length: 14\r\n\r\n{\"label\":\"", false),
    LspFrameResult.Pending
    )
    val splitUtf8 : Ptr[byte] = alloc[byte](usize(1))
    defer free(splitUtf8)
    splitUtf8.store(usize(0), byte(195))
    assertEqual[LspFrameResult](
    parser.feedBytes(splitUtf8, usize(1), false),
    LspFrameResult.Pending
    )
    splitUtf8.store(usize(0), byte(169))
    assertEqual[LspFrameResult](
    parser.feedBytes(splitUtf8, usize(1), false),
    LspFrameResult.Pending
    )
    assertEqual[LspFrameResult](parser.feed("\"}", false), LspFrameResult.Ready)
    val utf8Message : Result[string, TextDecodeError] = parser.message()
    val utf8Matches : bool = match utf8Message {
        Ok(value) => value == "{\"label\":\"é\"}",
        Error(error) => false
    }
    assertTrue(utf8Matches)

    parser.reset()
    assertEqual[LspFrameResult](
    parser.feed("Content-Length: 4194305\r\n\r\n", false),
    LspFrameResult.Invalid
    )
    parser.reset()
    assertEqual[LspFrameResult](
    parser.feed("Content-Length: 20\r\n\r\nshort", true),
    LspFrameResult.EndOfFile
    )
}

/// @test
def modelsTimeoutReplacementStaleReplyAndRestartWithoutSleeping() : Unit {
    val machine : LspStateMachine = lspStateMachine()
    defer delete machine
    machine.started(usize(100))
    assertEqual[LspMachineState](machine.state(), LspMachineState.Initializing)
    assertEqual[LspPollEvent](machine.advance(usize(5099)), LspPollEvent.None)
    assertEqual[LspPollEvent](machine.advance(usize(5100)), LspPollEvent.TimedOut)
    assertEqual[LspMachineState](machine.state(), LspMachineState.BackingOff)
    machine.ensureBackoff(usize(5200))
    assertEqual[LspPollEvent](machine.advance(usize(5349)), LspPollEvent.None)
    assertEqual[LspPollEvent](machine.advance(usize(5350)), LspPollEvent.Restart)

    machine.started(usize(6000))
    assertEqual[LspPollEvent](
    machine.response(usize(1), usize(6001)),
    LspPollEvent.Initialized
    )
    machine.request(usize(2), usize(6100))
    machine.request(usize(3), usize(6101))
    assertEqual[usize](machine.activeRequest(), usize(2))
    assertEqual[usize](machine.replacementRequest(), usize(3))
    machine.invalidate()
    assertEqual[usize](machine.activeRequest(), usize(2))
    assertEqual[LspPollEvent](
    machine.response(usize(2), usize(6200)),
    LspPollEvent.Stale
    )
    assertEqual[usize](machine.activeRequest(), usize(0))
}

/// @test
def modelsSilentServerAndStopDuringRequest() : Unit {
    val machine : LspStateMachine = lspStateMachine()
    defer delete machine
    machine.started(usize(10))
    assertEqual[LspPollEvent](machine.advance(usize(5010)), LspPollEvent.TimedOut)
    machine.started(usize(6000))
    assertEqual[LspPollEvent](
    machine.response(usize(1), usize(6001)),
    LspPollEvent.Initialized
    )
    machine.request(usize(2), usize(6100))
    assertEqual[LspPollEvent](machine.endOfFile(usize(6101)), LspPollEvent.Restarting)
    assertEqual[LspMachineState](machine.state(), LspMachineState.BackingOff)
}

/// @test
def queuesCompletionUntilInitializeAndKeepsLatestReplacement() : Unit {
    val machine : LspStateMachine = lspStateMachine()
    defer delete machine
    machine.started(usize(100))
    machine.request(usize(2), usize(101))
    machine.request(usize(3), usize(102))
    assertEqual[LspMachineState](machine.state(), LspMachineState.Initializing)
    assertEqual[usize](machine.activeRequest(), usize(1))
    assertEqual[usize](machine.replacementRequest(), usize(3))
    assertEqual[LspPollEvent](
    machine.response(usize(1), usize(200)),
    LspPollEvent.Initialized
    )
    assertEqual[LspMachineState](machine.state(), LspMachineState.Waiting)
    assertEqual[usize](machine.activeRequest(), usize(3))
    assertEqual[usize](machine.deadlineAt(), usize(2200))
}

/// @test
def ignoresInvalidatedActiveThenStartsLatestWithFreshDeadline() : Unit {
    val machine : LspStateMachine = lspStateMachine()
    defer delete machine
    machine.started(usize(0))
    machine.response(usize(1), usize(10))
    machine.request(usize(2), usize(20))
    machine.invalidate()
    machine.request(usize(3), usize(30))
    machine.request(usize(4), usize(40))
    assertEqual[usize](machine.activeRequest(), usize(2))
    assertEqual[usize](machine.replacementRequest(), usize(4))
    assertEqual[LspPollEvent](
    machine.response(usize(2), usize(150)),
    LspPollEvent.Stale
    )
    assertEqual[usize](machine.activeRequest(), usize(4))
    assertEqual[usize](machine.deadlineAt(), usize(2150))
}

/// @test
def retriesFailedSpawnAfterEachBackoff() : Unit {
    val machine : LspStateMachine = lspStateMachine()
    defer delete machine
    machine.endOfFile(usize(100))
    assertEqual[LspPollEvent](machine.advance(usize(350)), LspPollEvent.Restart)
    machine.restartFailed(usize(350))
    assertEqual[LspPollEvent](machine.advance(usize(599)), LspPollEvent.None)
    assertEqual[LspPollEvent](machine.advance(usize(600)), LspPollEvent.Restart)
}

/// @test
def saturatesDeadlinesInsteadOfWrapping() : Unit {
    val machine : LspStateMachine = lspStateMachine()
    defer delete machine
    machine.started(usize(-2))
    assertEqual[usize](machine.deadlineAt(), usize(-1))
    assertEqual[LspPollEvent](machine.advance(usize(-2)), LspPollEvent.None)
    assertEqual[LspPollEvent](machine.advance(usize(-1)), LspPollEvent.TimedOut)
}

/// @test
def rebuildsLatestDocumentReplacementFromActiveState() : Unit {
    val documents : LspDocumentQueueState = lspDocumentQueueState()
    defer delete documents
    documents.beginReplacement()
    assertEqual[LspDocumentTransition](
    documents.replace("file:///A.janus"), LspDocumentTransition.Open
    )
    documents.commitReplacement()

    documents.beginReplacement()
    assertEqual[LspDocumentTransition](
    documents.replace("file:///B.janus"), LspDocumentTransition.CloseThenOpen
    )
    documents.beginReplacement()
    assertEqual[LspDocumentTransition](
    documents.replace("file:///B.janus"), LspDocumentTransition.CloseThenOpen
    )
    assertEqual[usize](documents.pendingVersion(), usize(1))

    documents.beginReplacement()
    assertEqual[LspDocumentTransition](
    documents.replace("file:///B.janus"), LspDocumentTransition.CloseThenOpen
    )
    documents.beginReplacement()
    assertEqual[LspDocumentTransition](
    documents.replace("file:///C.janus"), LspDocumentTransition.CloseThenOpen
    )
    assertEqual[string](documents.activeDocument(), "file:///A.janus")
    assertEqual[string](documents.replacementDocument(), "file:///C.janus")
}

/// @test
def putsInitializedBeforeQueuedDocumentBytes() : Unit {
    val replacement : ByteBuffer = new ByteBuffer(usize(64))
    defer delete replacement
    val outgoing : ByteBuffer = new ByteBuffer(usize(128))
    defer delete outgoing
    assertTrue(replacement.appendText("DID_OPEN_THEN_COMPLETION"))
    assertTrue(appendInitializedPrefix(replacement, outgoing))
    val bytes : Result[string, TextDecodeError] = outgoing.asText()
    val ordered : bool = match bytes {
        Ok(value) => value ==
        "Content-Length: 52\r\n\r\n{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}DID_OPEN_THEN_COMPLETION",
        Error(error) => false
    }
    assertTrue(ordered)
}

/// @test
def leavesDocumentQueueAndMetadataUntouchedWhenCandidateFails() : Unit {
    val error : TextBuilder = new TextBuilder()
    defer delete error
    val labels : TextBuilder = new TextBuilder()
    defer delete labels
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("def small() : int { return 1 }")
    val client : LspClient = lspClient(error)
    defer delete client
    assertTrue(client.requestCompletion(
    "samples/atomic-A.janus", buffer, usize(0), usize(3), labels, error
    ))
    val uriBefore : TextBuilder = new TextBuilder()
    defer delete uriBefore
    uriBefore.append(client.queuedDocument())
    val versionBefore : usize = client.queuedDocumentVersion()
    val bytesBefore : usize = client.queuedBytes()
    val requestBefore : usize = client.nextRequestId()

    val oversized : TextBuilder = new TextBuilder()
    defer delete oversized
    while oversized.size() <= usize(700000) {
        oversized.append("0123456789abcdef0123456789abcdef")
    }
    buffer.load(oversized.view())
    assertTrue(!client.requestCompletion(
    "samples/atomic-B.janus", buffer, usize(0), usize(1), labels, error
    ))
    assertEqual[string](client.queuedDocument(), uriBefore.view())
    assertEqual[usize](client.queuedDocumentVersion(), versionBefore)
    assertEqual[usize](client.queuedBytes(), bytesBefore)
    assertEqual[usize](client.nextRequestId(), requestBefore)
}

/// Les primitives non bloquantes tryRead/tryWrite sont couvertes avec de vrais
/// processus enfants dans la PR Janus liée. Ici, ce test exerce le vrai LspClient
/// et janus-lsp de bout en bout, sans jamais appeler une lecture bloquante.
/// @test
def completesThroughRealJanusLspBeforeMonotonicDeadline() : Unit {
    val error : TextBuilder = new TextBuilder()
    defer delete error
    val labels : TextBuilder = new TextBuilder()
    defer delete labels
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load(
    "import std.array\n\ndef main() : int {\n    val xs = [1]\n    xs.\n    return 0\n}"
    )
    val client : LspClient = lspClient(error)
    defer delete client
    assertTrue(client.requestCompletion(
    "samples/persistent-completion.janus",
    buffer,
    usize(4),
    usize(7),
    labels,
    error
    ))
    val origin : Instant = monotonicNow()
    var completed : bool = false
    while !completed &&
    monotonicNow().durationSince(origin).milliseconds() < usize(5000) {
        client.poll(error)
        completed = client.takeCompletion(labels)
    }
    assertTrue(completed)
    assertTrue(containsCompletionLabel(labels.view(), "get"))
    assertTrue(containsCompletionLabel(labels.view(), "size"))
}

/// @test
def escapesJsonStringsAsUtf8() : Unit {
    val encoded : ByteBuffer = new ByteBuffer(usize(32))
    defer delete encoded
    assertTrue(appendJsonString("hé\n\"Janus\"", encoded))
    val text : Result[string, TextDecodeError] = encoded.asText()
    val matches : bool = match text {
        Ok(value) => value == "\"hé\\n\\\"Janus\\\"\"",
        Error(error) => false
    }
    assertTrue(matches)
}

/// @test
def navigatesAndAcceptsCompletion() : Unit {
    val completion : CompletionModel = completionModel()
    defer delete completion
    completion.load("get\nsize\npush\n")
    assertTrue(completion.isVisible())
    assertEqual[usize](completion.size(), usize(3))

    completion.selectNext()
    val selected : TextBuilder = new TextBuilder()
    defer delete selected
    completion.appendItem(completion.selected(), selected)
    assertEqual[string](selected.view(), "size")

    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("xs.")
    assertTrue(completion.accept(buffer))
    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "xs.size")
    assertTrue(!completion.isVisible())
}
