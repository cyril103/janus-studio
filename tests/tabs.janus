import editor.buffer
import studio.tabs
import std.testing
import std.text

/// @test
def startsAndReturnsToNoOpenDocument() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    val tabs : DocumentTabs = documentTabs("", buffer)
    defer delete tabs
    val path : TextBuilder = new TextBuilder()
    defer delete path
    val status : TextBuilder = new TextBuilder()
    defer delete status

    assertEqual[usize](tabs.size(), usize(0))
    assertTrue(tabs.create(
        "nouveau.janus",
        buffer,
        path,
        usize(0),
        usize(0),
        status
    ))
    assertEqual[usize](tabs.size(), usize(1))
    assertEqual[string](path.view(), "nouveau.janus")
    assertTrue(tabs.close(
        usize(0),
        buffer,
        path,
        status,
        usize(0),
        usize(0)
    ))
    assertEqual[usize](tabs.size(), usize(0))
    assertEqual[string](path.view(), "")
}

/// @test
def restoresIndependentDocuments() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("premier")
    val tabs : DocumentTabs = documentTabs("src/premier.janus", buffer)
    defer delete tabs
    val path : TextBuilder = new TextBuilder()
    defer delete path
    path.append("src/premier.janus")
    val status : TextBuilder = new TextBuilder()
    defer delete status

    buffer.insert('!')
    assertTrue(tabs.create(
        "src/deuxième.janus",
        buffer,
        path,
        usize(3),
        usize(4),
        status
    ))
    assertEqual[usize](tabs.size(), usize(2))
    assertEqual[string](path.view(), "src/deuxième.janus")
    buffer.insertText("second")

    assertTrue(tabs.switchTo(
        usize(0),
        buffer,
        path,
        usize(7),
        usize(8)
    ))
    val text : TextBuilder = new TextBuilder()
    defer delete text
    buffer.appendText(text)
    assertEqual[string](text.view(), "premier!")
    assertTrue(buffer.isModified())
    assertEqual[usize](tabs.firstLine(), usize(3))
    assertEqual[usize](tabs.firstColumn(), usize(4))

    assertTrue(tabs.switchTo(
        usize(1),
        buffer,
        path,
        usize(1),
        usize(2)
    ))
    text.clear()
    buffer.appendText(text)
    assertEqual[string](text.view(), "second")
    assertEqual[usize](tabs.firstLine(), usize(7))
    assertEqual[usize](tabs.firstColumn(), usize(8))
}

/// @test
def restoresShorterDocumentFromReusedStorage() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("un contenu assez long")
    val tabs : DocumentTabs = documentTabs("long.janus", buffer)
    defer delete tabs
    val path : TextBuilder = new TextBuilder()
    defer delete path
    path.append("long.janus")
    val status : TextBuilder = new TextBuilder()
    defer delete status

    assertTrue(tabs.create(
        "second.janus",
        buffer,
        path,
        usize(0),
        usize(0),
        status
    ))
    buffer.load("second")
    assertTrue(tabs.switchTo(
        usize(0),
        buffer,
        path,
        usize(0),
        usize(0)
    ))

    buffer.load("court")
    assertTrue(tabs.switchTo(
        usize(1),
        buffer,
        path,
        usize(0),
        usize(0)
    ))
    assertTrue(tabs.switchTo(
        usize(0),
        buffer,
        path,
        usize(0),
        usize(0)
    ))

    val restored : TextBuilder = new TextBuilder()
    defer delete restored
    buffer.appendText(restored)
    assertEqual[string](restored.view(), "court")
}

/// @test
def protectsAndClosesModifiedTabs() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("stable")
    val tabs : DocumentTabs = documentTabs("stable.janus", buffer)
    defer delete tabs
    val path : TextBuilder = new TextBuilder()
    defer delete path
    path.append("stable.janus")
    val status : TextBuilder = new TextBuilder()
    defer delete status

    assertTrue(tabs.create(
        "travail.janus",
        buffer,
        path,
        usize(0),
        usize(0),
        status
    ))
    buffer.insertText("modifié")
    assertFalse(tabs.close(
        tabs.selected(),
        buffer,
        path,
        status,
        usize(0),
        usize(0)
    ))
    assertEqual[usize](tabs.size(), usize(2))

    buffer.markSaved()
    assertTrue(tabs.close(
        tabs.selected(),
        buffer,
        path,
        status,
        usize(0),
        usize(0)
    ))
    assertEqual[usize](tabs.size(), usize(1))
    assertEqual[string](path.view(), "stable.janus")
}

/// @test
def rejectsDocumentPathCollisions() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("stable")
    val tabs : DocumentTabs = documentTabs("/projet/stable.janus", buffer)
    defer delete tabs
    val path : TextBuilder = new TextBuilder()
    defer delete path
    path.append("/projet/stable.janus")
    val status : TextBuilder = new TextBuilder()
    defer delete status

    assertFalse(tabs.create(
        "/projet/stable.janus",
        buffer,
        path,
        usize(0),
        usize(0),
        status
    ))
    assertEqual[usize](tabs.size(), usize(1))
    assertTrue(tabs.create(
        "/projet/autre.janus",
        buffer,
        path,
        usize(0),
        usize(0),
        status
    ))
    assertFalse(tabs.pathAvailableForActive("/projet/stable.janus"))
    assertFalse(tabs.updateActivePath("/projet/stable.janus"))
    assertEqual[usize](tabs.size(), usize(2))
    assertEqual[string](path.view(), "/projet/autre.janus")
}

/// @test
def restoresUndoAndRedoHistoryForEachTab() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("premier")
    val tabs : DocumentTabs = documentTabs("premier.janus", buffer)
    defer delete tabs
    val path : TextBuilder = new TextBuilder()
    defer delete path
    path.append("premier.janus")
    val status : TextBuilder = new TextBuilder()
    defer delete status
    val text : TextBuilder = new TextBuilder()
    defer delete text

    buffer.insert('!')
    assertTrue(tabs.create(
        "second.janus",
        buffer,
        path,
        usize(0),
        usize(0),
        status
    ))
    buffer.insertText("second")
    assertTrue(tabs.switchTo(
        usize(0),
        buffer,
        path,
        usize(0),
        usize(0)
    ))
    assertTrue(buffer.undo())
    buffer.appendText(text)
    assertEqual[string](text.view(), "premier")
    assertTrue(buffer.redo())

    assertTrue(tabs.switchTo(
        usize(1),
        buffer,
        path,
        usize(0),
        usize(0)
    ))
    assertTrue(buffer.undo())
    text.clear()
    buffer.appendText(text)
    assertEqual[string](text.view(), "")
}
