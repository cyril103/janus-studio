import editor.buffer
import std.testing
import std.text

/// @test
def insertsAndDeletesAtCursor() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("ac")
    buffer.moveLeft()
    buffer.insert('b')

    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "abc")

    buffer.backspace()
    output.clear()
    buffer.appendText(output)
    assertEqual[string](output.view(), "ac")
}

/// @test
def insertsAndSkipsAutomaticPairs() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.insertPaired(char(40))

    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "()")
    assertEqual[usize](buffer.column(), usize(1))

    buffer.insertPaired(char(41))
    assertEqual[usize](buffer.column(), usize(2))
    buffer.insertPaired(' ')
    buffer.insertPaired(char(91))
    buffer.insertPaired(char(123))
    buffer.insertPaired(char(34))
    buffer.insertPaired(char(34))
    buffer.insertPaired(char(125))
    buffer.insertPaired(char(93))
    output.clear()
    buffer.appendText(output)
    assertEqual[string](output.view(), "() [{\"\"}]")
}

/// @test
def removesEmptyAutomaticPairWithBackspace() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.insertPaired(char(123))
    buffer.backspace()
    assertEqual[usize](buffer.size(), usize(0))
    assertEqual[usize](buffer.cursor(), usize(0))
}

/// @test
def indentsNewLineInsideBraces() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("    {}")
    buffer.moveLeft()
    buffer.insertIndentedNewline()

    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "    {\n        \n    }")
    assertEqual[usize](buffer.line(), usize(1))
    assertEqual[usize](buffer.column(), usize(8))

    assertTrue(buffer.undo())
    output.clear()
    buffer.appendText(output)
    assertEqual[string](output.view(), "    {}")
}

/// @test
def preservesIndentationOnNewLine() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("    value")
    buffer.insertIndentedNewline()
    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "    value\n    ")
    assertEqual[usize](buffer.column(), usize(4))
}

/// @test
def selectsCopiesAndReplacesText() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("alpha beta")
    buffer.moveFileStart()
    buffer.beginSelection()
    buffer.moveRight()
    buffer.moveRight()
    buffer.moveRight()
    buffer.moveRight()
    buffer.moveRight()
    assertTrue(buffer.hasSelection())
    assertEqual[usize](buffer.selectionStart(), usize(0))
    assertEqual[usize](buffer.selectionEnd(), usize(5))

    val copied : TextBuilder = new TextBuilder()
    defer delete copied
    assertTrue(buffer.appendSelection(copied))
    assertEqual[string](copied.view(), "alpha")
    buffer.insertText("value")
    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "value beta")
    assertTrue(!buffer.hasSelection())
    assertTrue(buffer.undo())
    output.clear()
    buffer.appendText(output)
    assertEqual[string](output.view(), "alpha beta")
}

/// @test
def deletesSelectedTextInOneChange() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("first\nsecond")
    buffer.moveFileStart()
    buffer.beginSelection()
    buffer.moveDown()
    assertTrue(buffer.deleteSelection())
    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "second")
    assertTrue(buffer.undo())
    output.clear()
    buffer.appendText(output)
    assertEqual[string](output.view(), "first\nsecond")
}

/// @test
def countsVisibleTextLines() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer

    assertEqual[usize](buffer.lineCount(), usize(1))
    buffer.load("première\ndeuxième\ntroisième")
    assertEqual[usize](buffer.lineCount(), usize(3))
}

/// @test
def insertsUnicodeCharacters() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.insert(char(233))

    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "é")
    assertEqual[usize](buffer.column(), usize(1))
}

/// @test
def loadsUtf8AsUnicodeCharacters() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("hé λ世😀")

    assertEqual[usize](buffer.size(), usize(6))
    assertEqual[usize](buffer.cursor(), usize(6))
    assertEqual[usize](buffer.column(), usize(6))

    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "hé λ世😀")
}

/// @test
def insertsUtf8TextAsUnicodeCharacters() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("ab")
    buffer.moveLeft()
    buffer.insertText("é世")

    assertEqual[usize](buffer.size(), usize(4))
    assertEqual[usize](buffer.cursor(), usize(3))

    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "aé世b")
}

/// @test
def replacesInvalidUtf8Bytes() : Unit {
    val bytes : Ptr[byte] = alloc[byte](usize(2))
    defer free(bytes)
    bytes.store(usize(0), byte(195))
    bytes.store(usize(1), byte(40))

    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load(stringView(bytes, usize(2)))
    assertEqual[usize](buffer.size(), usize(2))

    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "�(")
}

/// @test
def movesAcrossLines() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("alpha\nbeta\ngamma")

    buffer.moveUp()
    assertEqual[usize](buffer.line(), usize(1))
    assertEqual[usize](buffer.column(), usize(4))

    buffer.moveUp()
    assertEqual[usize](buffer.line(), usize(0))
    assertEqual[usize](buffer.column(), usize(4))

    buffer.moveDown()
    assertEqual[usize](buffer.line(), usize(1))
    assertEqual[usize](buffer.column(), usize(4))
}

/// @test
def movesRightOnlyAfterLineEnd() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("abcd\nxy")
    buffer.moveHome()
    buffer.moveUp()

    buffer.moveRight()
    buffer.moveRight()
    buffer.moveRight()
    assertEqual[usize](buffer.line(), usize(0))
    assertEqual[usize](buffer.column(), usize(3))

    buffer.moveRight()
    assertEqual[usize](buffer.line(), usize(0))
    assertEqual[usize](buffer.column(), usize(4))

    buffer.moveRight()
    assertEqual[usize](buffer.line(), usize(1))
    assertEqual[usize](buffer.column(), usize(0))
}

/// @test
def navigatesWordsAndFileBounds() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("alpha beta\nsecond")
    buffer.moveFileStart()

    buffer.moveWordForward()
    assertEqual[usize](buffer.column(), usize(6))
    buffer.moveWordBackward()
    assertEqual[usize](buffer.column(), usize(0))

    buffer.moveFileEnd()
    assertEqual[usize](buffer.line(), usize(1))
    assertEqual[usize](buffer.column(), usize(6))
}

/// @test
def movesToClickedLineAndClampsColumn() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("court\nune ligne longue\nfin")

    buffer.moveTo(usize(1), usize(4))
    assertEqual[usize](buffer.line(), usize(1))
    assertEqual[usize](buffer.column(), usize(4))

    buffer.moveTo(usize(0), usize(100))
    assertEqual[usize](buffer.line(), usize(0))
    assertEqual[usize](buffer.column(), usize(5))

    buffer.moveTo(usize(100), usize(0))
    assertEqual[usize](buffer.line(), usize(2))
    assertEqual[usize](buffer.column(), usize(3))
}

/// @test
def deletesLinesAndRestoresHistory() : Unit {
    val buffer : EditorBuffer = emptyBuffer()
    defer delete buffer
    buffer.load("first\nsecond\nthird")
    buffer.moveFileStart()
    buffer.deleteCurrentLine()

    val output : TextBuilder = new TextBuilder()
    defer delete output
    buffer.appendText(output)
    assertEqual[string](output.view(), "second\nthird")

    assertTrue(buffer.undo())
    output.clear()
    buffer.appendText(output)
    assertEqual[string](output.view(), "first\nsecond\nthird")

    assertTrue(buffer.redo())
    output.clear()
    buffer.appendText(output)
    assertEqual[string](output.view(), "second\nthird")
}
